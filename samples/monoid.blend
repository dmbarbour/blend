import Base

abstract object Monoid with
  declare type T
  declare zero, op
  law right_id:
    for +x: T()
    {op(x, zero()) == x : T()}

object AnyOf extends Monoid with
  type T: Data = Bool
  def zero() -> T():
    False{}
  def op(+a: T(), +b: T()) -> T():
    a || b
  proof right_id(x):
    match x:
      case True{}:
        {==}
      case False{}:
        {==}

def main() -> IO(Unit):
  IO.print(Bool.show(AnyOf.op(True{}, AnyOf.zero())))
