import Base

object Arith with
  copied def inc(+n: U32) -> U32:
    (n + 1 : U32)
  shared def show(+n: U32) -> String:
    U32.show(n)
  def twice(+n: U32) -> U32:
    inc(inc(n))
  def report(+n: U32) -> String:
    show(n) ++ " -> " ++ show(twice(n))

def main() -> IO(Unit):
  IO.print(Arith.report(5))
