# A lemma proves no law: named as a law of its own object, it is
# refused, with the cure, a proof proving the law.
import Base

object A with
  def id(+x: Nat) -> Nat:
    x
  law same:
    for +x: Nat
    {id(x) == x : Nat}
  lemma same(x: Nat) -> {id(x) == x : Nat}:
    {==}

def main() -> Nat:
  A.id(1n)
