#!/bin/sh
# Before git records a commit, the gate's quick checks, a dozen seconds at
# most: the docs (links, decision records and their index, plan steps and
# their dispositions), the law history, the generated samples matching
# what Blend writes (check_generated.sh), and the staged Bend files
# typechecking, with the proofs where they import a staged file
# (scripts/check_staged.py). Checks the work tree; never regenerates. The
# full gate, check.sh, still runs before every commit. Enable once per
# clone: git config core.hooksPath .githooks
cd "$(git rev-parse --show-toplevel)" || exit 1
status=0
python3 -I scripts/check_docs.py || status=1
python3 -I scripts/check_laws.py || status=1
./check_generated.sh || status=1
python3 -I scripts/check_staged.py || status=1
exit "$status"
