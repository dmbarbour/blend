def in_app_l(a: List<&2, B.Node>, +b: List<&2, B.Node>, +nd: B.Node, +h: {B.def.in(a, nd) == True{} : Bool}) -> {B.def.in(List.append(&2, B.Node, a, b), nd) == True{} : Bool}:
  match a:
    case Nil{}:
      Empty.absurd({B.def.in(b, nd) == True{} : Bool}, MB.false_ne_true()(h))
    case Con{+d, +t}:
      or_map(B.ndef.same(d, nd), B.def.in(t, nd), B.ndef.same(d, nd), B.def.in(List.append(&2, B.Node, t, b), nd), h, p => p, q => in_app_l(t, b, nd, q))

def in_app_r(a: List<&2, B.Node>, +b: List<&2, B.Node>, +nd: B.Node, +h: {B.def.in(b, nd) == True{} : Bool}) -> {B.def.in(List.append(&2, B.Node, a, b), nd) == True{} : Bool}:
  match a:
    case Nil{}:
      h
    case Con{+d, +t}:
      or_r_true(B.ndef.same(d, nd), B.def.in(List.append(&2, B.Node, t, b), nd), in_app_r(t, b, nd, h))

def within_app_l(ns: List<&2, B.Node>, +a: List<&2, B.Node>, +b: List<&2, B.Node>, +h: {B.defs.within(ns, a) == True{} : Bool}) -> {B.defs.within(ns, List.append(&2, B.Node, a, b)) == True{} : Bool}:
  match ns:
    case Nil{}:
      {==}
    case Con{nd, +t}:
      match nd:
        case B.NObj{+abs, +ext, +name, +parents, +kids, +no}:
          and_intro(B.defs.within(kids, List.append(&2, B.Node, a, b)), B.defs.within(t, List.append(&2, B.Node, a, b)),
            within_app_l(kids, a, b, and_l(B.defs.within(kids, a), B.defs.within(t, a), h)),
            within_app_l(t, a, b, and_r(B.defs.within(kids, a), B.defs.within(t, a), h)))
        case B.NDef{+share, +upd, +name, +rest, +params, +body, +no, +ind, +what}:
          and_intro(B.def.in(List.append(&2, B.Node, a, b), B.NDef{share, upd, name, rest, params, body, no, ind, what}), B.defs.within(t, List.append(&2, B.Node, a, b)),
            in_app_l(a, b, B.NDef{share, upd, name, rest, params, body, no, ind, what}, and_l(B.def.in(a, B.NDef{share, upd, name, rest, params, body, no, ind, what}), B.defs.within(t, a), h)),
            within_app_l(t, a, b, and_r(B.def.in(a, B.NDef{share, upd, name, rest, params, body, no, ind, what}), B.defs.within(t, a), h)))
        case B.NImport{+txt, +no}:
          within_app_l(t, a, b, h)
        case B.NDecl{+names, +no}:
          within_app_l(t, a, b, h)
        case B.NBad{+txt, +no}:
          within_app_l(t, a, b, h)
        case B.NErr{+msg, +no}:
          within_app_l(t, a, b, h)
        case B.NBend{+lines, +no}:
          within_app_l(t, a, b, h)

def within_app_r(ns: List<&2, B.Node>, +a: List<&2, B.Node>, +b: List<&2, B.Node>, +h: {B.defs.within(ns, b) == True{} : Bool}) -> {B.defs.within(ns, List.append(&2, B.Node, a, b)) == True{} : Bool}:
  match ns:
    case Nil{}:
      {==}
    case Con{nd, +t}:
      match nd:
        case B.NObj{+abs, +ext, +name, +parents, +kids, +no}:
          and_intro(B.defs.within(kids, List.append(&2, B.Node, a, b)), B.defs.within(t, List.append(&2, B.Node, a, b)),
            within_app_r(kids, a, b, and_l(B.defs.within(kids, b), B.defs.within(t, b), h)),
            within_app_r(t, a, b, and_r(B.defs.within(kids, b), B.defs.within(t, b), h)))
        case B.NDef{+share, +upd, +name, +rest, +params, +body, +no, +ind, +what}:
          and_intro(B.def.in(List.append(&2, B.Node, a, b), B.NDef{share, upd, name, rest, params, body, no, ind, what}), B.defs.within(t, List.append(&2, B.Node, a, b)),
            in_app_r(a, b, B.NDef{share, upd, name, rest, params, body, no, ind, what}, and_l(B.def.in(b, B.NDef{share, upd, name, rest, params, body, no, ind, what}), B.defs.within(t, b), h)),
            within_app_r(t, a, b, and_r(B.def.in(b, B.NDef{share, upd, name, rest, params, body, no, ind, what}), B.defs.within(t, b), h)))
        case B.NImport{+txt, +no}:
          within_app_r(t, a, b, h)
        case B.NDecl{+names, +no}:
          within_app_r(t, a, b, h)
        case B.NBad{+txt, +no}:
          within_app_r(t, a, b, h)
        case B.NErr{+msg, +no}:
          within_app_r(t, a, b, h)
        case B.NBend{+lines, +no}:
          within_app_r(t, a, b, h)

def within_cons(ns: List<&2, B.Node>, +d: B.Node, +b: List<&2, B.Node>, +h: {B.defs.within(ns, b) == True{} : Bool}) -> {B.defs.within(ns, Con{d, b}) == True{} : Bool}:
  match ns:
    case Nil{}:
      {==}
    case Con{nd, +t}:
      match nd:
        case B.NObj{+abs, +ext, +name, +parents, +kids, +no}:
          and_intro(B.defs.within(kids, Con{d, b}), B.defs.within(t, Con{d, b}),
            within_cons(kids, d, b, and_l(B.defs.within(kids, b), B.defs.within(t, b), h)),
            within_cons(t, d, b, and_r(B.defs.within(kids, b), B.defs.within(t, b), h)))
        case B.NDef{+share, +upd, +name, +rest, +params, +body, +no, +ind, +what}:
          and_intro(B.def.in(Con{d, b}, B.NDef{share, upd, name, rest, params, body, no, ind, what}), B.defs.within(t, Con{d, b}),
            or_r_true(B.ndef.same(d, B.NDef{share, upd, name, rest, params, body, no, ind, what}), B.def.in(b, B.NDef{share, upd, name, rest, params, body, no, ind, what}), and_l(B.def.in(b, B.NDef{share, upd, name, rest, params, body, no, ind, what}), B.defs.within(t, b), h)),
            within_cons(t, d, b, and_r(B.def.in(b, B.NDef{share, upd, name, rest, params, body, no, ind, what}), B.defs.within(t, b), h)))
        case B.NImport{+txt, +no}:
          within_cons(t, d, b, h)
        case B.NDecl{+names, +no}:
          within_cons(t, d, b, h)
        case B.NBad{+txt, +no}:
          within_cons(t, d, b, h)
        case B.NErr{+msg, +no}:
          within_cons(t, d, b, h)
        case B.NBend{+lines, +no}:
          within_cons(t, d, b, h)

# a tree's definitions held by its own list
def tree_self(ns: List<&2, B.Node>) -> {B.defs.within(ns, B.tree.defs(ns)) == True{} : Bool}:
  match ns:
    case Nil{}:
      {==}
    case Con{nd, +t}:
      match nd:
        case B.NObj{+abs, +ext, +name, +parents, +kids, +no}:
          and_intro(B.defs.within(kids, List.append(&2, B.Node, B.tree.defs(kids), B.tree.defs(t))), B.defs.within(t, List.append(&2, B.Node, B.tree.defs(kids), B.tree.defs(t))),
            within_app_l(kids, B.tree.defs(kids), B.tree.defs(t), tree_self(kids)), within_app_r(t, B.tree.defs(kids), B.tree.defs(t), tree_self(t)))
        case B.NDef{+share, +upd, +name, +rest, +params, +body, +no, +ind, +what}:
          and_intro(B.def.in(Con{B.NDef{share, upd, name, rest, params, body, no, ind, what}, B.tree.defs(t)}, B.NDef{share, upd, name, rest, params, body, no, ind, what}), B.defs.within(t, Con{B.NDef{share, upd, name, rest, params, body, no, ind, what}, B.tree.defs(t)}),
            or_l_true(B.ndef.same(B.NDef{share, upd, name, rest, params, body, no, ind, what}, B.NDef{share, upd, name, rest, params, body, no, ind, what}), B.def.in(B.tree.defs(t), B.NDef{share, upd, name, rest, params, body, no, ind, what}), ndef_refl(share, upd, name, rest, params, body, no, ind, what)),
            within_cons(t, B.NDef{share, upd, name, rest, params, body, no, ind, what}, B.tree.defs(t), tree_self(t)))
        case B.NImport{+txt, +no}:
          tree_self(t)
        case B.NDecl{+names, +no}:
          tree_self(t)
        case B.NBad{+txt, +no}:
          tree_self(t)
        case B.NErr{+msg, +no}:
          tree_self(t)
        case B.NBend{+lines, +no}:
          tree_self(t)

# every tree of a list within ds
def tsw(ts: List<&2, List<&2, B.Node>>, +ds: List<&2, B.Node>) -> Bool:
  match ts:
    case Nil{}:
      True{}
    case Con{tr, t}:
      Bool.and(B.defs.within(tr, ds), tsw(t, ds))

def tsw_app_r(ts: List<&2, List<&2, B.Node>>, +a: List<&2, B.Node>, +b: List<&2, B.Node>, +h: {tsw(ts, b) == True{} : Bool}) ->
    {tsw(ts, List.append(&2, B.Node, a, b)) == True{} : Bool}:
  match ts:
    case Nil{}:
      {==}
    case Con{+tr, +t}:
      and_intro(B.defs.within(tr, List.append(&2, B.Node, a, b)), tsw(t, List.append(&2, B.Node, a, b)),
        within_app_r(tr, a, b, and_l(B.defs.within(tr, b), tsw(t, b), h)), tsw_app_r(t, a, b, and_r(B.defs.within(tr, b), tsw(t, b), h)))

# every tree within the trees' definitions
def trees_within(ts: List<&2, List<&2, B.Node>>) -> {tsw(ts, B.trees.defs(ts)) == True{} : Bool}:
  match ts:
    case Nil{}:
      {==}
    case Con{+tr, +t}:
      and_intro(B.defs.within(tr, List.append(&2, B.Node, B.tree.defs(tr), B.trees.defs(t))), tsw(t, List.append(&2, B.Node, B.tree.defs(tr), B.trees.defs(t))),
        within_app_l(tr, B.tree.defs(tr), B.trees.defs(t), tree_self(tr)), tsw_app_r(t, B.tree.defs(tr), B.trees.defs(t), trees_within(t)))

# the walk's member lists within ds
def wfsw(st: List<&2, B.Wf>, +ds: List<&2, B.Node>) -> Bool:
  match st:
    case Nil{}:
      True{}
    case Con{f, t}:
      match f:
        case B.Wf{+host, path, nodes}:
          Bool.and(B.defs.within(nodes, ds), wfsw(t, ds))

# the objects walked: each one's members a list the walk had, within ds
def og_ok(n: Nat, st: List<&2, B.Wf>, +next: U32, +out: List<&2, B.Ob>, +ds: List<&2, B.Node>, +hs: {wfsw(st, ds) == True{} : Bool},
    +ho: {B.objs.within(out, ds) == True{} : Bool}) -> {B.objs.within(B.obs.go(n, st, next, out), ds) == True{} : Bool}:
  match n:
    case 0n:
      ho
    case 1n+(+k):
      match st:
        case Nil{}:
          ho
        case Con{f, +rest}:
          match f:
            case B.Wf{+host, +path, nodes}:
              match nodes:
                case Nil{}:
                  og_ok(k, rest, next, out, ds, hs, ho)
                case Con{nd, +t}:
                  match nd:
                    case B.NObj{+abs, +ext, +name, +parents, +kids, +no}:
                      og_ok(k, Con{B.Wf{next, List.append(&2, List<&2, U32>, path, [name]), kids}, Con{B.Wf{host, path, t}, rest}}, U32.add(next, 1),
                        Con{B.Ob{next, host, List.append(&2, List<&2, U32>, path, [name]), abs, parents, kids, no, B.ob.kind.of(ext, path), next}, out}, ds,
                        and_intro(B.defs.within(kids, ds), Bool.and(B.defs.within(t, ds), wfsw(rest, ds)),
                          and_l(B.defs.within(kids, ds), B.defs.within(t, ds), and_l(Bool.and(B.defs.within(kids, ds), B.defs.within(t, ds)), wfsw(rest, ds), hs)),
                          and_intro(B.defs.within(t, ds), wfsw(rest, ds),
                            and_r(B.defs.within(kids, ds), B.defs.within(t, ds), and_l(Bool.and(B.defs.within(kids, ds), B.defs.within(t, ds)), wfsw(rest, ds), hs)),
                            and_r(Bool.and(B.defs.within(kids, ds), B.defs.within(t, ds)), wfsw(rest, ds), hs))),
                        and_intro(B.defs.within(kids, ds), B.objs.within(out, ds),
                          and_l(B.defs.within(kids, ds), B.defs.within(t, ds), and_l(Bool.and(B.defs.within(kids, ds), B.defs.within(t, ds)), wfsw(rest, ds), hs)), ho))
                    case B.NDef{+share, +upd, +name, +rest2, +params, +body, +no, +ind, +what}:
                      og_ok(k, Con{B.Wf{host, path, t}, rest}, next, out, ds,
                        and_intro(B.defs.within(t, ds), wfsw(rest, ds),
                          and_r(B.def.in(ds, B.NDef{share, upd, name, rest2, params, body, no, ind, what}), B.defs.within(t, ds),
                            and_l(Bool.and(B.def.in(ds, B.NDef{share, upd, name, rest2, params, body, no, ind, what}), B.defs.within(t, ds)), wfsw(rest, ds), hs)),
                          and_r(Bool.and(B.def.in(ds, B.NDef{share, upd, name, rest2, params, body, no, ind, what}), B.defs.within(t, ds)), wfsw(rest, ds), hs)), ho)
                    case B.NImport{+txt, +no}:
                      og_ok(k, Con{B.Wf{host, path, t}, rest}, next, out, ds, hs, ho)
                    case B.NDecl{+names, +no}:
                      og_ok(k, Con{B.Wf{host, path, t}, rest}, next, out, ds, hs, ho)
                    case B.NBad{+txt, +no}:
                      og_ok(k, Con{B.Wf{host, path, t}, rest}, next, out, ds, hs, ho)
                    case B.NErr{+msg, +no}:
                      og_ok(k, Con{B.Wf{host, path, t}, rest}, next, out, ds, hs, ho)
                    case B.NBend{+lines, +no}:
                      og_ok(k, Con{B.Wf{host, path, t}, rest}, next, out, ds, hs, ho)

def objs_rev(xs: List<&2, B.Ob>, +acc: List<&2, B.Ob>, +ds: List<&2, B.Node>, +hx: {B.objs.within(xs, ds) == True{} : Bool}, +ha: {B.objs.within(acc, ds) == True{} : Bool}) -> {B.objs.within(List.reverse.go(&2, B.Ob, xs, acc), ds) == True{} : Bool}:
  match xs:
    case Nil{}:
      ha
    case Con{+o, +t}:
      objs_rev(t, Con{o, acc}, ds, and_r(B.defs.within(B.ob.mems(o), ds), B.objs.within(t, ds), hx),
        and_intro(B.defs.within(B.ob.mems(o), ds), B.objs.within(acc, ds), and_l(B.defs.within(B.ob.mems(o), ds), B.objs.within(t, ds), hx), ha))

def objs_app(xs: List<&2, B.Ob>, +b: List<&2, B.Ob>, +ds: List<&2, B.Node>, +hx: {B.objs.within(xs, ds) == True{} : Bool}, +hb: {B.objs.within(b, ds) == True{} : Bool}) -> {B.objs.within(List.append(&2, B.Ob, xs, b), ds) == True{} : Bool}:
  match xs:
    case Nil{}:
      hb
    case Con{+o, +t}:
      and_intro(B.defs.within(B.ob.mems(o), ds), B.objs.within(List.append(&2, B.Ob, t, b), ds), and_l(B.defs.within(B.ob.mems(o), ds), B.objs.within(t, ds), hx),
        objs_app(t, b, ds, and_r(B.defs.within(B.ob.mems(o), ds), B.objs.within(t, ds), hx), hb))

def mods_ok(ts: List<&2, List<&2, B.Node>>, +k: U32, +out: List<&2, B.Ob>, +ds: List<&2, B.Node>, +ht: {tsw(ts, ds) == True{} : Bool}, +ho: {B.objs.within(out, ds) == True{} : Bool}) ->
    {B.objs.within(B.obs.mods(ts, k, out), ds) == True{} : Bool}:
  match ts:
    case Nil{}:
      ho
    case Con{+tr, +t}:
      mods_ok(t, U32.add(k, 1), B.obs.mod(tr, k, out), ds, and_r(B.defs.within(tr, ds), tsw(t, ds), ht),
        og_ok(B.wf.turns([B.Wf{U32.from_nat(List.length(&2, B.Ob, out)), Nil{}, tr}]), [B.Wf{U32.from_nat(List.length(&2, B.Ob, out)), Nil{}, tr}], U32.add(U32.from_nat(List.length(&2, B.Ob, out)), 1),
          Con{B.Ob{U32.from_nat(List.length(&2, B.Ob, out)), U32.from_nat(List.length(&2, B.Ob, out)), Nil{}, False{}, Nil{}, tr, B.loc.top(k), 0,
            U32.from_nat(List.length(&2, B.Ob, out))}, out}, ds,
          and_intro(B.defs.within(tr, ds), True{}, and_l(B.defs.within(tr, ds), tsw(t, ds), ht), {==}),
          and_intro(B.defs.within(tr, ds), B.objs.within(out, ds), and_l(B.defs.within(tr, ds), tsw(t, ds), ht), ho)))

# the trees' objects: their members within the trees' definitions
def obs_ok(+trees: List<&2, List<&2, B.Node>>) -> {B.objs.within(B.obs(trees), B.trees.defs(trees)) == True{} : Bool}:
  objs_rev(B.obs.mods(trees, 0, Nil{}), Nil{}, B.trees.defs(trees), mods_ok(trees, 0, Nil{}, B.trees.defs(trees), trees_within(trees), {==}), {==})

# syn.x's decision mirrored: a made object, no members of its own
def sxk(+c: Bool, +n: List<&2, U32>, +t: List<&2, List<&2, U32>>, +x: U32, +obs: List<&2, B.Ob>, +made: List<&2, B.Ob>, +next: U32) -> List<&2, B.Ob>:
  B.when(List<&2, B.Ob>, c, u => B.syn.x(t, x, obs, made, next), u => B.syn.x(t, x, obs, Con{B.Ob{next, x, List.append(&2, List<&2, U32>, B.ob.path(B.ob.at(obs, x)), [n]), B.ob.abs(B.ob.at(obs, x)), Nil{}, Nil{}, B.ob.no(B.ob.at(obs, x)), 3, next}, made}, U32.add(next, 1)))

def sx_k(c: Bool, +n: List<&2, U32>, +t: List<&2, List<&2, U32>>, +x: U32, +obs: List<&2, B.Ob>, +made: List<&2, B.Ob>, +next: U32, +ds: List<&2, B.Node>,
    ih1: {B.objs.within(B.syn.x(t, x, obs, made, next), ds) == True{} : Bool}, ih2: {B.objs.within(B.syn.x(t, x, obs, Con{B.Ob{next, x, List.append(&2, List<&2, U32>, B.ob.path(B.ob.at(obs, x)), [n]), B.ob.abs(B.ob.at(obs, x)), Nil{}, Nil{}, B.ob.no(B.ob.at(obs, x)), 3, next}, made}, U32.add(next, 1)), ds) == True{} : Bool}) ->
    {B.objs.within(sxk(c, n, t, x, obs, made, next), ds) == True{} : Bool}:
  match c:
    case True{}:
      ih1
    case False{}:
      ih2

def sx_ok(ns: List<&2, List<&2, U32>>, +x: U32, +obs: List<&2, B.Ob>, +made: List<&2, B.Ob>, +next: U32, +ds: List<&2, B.Node>, +hm: {B.objs.within(made, ds) == True{} : Bool}) ->
    {B.objs.within(B.syn.x(ns, x, obs, made, next), ds) == True{} : Bool}:
  match ns:
    case Nil{}:
      hm
    case Con{+n, +t}:
      sx_k(Bool.or(B.made.has(obs, x, n), B.made.has(made, x, n)), n, t, x, obs, made, next, ds, sx_ok(t, x, obs, made, next, ds, hm),
        sx_ok(t, x, obs, Con{B.Ob{next, x, List.append(&2, List<&2, U32>, B.ob.path(B.ob.at(obs, x)), [n]), B.ob.abs(B.ob.at(obs, x)), Nil{}, Nil{}, B.ob.no(B.ob.at(obs, x)), 3, next}, made}, U32.add(next, 1), ds, hm))

def srk(+c: Bool, +id: U32, +t: List<&2, B.Ob>, +obs: List<&2, B.Ob>, +ls: List<&2, Maybe<&2, B.Lz>>, +made: List<&2, B.Ob>) -> List<&2, B.Ob>:
  B.when(List<&2, B.Ob>, c, u => B.syn.round(t, obs, ls, B.syn.x(B.mixin.names(B.lz.ord(B.lz.at(ls, id)), obs, Nil{}), id, obs, made, U32.add(U32.from_nat(List.length(&2, B.Ob, obs)), U32.from_nat(List.length(&2, B.Ob, made))))),
    u => B.syn.round(t, obs, ls, made))

def sr_k(c: Bool, +id: U32, +t: List<&2, B.Ob>, +obs: List<&2, B.Ob>, +ls: List<&2, Maybe<&2, B.Lz>>, +made: List<&2, B.Ob>, +ds: List<&2, B.Node>,
    ih1: {B.objs.within(B.syn.round(t, obs, ls, B.syn.x(B.mixin.names(B.lz.ord(B.lz.at(ls, id)), obs, Nil{}), id, obs, made, U32.add(U32.from_nat(List.length(&2, B.Ob, obs)), U32.from_nat(List.length(&2, B.Ob, made))))), ds) == True{} : Bool},
    ih2: {B.objs.within(B.syn.round(t, obs, ls, made), ds) == True{} : Bool}) -> {B.objs.within(srk(c, id, t, obs, ls, made), ds) == True{} : Bool}:
  match c:
    case True{}:
      ih1
    case False{}:
      ih2

# a round's made objects: none with members
def sr_ok(os: List<&2, B.Ob>, +obs: List<&2, B.Ob>, +ls: List<&2, Maybe<&2, B.Lz>>, +made: List<&2, B.Ob>, +ds: List<&2, B.Node>, +hm: {B.objs.within(made, ds) == True{} : Bool}) ->
    {B.objs.within(B.syn.round(os, obs, ls, made), ds) == True{} : Bool}:
  match os:
    case Nil{}:
      hm
    case Con{o, +t}:
      match o:
        case B.Ob{+id, +host, path, +abs, parents, mems, +no, +kind, +tpl}:
          sr_k(Bool.and(B.is.object(kind), Bool.not(U32.is_eq(id, host))), id, t, obs, ls, made, ds,
            sr_ok(t, obs, ls, B.syn.x(B.mixin.names(B.lz.ord(B.lz.at(ls, id)), obs, Nil{}), id, obs, made, U32.add(U32.from_nat(List.length(&2, B.Ob, obs)), U32.from_nat(List.length(&2, B.Ob, made)))), ds,
              sx_ok(B.mixin.names(B.lz.ord(B.lz.at(ls, id)), obs, Nil{}), id, obs, made, U32.add(U32.from_nat(List.length(&2, B.Ob, obs)), U32.from_nat(List.length(&2, B.Ob, made))), ds, hm)),
            sr_ok(t, obs, ls, made, ds, hm))

# an object's members by its number: within, where every object's are
def get_within(os: List<&2, B.Ob>, n: Nat, +ds: List<&2, B.Node>, +h: {B.objs.within(os, ds) == True{} : Bool}) -> {B.defs.within(B.ob.mems(B.ob.or(List.get(&2, B.Ob, os, n))), ds) == True{} : Bool}:
  match os:
    case Nil{}:
      {==}
    case Con{+o, +t}:
      match n:
        case 0n:
          and_l(B.defs.within(B.ob.mems(o), ds), B.objs.within(t, ds), h)
        case 1n+k:
          get_within(t, k, ds, and_r(B.defs.within(B.ob.mems(o), ds), B.objs.within(t, ds), h))

def ctk(+c: Bool, +t: U32, +r: List<&2, U32>, +x: U32, +obs: List<&2, B.Ob>, +made: List<&2, B.Ob>, +next: U32) -> List<&2, B.Ob>:
  B.when(List<&2, B.Ob>, c, u => B.copies.t(r, x, obs, made, next), u => B.copies.t(r, x, obs, Con{B.Ob{next, x, B.ob.path(B.ob.at(obs, t)), B.ob.abs(B.ob.at(obs, t)), Nil{}, B.ob.mems(B.ob.at(obs, t)), B.ob.no(B.ob.at(obs, t)), B.ob.kind(B.ob.at(obs, t)), t}, made}, U32.add(next, 1)))

def ct_k(c: Bool, +t: U32, +r: List<&2, U32>, +x: U32, +obs: List<&2, B.Ob>, +made: List<&2, B.Ob>, +next: U32, +ds: List<&2, B.Node>,
    ih1: {B.objs.within(B.copies.t(r, x, obs, made, next), ds) == True{} : Bool}, ih2: {B.objs.within(B.copies.t(r, x, obs, Con{B.Ob{next, x, B.ob.path(B.ob.at(obs, t)), B.ob.abs(B.ob.at(obs, t)), Nil{}, B.ob.mems(B.ob.at(obs, t)), B.ob.no(B.ob.at(obs, t)), B.ob.kind(B.ob.at(obs, t)), t}, made}, U32.add(next, 1)), ds) == True{} : Bool}) -> {B.objs.within(ctk(c, t, r, x, obs, made, next), ds) == True{} : Bool}:
  match c:
    case True{}:
      ih1
    case False{}:
      ih2

# a mixin's bound copies: its members, within
def ct_ok(ts: List<&2, U32>, +x: U32, +obs: List<&2, B.Ob>, +made: List<&2, B.Ob>, +next: U32, +ds: List<&2, B.Node>, +hobs: {B.objs.within(obs, ds) == True{} : Bool}, +hm: {B.objs.within(made, ds) == True{} : Bool}) ->
    {B.objs.within(B.copies.t(ts, x, obs, made, next), ds) == True{} : Bool}:
  match ts:
    case Nil{}:
      hm
    case Con{+t, +r}:
      ct_k(B.copy.has(obs, made, t, x), t, r, x, obs, made, next, ds, ct_ok(r, x, obs, made, next, ds, hobs, hm),
        ct_ok(r, x, obs, Con{B.Ob{next, x, B.ob.path(B.ob.at(obs, t)), B.ob.abs(B.ob.at(obs, t)), Nil{}, B.ob.mems(B.ob.at(obs, t)), B.ob.no(B.ob.at(obs, t)), B.ob.kind(B.ob.at(obs, t)), t}, made}, U32.add(next, 1), ds, hobs,
          and_intro(B.defs.within(B.ob.mems(B.ob.at(obs, t)), ds), B.objs.within(made, ds), get_within(obs, U32.to_nat(t), ds, hobs), hm)))

def sck(+c: Bool, +host: U32, +path: List<&2, List<&2, U32>>, +t: List<&2, B.Ob>, +obs: List<&2, B.Ob>, +ls: List<&2, Maybe<&2, B.Lz>>, +made: List<&2, B.Ob>) -> List<&2, B.Ob>:
  B.when(List<&2, B.Ob>, c, u => B.syn.copies(t, obs, ls, B.copies.t(B.mixins.of(B.lz.ord(B.lz.at(ls, host)), obs, B.path.last(path)), host, obs, made, U32.add(U32.from_nat(List.length(&2, B.Ob, obs)), U32.from_nat(List.length(&2, B.Ob, made))))), u => B.syn.copies(t, obs, ls, made))

def sc_k(c: Bool, +host: U32, +path: List<&2, List<&2, U32>>, +t: List<&2, B.Ob>, +obs: List<&2, B.Ob>, +ls: List<&2, Maybe<&2, B.Lz>>, +made: List<&2, B.Ob>,
    +ds: List<&2, B.Node>, ih1: {B.objs.within(B.syn.copies(t, obs, ls, B.copies.t(B.mixins.of(B.lz.ord(B.lz.at(ls, host)), obs, B.path.last(path)), host, obs, made, U32.add(U32.from_nat(List.length(&2, B.Ob, obs)), U32.from_nat(List.length(&2, B.Ob, made))))), ds) == True{} : Bool}, ih2: {B.objs.within(B.syn.copies(t, obs, ls, made), ds) == True{} : Bool}) -> {B.objs.within(sck(c, host, path, t, obs, ls, made), ds) == True{} : Bool}:
  match c:
    case True{}:
      ih1
    case False{}:
      ih2

# the made objects' bound mixins: their members, within
def sc_ok(os: List<&2, B.Ob>, +obs: List<&2, B.Ob>, +ls: List<&2, Maybe<&2, B.Lz>>, +made: List<&2, B.Ob>, +ds: List<&2, B.Node>, +hobs: {B.objs.within(obs, ds) == True{} : Bool}, +hm: {B.objs.within(made, ds) == True{} : Bool}) ->
    {B.objs.within(B.syn.copies(os, obs, ls, made), ds) == True{} : Bool}:
  match os:
    case Nil{}:
      hm
    case Con{o, +t}:
      match o:
        case B.Ob{+id, +host, +path, +abs, parents, mems, +no, +kind, +tpl}:
          sc_k(U32.is_eq(kind, 3), host, path, t, obs, ls, made, ds,
            sc_ok(t, obs, ls, B.copies.t(B.mixins.of(B.lz.ord(B.lz.at(ls, host)), obs, B.path.last(path)), host, obs, made, U32.add(U32.from_nat(List.length(&2, B.Ob, obs)), U32.from_nat(List.length(&2, B.Ob, made)))), ds, hobs, ct_ok(B.mixins.of(B.lz.ord(B.lz.at(ls, host)), obs, B.path.last(path)), host, obs, made, U32.add(U32.from_nat(List.length(&2, B.Ob, obs)), U32.from_nat(List.length(&2, B.Ob, made))), ds, hobs, hm)),
            sc_ok(t, obs, ls, made, ds, hobs, hm))

# syn.go's step mirrored
def sgk(+c: Bool, +k: Nat, +als: List<&2, B.Al>, +obs: List<&2, B.Ob>, +npss: List<&2, List<&2, U32>>, +nls: List<&2, Maybe<&2, B.Lz>>, +made: List<&2, B.Ob>) -> B.Sy:
  B.when(B.Sy, c, u => B.Sy{obs, npss, nls}, u => B.syn.go(k, als, List.append(&2, B.Ob, obs, List.reverse(&2, B.Ob, made)), npss, nls))

def sg_k(c: Bool, +k: Nat, +als: List<&2, B.Al>, +obs: List<&2, B.Ob>, +npss: List<&2, List<&2, U32>>, +nls: List<&2, Maybe<&2, B.Lz>>, +made: List<&2, B.Ob>,
    +ds: List<&2, B.Node>, +h: {B.objs.within(obs, ds) == True{} : Bool}, ih: {B.objs.within(B.sy.obs(B.syn.go(k, als, List.append(&2, B.Ob, obs, List.reverse(&2, B.Ob, made)), npss, nls)), ds) == True{} : Bool}) ->
    {B.objs.within(B.sy.obs(sgk(c, k, als, obs, npss, nls, made)), ds) == True{} : Bool}:
  match c:
    case True{}:
      h
    case False{}:
      ih

# the made objects' rounds keep every object's members within
def sg_ok(n: Nat, +als: List<&2, B.Al>, +obs: List<&2, B.Ob>, +pss: List<&2, List<&2, U32>>, +ls: List<&2, Maybe<&2, B.Lz>>, +ds: List<&2, B.Node>, +h: {B.objs.within(obs, ds) == True{} : Bool}) ->
    {B.objs.within(B.sy.obs(B.syn.go(n, als, obs, pss, ls)), ds) == True{} : Bool}:
  match n:
    case 0n:
      h
    case 1n+(+k):
      sg_k(Bool.and(B.obs.none(B.syn.copies(obs, obs, B.lins(B.pids(obs, als, obs, ls)), B.syn.round(obs, obs, B.lins(B.pids(obs, als, obs, ls)), Nil{}))), B.pss.eq(B.pids(obs, als, obs, ls), pss)), k, als, obs, B.pids(obs, als, obs, ls), B.lins(B.pids(obs, als, obs, ls)), B.syn.copies(obs, obs, B.lins(B.pids(obs, als, obs, ls)), B.syn.round(obs, obs, B.lins(B.pids(obs, als, obs, ls)), Nil{})), ds, h,
        sg_ok(k, als, List.append(&2, B.Ob, obs, List.reverse(&2, B.Ob, B.syn.copies(obs, obs, B.lins(B.pids(obs, als, obs, ls)), B.syn.round(obs, obs, B.lins(B.pids(obs, als, obs, ls)), Nil{})))), B.pids(obs, als, obs, ls), B.lins(B.pids(obs, als, obs, ls)), ds,
          objs_app(obs, List.reverse(&2, B.Ob, B.syn.copies(obs, obs, B.lins(B.pids(obs, als, obs, ls)), B.syn.round(obs, obs, B.lins(B.pids(obs, als, obs, ls)), Nil{}))), ds, h,
            objs_rev(B.syn.copies(obs, obs, B.lins(B.pids(obs, als, obs, ls)), B.syn.round(obs, obs, B.lins(B.pids(obs, als, obs, ls)), Nil{})), Nil{}, ds, sc_ok(obs, obs, B.lins(B.pids(obs, als, obs, ls)), B.syn.round(obs, obs, B.lins(B.pids(obs, als, obs, ls)), Nil{}), ds, h, sr_ok(obs, obs, B.lins(B.pids(obs, als, obs, ls)), Nil{}, ds, {==})), {==}))))

def ma_ok(os: List<&2, B.Ob>, +obs: List<&2, B.Ob>, +pss: List<&2, List<&2, U32>>, +ds: List<&2, B.Node>, +h: {B.objs.within(os, ds) == True{} : Bool}) -> {B.objs.within(B.made.abs(os, obs, pss), ds) == True{} : Bool}:
  match os:
    case Nil{}:
      {==}
    case Con{o, +t}:
      match o:
        case B.Ob{+id, +host, path, +abs, parents, +mems, +no, +kind, +tpl}:
          and_intro(B.defs.within(mems, ds), B.objs.within(B.made.abs(t, obs, pss), ds), and_l(B.defs.within(mems, ds), B.objs.within(t, ds), h),
            ma_ok(t, obs, pss, ds, and_r(B.defs.within(mems, ds), B.objs.within(t, ds), h)))

def Laws.nodes.objects(trees, als):
  ma_ok(B.sy.obs(B.syn.of(als, B.obs(trees))), B.sy.obs(B.syn.of(als, B.obs(trees))), B.sy.pss(B.syn.of(als, B.obs(trees))), B.trees.defs(trees),
    sg_ok(Nat.add(2n, Nat.add(List.length(&2, B.Ob, B.obs(trees)), List.length(&2, B.Ob, B.obs(trees)))), als, B.obs(trees), Nil{}, Nil{}, B.trees.defs(trees), obs_ok(trees)))

def Laws.nodes(trees, als, ls, fs, als2, paths, pss):
  Laws.nodes.copies(B.obs.made(B.syn.of(als, B.obs(trees))), ls, fs, als2, paths, pss, B.trees.defs(trees), Laws.nodes.objects(trees, als))

# The tree (`markers.tree`): a body's lines made the tree's one for one
# (`ln_bl`), each open object's members numbered so (`frok`), a node added
# (`into_ok`), an object closed (`close_ok`), each item put (`put_ok`).

def ln_bl(ls: List<&2, B.Ln>, +k: B.Loc) -> {B.bl.from(B.toks.lines(ls), k) == B.ln.from(ls, k) : Bool}:
  match ls:
    case Nil{}:
      {==}
    case Con{l, +t}:
      match l:
        case B.Ln{+no, +ind, +txt}:
          %Equal.sym(Bool, B.bl.from(B.toks.lines(t), B.loc.next(k)), B.ln.from(t, B.loc.next(k)), ln_bl(t, B.loc.next(k))) :
            {Bool.and(B.loc.eq(no, k), _) == Bool.and(B.loc.eq(no, k), B.ln.from(t, B.loc.next(k))) : Bool}
          {==}

def frok(st: List<&2, B.Fr>) -> Bool:
  match st:
    case Nil{}:
      True{}
    case Con{f, t}:
      match f:
        case B.Fr{+top, +ind, +abs, +with, +ext, name, parents, kids, +no}:
          Bool.and(B.defs.ok(kids), frok(t))

def cons_ok(n: B.Node, +ks: List<&2, B.Node>, +hn: {B.defs.ok(Con{n, Nil{}}) == True{} : Bool}, +hk: {B.defs.ok(ks) == True{} : Bool}) -> {B.defs.ok(Con{n, ks}) == True{} : Bool}:
  match n:
    case B.NObj{+abs, +ext, +name, +parents, +kids, +no}:
      and_intro(B.defs.ok(kids), B.defs.ok(ks), and_l(B.defs.ok(kids), True{}, hn), hk)
    case B.NDef{+share, +upd, +name, +rest, +params, +body, +no, +ind, +what}:
      and_intro(Bool.or(B.bl.from(body, no), B.bl.from(body, B.loc.next(no))), B.defs.ok(ks),
        and_l(Bool.or(B.bl.from(body, no), B.bl.from(body, B.loc.next(no))), True{}, hn), hk)
    case B.NImport{+txt, +no}:
      hk
    case B.NDecl{+names, +no}:
      hk
    case B.NBad{+txt, +no}:
      hk
    case B.NErr{+msg, +no}:
      hk
    case B.NBend{+lines, +no}:
      hk

def head_ok(n: B.Node, +t: List<&2, B.Node>, +h: {B.defs.ok(Con{n, t}) == True{} : Bool}) -> {B.defs.ok(Con{n, Nil{}}) == True{} : Bool}:
  match n:
    case B.NObj{+abs, +ext, +name, +parents, +kids, +no}:
      and_intro(B.defs.ok(kids), True{}, and_l(B.defs.ok(kids), B.defs.ok(t), h), {==})
    case B.NDef{+share, +upd, +name, +rest, +params, +body, +no, +ind, +what}:
      and_intro(Bool.or(B.bl.from(body, no), B.bl.from(body, B.loc.next(no))), True{},
        and_l(Bool.or(B.bl.from(body, no), B.bl.from(body, B.loc.next(no))), B.defs.ok(t), h), {==})
    case B.NImport{+txt, +no}:
      {==}
    case B.NDecl{+names, +no}:
      {==}
    case B.NBad{+txt, +no}:
      {==}
    case B.NErr{+msg, +no}:
      {==}
    case B.NBend{+lines, +no}:
      {==}

def tail_ok(n: B.Node, +t: List<&2, B.Node>, +h: {B.defs.ok(Con{n, t}) == True{} : Bool}) -> {B.defs.ok(t) == True{} : Bool}:
  match n:
    case B.NObj{+abs, +ext, +name, +parents, +kids, +no}:
      and_r(B.defs.ok(kids), B.defs.ok(t), h)
    case B.NDef{+share, +upd, +name, +rest, +params, +body, +no, +ind, +what}:
      and_r(Bool.or(B.bl.from(body, no), B.bl.from(body, B.loc.next(no))), B.defs.ok(t), h)
    case B.NImport{+txt, +no}:
      h
    case B.NDecl{+names, +no}:
      h
    case B.NBad{+txt, +no}:
      h
    case B.NErr{+msg, +no}:
      h
    case B.NBend{+lines, +no}:
      h

def dok_rev(xs: List<&2, B.Node>, +acc: List<&2, B.Node>, +hx: {B.defs.ok(xs) == True{} : Bool}, +ha: {B.defs.ok(acc) == True{} : Bool}) ->
    {B.defs.ok(List.reverse.go(&2, B.Node, xs, acc)) == True{} : Bool}:
  match xs:
    case Nil{}:
      ha
    case Con{+n, +t}:
      dok_rev(t, Con{n, acc}, tail_ok(n, t, hx), cons_ok(n, acc, head_ok(n, t, hx), ha))

# a node, numbered so, added to the open object
def into_ok(st: List<&2, B.Fr>, +n: B.Node, +hn: {B.defs.ok(Con{n, Nil{}}) == True{} : Bool}, +hs: {frok(st) == True{} : Bool}) -> {frok(B.close.into(st, n)) == True{} : Bool}:
  match st:
    case Nil{}:
      {==}
    case Con{f, +rest}:
      match f:
        case B.Fr{+top, +ind, +abs, +with, +ext, +name, +parents, +kids, +no}:
          and_intro(B.defs.ok(Con{n, kids}), frok(rest), cons_ok(n, kids, hn, and_l(B.defs.ok(kids), frok(rest), hs)), and_r(B.defs.ok(kids), frok(rest), hs))

def with_ok(with: Bool, kids: List<&2, B.Node>, +name: List<&2, U32>, +no: B.Loc, +st: List<&2, B.Fr>, +hs: {frok(st) == True{} : Bool}) ->
    {frok(B.close.with(with, kids, name, no, st)) == True{} : Bool}:
  match with:
    case True{}:
      hs
    case False{}:
      match kids:
        case Nil{}:
          hs
        case Con{k, t}:
          into_ok(st, B.NErr{List.append(&2, U32, B.codes("object "), List.append(&2, U32, name, B.codes(" has members, so its header ends with `with`"))), no}, {==}, hs)

# close.go's decision mirrored
def cgo(+c: Bool, +k: Nat, +top: Bool, +ind: U32, +abs: Bool, +with: Bool, +ext: Bool, +name: List<&2, U32>, +parents: List<&2, List<&2, U32>>,
    +kids: List<&2, B.Node>, +no: B.Loc, +rest: List<&2, B.Fr>, +i: U32) -> List<&2, B.Fr>:
  B.when(List<&2, B.Fr>, c, u => B.close.go(k, B.close.into(B.close.with(with, kids, name, no, rest), B.NObj{abs, ext, name, parents, List.reverse(&2, B.Node, kids), no}), i),
    u => Con{B.Fr{top, ind, abs, with, ext, name, parents, kids, no}, rest})

def cgo_ok(c: Bool, +k: Nat, +top: Bool, +ind: U32, +abs: Bool, +with: Bool, +ext: Bool, +name: List<&2, U32>, +parents: List<&2, List<&2, U32>>,
    +kids: List<&2, B.Node>, +no: B.Loc, +rest: List<&2, B.Fr>, +i: U32,
    ih: {frok(B.close.go(k, B.close.into(B.close.with(with, kids, name, no, rest), B.NObj{abs, ext, name, parents, List.reverse(&2, B.Node, kids), no}), i)) == True{} : Bool},
    hs: {frok(Con{B.Fr{top, ind, abs, with, ext, name, parents, kids, no}, rest}) == True{} : Bool}) ->
    {frok(cgo(c, k, top, ind, abs, with, ext, name, parents, kids, no, rest, i)) == True{} : Bool}:
  match c:
    case True{}:
      ih
    case False{}:
      hs

# objects closed: each a node, its members numbered so, of the one below
def close_ok(n: Nat, st: List<&2, B.Fr>, +i: U32, +hs: {frok(st) == True{} : Bool}) -> {frok(B.close.go(n, st, i)) == True{} : Bool}:
  match n:
    case 0n:
      hs
    case 1n+(+k):
      match st:
        case Nil{}:
          {==}
        case Con{f, +rest}:
          match f:
            case B.Fr{+top, +ind, +abs, +with, +ext, +name, +parents, +kids, +no}:
              cgo_ok(Bool.and(Bool.not(top), U32.is_ge(ind, i)), k, top, ind, abs, with, ext, name, parents, kids, no, rest, i,
                close_ok(k, B.close.into(B.close.with(with, kids, name, no, rest), B.NObj{abs, ext, name, parents, List.reverse(&2, B.Node, kids), no}), i,
                  into_ok(B.close.with(with, kids, name, no, rest), B.NObj{abs, ext, name, parents, List.reverse(&2, B.Node, kids), no},
                    and_intro(B.defs.ok(List.reverse(&2, B.Node, kids)), True{}, dok_rev(kids, Nil{}, and_l(B.defs.ok(kids), frok(rest), hs), {==}), {==}),
                    with_ok(with, kids, name, no, rest, and_r(B.defs.ok(kids), frok(rest), hs)))),
                hs)

def close_all(+st: List<&2, B.Fr>, +i: U32, +hs: {frok(st) == True{} : Bool}) -> {frok(B.close(st, i)) == True{} : Bool}:
  close_ok(List.length(&2, B.Fr, st), st, i, hs)

def ndb_ok(+body: List<&2, B.Ln>, +no: B.Loc, +hi: {B.body.from(body, no) == True{} : Bool}) -> {Bool.or(B.bl.from(B.toks.lines(body), no), B.bl.from(B.toks.lines(body), B.loc.next(no))) == True{} : Bool}:
  %Equal.sym(Bool, B.bl.from(B.toks.lines(body), no), B.ln.from(body, no), ln_bl(body, no)) :
    {Bool.or(_, B.bl.from(B.toks.lines(body), B.loc.next(no))) == True{} : Bool}
  %Equal.sym(Bool, B.bl.from(B.toks.lines(body), B.loc.next(no)), B.ln.from(body, B.loc.next(no)), ln_bl(body, B.loc.next(no))) :
    {Bool.or(B.ln.from(body, no), _) == True{} : Bool}
  hi

# an item put: its node numbered so
def put_ok(st: List<&2, B.Fr>, it: B.Item, +hi: {B.item.ok(it) == True{} : Bool}, +hs: {frok(st) == True{} : Bool}) -> {frok(B.tree.put(st, it)) == True{} : Bool}:
  match it:
    case B.IObj{+abs, +with, +ext, +name, +parents, +no, +ind}:
      hs
    case B.IDef{+share, +upd, +name, +rest, +params, +body, +no, +ind, +what}:
      into_ok(st, B.NDef{share, upd, name, rest, params, B.toks.lines(body), no, ind, what}, and_intro(Bool.or(B.bl.from(B.toks.lines(body), no), B.bl.from(B.toks.lines(body), B.loc.next(no))), True{}, ndb_ok(body, no, hi), {==}), hs)
    case B.IImport{+txt, +no, +ind}:
      into_ok(st, B.NImport{txt, no}, {==}, hs)
    case B.IDecl{+names, +no, +ind}:
      into_ok(st, B.NDecl{names, no}, {==}, hs)
    case B.IBad{+txt, +no, +ind}:
      into_ok(st, B.NBad{txt, no}, {==}, hs)
    case B.IBend{+lines, +no, +ind}:
      into_ok(st, B.NBend{lines, no}, {==}, hs)

# the items put in turn, each after the objects its column closes
def tree_go_ok(its: List<&2, B.Item>, +st: List<&2, B.Fr>, +hi: {B.items.ok(its) == True{} : Bool}, +hs: {frok(st) == True{} : Bool}) ->
    {frok(B.tree.go(its, st)) == True{} : Bool}:
  match its:
    case Nil{}:
      close_all(st, 0, hs)
    case Con{it, +t}:
      match it:
        case B.IImport{+txt, +no, +ind}:
          tree_go_ok(t, B.tree.put(B.close(st, ind), B.IImport{txt, no, ind}), and_r(B.item.ok(B.IImport{txt, no, ind}), B.items.ok(t), hi),
            put_ok(B.close(st, ind), B.IImport{txt, no, ind}, and_l(B.item.ok(B.IImport{txt, no, ind}), B.items.ok(t), hi), close_all(st, ind, hs)))
        case B.IObj{+abs, +with, +ext, +name, +parents, +no, +ind}:
          tree_go_ok(t, B.tree.put(B.close(st, ind), B.IObj{abs, with, ext, name, parents, no, ind}), and_r(B.item.ok(B.IObj{abs, with, ext, name, parents, no, ind}), B.items.ok(t), hi),
            put_ok(B.close(st, ind), B.IObj{abs, with, ext, name, parents, no, ind}, and_l(B.item.ok(B.IObj{abs, with, ext, name, parents, no, ind}), B.items.ok(t), hi), close_all(st, ind, hs)))
        case B.IDecl{+names, +no, +ind}:
          tree_go_ok(t, B.tree.put(B.close(st, ind), B.IDecl{names, no, ind}), and_r(B.item.ok(B.IDecl{names, no, ind}), B.items.ok(t), hi),
            put_ok(B.close(st, ind), B.IDecl{names, no, ind}, and_l(B.item.ok(B.IDecl{names, no, ind}), B.items.ok(t), hi), close_all(st, ind, hs)))
        case B.IDef{+share, +upd, +name, +rest, +params, +body, +no, +ind, +what}:
          tree_go_ok(t, B.tree.put(B.close(st, ind), B.IDef{share, upd, name, rest, params, body, no, ind, what}), and_r(B.item.ok(B.IDef{share, upd, name, rest, params, body, no, ind, what}), B.items.ok(t), hi),
            put_ok(B.close(st, ind), B.IDef{share, upd, name, rest, params, body, no, ind, what}, and_l(B.item.ok(B.IDef{share, upd, name, rest, params, body, no, ind, what}), B.items.ok(t), hi), close_all(st, ind, hs)))
        case B.IBad{+txt, +no, +ind}:
          tree_go_ok(t, B.tree.put(B.close(st, ind), B.IBad{txt, no, ind}), and_r(B.item.ok(B.IBad{txt, no, ind}), B.items.ok(t), hi),
            put_ok(B.close(st, ind), B.IBad{txt, no, ind}, and_l(B.item.ok(B.IBad{txt, no, ind}), B.items.ok(t), hi), close_all(st, ind, hs)))
        case B.IBend{+lines, +no, +ind}:
          tree_go_ok(t, B.tree.put(B.close(st, ind), B.IBend{lines, no, ind}), and_r(B.item.ok(B.IBend{lines, no, ind}), B.items.ok(t), hi),
            put_ok(B.close(st, ind), B.IBend{lines, no, ind}, and_l(B.item.ok(B.IBend{lines, no, ind}), B.items.ok(t), hi), close_all(st, ind, hs)))

def fin_ok(st: List<&2, B.Fr>, +hs: {frok(st) == True{} : Bool}) -> {B.defs.ok(B.tree.fin(st)) == True{} : Bool}:
  match st:
    case Nil{}:
      {==}
    case Con{f, +rest}:
      match f:
        case B.Fr{+top, +ind, +abs, +with, +ext, +name, +parents, +kids, +no}:
          dok_rev(kids, Nil{}, and_l(B.defs.ok(kids), frok(rest), hs), {==})

def Laws.markers.tree(its, h):
  fin_ok(B.tree.go(its, [B.Fr{True{}, 0, False{}, True{}, False{}, Nil{}, Nil{}, Nil{}, B.loc.top(0)}]), tree_go_ok(its, [B.Fr{True{}, 0, False{}, True{}, False{}, Nil{}, Nil{}, Nil{}, B.loc.top(0)}], h, {==}))

def Laws.markers.read(bs, base):
  Laws.markers.tree(B.flat(B.lines.at(bs, base)), Laws.markers.items(B.lines.at(bs, base), B.loc.next(base), Laws.markers.lines(bs, base)))

# Definitions the same are equal (`nodes.same_eq`): each field compared
# is equal, by its comparison's own law

def teq_no(+x: B.Tok, +y: B.Tok, h: {False{} == True{} : Bool}) -> {x == y : B.Tok}:
  Empty.absurd({x == y : B.Tok}, MB.false_ne_true()(h))

def tok_eq(x: B.Tok, y: B.Tok, +hs: {B.tok.same(x, y) == True{} : Bool}) -> {x == y : B.Tok}:
  match x:
    case B.TName{+a}:
      match y:
        case B.TName{+b}:
          Equal.cong(List<&2, U32>, B.Tok, z => B.TName{z}, a, b, Laws.names.same_eq(a, b, hs))
        case B.TNum{+b}:
          teq_no(B.TName{a}, B.TNum{b}, hs)
        case B.TStr{+b}:
          teq_no(B.TName{a}, B.TStr{b}, hs)
        case B.TCom{+b}:
          teq_no(B.TName{a}, B.TCom{b}, hs)
        case B.TSp{+b}:
          teq_no(B.TName{a}, B.TSp{b}, hs)
        case B.TSym{+d}:
          teq_no(B.TName{a}, B.TSym{d}, hs)
    case B.TNum{+a}:
      match y:
        case B.TName{+b}:
          teq_no(B.TNum{a}, B.TName{b}, hs)
        case B.TNum{+b}:
          Equal.cong(List<&2, U32>, B.Tok, z => B.TNum{z}, a, b, Laws.names.same_eq(a, b, hs))
        case B.TStr{+b}:
          teq_no(B.TNum{a}, B.TStr{b}, hs)
        case B.TCom{+b}:
          teq_no(B.TNum{a}, B.TCom{b}, hs)
        case B.TSp{+b}:
          teq_no(B.TNum{a}, B.TSp{b}, hs)
        case B.TSym{+d}:
          teq_no(B.TNum{a}, B.TSym{d}, hs)
    case B.TStr{+a}:
      match y:
        case B.TName{+b}:
          teq_no(B.TStr{a}, B.TName{b}, hs)
        case B.TNum{+b}:
          teq_no(B.TStr{a}, B.TNum{b}, hs)
        case B.TStr{+b}:
          Equal.cong(List<&2, U32>, B.Tok, z => B.TStr{z}, a, b, Laws.names.same_eq(a, b, hs))
        case B.TCom{+b}:
          teq_no(B.TStr{a}, B.TCom{b}, hs)
        case B.TSp{+b}:
          teq_no(B.TStr{a}, B.TSp{b}, hs)
        case B.TSym{+d}:
          teq_no(B.TStr{a}, B.TSym{d}, hs)
    case B.TCom{+a}:
      match y:
        case B.TName{+b}:
          teq_no(B.TCom{a}, B.TName{b}, hs)
        case B.TNum{+b}:
          teq_no(B.TCom{a}, B.TNum{b}, hs)
        case B.TStr{+b}:
          teq_no(B.TCom{a}, B.TStr{b}, hs)
        case B.TCom{+b}:
          Equal.cong(List<&2, U32>, B.Tok, z => B.TCom{z}, a, b, Laws.names.same_eq(a, b, hs))
        case B.TSp{+b}:
          teq_no(B.TCom{a}, B.TSp{b}, hs)
        case B.TSym{+d}:
          teq_no(B.TCom{a}, B.TSym{d}, hs)
    case B.TSp{+a}:
      match y:
        case B.TName{+b}:
          teq_no(B.TSp{a}, B.TName{b}, hs)
        case B.TNum{+b}:
          teq_no(B.TSp{a}, B.TNum{b}, hs)
        case B.TStr{+b}:
          teq_no(B.TSp{a}, B.TStr{b}, hs)
        case B.TCom{+b}:
          teq_no(B.TSp{a}, B.TCom{b}, hs)
        case B.TSp{+b}:
          Equal.cong(List<&2, U32>, B.Tok, z => B.TSp{z}, a, b, Laws.names.same_eq(a, b, hs))
        case B.TSym{+d}:
          teq_no(B.TSp{a}, B.TSym{d}, hs)
    case B.TSym{+c}:
      match y:
        case B.TName{+b}:
          teq_no(B.TSym{c}, B.TName{b}, hs)
        case B.TNum{+b}:
          teq_no(B.TSym{c}, B.TNum{b}, hs)
        case B.TStr{+b}:
          teq_no(B.TSym{c}, B.TStr{b}, hs)
        case B.TCom{+b}:
          teq_no(B.TSym{c}, B.TCom{b}, hs)
        case B.TSp{+b}:
          teq_no(B.TSym{c}, B.TSp{b}, hs)
        case B.TSym{+d}:
          Equal.cong(U32, B.Tok, z => B.TSym{z}, c, d, u32_eq_of_is_eq(c, d, hs))

def toks_eq(xs: List<&2, B.Tok>, ys: List<&2, B.Tok>, +hs: {B.toks.same(xs, ys) == True{} : Bool}) -> {xs == ys : List<&2, B.Tok>}:
  match xs:
    case Nil{}:
      match ys:
        case Nil{}:
          {==}
        case Con{+y, +yt}:
          Empty.absurd({Nil{} == Con{y, yt} : List<&2, B.Tok>}, MB.false_ne_true()(hs))
    case Con{+x, +xt}:
      match ys:
        case Nil{}:
          Empty.absurd({Con{x, xt} == Nil{} : List<&2, B.Tok>}, MB.false_ne_true()(hs))
        case Con{+y, +yt}:
          %tok_eq(x, y, and_l(B.tok.same(x, y), B.toks.same(xt, yt), hs)) : {Con{x, xt} == Con{_, yt} : List<&2, B.Tok>}
          %toks_eq(xt, yt, and_r(B.tok.same(x, y), B.toks.same(xt, yt), hs)) : {Con{x, xt} == Con{x, _} : List<&2, B.Tok>}
          {==}

def bl_eq(a: B.Bl, b: B.Bl, +hs: {B.bl.same(a, b) == True{} : Bool}) -> {a == b : B.Bl}:
  match a:
    case B.Bl{+n1, +i1, +t1}:
      match b:
        case B.Bl{+n2, +i2, +t2}:
          %loc_eq_eq(n1, n2, and_l(B.loc.eq(n1, n2), U32.is_eq(i1, i2), and_l(Bool.and(B.loc.eq(n1, n2), U32.is_eq(i1, i2)), B.toks.same(t1, t2), hs))) :
            {B.Bl{n1, i1, t1} == B.Bl{_, i2, t2} : B.Bl}
          %u32_eq_of_is_eq(i1, i2, and_r(B.loc.eq(n1, n2), U32.is_eq(i1, i2), and_l(Bool.and(B.loc.eq(n1, n2), U32.is_eq(i1, i2)), B.toks.same(t1, t2), hs))) :
            {B.Bl{n1, i1, t1} == B.Bl{n1, _, t2} : B.Bl}
          %toks_eq(t1, t2, and_r(Bool.and(B.loc.eq(n1, n2), U32.is_eq(i1, i2)), B.toks.same(t1, t2), hs)) : {B.Bl{n1, i1, t1} == B.Bl{n1, i1, _} : B.Bl}
          {==}

def bls_eq(xs: List<&2, B.Bl>, ys: List<&2, B.Bl>, +hs: {B.bls.same(xs, ys) == True{} : Bool}) -> {xs == ys : List<&2, B.Bl>}:
  match xs:
    case Nil{}:
      match ys:
        case Nil{}:
          {==}
        case Con{+y, +yt}:
          Empty.absurd({Nil{} == Con{y, yt} : List<&2, B.Bl>}, MB.false_ne_true()(hs))
    case Con{+x, +xt}:
      match ys:
        case Nil{}:
          Empty.absurd({Con{x, xt} == Nil{} : List<&2, B.Bl>}, MB.false_ne_true()(hs))
        case Con{+y, +yt}:
          %bl_eq(x, y, and_l(B.bl.same(x, y), B.bls.same(xt, yt), hs)) : {Con{x, xt} == Con{_, yt} : List<&2, B.Bl>}
          %bls_eq(xt, yt, and_r(B.bl.same(x, y), B.bls.same(xt, yt), hs)) : {Con{x, xt} == Con{x, _} : List<&2, B.Bl>}
          {==}

def names_eq(xs: List<&2, List<&2, U32>>, ys: List<&2, List<&2, U32>>, +hs: {B.names.eq(xs, ys) == True{} : Bool}) -> {xs == ys : List<&2, List<&2, U32>>}:
  match xs:
    case Nil{}:
      match ys:
        case Nil{}:
          {==}
        case Con{+y, +yt}:
          Empty.absurd({Nil{} == Con{y, yt} : List<&2, List<&2, U32>>}, MB.false_ne_true()(hs))
    case Con{+x, +xt}:
      match ys:
        case Nil{}:
          Empty.absurd({Con{x, xt} == Nil{} : List<&2, List<&2, U32>>}, MB.false_ne_true()(hs))
        case Con{+y, +yt}:
          %Laws.names.same_eq(x, y, and_l(B.same(x, y), B.names.eq(xt, yt), hs)) : {Con{x, xt} == Con{_, yt} : List<&2, List<&2, U32>>}
          %names_eq(xt, yt, and_r(B.same(x, y), B.names.eq(xt, yt), hs)) : {Con{x, xt} == Con{x, _} : List<&2, List<&2, U32>>}
          {==}

def xor_eq(u1: Bool, u2: Bool, +hs: {Bool.not(Bool.xor(u1, u2)) == True{} : Bool}) -> {u1 == u2 : Bool}:
  match u1:
    case True{}:
      match u2:
        case True{}:
          {==}
        case False{}:
          Empty.absurd({True{} == False{} : Bool}, MB.false_ne_true()(hs))
    case False{}:
      match u2:
        case True{}:
          Empty.absurd({False{} == True{} : Bool}, MB.false_ne_true()(hs))
        case False{}:
          {==}

def ndef_eq(+s1: U32, +u1: Bool, +n1: List<&2, U32>, +r1: List<&2, U32>, +p1: List<&2, List<&2, U32>>, +b1: List<&2, B.Bl>, +o1: B.Loc, +i1: U32, +w1: U32,
    +s2: U32, +u2: Bool, +n2: List<&2, U32>, +r2: List<&2, U32>, +p2: List<&2, List<&2, U32>>, +b2: List<&2, B.Bl>, +o2: B.Loc, +i2: U32, +w2: U32,
    +hs: {B.ndef.same(B.NDef{s1, u1, n1, r1, p1, b1, o1, i1, w1}, B.NDef{s2, u2, n2, r2, p2, b2, o2, i2, w2}) == True{} : Bool}) ->
    {B.NDef{s1, u1, n1, r1, p1, b1, o1, i1, w1} == B.NDef{s2, u2, n2, r2, p2, b2, o2, i2, w2} : B.Node}:
  +x1 = Bool.and(U32.is_eq(s1, s2), Bool.not(Bool.xor(u1, u2)))
  +x2 = Bool.and(x1, B.same(n1, n2))
  +x3 = Bool.and(x2, B.same(r1, r2))
  +x4 = Bool.and(x3, B.names.eq(p1, p2))
  +x5 = Bool.and(x4, B.bls.same(b1, b2))
  +x6 = Bool.and(x5, B.loc.eq(o1, o2))
  +x7 = Bool.and(x6, U32.is_eq(i1, i2))
  +h7 = and_l(x7, U32.is_eq(w1, w2), hs)
  +h6 = and_l(x6, U32.is_eq(i1, i2), h7)
  +h5 = and_l(x5, B.loc.eq(o1, o2), h6)
  +h4 = and_l(x4, B.bls.same(b1, b2), h5)
  +h3 = and_l(x3, B.names.eq(p1, p2), h4)
  +h2 = and_l(x2, B.same(r1, r2), h3)
  +h1 = and_l(x1, B.same(n1, n2), h2)
  %u32_eq_of_is_eq(s1, s2, and_l(U32.is_eq(s1, s2), Bool.not(Bool.xor(u1, u2)), h1)) : {B.NDef{s1, u1, n1, r1, p1, b1, o1, i1, w1} == B.NDef{_, u2, n2, r2, p2, b2, o2, i2, w2} : B.Node}
  %xor_eq(u1, u2, and_r(U32.is_eq(s1, s2), Bool.not(Bool.xor(u1, u2)), h1)) : {B.NDef{s1, u1, n1, r1, p1, b1, o1, i1, w1} == B.NDef{s1, _, n2, r2, p2, b2, o2, i2, w2} : B.Node}
  %Laws.names.same_eq(n1, n2, and_r(x1, B.same(n1, n2), h2)) : {B.NDef{s1, u1, n1, r1, p1, b1, o1, i1, w1} == B.NDef{s1, u1, _, r2, p2, b2, o2, i2, w2} : B.Node}
  %Laws.names.same_eq(r1, r2, and_r(x2, B.same(r1, r2), h3)) : {B.NDef{s1, u1, n1, r1, p1, b1, o1, i1, w1} == B.NDef{s1, u1, n1, _, p2, b2, o2, i2, w2} : B.Node}
  %names_eq(p1, p2, and_r(x3, B.names.eq(p1, p2), h4)) : {B.NDef{s1, u1, n1, r1, p1, b1, o1, i1, w1} == B.NDef{s1, u1, n1, r1, _, b2, o2, i2, w2} : B.Node}
  %bls_eq(b1, b2, and_r(x4, B.bls.same(b1, b2), h5)) : {B.NDef{s1, u1, n1, r1, p1, b1, o1, i1, w1} == B.NDef{s1, u1, n1, r1, p1, _, o2, i2, w2} : B.Node}
  %loc_eq_eq(o1, o2, and_r(x5, B.loc.eq(o1, o2), h6)) : {B.NDef{s1, u1, n1, r1, p1, b1, o1, i1, w1} == B.NDef{s1, u1, n1, r1, p1, b1, _, i2, w2} : B.Node}
  %u32_eq_of_is_eq(i1, i2, and_r(x6, U32.is_eq(i1, i2), h7)) : {B.NDef{s1, u1, n1, r1, p1, b1, o1, i1, w1} == B.NDef{s1, u1, n1, r1, p1, b1, o1, _, w2} : B.Node}
  %u32_eq_of_is_eq(w1, w2, and_r(x7, U32.is_eq(w1, w2), hs)) : {B.NDef{s1, u1, n1, r1, p1, b1, o1, i1, w1} == B.NDef{s1, u1, n1, r1, p1, b1, o1, i1, _} : B.Node}
  {==}

def neq_no(+a: B.Node, +b: B.Node, h: {False{} == True{} : Bool}) -> {a == b : B.Node}:
  Empty.absurd({a == b : B.Node}, MB.false_ne_true()(h))

def Laws.nodes.same_eq(a, b, h):
  match a:
    case B.NDef{+s1, +u1, +n1, +r1, +p1, +b1, +o1, +i1, +w1}:
      match b:
        case B.NDef{+s2, +u2, +n2, +r2, +p2, +b2, +o2, +i2, +w2}:
          ndef_eq(s1, u1, n1, r1, p1, b1, o1, i1, w1, s2, u2, n2, r2, p2, b2, o2, i2, w2, h)
        case B.NObj{+abs, +ext, +name, +parents, +kids, +no}:
          neq_no(B.NDef{s1, u1, n1, r1, p1, b1, o1, i1, w1}, B.NObj{abs, ext, name, parents, kids, no}, h)
        case B.NImport{+txt, +no}:
          neq_no(B.NDef{s1, u1, n1, r1, p1, b1, o1, i1, w1}, B.NImport{txt, no}, h)
        case B.NDecl{+names, +no}:
          neq_no(B.NDef{s1, u1, n1, r1, p1, b1, o1, i1, w1}, B.NDecl{names, no}, h)
        case B.NBad{+txt, +no}:
          neq_no(B.NDef{s1, u1, n1, r1, p1, b1, o1, i1, w1}, B.NBad{txt, no}, h)
        case B.NErr{+msg, +no}:
          neq_no(B.NDef{s1, u1, n1, r1, p1, b1, o1, i1, w1}, B.NErr{msg, no}, h)
        case B.NBend{+lines, +no}:
          neq_no(B.NDef{s1, u1, n1, r1, p1, b1, o1, i1, w1}, B.NBend{lines, no}, h)
    case B.NObj{+abs, +ext, +name, +parents, +kids, +no}:
      neq_no(B.NObj{abs, ext, name, parents, kids, no}, b, h)
    case B.NImport{+txt, +no}:
      neq_no(B.NImport{txt, no}, b, h)
    case B.NDecl{+names, +no}:
      neq_no(B.NDecl{names, no}, b, h)
    case B.NBad{+txt, +no}:
      neq_no(B.NBad{txt, no}, b, h)
    case B.NErr{+msg, +no}:
      neq_no(B.NErr{msg, no}, b, h)
    case B.NBend{+lines, +no}:
      neq_no(B.NBend{lines, no}, b, h)

# The units' lines (`markers.units`): a unit's lines its definition's
# body's, number for number (`nos`), resolution making a line for a line
# (`rbl_nos`), whatever definition a copy holds; the trees' definitions
# numbered on from their lines (`dsok`), and a definition the same field
# by field numbered so too (`in_ok`), so that through `nodes` every
# unit's lines are.

# lines and a body's lines, number for number
def rlno(l: B.Rl) -> B.Loc:
  match l:
    case B.Rl{+no, +ind, ts}:
      no

def blno(b: B.Bl) -> B.Loc:
  match b:
    case B.Bl{+no, +ind, ts}:
      no

# a line and a body's line alike: the same depth, and a blank one blank
# (`deep.units`)
def lk(l: B.Rl, b: B.Bl) -> Bool:
  match l b:
    case B.Rl{+n1, +i1, ts} B.Bl{+n2, +i2, tks}:
      Bool.and(U32.is_eq(i1, i2), Bool.or(Bool.not(B.toks.blank(tks)), B.rts.blank(ts)))

def nos(ls: List<&2, B.Rl>, bs: List<&2, B.Bl>) -> Bool:
  match ls bs:
    case Nil{} Nil{}:
      True{}
    case Con{+l, lt} Con{+b, bt}:
      Bool.and(Bool.and(B.loc.eq(rlno(l), blno(b)), lk(l, b)), nos(lt, bt))
    case _ _:
      False{}

def rbls(b: B.Rb) -> List<&2, B.Rl>:
  match b:
    case B.Rb{ls, es, more}:
      ls

def rbls_join(a: B.Rb, b: B.Rb) -> {List.append(&2, B.Rl, rbls(a), rbls(b)) == rbls(B.rb.join(a, b)) : List<&2, B.Rl>}:
  match a b:
    case B.Rb{l1, e1, i1} B.Rb{l2, e2, i2}:
      {==}

def rbls_line(+no: B.Loc, +ind: U32, b: B.Rb) -> {[B.Rl{no, ind, B.rl.join(rbls(b))}] == rbls(B.rb.line(no, ind, b)) : List<&2, B.Rl>}:
  match b:
    case B.Rb{ls, es, more}:
      {==}

# a line resolved: its depth, and blank where blank
def lk_ok(ts: List<&2, B.Tok>, +no: B.Loc, +ind: U32, +cx: B.Cx, +o: U32, +q: U32, +locals: List<&2, List<&2, U32>>) ->
    {lk(B.Rl{no, ind, B.rl.join(rbls(B.rb.toks(ts, cx, o, q, locals, no)))}, B.Bl{no, ind, ts}) == True{} : Bool}:
  match ts:
    case Nil{}:
      and_intro(U32.is_eq(ind, ind), True{}, u32_is_eq_refl(ind), {==})
    case Con{t, r}:
      and_intro(U32.is_eq(ind, ind), True{}, u32_is_eq_refl(ind), {==})

# a body resolved: a line for each of its lines, the same number
def rbl_nos(bs: List<&2, B.Bl>, +cx: B.Cx, +o: U32, +q: U32, +locals: List<&2, List<&2, U32>>) -> {nos(rbls(B.rb.lines(bs, cx, o, q, locals)), bs) == True{} : Bool}:
  match bs:
    case Nil{}:
      {==}
    case Con{b, +t}:
      match b:
        case B.Bl{+no, +ind, +ts}:
          %rbls_join(B.rb.line(no, ind, B.rb.toks(ts, cx, o, q, locals, no)), B.rb.lines(t, cx, o, q, locals)) :
            {nos(_, Con{B.Bl{no, ind, ts}, t}) == True{} : Bool}
          %rbls_line(no, ind, B.rb.toks(ts, cx, o, q, locals, no)) :
            {nos(List.append(&2, B.Rl, _, rbls(B.rb.lines(t, cx, o, q, locals))), Con{B.Bl{no, ind, ts}, t}) == True{} : Bool}
          and_intro(Bool.and(B.loc.eq(no, no), lk(B.Rl{no, ind, B.rl.join(rbls(B.rb.toks(ts, cx, o, q, locals, no)))}, B.Bl{no, ind, ts})), nos(rbls(B.rb.lines(t, cx, o, q, locals)), t),
            and_intro(B.loc.eq(no, no), lk(B.Rl{no, ind, B.rl.join(rbls(B.rb.toks(ts, cx, o, q, locals, no)))}, B.Bl{no, ind, ts}), loc_eq_refl(no), lk_ok(ts, no, ind, cx, o, q, locals)),
            rbl_nos(t, cx, o, q, locals))

# a copy's lines its definition's body's, number for number
def rdm(r: B.Rd) -> Bool:
  match r:
    case B.Rd{i, nd, hd, ls}:
      match nd:
        case B.NDef{+share, +upd, name, rest, params, body, +no, +ind, +what}:
          nos(ls, body)
        case _:
          True{}

def ck_m(i: B.In, +share: U32, +upd: Bool, +name: List<&2, U32>, +rest: List<&2, U32>, +params: List<&2, List<&2, U32>>, +body: List<&2, B.Bl>, +no: B.Loc, +ind: U32, +what: U32,
    h: B.Rb, b: B.Rb, sh: List<&2, B.Er>, hb: {nos(rbls(b), body) == True{} : Bool}) ->
    {rdm(Pair.fst(B.Rd, B.Rb, B.copy.k(i, B.NDef{share, upd, name, rest, params, body, no, ind, what}, h, b, sh))) == True{} : Bool}:
  match h b:
    case B.Rb{hl, he, hi} B.Rb{ls, es, more}:
      hb

def cn_m(+cx: B.Cx, +o: U32, i: B.In, nd: B.Node) -> {rdm(Pair.fst(B.Rd, B.Rb, B.copy.node(cx, o, i, nd))) == True{} : Bool}:
  match i:
    case B.In{+n, +q, +prior}:
      match nd:
        case B.NDef{+share, +upd, +name, +rest, +params, +body, +no, +ind, +what}:
          ck_m(B.In{n, q, prior}, share, upd, name, rest, params, body, no, ind, what,
            B.rb.line(no, 0, B.rb.toks(B.toks(rest), cx, o, q, List.append(&2, List<&2, U32>, B.unmarks(params), B.lc.names(B.body.binders(body))), no)),
            B.rb.lines(body, cx, o, q, List.append(&2, List<&2, U32>, B.unmarks(params), B.lc.names(B.body.binders(body)))),
            B.when(List<&2, B.Er>, B.is.root(B.cx.obs(cx), o), u => Nil{},
              u => List.append(&2, B.Er, B.shadow.params(B.unmarks(params), cx, o, q, B.text(B.rf.text(B.cx.obs(cx), B.in.ref(o, B.In{n, q, prior}))), no),
                B.shadow.locals(B.body.binders(body), cx, o, q, B.text(B.rf.text(B.cx.obs(cx), B.in.ref(o, B.In{n, q, prior})))))),
            rbl_nos(body, cx, o, q, List.append(&2, List<&2, U32>, B.unmarks(params), B.lc.names(B.body.binders(body)))))
        case B.NImport{+txt, +no}:
          {==}
        case B.NDecl{+names, +no}:
          {==}
        case B.NBad{+txt, +no}:
          {==}
        case B.NErr{+msg, +no}:
          {==}
        case B.NBend{+lines, +no}:
          {==}
        case B.NObj{+abs, +ext, +name, +parents, +kids, +no}:
          {==}

def oc_m(mb: Maybe<&2, B.Node>, +cx: B.Cx, +o: U32, +n: List<&2, U32>, +q: U32, +prior: Bool) -> {rdm(Pair.fst(B.Rd, B.Rb, ocm(mb, cx, o, n, q, prior))) == True{} : Bool}:
  match mb:
    case None{}:
      {==}
    case Some{nd}:
      cn_m(cx, o, B.In{n, q, prior}, nd)

def rd_m(+cx: B.Cx, +o: U32, i: B.In) -> {rdm(Pair.fst(B.Rd, B.Rb, B.copy.of(cx, o, i))) == True{} : Bool}:
  match i:
    case B.In{+n, +q, +prior}:
      oc_m(B.cx.mem(cx, q, n), cx, o, n, q, prior)

def rdsm(rs: List<&2, B.Rd>) -> Bool:
  match rs:
    case Nil{}:
      True{}
    case Con{+r, t}:
      Bool.and(rdm(r), rdsm(t))

def cpm(c: B.Cp) -> Bool:
  match c:
    case B.Cp{rds, ers, done}:
      rdsm(rds)

def cpadd_m(+rd: B.Rd, b: B.Rb, c: B.Cp, +hr: {rdm(rd) == True{} : Bool}, +hc: {cpm(c) == True{} : Bool}) -> {cpm(B.cp.add(rd, b, c)) == True{} : Bool}:
  match b:
    case B.Rb{ls, es, more}:
      match c:
        case B.Cp{+rds, ers, done}:
          and_intro(rdm(rd), rdsm(rds), hr, hc)

def cg_m(c: Bool, +k: Nat, +cx: B.Cx, +o: U32, +i: B.In, +t: List<&2, B.In>, +rds: List<&2, B.Rd>, +ers: List<&2, B.Er>, +done: B.Ht<B.In>,
    ht: {cpm(B.copies.go(k, cx, o, t, B.Cp{rds, ers, done})) == True{} : Bool}, hf: {cpm(B.copies.go(k, cx, o, B.ins.then(t, B.rb.ins(Pair.snd(B.Rd, B.Rb, B.copy.of(cx, o, i)))), B.cp.add(Pair.fst(B.Rd, B.Rb, B.copy.of(cx, o, i)), Pair.snd(B.Rd, B.Rb, B.copy.of(cx, o, i)), B.Cp{rds, ers, B.done.put(done, i)}))) == True{} : Bool}) ->
    {cpm(cgk(c, k, cx, o, i, t, rds, ers, done)) == True{} : Bool}:
  match c:
    case True{}:
      ht
    case False{}:
      %Equal.sym(B.Cp, B.on.pair(B.Rd, B.Rb, B.Cp, B.copy.of(cx, o, i), rd => +b => B.copies.go(k, cx, o, B.ins.then(t, B.rb.ins(b)), B.cp.add(rd, b, B.Cp{rds, ers, B.done.put(done, i)}))), B.copies.go(k, cx, o, B.ins.then(t, B.rb.ins(Pair.snd(B.Rd, B.Rb, B.copy.of(cx, o, i)))), B.cp.add(Pair.fst(B.Rd, B.Rb, B.copy.of(cx, o, i)), Pair.snd(B.Rd, B.Rb, B.copy.of(cx, o, i)), B.Cp{rds, ers, B.done.put(done, i)})), pair_eta_rd(B.copy.of(cx, o, i), rd => +b => B.copies.go(k, cx, o, B.ins.then(t, B.rb.ins(b)), B.cp.add(rd, b, B.Cp{rds, ers, B.done.put(done, i)})))) : {cpm(_) == True{} : Bool}
      hf

# past the fuel, the copies as they were, an error at most added
def short_cpm(todo: List<&2, B.In>, +cx: B.Cx, +o: U32, c: B.Cp, hc: {cpm(c) == True{} : Bool}) -> {cpm(B.cp.short(todo, cx, o, c)) == True{} : Bool}:
  match todo:
    case Nil{}:
      hc
    case Con{i, t}:
      match c:
        case B.Cp{rds, ers, done}:
          hc

def copies_m(n: Nat, +cx: B.Cx, +o: U32, todo: List<&2, B.In>, +c: B.Cp, +hc: {cpm(c) == True{} : Bool}) -> {cpm(B.copies.go(n, cx, o, todo, c)) == True{} : Bool}:
  match n:
    case 0n:
      short_cpm(todo, cx, o, c, hc)
    case 1n+(+k):
      match todo:
        case Nil{}:
          hc
        case Con{+i, +t}:
          match c:
            case B.Cp{+rds, +ers, +done}:
              cg_m(B.done.has(done, i), k, cx, o, i, t, rds, ers, done,
                copies_m(k, cx, o, t, B.Cp{rds, ers, done}, hc),
                copies_m(k, cx, o, B.ins.then(t, B.rb.ins(Pair.snd(B.Rd, B.Rb, B.copy.of(cx, o, i)))), B.cp.add(Pair.fst(B.Rd, B.Rb, B.copy.of(cx, o, i)), Pair.snd(B.Rd, B.Rb, B.copy.of(cx, o, i)), B.Cp{rds, ers, B.done.put(done, i)}),
                  cpadd_m(Pair.fst(B.Rd, B.Rb, B.copy.of(cx, o, i)), Pair.snd(B.Rd, B.Rb, B.copy.of(cx, o, i)), B.Cp{rds, ers, B.done.put(done, i)}, rd_m(cx, o, i), hc)))

def ocsm(os: List<&2, B.Oc>) -> Bool:
  match os:
    case Nil{}:
      True{}
    case Con{oc, t}:
      match oc:
        case B.Oc{+id, c}:
          Bool.and(cpm(c), ocsm(t))

def mc_m(c1: Bool, abs: Bool, +id: U32, +t: List<&2, B.Ob>, +cx: B.Cx, +ih: {ocsm(B.module.copies(t, cx)) == True{} : Bool}) -> {ocsm(mck(c1, abs, id, t, cx)) == True{} : Bool}:
  match c1 abs:
    case True{} _:
      ih
    case False{} True{}:
      ih
    case False{} False{}:
      and_intro(cpm(B.copies(cx, id)), ocsm(B.module.copies(t, cx)),
        copies_m(B.copies.fuel(), cx, id, B.ins.finals(B.cx.map(cx, id)),
          B.Cp{Nil{}, Nil{}, B.copies.room(cx)}, {==}), ih)

def mcopies_m(os: List<&2, B.Ob>, +cx: B.Cx) -> {ocsm(B.module.copies(os, cx)) == True{} : Bool}:
  match os:
    case Nil{}:
      {==}
    case Con{o, +t}:
      match o:
        case B.Ob{+id, +host, path, +abs, parents, mems, +no, +kind, +tpl}:
          mc_m(Bool.or(Bool.not(U32.is_eq(B.loc.mod(no), 0)), Bool.not(B.is.object(kind))), abs, id, t, cx, mcopies_m(t, cx))

def nbok(nd: B.Node) -> Bool:
  match nd:
    case B.NDef{+share, +upd, name, rest, params, +body, +no, +ind, +what}:
      Bool.or(B.bl.from(body, no), B.bl.from(body, B.loc.next(no)))
    case _:
      True{}

def dsok(ds: List<&2, B.Node>) -> Bool:
  match ds:
    case Nil{}:
      True{}
    case Con{+d, t}:
      Bool.and(nbok(d), dsok(t))

def dsok_app(a: List<&2, B.Node>, +b: List<&2, B.Node>, +ha: {dsok(a) == True{} : Bool}, +hb: {dsok(b) == True{} : Bool}) -> {dsok(List.append(&2, B.Node, a, b)) == True{} : Bool}:
  match a:
    case Nil{}:
      hb
    case Con{+d, +t}:
      and_intro(nbok(d), dsok(List.append(&2, B.Node, t, b)), and_l(nbok(d), dsok(t), ha), dsok_app(t, b, and_r(nbok(d), dsok(t), ha), hb))

# a tree whose definitions are numbered so: its definitions' list
def dsok_tree(ns: List<&2, B.Node>, +h: {B.defs.ok(ns) == True{} : Bool}) -> {dsok(B.tree.defs(ns)) == True{} : Bool}:
  match ns:
    case Nil{}:
      {==}
    case Con{nd, +t}:
      match nd:
        case B.NObj{+abs, +ext, +name, +parents, +kids, +no}:
          dsok_app(B.tree.defs(kids), B.tree.defs(t), dsok_tree(kids, and_l(B.defs.ok(kids), B.defs.ok(t), h)), dsok_tree(t, and_r(B.defs.ok(kids), B.defs.ok(t), h)))
        case B.NDef{+share, +upd, +name, +rest, +params, +body, +no, +ind, +what}:
          and_intro(Bool.or(B.bl.from(body, no), B.bl.from(body, B.loc.next(no))), dsok(B.tree.defs(t)),
            and_l(Bool.or(B.bl.from(body, no), B.bl.from(body, B.loc.next(no))), B.defs.ok(t), h),
            dsok_tree(t, and_r(Bool.or(B.bl.from(body, no), B.bl.from(body, B.loc.next(no))), B.defs.ok(t), h)))
        case B.NImport{+txt, +no}:
          dsok_tree(t, h)
        case B.NDecl{+names, +no}:
          dsok_tree(t, h)
        case B.NBad{+txt, +no}:
          dsok_tree(t, h)
        case B.NErr{+msg, +no}:
          dsok_tree(t, h)
        case B.NBend{+lines, +no}:
          dsok_tree(t, h)

def dsok_trees(ts: List<&2, List<&2, B.Node>>, +h: {B.trees.ok(ts) == True{} : Bool}) -> {dsok(B.trees.defs(ts)) == True{} : Bool}:
  match ts:
    case Nil{}:
      {==}
    case Con{+tr, +t}:
      dsok_app(B.tree.defs(tr), B.trees.defs(t), dsok_tree(tr, and_l(B.defs.ok(tr), B.trees.ok(t), h)), dsok_trees(t, and_r(B.defs.ok(tr), B.trees.ok(t), h)))

# a definition the same as one numbered so: numbered so, being it
# (`nodes.same_eq`)
def same_ok(d: B.Node, nd: B.Node, +hs: {B.ndef.same(d, nd) == True{} : Bool}, +hd: {nbok(d) == True{} : Bool}) -> {nbok(nd) == True{} : Bool}:
  %Laws.nodes.same_eq(d, nd, hs) : {nbok(_) == True{} : Bool}
  hd

# a definition held by definitions numbered so: numbered so
def in_ok(ds: List<&2, B.Node>, +nd: B.Node, +hin: {B.def.in(ds, nd) == True{} : Bool}, +hd: {dsok(ds) == True{} : Bool}) -> {nbok(nd) == True{} : Bool}:
  match ds:
    case Nil{}:
      Empty.absurd({nbok(nd) == True{} : Bool}, MB.false_ne_true()(hin))
    case Con{+d, +t}:
      or_cases(B.ndef.same(d, nd), B.def.in(t, nd), nbok(nd), hin, p => same_ok(d, nd, p, and_l(nbok(d), dsok(t), hd)), q => in_ok(t, nd, q, and_r(nbok(d), dsok(t), hd)))

# a unit's lines its definition's body's, number for number
def um1(u: B.Un) -> Bool:
  match u:
    case B.Un{+o, i, nd, hd, ls}:
      match nd:
        case B.NDef{+share, +upd, name, rest, params, body, +no, +ind, +what}:
          nos(ls, body)
        case _:
          True{}

def um(us: List<&2, B.Un>) -> Bool:
  match us:
    case Nil{}:
      True{}
    case Con{+u, t}:
      Bool.and(um1(u), um(t))

def rdsm_rev(xs: List<&2, B.Rd>, +acc: List<&2, B.Rd>, +hx: {rdsm(xs) == True{} : Bool}, +ha: {rdsm(acc) == True{} : Bool}) -> {rdsm(List.reverse.go(&2, B.Rd, xs, acc)) == True{} : Bool}:
  match xs:
    case Nil{}:
      ha
    case Con{+r, +t}:
      rdsm_rev(t, Con{r, acc}, and_r(rdm(r), rdsm(t), hx), and_intro(rdm(r), rdsm(acc), and_l(rdm(r), rdsm(t), hx), ha))

def urds_m(+o: U32, rs: List<&2, B.Rd>, +h: {rdsm(rs) == True{} : Bool}) -> {um(B.un.rds(o, rs)) == True{} : Bool}:
  match rs:
    case Nil{}:
      {==}
    case Con{r, +t}:
      match r:
        case B.Rd{+i, nd, +hd, +ls}:
          match nd:
            case B.NDef{+share, +upd, +name, +rest, +params, +body, +no, +ind, +what}:
              and_intro(nos(ls, body), um(B.un.rds(o, t)), and_l(nos(ls, body), rdsm(t), h), urds_m(o, t, and_r(nos(ls, body), rdsm(t), h)))
            case B.NImport{+txt, +no}:
              urds_m(o, t, h)
            case B.NDecl{+names, +no}:
              urds_m(o, t, h)
            case B.NBad{+txt, +no}:
              urds_m(o, t, h)
            case B.NErr{+msg, +no}:
              urds_m(o, t, h)
            case B.NBend{+lines, +no}:
              urds_m(o, t, h)
            case B.NObj{+abs, +ext, +name, +parents, +kids, +no}:
              urds_m(o, t, h)

def um_app(a: List<&2, B.Un>, +b: List<&2, B.Un>, +ha: {um(a) == True{} : Bool}, +hb: {um(b) == True{} : Bool}) -> {um(List.append(&2, B.Un, a, b)) == True{} : Bool}:
  match a:
    case Nil{}:
      hb
    case Con{+u, +t}:
      and_intro(um1(u), um(List.append(&2, B.Un, t, b)), and_l(um1(u), um(t), ha), um_app(t, b, and_r(um1(u), um(t), ha), hb))

def units_m(os: List<&2, B.Oc>, +h: {ocsm(os) == True{} : Bool}) -> {um(B.units(os)) == True{} : Bool}:
  match os:
    case Nil{}:
      {==}
    case Con{oc, +t}:
      match oc:
        case B.Oc{+id, c}:
          match c:
            case B.Cp{+rds, ers, done}:
              um_app(B.un.rds(id, List.reverse(&2, B.Rd, rds)), B.units(t),
                urds_m(id, List.reverse(&2, B.Rd, rds), rdsm_rev(rds, Nil{}, and_l(rdsm(rds), ocsm(t), h), {==})), units_m(t, and_r(rdsm(rds), ocsm(t), h)))

# lines number for number with a body numbered from k: numbered from k
def nos_from(ls: List<&2, B.Rl>, bs: List<&2, B.Bl>, +k: B.Loc, +hn: {nos(ls, bs) == True{} : Bool}, +hb: {B.bl.from(bs, k) == True{} : Bool}) -> {B.rl.from(ls, k) == True{} : Bool}:
  match ls:
    case Nil{}:
      {==}
    case Con{l, +lt}:
      match l:
        case B.Rl{+n1, +i1, +t1}:
          match bs:
            case Nil{}:
              Empty.absurd({B.rl.from(Con{B.Rl{n1, i1, t1}, lt}, k) == True{} : Bool}, MB.false_ne_true()(hn))
            case Con{b, +bt}:
              match b:
                case B.Bl{+n2, +i2, +t2}:
                  %Equal.sym(B.Loc, n1, n2, loc_eq_eq(n1, n2, and_l(B.loc.eq(n1, n2), lk(B.Rl{n1, i1, t1}, B.Bl{n2, i2, t2}),
                      and_l(Bool.and(B.loc.eq(n1, n2), lk(B.Rl{n1, i1, t1}, B.Bl{n2, i2, t2})), nos(lt, bt), hn)))) :
                    {Bool.and(B.loc.eq(_, k), B.rl.from(lt, B.loc.next(k))) == True{} : Bool}
                  and_intro(B.loc.eq(n2, k), B.rl.from(lt, B.loc.next(k)), and_l(B.loc.eq(n2, k), B.bl.from(bt, B.loc.next(k)), hb),
                    nos_from(lt, bt, B.loc.next(k), and_r(Bool.and(B.loc.eq(n1, n2), lk(B.Rl{n1, i1, t1}, B.Bl{n2, i2, t2})), nos(lt, bt), hn), and_r(B.loc.eq(n2, k), B.bl.from(bt, B.loc.next(k)), hb)))

# a unit whose definition is held by definitions numbered so, its lines
# its definition's body's: numbered so
def unit_ok(u: B.Un, +ds: List<&2, B.Node>, +hh: {B.node.held(B.un.node(u), ds) == True{} : Bool}, +hd: {dsok(ds) == True{} : Bool}, +hm: {um1(u) == True{} : Bool}) ->
    {B.un.ok(u) == True{} : Bool}:
  match u:
    case B.Un{+o, +i, nd, +hd2, +ls}:
      match nd:
        case B.NDef{+share, +upd, +name, +rest, +params, +body, +no, +ind, +what}:
          or_map(B.bl.from(body, no), B.bl.from(body, B.loc.next(no)), B.rl.from(ls, no), B.rl.from(ls, B.loc.next(no)), in_ok(ds, B.NDef{share, upd, name, rest, params, body, no, ind, what}, hh, hd),
            p => nos_from(ls, body, no, hm, p), q => nos_from(ls, body, B.loc.next(no), hm, q))
        case B.NImport{+txt, +no}:
          {==}
        case B.NDecl{+names, +no}:
          {==}
        case B.NBad{+txt, +no}:
          {==}
        case B.NErr{+msg, +no}:
          {==}
        case B.NBend{+lines, +no}:
          {==}
        case B.NObj{+abs, +ext, +name, +parents, +kids, +no}:
          {==}

def units_ok(us: List<&2, B.Un>, +ds: List<&2, B.Node>, +hh: {B.units.held(us, ds) == True{} : Bool}, +hd: {dsok(ds) == True{} : Bool}, +hm: {um(us) == True{} : Bool}) ->
    {B.units.ok(us) == True{} : Bool}:
  match us:
    case Nil{}:
      {==}
    case Con{+u, +t}:
      and_intro(B.un.ok(u), B.units.ok(t),
        unit_ok(u, ds, and_l(B.node.held(B.un.node(u), ds), B.units.held(t, ds), hh), hd, and_l(um1(u), um(t), hm)),
        units_ok(t, ds, and_r(B.node.held(B.un.node(u), ds), B.units.held(t, ds), hh), hd, and_r(um1(u), um(t), hm)))

def Laws.markers.units(trees, als, ls, fs, als2, paths, pss, h):
  units_ok(B.units(B.module.copies(B.obs.made(B.syn.of(als, B.obs(trees))), B.cx.of(B.obs.made(B.syn.of(als, B.obs(trees))), ls, fs, als2, paths, pss))), B.trees.defs(trees), Laws.nodes(trees, als, ls, fs, als2, paths, pss), dsok_trees(trees, h),
    units_m(B.module.copies(B.obs.made(B.syn.of(als, B.obs(trees))), B.cx.of(B.obs.made(B.syn.of(als, B.obs(trees))), ls, fs, als2, paths, pss)), mcopies_m(B.obs.made(B.syn.of(als, B.obs(trees))), B.cx.of(B.obs.made(B.syn.of(als, B.obs(trees))), ls, fs, als2, paths, pss))))

# The writer's lines
# ------------------
#
# Text held within a line (`inline`) written after a text leaves it the
# same from its last newline on (`onto_from`); a newline written starts
# it over. Each piece the writer puts within a line is drawn from a
# context whose texts hold no newline, or is a literal, or digits (a
# remainder below ten, through the hub's division invariant, `digit_ne`):
# a body's tokens keep the text from its last newline (`rts_from`); a
# line starts with a newline, or a space on the header's line
# (`line_from`); the walk follows the lines, a line further each, from
# the header's line or the line after (`at_new`, `at_stay`), the second
# because a line's number and the next differ, also past 2^32
# (`u32_succ_ne`).

# Text within a line

def ne10(+h: U32, +t: List<&2, U32>, h1: {B.inline(Con{h, t}) == True{} : Bool}) -> {U32.is_eq(h, 10) == False{} : Bool}:
  not_true(U32.is_eq(h, 10), and_l(Bool.not(U32.is_eq(h, 10)), B.inline(t), h1))

def il_tail(+h: U32, +t: List<&2, U32>, h1: {B.inline(Con{h, t}) == True{} : Bool}) -> {B.inline(t) == True{} : Bool}:
  and_r(Bool.not(U32.is_eq(h, 10)), B.inline(t), h1)

def from_skip(c: Bool, +h: U32, +t: List<&2, U32>, e: {c == False{} : Bool}) -> {B.from.k(c, Con{h, t}, B.from.nl(t)) == B.from.nl(t) : List<&2, U32>}:
  match c:
    case True{}:
      Empty.absurd({B.from.k(True{}, Con{h, t}, B.from.nl(t)) == B.from.nl(t) : List<&2, U32>}, MB.true_ne_false()(e))
    case False{}:
      {==}

# text within a line written: the text from the last newline as before
def onto_from(xs: List<&2, U32>, +acc: List<&2, U32>, +h: {B.inline(xs) == True{} : Bool}) -> {B.from.nl(B.rev.onto(xs, acc)) == B.from.nl(acc) : List<&2, U32>}:
  match xs:
    case Nil{}:
      {==}
    case Con{+x, +t}:
      Equal.trans(List<&2, U32>, B.from.nl(B.rev.onto(t, Con{x, acc})), B.from.nl(Con{x, acc}), B.from.nl(acc),
        onto_from(t, Con{x, acc}, il_tail(x, t, h)), from_skip(U32.is_eq(x, 10), x, acc, ne10(x, t, h)))

def nf_k(c: Bool, +h: U32, +t: List<&2, U32>, e: {U32.is_eq(h, 10) == c : Bool}, ih: {B.nls(t) == B.nls(B.from.nl(t)) : Nat}) ->
    {B.nl.k(c, B.nls(t)) == B.nls(B.from.k(c, Con{h, t}, B.from.nl(t))) : Nat}:
  match c:
    case True{}:
      %Equal.sym(Bool, U32.is_eq(h, 10), True{}, e) : {1n+B.nls(t) == B.nl.k(_, B.nls(t)) : Nat}
      {==}
    case False{}:
      ih

# the newlines of a text, those before its last line's
def nls_from(xs: List<&2, U32>) -> {B.nls(xs) == B.nls(B.from.nl(xs)) : Nat}:
  match xs:
    case Nil{}:
      {==}
    case Con{+h, +t}:
      nf_k(U32.is_eq(h, 10), h, t, {==}, nls_from(t))

def put_from(b: B.Tb, +xs: List<&2, U32>, +h: {B.inline(xs) == True{} : Bool}) -> {B.tb.from(B.tb.put(b, xs)) == B.tb.from(b) : List<&2, U32>}:
  match b:
    case B.Tb{+acc, ctrs}:
      onto_from(xs, acc, h)

def il_app(a: List<&2, U32>, +b: List<&2, U32>, +ha: {B.inline(a) == True{} : Bool}, +hb: {B.inline(b) == True{} : Bool}) ->
    {B.inline(List.append(&2, U32, a, b)) == True{} : Bool}:
  match a:
    case Nil{}:
      hb
    case Con{+x, +t}:
      and_intro(Bool.not(U32.is_eq(x, 10)), B.inline(List.append(&2, U32, t, b)), and_l(Bool.not(U32.is_eq(x, 10)), B.inline(t), ha),
        il_app(t, b, il_tail(x, t, ha), hb))

def il_spaces(n: Nat) -> {B.inline(B.spaces(n)) == True{} : Bool}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      il_spaces(p)

# Digits: 48 and a remainder below ten (the hub's division invariant),
# never a newline

def ltb(+m: Nat, +em: {Nat.pow(2n, 32n) == m : Nat}) -> MNat.lt(58n, m):
  %em : MNat.lt(58n, _)
  MU.u32_to_nat_lt(58)

def lt48(+r: U32, +m: Nat, +em: {Nat.pow(2n, 32n) == m : Nat}, h: MNat.lt(U32.to_nat(r), 10n)) -> MNat.lt(Nat.add(48n, U32.to_nat(r)), m):
  MNat.lt_trans(Nat.add(48n, U32.to_nat(r)), 58n, m, h, ltb(m, em))

def add48(+r: U32, +m: Nat, +em: {Nat.pow(2n, 32n) == m : Nat}, h: MNat.lt(U32.to_nat(r), 10n)) -> {U32.to_nat(U32.add(48, r)) == Nat.add(48n, U32.to_nat(r)) : Nat}:
  MU.internal_u32_add_exact(m, 48, r, em, lt48(r, m, em, h))

def ne_k(+a: Nat, +n: Nat, e: {a == Nat.add(48n, n) : Nat}) -> {Nat.is_eq(a, 10n) == False{} : Bool}:
  %Equal.sym(Nat, a, Nat.add(48n, n), e) : {Nat.is_eq(_, 10n) == False{} : Bool}
  {==}

def dig_ne(+r: U32, +m: Nat, +em: {Nat.pow(2n, 32n) == m : Nat}, h: MNat.lt(U32.to_nat(r), 10n)) -> {U32.is_eq(U32.add(48, r), 10) == False{} : Bool}:
  Equal.trans(Bool, U32.is_eq(U32.add(48, r), 10), Nat.is_eq(U32.to_nat(U32.add(48, r)), 10n), False{},
    MU.u32_is_eq_to_nat(U32.add(48, r), 10), ne_k(U32.to_nat(U32.add(48, r)), U32.to_nat(r), add48(r, m, em, h)))

def mod_fin_lt(qr: Word(32n) & U32, -a: Nat, inv: MU.internal_dm_inv(32n, 10n, a, qr)) -> MNat.lt(U32.to_nat(U32.mod.fin(qr)), 10n):
  match qr:
    case (q, r):
      match inv:
        case (e, h):
          h

def mod10_lt(n: U32) -> MNat.lt(U32.to_nat(U32.mod(n, 10)), 10n):
  match n:
    case U32{+aw}:
      mod_fin_lt(U32.divmod.go(32n, aw, 10), Word.to_nat(32n, aw), MU.internal_dm_go(32n, aw, 10, {==}, Nat.pow(2n, 32n), {==}))

def digit_ne(+n: U32) -> {U32.is_eq(U32.add(48, U32.mod(n, 10)), 10) == False{} : Bool}:
  dig_ne(U32.mod(n, 10), Nat.pow(2n, 32n), {==}, mod10_lt(n))

def show_fin(g: Nat, +acc: String, +n: U32, z: Bool, h: {B.inline(B.codes(acc)) == True{} : Bool},
    ih: {B.inline(B.codes(U32.show.go(g, U32.div(n, 10), SCon{Chr{U32.add(48, U32.mod(n, 10))}, acc}))) == True{} : Bool}) ->
    {B.inline(B.codes(U32.show.fin(g, acc, n, z))) == True{} : Bool}:
  match z:
    case True{}:
      h
    case False{}:
      ih

def show_go(f: Nat, +n: U32, +acc: String, +h: {B.inline(B.codes(acc)) == True{} : Bool}) -> {B.inline(B.codes(U32.show.go(f, n, acc))) == True{} : Bool}:
  match f:
    case 0n:
      h
    case 1n+(+g):
      show_fin(g, acc, n, U32.is_zero(n), h,
        show_go(g, U32.div(n, 10), SCon{Chr{U32.add(48, U32.mod(n, 10))}, acc},
          and_intro(Bool.not(U32.is_eq(U32.add(48, U32.mod(n, 10)), 10)), B.inline(B.codes(acc)),
            not_false(U32.is_eq(U32.add(48, U32.mod(n, 10)), 10), digit_ne(n)), h)))

def show_if(+a: U32, z: Bool) -> {B.inline(B.codes(U32.show.if(a, z))) == True{} : Bool}:
  match z:
    case True{}:
      {==}
    case False{}:
      show_go(10n, a, SNil{}, {==})

def il_show(+n: U32) -> {B.inline(B.codes(U32.show(n))) == True{} : Bool}:
  show_if(n, U32.is_zero(n))

# Names and paths within a line, from objects' paths and names that are

def il_dots(ps: List<&2, List<&2, U32>>, +h: {B.inlines(ps) == True{} : Bool}) -> {B.inline(B.dots(ps)) == True{} : Bool}:
  match ps:
    case Nil{}:
      {==}
    case Con{+p, +t}:
      match t:
        case Nil{}:
          and_l(B.inline(p), True{}, h)
        case Con{+q, +r}:
          il_app(p, Con{46, B.dots(Con{q, r})}, and_l(B.inline(p), B.inlines(Con{q, r}), h),
            il_dots(Con{q, r}, and_r(B.inline(p), B.inlines(Con{q, r}), h)))

def il_path(+path: List<&2, List<&2, U32>>, +n: List<&2, U32>, +hp: {B.inlines(path) == True{} : Bool}, +hn: {B.inline(n) == True{} : Bool}) ->
    {B.inline(B.path.name(path, n)) == True{} : Bool}:
  match path:
    case Nil{}:
      hn
    case Con{+h, +t}:
      il_app(B.dots(Con{h, t}), Con{46, n}, il_dots(Con{h, t}, hp), hn)

def il_take(xs: List<&2, U32>, n: Nat, +h: {B.inline(xs) == True{} : Bool}) -> {B.inline(List.take(&2, U32, xs, n)) == True{} : Bool}:
  match xs:
    case Nil{}:
      {==}
    case Con{+x, +t}:
      match n:
        case 0n:
          {==}
        case 1n+(+p):
          and_intro(Bool.not(U32.is_eq(x, 10)), B.inline(List.take(&2, U32, t, p)), and_l(Bool.not(U32.is_eq(x, 10)), B.inline(t), h),
            il_take(t, p, il_tail(x, t, h)))

# name.plain's and name.out's choices mirrored
def np_k(+c: Bool, +n: List<&2, U32>) -> List<&2, U32>:
  B.name.plain.k(c, n)

def il_np(c: Bool, +n: List<&2, U32>, +h: {B.inline(n) == True{} : Bool}) -> {B.inline(np_k(c, n)) == True{} : Bool}:
  match c:
    case True{}:
      il_take(n, Nat.sub(List.length(&2, U32, n), 1n), h)
    case False{}:
      h

def il_plain(+n: List<&2, U32>, +h: {B.inline(n) == True{} : Bool}) -> {B.inline(B.name.plain(n)) == True{} : Bool}:
  il_np(Bool.or(U32.is_eq(B.last.or(n, 0), 35), U32.is_eq(B.last.or(n, 0), 33)), n, h)

def no_k(+c: Bool, +n: List<&2, U32>) -> List<&2, U32>:
  B.name.out.k(c, n)

def il_nok(c: Bool, +n: List<&2, U32>, +h: {B.inline(n) == True{} : Bool}) -> {B.inline(no_k(c, n)) == True{} : Bool}:
  match c:
    case True{}:
      il_app(B.name.plain(n), B.codes(".as_declared"), il_plain(n, h), {==})
    case False{}:
      il_plain(n, h)

def il_out(+n: List<&2, U32>, +h: {B.inline(n) == True{} : Bool}) -> {B.inline(B.name.out(n)) == True{} : Bool}:
  il_nok(U32.is_eq(B.last.or(n, 0), 33), n, h)

def il_ob(o: B.Ob, h: {B.ob.inline(o) == True{} : Bool}) -> {B.inlines(B.ob.path(o)) == True{} : Bool}:
  match o:
    case B.Ob{+id, +host, +path, +abs, parents, mems, +no, +kind, +tpl}:
      h

def il_get(os: List<&2, B.Ob>, n: Nat, +h: {B.obs.inline(os) == True{} : Bool}) -> {B.inlines(B.ob.path(B.ob.or(List.get(&2, B.Ob, os, n)))) == True{} : Bool}:
  match os:
    case Nil{}:
      {==}
    case Con{+o, +t}:
      match n:
        case 0n:
          il_ob(o, and_l(B.ob.inline(o), B.obs.inline(t), h))
        case 1n+k:
          il_get(t, k, and_r(B.ob.inline(o), B.obs.inline(t), h))

def il_at(+obs: List<&2, B.Ob>, +id: U32, +h: {B.obs.inline(obs) == True{} : Bool}) -> {B.inlines(B.ob.path(B.ob.at(obs, id))) == True{} : Bool}:
  il_get(obs, U32.to_nat(id), h)

# rf.text's choice mirrored
def rt_k(+c: Bool, +obs: List<&2, B.Ob>, +obj: U32, +name: List<&2, U32>, +origin: U32) -> List<&2, U32>:
  B.when(List<&2, U32>, c,
    u => List.append(&2, U32, B.path.name(B.ob.path(B.ob.at(obs, obj)), B.name.out(name)), Con{46, B.dots(B.ob.path(B.ob.at(obs, origin)))}),
    u => B.path.name(B.ob.path(B.ob.at(obs, obj)), B.name.out(name)))

def il_rtk(c: Bool, +obs: List<&2, B.Ob>, +obj: U32, +name: List<&2, U32>, +origin: U32, +ho: {B.obs.inline(obs) == True{} : Bool},
    +hn: {B.inline(name) == True{} : Bool}) -> {B.inline(rt_k(c, obs, obj, name, origin)) == True{} : Bool}:
  match c:
    case True{}:
      il_app(B.path.name(B.ob.path(B.ob.at(obs, obj)), B.name.out(name)), Con{46, B.dots(B.ob.path(B.ob.at(obs, origin)))},
        il_path(B.ob.path(B.ob.at(obs, obj)), B.name.out(name), il_at(obs, obj, ho), il_out(name, hn)),
        il_dots(B.ob.path(B.ob.at(obs, origin)), il_at(obs, origin, ho)))
    case False{}:
      il_path(B.ob.path(B.ob.at(obs, obj)), B.name.out(name), il_at(obs, obj, ho), il_out(name, hn))

def il_text(+obs: List<&2, B.Ob>, r: B.Rf, +ho: {B.obs.inline(obs) == True{} : Bool}, hn: {B.inline(B.rf.name(r)) == True{} : Bool}) ->
    {B.inline(B.rf.text(obs, r)) == True{} : Bool}:
  match r:
    case B.Rf{+obj, +name, +prior, +origin}:
      il_rtk(prior, obs, obj, name, origin, ho, hn)

# The context's parts within a line


# a law-side unit's name, `LAW.` before its member's own
# (`blend-laws-in-module`)
def il_textlaw(+obs: List<&2, B.Ob>, r: B.Rf, +ho: {B.obs.inline(obs) == True{} : Bool}, hn: {B.inline(B.rf.name(r)) == True{} : Bool}) ->
    {B.inline(B.rf.text.law(obs, r)) == True{} : Bool}:
  match r:
    case B.Rf{+obj, +name, +prior, +origin}:
      il_text(obs, B.Rf{obj, List.append(&2, U32, B.codes("LAW."), name), prior, origin}, ho, il_app(B.codes("LAW."), name, {==}, hn))

def il_utk(c: Bool, +obs: List<&2, B.Ob>, r: B.Rf, +ho: {B.obs.inline(obs) == True{} : Bool}, hn: {B.inline(B.rf.name(r)) == True{} : Bool}) ->
    {B.inline(B.unit.text.k(c, obs, r)) == True{} : Bool}:
  match c:
    case True{}:
      il_textlaw(obs, r, ho, hn)
    case False{}:
      il_text(obs, r, ho, hn)

def ec_files(e: B.Ec, h: {B.ec.inline(e) == True{} : Bool}) -> {B.inlines(B.ec.files(e)) == True{} : Bool}:
  match e:
    case B.Ec{+files, +obs, us, als, +own, res, paths, +mode, rtypes, ux, +ut, mt}:
      and_l(B.inlines(files), B.obs.inline(obs), and_l(Bool.and(B.inlines(files), B.obs.inline(obs)), B.cis.inline(own),
        and_l(Bool.and(Bool.and(B.inlines(files), B.obs.inline(obs)), B.cis.inline(own)), B.ht.inline(ut), h)))

def ec_obs(e: B.Ec, h: {B.ec.inline(e) == True{} : Bool}) -> {B.obs.inline(B.ec.obs(e)) == True{} : Bool}:
  match e:
    case B.Ec{+files, +obs, us, als, +own, res, paths, +mode, rtypes, ux, +ut, mt}:
      and_r(B.inlines(files), B.obs.inline(obs), and_l(Bool.and(B.inlines(files), B.obs.inline(obs)), B.cis.inline(own),
        and_l(Bool.and(Bool.and(B.inlines(files), B.obs.inline(obs)), B.cis.inline(own)), B.ht.inline(ut), h)))

def ec_own(e: B.Ec, h: {B.ec.inline(e) == True{} : Bool}) -> {B.cis.inline(B.ec.own(e)) == True{} : Bool}:
  match e:
    case B.Ec{+files, +obs, us, als, +own, res, paths, +mode, rtypes, ux, +ut, mt}:
      and_r(Bool.and(B.inlines(files), B.obs.inline(obs)), B.cis.inline(own),
        and_l(Bool.and(Bool.and(B.inlines(files), B.obs.inline(obs)), B.cis.inline(own)), B.ht.inline(ut), h))

def il_pick(c: Bool, +z: B.Ht<B.Pk<B.Un>>, +o: B.Ht<B.Pk<B.Un>>, +h: {B.ht.inline(B.HNode{z, o}) == True{} : Bool}) -> {B.ht.inline(B.ht.pick(B.Pk<B.Un>, c, z, o)) == True{} : Bool}:
  match c:
    case True{}:
      and_l(B.ht.inline(z), B.ht.inline(o), h)
    case False{}:
      and_r(B.ht.inline(z), B.ht.inline(o), h)

def il_leaf(fuel: Nat, t: B.Ht<B.Pk<B.Un>>, +b: U32, +h: U32, +ht: {B.ht.inline(t) == True{} : Bool}) -> {B.pks.inline(B.ht.leaf.go(B.Pk<B.Un>, fuel, t, b, h)) == True{} : Bool}:
  match fuel:
    case 0n:
      match t:
        case B.HLeaf{es}:
          ht
        case B.HNode{z, o}:
          {==}
    case 1n+(+k):
      match t:
        case B.HLeaf{es}:
          ht
        case B.HNode{+z, +o}:
          il_leaf(k, B.ht.pick(B.Pk<B.Un>, U32.is_eq(b, 0), z, o), nb(h), nh(h), il_pick(U32.is_eq(b, 0), z, o, ht))

def pkf_k(c: Bool, +u: B.Un, +m: Maybe<&2, B.Un>, +hu: {B.un.inline(u) == True{} : Bool}, +hm: {B.un.inline(B.un.or(m)) == True{} : Bool}) ->
    {B.un.inline(B.un.or(B.pk.pick(B.Un, c, u, m))) == True{} : Bool}:
  match c:
    case True{}:
      hu
    case False{}:
      hm

# the unit a keyed leaf finds: one of its own, within a line
def il_pkfind(es: List<&2, B.Pk<B.Un>>, +i: U32, +h: {B.pks.inline(es) == True{} : Bool}) -> {B.un.inline(B.un.or(B.pk.find(B.Un, es, i))) == True{} : Bool}:
  match es:
    case Nil{}:
      {==}
    case Con{e, +t}:
      match e:
        case B.Pk{+k, +u}:
          pkf_k(U32.is_eq(k, i), u, B.pk.find(B.Un, t, i), and_l(B.un.inline(u), B.pks.inline(t), h), il_pkfind(t, i, and_r(B.un.inline(u), B.pks.inline(t), h)))

# every unit the writer reads within a line
def il_un(e: B.Ec, +i: U32, h: {B.ec.inline(e) == True{} : Bool}) -> {B.un.inline(B.ec.un(e, i)) == True{} : Bool}:
  match e:
    case B.Ec{+files, +obs, us, als, +own, res, paths, +mode, rtypes, ux, +ut, mt}:
      il_pkfind(B.ht.leaf(B.Pk<B.Un>, ut, (i .&. 1 : U32), i), i, il_leaf(32n, ut, (i .&. 1 : U32), i,
        and_r(Bool.and(Bool.and(B.inlines(files), B.obs.inline(obs)), B.cis.inline(own)), B.ht.inline(ut), h)))

def un_name(u: B.Un, h: {B.un.inline(u) == True{} : Bool}) -> {B.inline(B.rf.name(B.un.ref(u))) == True{} : Bool}:
  match u:
    case B.Un{+o, i, +nd, +hd, +ls}:
      match i:
        case B.In{+name, +q, +prior}:
          and_l(B.inline(name), B.rts.inline(hd), and_l(Bool.and(B.inline(name), B.rts.inline(hd)), B.rls.inline(ls), h))

def un_hd(u: B.Un, h: {B.un.inline(u) == True{} : Bool}) -> {B.rts.inline(B.un.hd(u)) == True{} : Bool}:
  match u:
    case B.Un{+o, i, +nd, +hd, +ls}:
      match i:
        case B.In{+name, +q, +prior}:
          and_r(B.inline(name), B.rts.inline(hd), and_l(Bool.and(B.inline(name), B.rts.inline(hd)), B.rls.inline(ls), h))

def un_ls(u: B.Un, h: {B.un.inline(u) == True{} : Bool}) -> {B.rls.inline(B.un.lines(u)) == True{} : Bool}:
  match u:
    case B.Un{+o, i, +nd, +hd, +ls}:
      match i:
        case B.In{+name, +q, +prior}:
          and_r(Bool.and(B.inline(name), B.rts.inline(hd)), B.rls.inline(ls), h)

def il_utext(+e: B.Ec, +y: U32, +hf: {B.ec.inline(e) == True{} : Bool}) -> {B.inline(B.unit.text(e, y)) == True{} : Bool}:
  il_utk(U32.is_gt(B.ec.mode(e), 0), B.ec.obs(e), B.un.ref(B.ec.un(e, y)), ec_obs(e, hf), un_name(B.ec.un(e, y), il_un(e, y, hf)))

def il_copy(+base: List<&2, U32>, +j: U32, +h: {B.inline(base) == True{} : Bool}) -> {B.inline(B.copy.name(base, j)) == True{} : Bool}:
  il_app(base, List.append(&2, U32, B.codes(".c"), B.codes(U32.show(j))), h, il_app(B.codes(".c"), B.codes(U32.show(j)), {==}, il_show(j)))

# own.name's choice mirrored
def on_k(+c: Bool, +e: B.Ec, +x: U32, +j: U32) -> List<&2, U32>:
  B.when(List<&2, U32>, c, u => B.unit.text(e, x), u => B.copy.name(B.unit.text(e, x), j))

def il_onk(c: Bool, +e: B.Ec, +x: U32, +j: U32, +hf: {B.ec.inline(e) == True{} : Bool}) -> {B.inline(on_k(c, e, x, j)) == True{} : Bool}:
  match c:
    case True{}:
      il_utext(e, x, hf)
    case False{}:
      il_copy(B.unit.text(e, x), j, il_utext(e, x, hf))

def il_own(+e: B.Ec, +x: U32, +j: U32, +hf: {B.ec.inline(e) == True{} : Bool}) -> {B.inline(B.own.name(e, x, j)) == True{} : Bool}:
  il_onk(U32.is_eq(j, 0), e, x, j, hf)

# an alias: an import's, or Blend's own `Blend_k`
def al_k(m: Maybe<&2, List<&2, U32>>, +k: U32) -> List<&2, U32>:
  B.on.maybe(List<&2, U32>, List<&2, U32>, m, u => B.res.alias(k), x => x)

def cf_k(+c: Bool, +alias: List<&2, U32>, +t: List<&2, B.Ci>, +p: List<&2, U32>) -> Maybe<&2, List<&2, U32>>:
  B.when(Maybe<&2, List<&2, U32>>, c, u => Some{alias}, u => B.ci.path.find(t, p))

def il_res(+k: U32) -> {B.inline(B.res.alias(k)) == True{} : Bool}:
  il_app(B.codes("Blend_"), B.codes(U32.show(k)), {==}, il_show(k))

def il_cfk(c: Bool, +alias: List<&2, U32>, +t: List<&2, B.Ci>, +p: List<&2, U32>, +k: U32, ha: {B.inline(alias) == True{} : Bool},
    ih: {B.inline(al_k(B.ci.path.find(t, p), k)) == True{} : Bool}) -> {B.inline(al_k(cf_k(c, alias, t, p), k)) == True{} : Bool}:
  match c:
    case True{}:
      ha
    case False{}:
      ih

def il_find(cs: List<&2, B.Ci>, +p: List<&2, U32>, +k: U32, +h: {B.cis.inline(cs) == True{} : Bool}) -> {B.inline(al_k(B.ci.path.find(cs, p), k)) == True{} : Bool}:
  match cs:
    case Nil{}:
      il_res(k)
    case Con{c, +t}:
      match c:
        case B.Ci{+alias, +path, +no}:
          il_cfk(B.same(path, p), alias, t, p, k, and_l(B.inline(alias), B.cis.inline(t), h), il_find(t, p, k, and_r(B.inline(alias), B.cis.inline(t), h)))

def il_alias(+e: B.Ec, +p: List<&2, U32>, +hf: {B.ec.inline(e) == True{} : Bool}) -> {B.inline(B.alias.of(e, p)) == True{} : Bool}:
  il_find(B.ec.own(e), p, U32.add(B.res.index(B.ec.res(e), p, 0), 1), ec_own(e, hf))

# A body's tokens written: the text from the last newline kept

def il_tok(+e: B.Ec, t: B.Tok, h: {B.inline(B.tok.bytes(t)) == True{} : Bool}) -> {B.inline(B.tok.in.proof(e, t)) == True{} : Bool}:
  h

def mark_from(c: Bool, +b: B.Tb) -> {B.tb.from(B.mark.put.k(c, b)) == B.tb.from(b) : List<&2, U32>}:
  match c:
    case True{}:
      put_from(b, [126], {==})
    case False{}:
      {==}

# text within a line put after a mark
def after_mark(+mark: U32, +b: B.Tb, +xs: List<&2, U32>, +h: {B.inline(xs) == True{} : Bool}) ->
    {B.tb.from(B.tb.put(B.mark.put(mark, b), xs)) == B.tb.from(b) : List<&2, U32>}:
  Equal.trans(List<&2, U32>, B.tb.from(B.tb.put(B.mark.put(mark, b), xs)), B.tb.from(B.mark.put(mark, b)), B.tb.from(b),
    put_from(B.mark.put(mark, b), xs, h), mark_from(U32.is_eq(mark, 126), b))

def next_from(+e: B.Ec, +y: U32, b: B.Tb, +hf: {B.ec.inline(e) == True{} : Bool}) -> {B.tb.from(B.ref.next(e, y, b)) == B.tb.from(b) : List<&2, U32>}:
  match b:
    case B.Tb{+acc, +ctrs}:
      onto_from(B.copy.name(B.unit.text(e, y), B.ctr.at(ctrs, y)), acc, il_copy(B.unit.text(e, y), B.ctr.at(ctrs, y), il_utext(e, y, hf)))

def rk_from(o0: Bool, +e: B.Ec, +y: U32, +b: B.Tb, +hf: {B.ec.inline(e) == True{} : Bool}) -> {B.tb.from(rk_k(o0, e, y, b)) == B.tb.from(b) : List<&2, U32>}:
  match o0:
    case True{}:
      put_from(b, B.unit.text(e, y), il_utext(e, y, hf))
    case False{}:
      next_from(e, y, b, hf)

def kind_from(p0: Bool, p1: Bool, +e: B.Ec, +x: U32, +y: U32, +j: U32, +b: B.Tb, +hf: {B.ec.inline(e) == True{} : Bool}) ->
    {B.tb.from(B.ref.kind.k(p0, p1, e, x, y, j, b)) == B.tb.from(b) : List<&2, U32>}:
  match p0 p1:
    case True{} _:
      put_from(b, B.unit.text(e, y), il_utext(e, y, hf))
    case False{} True{}:
      rk_from(U32.is_eq(B.un.o(B.ec.un(e, x)), 0), e, y, b, hf)
    case False{} False{}:
      put_from(b, B.own.name(e, y, j), il_own(e, y, j, hf))

def self_from(c: Bool, +e: B.Ec, +x: U32, +j: U32, +y: U32, +b: B.Tb, +hf: {B.ec.inline(e) == True{} : Bool}) ->
    {B.tb.from(B.ref.self(c, e, x, j, y, b)) == B.tb.from(b) : List<&2, U32>}:
  match c:
    case True{}:
      put_from(b, B.own.name(e, x, j), il_own(e, x, j, hf))
    case False{}:
      kind_from(U32.is_eq(B.mu.kind(B.ec.mu(e, y)), 0), U32.is_eq(B.mu.kind(B.ec.mu(e, y)), 1), e, x, y, j, b, hf)

def rpk_from(c1: Bool, c2: Bool, +e: B.Ec, +x: U32, +j: U32, +mark: U32, +r: B.Rf, +y: U32, +b: B.Tb, +hf: {B.ec.inline(e) == True{} : Bool},
    +hr: {B.inline(B.rf.name(r)) == True{} : Bool}) -> {B.tb.from(rp_k(c1, c2, e, x, j, mark, r, y, b)) == B.tb.from(b) : List<&2, U32>}:
  match c1 c2:
    case True{} _:
      after_mark(mark, b, B.own.name(e, x, j), il_own(e, x, j, hf))
    case False{} True{}:
      after_mark(mark, b, B.rf.text.law(B.ec.obs(e), r), il_textlaw(B.ec.obs(e), r, ec_obs(e, hf), hr))
    case False{} False{}:
      Equal.trans(List<&2, U32>, B.tb.from(B.ref.self(U32.is_eq(y, x), e, x, j, y, B.mark.put(mark, b))), B.tb.from(B.mark.put(mark, b)), B.tb.from(b),
        self_from(U32.is_eq(y, x), e, x, j, y, B.mark.put(mark, b), hf), mark_from(U32.is_eq(mark, 126), b))

# ref.put's choices for a reference outside the writer's units mirrored
def rx_k(+c: Bool, +e: B.Ec, +r: B.Rf) -> List<&2, U32>:
  B.when(List<&2, U32>, c, u => B.rf.text(B.ec.obs(e), r),
    u => List.append(&2, U32, B.alias.of(e, B.mod.bend(B.ec.paths(e), B.loc.mod(B.ob.no(B.ob.at(B.ec.obs(e), B.rf.obj(r)))))),
      Con{46, B.rf.text(B.ec.obs(e), r)}))

def il_rxk(c: Bool, +e: B.Ec, +r: B.Rf, +hf: {B.ec.inline(e) == True{} : Bool}, +hr: {B.inline(B.rf.name(r)) == True{} : Bool}) ->
    {B.inline(rx_k(c, e, r)) == True{} : Bool}:
  match c:
    case True{}:
      il_text(B.ec.obs(e), r, ec_obs(e, hf), hr)
    case False{}:
      il_app(B.alias.of(e, B.mod.bend(B.ec.paths(e), B.loc.mod(B.ob.no(B.ob.at(B.ec.obs(e), B.rf.obj(r)))))), Con{46, B.rf.text(B.ec.obs(e), r)},
        il_alias(e, B.mod.bend(B.ec.paths(e), B.loc.mod(B.ob.no(B.ob.at(B.ec.obs(e), B.rf.obj(r))))), hf), il_text(B.ec.obs(e), r, ec_obs(e, hf), hr))

# ref.put.m's first decision: the file
def rpm_from(m2: Bool, +e: B.Ec, +x: U32, +j: U32, +mark: U32, +r: B.Rf, +y: U32, +b: B.Tb, +hf: {B.ec.inline(e) == True{} : Bool},
    +hr: {B.inline(B.rf.name(r)) == True{} : Bool}) -> {B.tb.from(B.ref.put.m(m2, e, x, j, mark, r, y, b)) == B.tb.from(b) : List<&2, U32>}:
  match m2:
    case False{}:
      rpk_from(False{}, False{}, e, x, j, mark, r, y, b, hf, hr)
    case True{}:
      rpk_from(B.proves.own(B.ec.ut(e), x, y), Bool.or(U32.is_eq(B.node.what(B.un.node(B.ec.un(e, y))), 1), U32.is_eq(B.node.what(B.un.node(B.ec.un(e, y))), 2)), e, x, j, mark, r, y, b, hf, hr)

def rput_from(+e: B.Ec, +x: U32, +j: U32, +mark: U32, +r: B.Rf, m: Maybe<&2, U32>, +b: B.Tb, +hf: {B.ec.inline(e) == True{} : Bool},
    +hr: {B.inline(B.rf.name(r)) == True{} : Bool}) -> {B.tb.from(B.ref.put(e, x, j, mark, r, m, b)) == B.tb.from(b) : List<&2, U32>}:
  match m:
    case None{}:
      after_mark(mark, b, B.rf.ext(e, r),
        il_rxk(U32.is_eq(B.loc.mod(B.ob.no(B.ob.at(B.ec.obs(e), B.rf.obj(r)))), 0), e, r, hf, hr))
    case Some{+y}:
      rpm_from(U32.is_eq(B.ec.mode(e), 2), e, x, j, mark, r, y, b, hf, hr)

# a body's tokens, each within a line, written after b: b's text from
# its last newline kept
def rts_from(ts: List<&2, B.Rt>, +e: B.Ec, +x: U32, +j: U32, +b: B.Tb, +hf: {B.ec.inline(e) == True{} : Bool}, +ht: {B.rts.inline(ts) == True{} : Bool}) ->
    {B.tb.from(B.rts.put(ts, e, x, j, b)) == B.tb.from(b) : List<&2, U32>}:
  match ts:
    case Nil{}:
      {==}
    case Con{t, +r}:
      match t:
        case B.RT{+tk}:
          Equal.trans(List<&2, U32>, B.tb.from(B.rts.put(r, e, x, j, B.tb.put(b, B.tok.in.proof(e, tk)))), B.tb.from(B.tb.put(b, B.tok.in.proof(e, tk))), B.tb.from(b),
            rts_from(r, e, x, j, B.tb.put(b, B.tok.in.proof(e, tk)), hf, and_r(B.rt.inline(B.RT{tk}), B.rts.inline(r), ht)),
            put_from(b, B.tok.in.proof(e, tk), il_tok(e, tk, and_l(B.rt.inline(B.RT{tk}), B.rts.inline(r), ht))))
        case B.RR{+mark, +ref}:
          Equal.trans(List<&2, U32>, B.tb.from(B.rts.put(r, e, x, j, B.ref.put(e, x, j, mark, ref, B.ux.find(B.ec.ux(e), ref), b))),
            B.tb.from(B.ref.put(e, x, j, mark, ref, B.ux.find(B.ec.ux(e), ref), b)), B.tb.from(b),
            rts_from(r, e, x, j, B.ref.put(e, x, j, mark, ref, B.ux.find(B.ec.ux(e), ref), b), hf, and_r(B.rt.inline(B.RR{mark, ref}), B.rts.inline(r), ht)),
            rput_from(e, x, j, mark, ref, B.ux.find(B.ec.ux(e), ref), b, hf, and_l(B.rt.inline(B.RR{mark, ref}), B.rts.inline(r), ht)))
        case B.RX{+mark, +path, +rest}:
          Equal.trans(List<&2, U32>, B.tb.from(B.rts.put(r, e, x, j, B.tb.put(B.mark.put(mark, b), List.append(&2, U32, B.alias.of(e, path), Con{46, rest})))),
            B.tb.from(B.tb.put(B.mark.put(mark, b), List.append(&2, U32, B.alias.of(e, path), Con{46, rest}))), B.tb.from(b),
            rts_from(r, e, x, j, B.tb.put(B.mark.put(mark, b), List.append(&2, U32, B.alias.of(e, path), Con{46, rest})), hf,
              and_r(B.rt.inline(B.RX{mark, path, rest}), B.rts.inline(r), ht)),
            after_mark(mark, b, List.append(&2, U32, B.alias.of(e, path), Con{46, rest}),
              il_app(B.alias.of(e, path), Con{46, rest}, il_alias(e, path, hf), and_l(B.rt.inline(B.RX{mark, path, rest}), B.rts.inline(r), ht))))

# A line's number and the next differ, also past 2^32

def nat_succ_ne(n: Nat) -> {Nat.is_eq(1n+n, n) == False{} : Bool}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      nat_succ_ne(p)

def zero_ne(n: Nat, +m: Nat, e: {1n+n == m : Nat}, h58: MNat.lt(58n, m)) -> {Nat.is_eq(0n, n) == False{} : Bool}:
  match n:
    case 0n:
      Empty.absurd({Nat.is_eq(0n, 0n) == False{} : Bool},
        MB.false_ne_true()(Equal.trans(Bool, Nat.is_lt(58n, 1n), Nat.is_lt(58n, m), True{}, Equal.cong(Nat, Bool, z => Nat.is_lt(58n, z), 1n, m, e), h58)))
    case 1n+p:
      {==}

def sne_k(c: Bool, +n: Nat, +m: Nat, ec: {Nat.is_lt(1n+n, m) == c : Bool}, +hn: MNat.lt(n, m), +h58: MNat.lt(58n, m)) -> {Nat.is_eq(Nat.mod(1n+n, m), n) == False{} : Bool}:
  match c:
    case True{}:
      %Equal.sym(Nat, Nat.mod(1n+n, m), 1n+n, MNat.mod_eq_of_lt(1n+n, m, ec)) : {Nat.is_eq(_, n) == False{} : Bool}
      nat_succ_ne(n)
    case False{}:
      +e = MNat.le_antisymm(1n+n, m, MNat.succ_le_of_lt(n, m, hn), MNat.le_of_not_lt(1n+n, m, ec))
      %Equal.sym(Nat, 1n+n, m, e) : {Nat.is_eq(Nat.mod(_, m), n) == False{} : Bool}
      %Equal.sym(Nat, Nat.mod(m, m), 0n, MNat.mod_self(m)) : {Nat.is_eq(_, n) == False{} : Bool}
      zero_ne(n, m, e, h58)

def u32_succ_ne_m(+a: U32, +m: Nat, +em: {Nat.pow(2n, 32n) == m : Nat}) -> {U32.is_eq(U32.add(a, 1), a) == False{} : Bool}:
  %MU.u32_is_eq_to_nat_sym(U32.add(a, 1), a) : {_ == False{} : Bool}
  %Equal.sym(Nat, U32.to_nat(U32.add(a, 1)), Nat.mod(Nat.add(U32.to_nat(a), U32.to_nat(1)), m), wrap_m(m, em, a, 1)) :
    {Nat.is_eq(_, U32.to_nat(a)) == False{} : Bool}
  %MNat.add_comm(1n, U32.to_nat(a)) : {Nat.is_eq(Nat.mod(_, m), U32.to_nat(a)) == False{} : Bool}
  sne_k(Nat.is_lt(1n+U32.to_nat(a), m), U32.to_nat(a), m, {==}, MU.internal_u32_to_nat_lt(m, a, em), ltb(m, em))

def u32_succ_ne(+a: U32) -> {U32.is_eq(U32.add(a, 1), a) == False{} : Bool}:
  u32_succ_ne_m(a, Nat.pow(2n, 32n), {==})

# a location's next line is another
def loc_succ_ne(+a: B.Loc) -> {B.loc.eq(B.loc.next(a), a) == False{} : Bool}:
  match a:
    case B.Loc{+m, +n}:
      %Equal.sym(Bool, U32.is_eq(m, m), True{}, u32_is_eq_refl(m)) : {Bool.and(_, U32.is_eq(U32.add(n, 1), n)) == False{} : Bool}
      u32_succ_ne(n)

# A body's lines: where each starts, and the walk over them

# what a line leaves of the text from its last newline: as before, on
# the header's line (a space), or a newline after the text before it
def lx(c: Bool, +b: B.Tb) -> List<&2, U32>:
  match c:
    case True{}:
      B.tb.from(b)
    case False{}:
      Con{10, B.tb.acc(b)}

def lnls(c: Bool, +b: B.Tb) -> Nat:
  match c:
    case True{}:
      B.tb.nls(b)
    case False{}:
      1n+B.tb.nls(b)

def lead_from(c: Bool, blank: Bool, +n: Nat, +b: B.Tb) -> {B.tb.from(B.tb.put(b, B.rl.lead(c, blank, n))) == lx(c, b) : List<&2, U32>}:
  match c blank:
    case True{} _:
      put_from(b, [32], {==})
    case False{} True{}:
      match b:
        case B.Tb{+acc, ctrs}:
          {==}
    case False{} False{}:
      match b:
        case B.Tb{+acc, ctrs}:
          onto_from(B.spaces(n), Con{10, acc}, il_spaces(n))

# a line written: where it starts, its tokens within it
def line_from(+no: B.Loc, +ind: U32, ts: List<&2, B.Rt>, +e: B.Ec, +x: U32, +j: U32, +dind: U32, +first: Bool, +b: B.Tb,
    +hf: {B.ec.inline(e) == True{} : Bool}, +ht: {B.rts.inline(ts) == True{} : Bool}) ->
    {B.tb.from(B.rl.put(B.Rl{no, ind, ts}, e, x, j, dind, first, b)) == lx(Bool.and(first, B.loc.eq(no, B.node.no(B.un.node(B.ec.un(e, x))))), b) : List<&2, U32>}:
  match ts:
    case Nil{}:
      lead_from(Bool.and(first, B.loc.eq(no, B.node.no(B.un.node(B.ec.un(e, x))))), True{}, 0n, b)
    case Con{+t, +r}:
      Equal.trans(List<&2, U32>,
        B.tb.from(B.rts.put(Con{t, r}, e, x, j, B.tb.put(b, B.rl.lead(Bool.and(first, B.loc.eq(no, B.node.no(B.un.node(B.ec.un(e, x))))), False{},
          U32.to_nat(B.when(U32, U32.is_gt(ind, dind), v => U32.sub(ind, dind), v => 0)))))),
        B.tb.from(B.tb.put(b, B.rl.lead(Bool.and(first, B.loc.eq(no, B.node.no(B.un.node(B.ec.un(e, x))))), False{},
          U32.to_nat(B.when(U32, U32.is_gt(ind, dind), v => U32.sub(ind, dind), v => 0))))),
        lx(Bool.and(first, B.loc.eq(no, B.node.no(B.un.node(B.ec.un(e, x))))), b),
        rts_from(Con{t, r}, e, x, j, B.tb.put(b, B.rl.lead(Bool.and(first, B.loc.eq(no, B.node.no(B.un.node(B.ec.un(e, x))))), False{},
          U32.to_nat(B.when(U32, U32.is_gt(ind, dind), v => U32.sub(ind, dind), v => 0)))), hf, ht),
        lead_from(Bool.and(first, B.loc.eq(no, B.node.no(B.un.node(B.ec.un(e, x))))), False{},
          U32.to_nat(B.when(U32, U32.is_gt(ind, dind), v => U32.sub(ind, dind), v => 0)), b))

def lx_nls(c: Bool, +b: B.Tb) -> {B.nls(lx(c, b)) == lnls(c, b) : Nat}:
  match c:
    case True{}:
      Equal.sym(Nat, B.nls(B.tb.acc(b)), B.nls(B.from.nl(B.tb.acc(b))), nls_from(B.tb.acc(b)))
    case False{}:
      {==}

# a line's newlines, by where it starts
def line_nls(+a: B.Tb, +c: Bool, +b: B.Tb, h: {B.tb.from(a) == lx(c, b) : List<&2, U32>}) -> {B.tb.nls(a) == lnls(c, b) : Nat}:
  Equal.trans(Nat, B.tb.nls(a), B.nls(B.tb.from(a)), lnls(c, b), nls_from(B.tb.acc(a)),
    Equal.trans(Nat, B.nls(B.tb.from(a)), B.nls(lx(c, b)), lnls(c, b), Equal.cong(List<&2, U32>, Nat, z => B.nls(z), B.tb.from(a), lx(c, b), h), lx_nls(c, b)))

def same_at(+a: List<&2, U32>, +b: List<&2, U32>, h: {a == b : List<&2, U32>}) -> {B.same(a, b) == True{} : Bool}:
  %Equal.sym(List<&2, U32>, a, b, h) : {B.same(_, b) == True{} : Bool}
  Laws.names.same_refl(b)


def wl_or(c: Bool, +a: B.Tb, +b: B.Tb, h: {B.tb.from(a) == lx(c, b) : List<&2, U32>}) ->
    {Bool.or(B.same(B.tb.from(a), Con{10, B.tb.acc(b)}), B.same(B.tb.from(a), B.tb.from(b))) == True{} : Bool}:
  match c:
    case True{}:
      or_r_true(B.same(B.tb.from(a), Con{10, B.tb.acc(b)}), B.same(B.tb.from(a), B.tb.from(b)), same_at(B.tb.from(a), B.tb.from(b), h))
    case False{}:
      or_l_true(B.same(B.tb.from(a), Con{10, B.tb.acc(b)}), B.same(B.tb.from(a), B.tb.from(b)), same_at(B.tb.from(a), Con{10, B.tb.acc(b)}, h))

# a line written where the walk has it: numbered n, on line k
def wl_ok(+c: Bool, +a: B.Tb, +b: B.Tb, +no: B.Loc, +n: B.Loc, +k: Nat, hn: {B.loc.eq(no, n) == True{} : Bool}, +h: {B.tb.from(a) == lx(c, b) : List<&2, U32>},
    hk: {lnls(c, b) == k : Nat}) ->
    {Bool.and(Bool.and(B.loc.eq(no, n), Nat.is_eq(B.tb.nls(a), k)), Bool.or(B.same(B.tb.from(a), Con{10, B.tb.acc(b)}), B.same(B.tb.from(a), B.tb.from(b)))) == True{} : Bool}:
  and_intro(Bool.and(B.loc.eq(no, n), Nat.is_eq(B.tb.nls(a), k)), Bool.or(B.same(B.tb.from(a), Con{10, B.tb.acc(b)}), B.same(B.tb.from(a), B.tb.from(b))),
    and_intro(B.loc.eq(no, n), Nat.is_eq(B.tb.nls(a), k), hn, nat_at(B.tb.nls(a), k, Equal.trans(Nat, B.tb.nls(a), lnls(c, b), k, line_nls(a, c, b, h), hk))),
    wl_or(c, a, b, h))

def on_at(+first: Bool, +no: B.Loc, +n: B.Loc, +hno: B.Loc, heq: {no == n : B.Loc}, h: {Bool.and(first, B.loc.eq(n, hno)) == False{} : Bool}) ->
    {Bool.and(first, B.loc.eq(no, hno)) == False{} : Bool}:
  %Equal.sym(B.Loc, no, n, heq) : {Bool.and(first, B.loc.eq(_, hno)) == False{} : Bool}
  h

# the walk on from a line, its line's newlines as the walk counts them
def at_k(t: List<&2, B.Rl>, +e: B.Ec, +x: U32, +j: U32, +dind: U32, +a: B.Tb, +n: B.Loc, +k: Nat, +fin: List<&2, U32>,
    ih: {B.wr.at(t, e, x, j, dind, False{}, a, 1n+B.tb.nls(a), n, fin) == True{} : Bool}, h: {B.tb.nls(a) == k : Nat}) ->
    {B.wr.at(t, e, x, j, dind, False{}, a, 1n+k, n, fin) == True{} : Bool}:
  %h : {B.wr.at(t, e, x, j, dind, False{}, a, 1n+_, n, fin) == True{} : Bool}
  ih

# a line starting one of its own, numbered n: where the walk has it,
# and the walk on from it
def an_k(+no: B.Loc, +ind: U32, +ts: List<&2, B.Rt>, +t: List<&2, B.Rl>, +e: B.Ec, +x: U32, +j: U32, +dind: U32, +first: Bool, +b: B.Tb, +n: B.Loc,
    +hf: {B.ec.inline(e) == True{} : Bool}, +hi: {B.rls.inline(Con{B.Rl{no, ind, ts}, t}) == True{} : Bool},
    +hn: {B.rl.from(Con{B.Rl{no, ind, ts}, t}, n) == True{} : Bool},
    +hon: {Bool.and(first, B.loc.eq(n, B.node.no(B.un.node(B.ec.un(e, x))))) == False{} : Bool},
    ih: {B.wr.at(t, e, x, j, dind, False{}, B.rl.put(B.Rl{no, ind, ts}, e, x, j, dind, first, b), 1n+B.tb.nls(B.rl.put(B.Rl{no, ind, ts}, e, x, j, dind, first, b)),
      B.loc.next(n), B.tb.acc(B.rls.put(t, e, x, j, dind, False{}, B.rl.put(B.Rl{no, ind, ts}, e, x, j, dind, first, b)))) == True{} : Bool}) ->
    {B.wr.at(Con{B.Rl{no, ind, ts}, t}, e, x, j, dind, first, b, 1n+B.tb.nls(b), n, B.tb.acc(B.rls.put(Con{B.Rl{no, ind, ts}, t}, e, x, j, dind, first, b))) == True{} : Bool}:
  +a = B.rl.put(B.Rl{no, ind, ts}, e, x, j, dind, first, b)
  +on = Bool.and(first, B.loc.eq(no, B.node.no(B.un.node(B.ec.un(e, x)))))
  +hn0 = and_l(B.loc.eq(no, n), B.rl.from(t, B.loc.next(n)), hn)
  +hfa = Equal.trans(List<&2, U32>, B.tb.from(a), lx(on, b), lx(False{}, b),
    line_from(no, ind, ts, e, x, j, dind, first, b, hf, and_l(B.rts.inline(ts), B.rls.inline(t), hi)),
    Equal.cong(Bool, List<&2, U32>, z => lx(z, b), on, False{}, on_at(first, no, n, B.node.no(B.un.node(B.ec.un(e, x))), loc_eq_eq(no, n, hn0), hon)))
  and_intro(B.wr.line(B.Rl{no, ind, ts}, e, x, j, dind, first, b, 1n+B.tb.nls(b), n),
    B.wr.at(t, e, x, j, dind, False{}, a, 1n+(1n+B.tb.nls(b)), B.loc.next(n), B.tb.acc(B.rls.put(t, e, x, j, dind, False{}, a))),
    wl_ok(False{}, a, b, no, n, 1n+B.tb.nls(b), hn0, hfa, {==}),
    at_k(t, e, x, j, dind, a, B.loc.next(n), 1n+B.tb.nls(b), B.tb.acc(B.rls.put(t, e, x, j, dind, False{}, a)), ih, line_nls(a, False{}, b, hfa)))

# from a line starting one of its own, numbered n: each line after a
# newline of its own, a line further each
def at_new(ls: List<&2, B.Rl>, +e: B.Ec, +x: U32, +j: U32, +dind: U32, +first: Bool, +b: B.Tb, +n: B.Loc,
    +hf: {B.ec.inline(e) == True{} : Bool}, +hi: {B.rls.inline(ls) == True{} : Bool}, +hn: {B.rl.from(ls, n) == True{} : Bool},
    +hon: {Bool.and(first, B.loc.eq(n, B.node.no(B.un.node(B.ec.un(e, x))))) == False{} : Bool}) ->
    {B.wr.at(ls, e, x, j, dind, first, b, 1n+B.tb.nls(b), n, B.tb.acc(B.rls.put(ls, e, x, j, dind, first, b))) == True{} : Bool}:
  match ls:
    case Nil{}:
      Laws.names.same_refl(B.tb.acc(b))
    case Con{l, +t}:
      match l:
        case B.Rl{+no, +ind, +ts}:
          an_k(no, ind, ts, t, e, x, j, dind, first, b, n, hf, hi, hn, hon,
            at_new(t, e, x, j, dind, False{}, B.rl.put(B.Rl{no, ind, ts}, e, x, j, dind, first, b), B.loc.next(n), hf,
              and_r(B.rts.inline(ts), B.rls.inline(t), hi), and_r(B.loc.eq(no, n), B.rl.from(t, B.loc.next(n)), hn), {==}))

# a first line on the header's line, numbered as it: on that line, the
# walk on from it
def as_k(+no: B.Loc, +ind: U32, +ts: List<&2, B.Rt>, +t: List<&2, B.Rl>, +e: B.Ec, +x: U32, +j: U32, +dind: U32, +b: B.Tb,
    +hf: {B.ec.inline(e) == True{} : Bool}, +hi: {B.rls.inline(Con{B.Rl{no, ind, ts}, t}) == True{} : Bool},
    +hn: {B.rl.from(Con{B.Rl{no, ind, ts}, t}, B.node.no(B.un.node(B.ec.un(e, x)))) == True{} : Bool},
    ih: {B.wr.at(t, e, x, j, dind, False{}, B.rl.put(B.Rl{no, ind, ts}, e, x, j, dind, True{}, b), 1n+B.tb.nls(B.rl.put(B.Rl{no, ind, ts}, e, x, j, dind, True{}, b)),
      B.loc.next(B.node.no(B.un.node(B.ec.un(e, x)))), B.tb.acc(B.rls.put(t, e, x, j, dind, False{}, B.rl.put(B.Rl{no, ind, ts}, e, x, j, dind, True{}, b)))) == True{} : Bool}) ->
    {B.wr.at(Con{B.Rl{no, ind, ts}, t}, e, x, j, dind, True{}, b, B.tb.nls(b), B.node.no(B.un.node(B.ec.un(e, x))),
      B.tb.acc(B.rls.put(Con{B.Rl{no, ind, ts}, t}, e, x, j, dind, True{}, b))) == True{} : Bool}:
  +a = B.rl.put(B.Rl{no, ind, ts}, e, x, j, dind, True{}, b)
  +hno = B.node.no(B.un.node(B.ec.un(e, x)))
  +hn0 = and_l(B.loc.eq(no, hno), B.rl.from(t, B.loc.next(hno)), hn)
  +hfa = Equal.trans(List<&2, U32>, B.tb.from(a), lx(B.loc.eq(no, hno), b), lx(True{}, b),
    line_from(no, ind, ts, e, x, j, dind, True{}, b, hf, and_l(B.rts.inline(ts), B.rls.inline(t), hi)),
    Equal.cong(Bool, List<&2, U32>, z => lx(z, b), B.loc.eq(no, hno), True{}, hn0))
  and_intro(B.wr.line(B.Rl{no, ind, ts}, e, x, j, dind, True{}, b, B.tb.nls(b), hno),
    B.wr.at(t, e, x, j, dind, False{}, a, 1n+B.tb.nls(b), B.loc.next(hno), B.tb.acc(B.rls.put(t, e, x, j, dind, False{}, a))),
    wl_ok(True{}, a, b, no, hno, B.tb.nls(b), hn0, hfa, {==}),
    at_k(t, e, x, j, dind, a, B.loc.next(hno), B.tb.nls(b), B.tb.acc(B.rls.put(t, e, x, j, dind, False{}, a)), ih, line_nls(a, True{}, b, hfa)))

def at_stay(ls: List<&2, B.Rl>, +e: B.Ec, +x: U32, +j: U32, +dind: U32, +b: B.Tb,
    +hf: {B.ec.inline(e) == True{} : Bool}, +hi: {B.rls.inline(ls) == True{} : Bool}, +hn: {B.rl.from(ls, B.node.no(B.un.node(B.ec.un(e, x)))) == True{} : Bool}) ->
    {B.wr.at(ls, e, x, j, dind, True{}, b, B.tb.nls(b), B.node.no(B.un.node(B.ec.un(e, x))), B.tb.acc(B.rls.put(ls, e, x, j, dind, True{}, b))) == True{} : Bool}:
  match ls:
    case Nil{}:
      Laws.names.same_refl(B.tb.acc(b))
    case Con{l, +t}:
      match l:
        case B.Rl{+no, +ind, +ts}:
          as_k(no, ind, ts, t, e, x, j, dind, b, hf, hi, hn,
            at_new(t, e, x, j, dind, False{}, B.rl.put(B.Rl{no, ind, ts}, e, x, j, dind, True{}, b), B.loc.next(B.node.no(B.un.node(B.ec.un(e, x)))), hf,
              and_r(B.rts.inline(ts), B.rls.inline(t), hi), and_r(B.loc.eq(no, B.node.no(B.un.node(B.ec.un(e, x)))), B.rl.from(t, B.loc.next(B.node.no(B.un.node(B.ec.un(e, x))))), hn), {==}))

# A unit's head: a newline, the marker's line, a newline, the header

def onto_app(xs: List<&2, U32>, +ys: List<&2, U32>, +acc: List<&2, U32>) ->
    {B.rev.onto(List.append(&2, U32, xs, ys), acc) == B.rev.onto(ys, B.rev.onto(xs, acc)) : List<&2, U32>}:
  match xs:
    case Nil{}:
      {==}
    case Con{+x, +t}:
      onto_app(t, ys, Con{x, acc})

# unit.kw's choice mirrored: each a newline, then text within a line; a
# proof's `def` as any (`blend-laws-in-module`), its test kept for its
# callers
def kw_k(+c1: Bool, +c2: Bool) -> List<&2, U32>:
  B.when(List<&2, U32>, c1, u => B.codes("\nlaw "), u => B.codes("\ndef "))

def kw_from(c1: Bool, c2: Bool, +nm: List<&2, U32>, +xs: List<&2, U32>, +h: {B.inline(nm) == True{} : Bool}) ->
    {B.from.nl(B.rev.onto(List.append(&2, U32, kw_k(c1, c2), nm), xs)) == Con{10, xs} : List<&2, U32>}:
  match c1 c2:
    case True{} _:
      onto_from(List.append(&2, U32, B.codes("law "), nm), Con{10, xs}, il_app(B.codes("law "), nm, {==}, h))
    case False{} True{}:
      onto_from(List.append(&2, U32, B.codes("def "), nm), Con{10, xs}, il_app(B.codes("def "), nm, {==}, h))
    case False{} False{}:
      onto_from(List.append(&2, U32, B.codes("def "), nm), Con{10, xs}, il_app(B.codes("def "), nm, {==}, h))

def head_put(b: B.Tb, +ml: List<&2, U32>, +c1: Bool, +c2: Bool, +nm: List<&2, U32>, +h: {B.inline(nm) == True{} : Bool}) ->
    {B.tb.from(B.tb.put(b, List.append(&2, U32, Con{10, ml}, List.append(&2, U32, kw_k(c1, c2), nm)))) == Con{10, B.rev.onto(ml, Con{10, B.tb.acc(b)})} : List<&2, U32>}:
  match b:
    case B.Tb{+acc, ctrs}:
      %Equal.sym(List<&2, U32>, B.rev.onto(List.append(&2, U32, Con{10, ml}, List.append(&2, U32, kw_k(c1, c2), nm)), acc),
          B.rev.onto(List.append(&2, U32, kw_k(c1, c2), nm), B.rev.onto(Con{10, ml}, acc)), onto_app(Con{10, ml}, List.append(&2, U32, kw_k(c1, c2), nm), acc)) :
        {B.from.nl(_) == Con{10, B.rev.onto(ml, Con{10, acc})} : List<&2, U32>}
      kw_from(c1, c2, nm, B.rev.onto(ml, Con{10, acc}), h)

def head_from(+e: B.Ec, +s: U32, +x: U32, +j: U32, +b: B.Tb, +hf: {B.ec.inline(e) == True{} : Bool}) ->
    {B.tb.from(B.unit.head(e, s, x, j, b)) == Con{10, B.rev.onto(B.marker.line(B.ec.files(e), B.node.no(B.un.node(B.ec.un(e, s)))), Con{10, B.tb.acc(b)})} : List<&2, U32>}:
  Equal.trans(List<&2, U32>, B.tb.from(B.unit.head(e, s, x, j, b)),
    B.tb.from(B.tb.put(b, List.append(&2, U32, B.marker(e, s), List.append(&2, U32, B.unit.kw(e, s), B.own.name(e, x, j))))),
    Con{10, B.rev.onto(B.marker.line(B.ec.files(e), B.node.no(B.un.node(B.ec.un(e, s)))), Con{10, B.tb.acc(b)})},
    rts_from(B.un.hd(B.ec.un(e, s)), e, s, j, B.tb.put(b, List.append(&2, U32, B.marker(e, s), List.append(&2, U32, B.unit.kw(e, s), B.own.name(e, x, j)))),
      hf, un_hd(B.ec.un(e, s), il_un(e, s, hf))),
    head_put(b, B.marker.line(B.ec.files(e), B.node.no(B.un.node(B.ec.un(e, s)))),
      U32.is_eq(B.node.what(B.un.node(B.ec.un(e, s))), 1), U32.is_eq(B.node.what(B.un.node(B.ec.un(e, s))), 2), B.own.name(e, x, j), il_own(e, x, j, hf)))

# a file's path, or `blend`
def lfile_k(m: Maybe<&2, List<&2, U32>>) -> List<&2, U32>:
  B.on.maybe(List<&2, U32>, List<&2, U32>, m, u => B.codes("blend"), x => x)

def il_lf(fs: List<&2, List<&2, U32>>, n: Nat, +h: {B.inlines(fs) == True{} : Bool}) -> {B.inline(lfile_k(List.get(&2, List<&2, U32>, fs, n))) == True{} : Bool}:
  match fs:
    case Nil{}:
      {==}
    case Con{+f, +t}:
      match n:
        case 0n:
          and_l(B.inline(f), B.inlines(t), h)
        case 1n+k:
          il_lf(t, k, and_r(B.inline(f), B.inlines(t), h))

def il_marker(+files: List<&2, List<&2, U32>>, +no: B.Loc, +h: {B.inlines(files) == True{} : Bool}) -> {B.inline(B.marker.line(files, no)) == True{} : Bool}:
  il_app(B.codes("# blend: "), List.append(&2, U32, B.loc.file(files, no), Con{58, B.codes(U32.show(B.loc.line(no)))}), {==},
    il_app(B.loc.file(files, no), Con{58, B.codes(U32.show(B.loc.line(no)))}, il_lf(files, U32.to_nat(B.loc.mod(no)), h), il_show(B.loc.line(no))))

def head_same(+e: B.Ec, +s: U32, +x: U32, +j: U32, +b: B.Tb, +hf: {B.ec.inline(e) == True{} : Bool}) ->
    {B.same(B.tb.from(B.unit.head(e, s, x, j, b)), Con{10, B.rev.onto(B.marker.line(B.ec.files(e), B.node.no(B.un.node(B.ec.un(e, s)))), Con{10, B.tb.acc(b)})}) == True{} : Bool}:
  same_at(B.tb.from(B.unit.head(e, s, x, j, b)), Con{10, B.rev.onto(B.marker.line(B.ec.files(e), B.node.no(B.un.node(B.ec.un(e, s)))), Con{10, B.tb.acc(b)})},
    head_from(e, s, x, j, b, hf))

def wh_ok(+e: B.Ec, +s: U32, +x: U32, +j: U32, +b: B.Tb, +hf: {B.ec.inline(e) == True{} : Bool}) -> {B.wr.head(e, s, x, j, b) == True{} : Bool}:
  and_intro(B.inline(B.marker.line(B.ec.files(e), B.node.no(B.un.node(B.ec.un(e, s))))),
    B.same(B.tb.from(B.unit.head(e, s, x, j, b)), Con{10, B.rev.onto(B.marker.line(B.ec.files(e), B.node.no(B.un.node(B.ec.un(e, s)))), Con{10, B.tb.acc(b)})}),
    il_marker(B.ec.files(e), B.node.no(B.un.node(B.ec.un(e, s))), ec_files(e, hf)), head_same(e, s, x, j, b, hf))

# the body's lines from the header's line, or from the line after
def ul_k(c1: Bool, +c2: Bool, +ls: List<&2, B.Rl>, +e: B.Ec, +x: U32, +j: U32, +dind: U32, +b: B.Tb,
    +hf: {B.ec.inline(e) == True{} : Bool}, +hi: {B.rls.inline(ls) == True{} : Bool}, h: {Bool.or(c1, c2) == True{} : Bool},
    e1: {B.rl.from(ls, B.node.no(B.un.node(B.ec.un(e, x)))) == c1 : Bool}, e2: {B.rl.from(ls, B.loc.next(B.node.no(B.un.node(B.ec.un(e, x))))) == c2 : Bool}) ->
    {Bool.or(B.wr.at(ls, e, x, j, dind, True{}, b, B.tb.nls(b), B.node.no(B.un.node(B.ec.un(e, x))), B.tb.acc(B.rls.put(ls, e, x, j, dind, True{}, b))),
      B.wr.at(ls, e, x, j, dind, True{}, b, 1n+B.tb.nls(b), B.loc.next(B.node.no(B.un.node(B.ec.un(e, x)))), B.tb.acc(B.rls.put(ls, e, x, j, dind, True{}, b)))) == True{} : Bool}:
  match c1:
    case True{}:
      or_l_true(B.wr.at(ls, e, x, j, dind, True{}, b, B.tb.nls(b), B.node.no(B.un.node(B.ec.un(e, x))), B.tb.acc(B.rls.put(ls, e, x, j, dind, True{}, b))),
        B.wr.at(ls, e, x, j, dind, True{}, b, 1n+B.tb.nls(b), B.loc.next(B.node.no(B.un.node(B.ec.un(e, x)))), B.tb.acc(B.rls.put(ls, e, x, j, dind, True{}, b))),
        at_stay(ls, e, x, j, dind, b, hf, hi, e1))
    case False{}:
      or_r_true(B.wr.at(ls, e, x, j, dind, True{}, b, B.tb.nls(b), B.node.no(B.un.node(B.ec.un(e, x))), B.tb.acc(B.rls.put(ls, e, x, j, dind, True{}, b))),
        B.wr.at(ls, e, x, j, dind, True{}, b, 1n+B.tb.nls(b), B.loc.next(B.node.no(B.un.node(B.ec.un(e, x)))), B.tb.acc(B.rls.put(ls, e, x, j, dind, True{}, b))),
        at_new(ls, e, x, j, dind, True{}, b, B.loc.next(B.node.no(B.un.node(B.ec.un(e, x)))), hf, hi,
          Equal.trans(Bool, B.rl.from(ls, B.loc.next(B.node.no(B.un.node(B.ec.un(e, x))))), c2, True{}, e2, h),
          loc_succ_ne(B.node.no(B.un.node(B.ec.un(e, x))))))

def Laws.markers.writer(e, s, x, j, b, hf, hl):
  and_intro(B.wr.head(e, s, x, j, b),
    Bool.or(B.wr.at(B.un.lines(B.ec.un(e, s)), e, s, j, B.node.ind(B.un.node(B.ec.un(e, s))), True{}, B.unit.head(e, s, x, j, b),
        B.tb.nls(B.unit.head(e, s, x, j, b)), B.node.no(B.un.node(B.ec.un(e, s))), B.tb.acc(B.unit.body(e, s, x, j, b))),
      B.wr.at(B.un.lines(B.ec.un(e, s)), e, s, j, B.node.ind(B.un.node(B.ec.un(e, s))), True{}, B.unit.head(e, s, x, j, b),
        1n+B.tb.nls(B.unit.head(e, s, x, j, b)), B.loc.next(B.node.no(B.un.node(B.ec.un(e, s)))), B.tb.acc(B.unit.body(e, s, x, j, b)))),
    wh_ok(e, s, x, j, b, hf),
    ul_k(B.rl.from(B.un.lines(B.ec.un(e, s)), B.node.no(B.un.node(B.ec.un(e, s)))), B.rl.from(B.un.lines(B.ec.un(e, s)), B.loc.next(B.node.no(B.un.node(B.ec.un(e, s))))),
      B.un.lines(B.ec.un(e, s)), e, s, j, B.node.ind(B.un.node(B.ec.un(e, s))), B.unit.head(e, s, x, j, b), hf, un_ls(B.ec.un(e, s), il_un(e, s, hf)), hl, {==}, {==}))

# The reader's text within a line
# -------------------------------
#
# A file's lines hold no newline, lines.go splitting there (`inline.lines`);
# each item's texts are parts of its line or literals (`inline.items`);
# the tree keeps them, a body's tokens spelling its lines
# (`inline.tree`).

def il_cons(+x: U32, +t: List<&2, U32>, e: {U32.is_eq(x, 10) == False{} : Bool}, +h: {B.inline(t) == True{} : Bool}) -> {B.inline(Con{x, t}) == True{} : Bool}:
  and_intro(Bool.not(U32.is_eq(x, 10)), B.inline(t), not_false(U32.is_eq(x, 10), e), h)

def il_hd(+x: U32, +t: List<&2, U32>, h: {B.inline(Con{x, t}) == True{} : Bool}) -> {Bool.not(U32.is_eq(x, 10)) == True{} : Bool}:
  and_l(Bool.not(U32.is_eq(x, 10)), B.inline(t), h)

def il_rgo(xs: List<&2, U32>, +acc: List<&2, U32>, +hx: {B.inline(xs) == True{} : Bool}, +ha: {B.inline(acc) == True{} : Bool}) ->
    {B.inline(List.reverse.go(&2, U32, xs, acc)) == True{} : Bool}:
  match xs:
    case Nil{}:
      ha
    case Con{+x, +t}:
      il_rgo(t, Con{x, acc}, il_tail(x, t, hx), and_intro(Bool.not(U32.is_eq(x, 10)), B.inline(acc), il_hd(x, t, hx), ha))

def il_rev(+xs: List<&2, U32>, +h: {B.inline(xs) == True{} : Bool}) -> {B.inline(List.reverse(&2, U32, xs)) == True{} : Bool}:
  il_rgo(xs, Nil{}, h, {==})

def il_drop(n: Nat, xs: List<&2, U32>, +h: {B.inline(xs) == True{} : Bool}) -> {B.inline(B.drop(n, xs)) == True{} : Bool}:
  match n:
    case 0n:
      h
    case 1n+(+k):
      match xs:
        case Nil{}:
          {==}
        case Con{+x, +t}:
          il_drop(k, t, il_tail(x, t, h))

def il_ltail(xs: List<&2, U32>, +h: {B.inline(xs) == True{} : Bool}) -> {B.inline(List.tail(&2, U32, xs)) == True{} : Bool}:
  match xs:
    case Nil{}:
      {==}
    case Con{+x, +t}:
      il_tail(x, t, h)

# A file's lines

def lo_il(c: Bool, +h: U32, +t: List<&2, U32>, +n: Nat, +no: B.Loc, +hx: {B.inline(Con{h, t}) == True{} : Bool},
    ih: {B.ln.inline(B.line.of(t, 1n+n, no)) == True{} : Bool}) -> {B.ln.inline(lo_k(c, h, t, n, no)) == True{} : Bool}:
  match c:
    case True{}:
      ih
    case False{}:
      hx

def lineof_il(xs: List<&2, U32>, +n: Nat, +no: B.Loc, +hx: {B.inline(xs) == True{} : Bool}) -> {B.ln.inline(B.line.of(xs, n, no)) == True{} : Bool}:
  match xs:
    case Nil{}:
      {==}
    case Con{+x, +t}:
      lo_il(U32.is_eq(x, 32), x, t, n, no, hx, lineof_il(t, 1n+n, no, il_tail(x, t, hx)))

def lns_rgo(xs: List<&2, B.Ln>, +acc: List<&2, B.Ln>, +hx: {B.lns.inline(xs) == True{} : Bool}, +ha: {B.lns.inline(acc) == True{} : Bool}) ->
    {B.lns.inline(List.reverse.go(&2, B.Ln, xs, acc)) == True{} : Bool}:
  match xs:
    case Nil{}:
      ha
    case Con{+l, +t}:
      lns_rgo(t, Con{l, acc}, and_r(B.ln.inline(l), B.lns.inline(t), hx), and_intro(B.ln.inline(l), B.lns.inline(acc), and_l(B.ln.inline(l), B.lns.inline(t), hx), ha))

def lns_rev(+xs: List<&2, B.Ln>, +h: {B.lns.inline(xs) == True{} : Bool}) -> {B.lns.inline(List.reverse(&2, B.Ln, xs)) == True{} : Bool}:
  lns_rgo(xs, Nil{}, h, {==})

# a line ended: its text, the bytes kept, held within it
def lend_il(+cur: List<&2, U32>, +no: B.Loc, +out: List<&2, B.Ln>, +hc: {B.inline(cur) == True{} : Bool}, +ho: {B.lns.inline(out) == True{} : Bool}) ->
    {B.lns.inline(Con{B.lines.line(cur, no), out}) == True{} : Bool}:
  and_intro(B.ln.inline(B.lines.line(cur, no)), B.lns.inline(out), lineof_il(List.reverse(&2, U32, cur), 0n, no, il_rev(cur, hc)), ho)

def lg_il(b1: Bool, +b2: Bool, +b: U32, +t: List<&2, U32>, +cur: List<&2, U32>, +no: B.Loc, +out: List<&2, B.Ln>, e1: {U32.is_eq(b, 10) == b1 : Bool},
    ih1: {B.lns.inline(B.lines.go(t, B.Ls{Nil{}, B.loc.next(no), Con{B.lines.line(cur, no), out}})) == True{} : Bool},
    ih2: {B.lns.inline(B.lines.go(t, B.Ls{cur, no, out})) == True{} : Bool},
    ih3: @e:{U32.is_eq(b, 10) == False{} : Bool} -> {B.lns.inline(B.lines.go(t, B.Ls{Con{b, cur}, no, out})) == True{} : Bool}) ->
    {B.lns.inline(lines_k(b, t, cur, no, out, b1, b2)) == True{} : Bool}:
  match b1 b2:
    case True{} _:
      ih1
    case False{} True{}:
      ih2
    case False{} False{}:
      ih3(e1)

def lines_il(bs: List<&2, U32>, +cur: List<&2, U32>, +no: B.Loc, +out: List<&2, B.Ln>, +hc: {B.inline(cur) == True{} : Bool}, +ho: {B.lns.inline(out) == True{} : Bool}) ->
    {B.lns.inline(B.lines.go(bs, B.Ls{cur, no, out})) == True{} : Bool}:
  match bs:
    case Nil{}:
      lns_rev(Con{B.lines.line(cur, no), out}, lend_il(cur, no, out, hc, ho))
    case Con{+b, +t}:
      lg_il(U32.is_eq(b, 10), U32.is_eq(b, 13), b, t, cur, no, out, {==},
        lines_il(t, Nil{}, B.loc.next(no), Con{B.lines.line(cur, no), out}, {==}, lend_il(cur, no, out, hc, ho)),
        lines_il(t, cur, no, out, hc, ho),
        e => lines_il(t, Con{b, cur}, no, out, il_cons(b, cur, e, hc), ho))

def Laws.inline.lines(bs, base):
  lines_il(bs, Nil{}, B.loc.next(base), Nil{}, {==}, {==})

# Parts of lines: a pair's halves each within a line

def pil(p: List<&2, U32> & List<&2, U32>) -> Bool:
  match p:
    case (a, b):
      Bool.and(B.inline(a), B.inline(b))

def ugk(+cond: Bool, +h: U32, +t: List<&2, U32>, +c: U32, +acc: List<&2, U32>) -> List<&2, U32> & List<&2, U32>:
  B.when(List<&2, U32> & List<&2, U32>, cond, u => (List.reverse(&2, U32, acc), t), u => B.until.go(t, c, Con{h, acc}))

def ug_k(cond: Bool, +h: U32, +t: List<&2, U32>, +c: U32, +acc: List<&2, U32>, +ha: {B.inline(acc) == True{} : Bool}, +ht: {B.inline(t) == True{} : Bool},
    ih: {pil(B.until.go(t, c, Con{h, acc})) == True{} : Bool}) -> {pil(ugk(cond, h, t, c, acc)) == True{} : Bool}:
  match cond:
    case True{}:
      and_intro(B.inline(List.reverse(&2, U32, acc)), B.inline(t), il_rev(acc, ha), ht)
    case False{}:
      ih

def ug_il(xs: List<&2, U32>, +c: U32, +acc: List<&2, U32>, +hx: {B.inline(xs) == True{} : Bool}, +ha: {B.inline(acc) == True{} : Bool}) ->
    {pil(B.until.go(xs, c, acc)) == True{} : Bool}:
  match xs:
    case Nil{}:
      and_intro(B.inline(List.reverse(&2, U32, acc)), True{}, il_rev(acc, ha), {==})
    case Con{+h, +t}:
      ug_k(U32.is_eq(h, c), h, t, c, acc, ha, il_tail(h, t, hx), ug_il(t, c, Con{h, acc}, il_tail(h, t, hx), il_cons(h, acc, ne10(h, t, hx), ha)))

def il_until(+xs: List<&2, U32>, +c: U32, +hx: {B.inline(xs) == True{} : Bool}) -> {pil(B.until(xs, c)) == True{} : Bool}:
  ug_il(xs, c, Nil{}, hx, {==})

def ltk(+c: Bool, +h: U32, +t: List<&2, U32>) -> List<&2, U32>:
  B.when(List<&2, U32>, c, u => B.ltrim(t), u => Con{h, t})

def lt_il(c: Bool, +h: U32, +t: List<&2, U32>, +hx: {B.inline(Con{h, t}) == True{} : Bool}, ih: {B.inline(B.ltrim(t)) == True{} : Bool}) ->
    {B.inline(ltk(c, h, t)) == True{} : Bool}:
  match c:
    case True{}:
      ih
    case False{}:
      hx

def il_ltrim(xs: List<&2, U32>, +h: {B.inline(xs) == True{} : Bool}) -> {B.inline(B.ltrim(xs)) == True{} : Bool}:
  match xs:
    case Nil{}:
      {==}
    case Con{+x, +t}:
      lt_il(U32.is_eq(x, 32), x, t, h, il_ltrim(t, il_tail(x, t, h)))

def il_rtrim(+xs: List<&2, U32>, +h: {B.inline(xs) == True{} : Bool}) -> {B.inline(B.rtrim(xs)) == True{} : Bool}:
  il_rev(B.ltrim(List.reverse(&2, U32, xs)), il_ltrim(List.reverse(&2, U32, xs), il_rev(xs, h)))

def il_trim(+xs: List<&2, U32>, +h: {B.inline(xs) == True{} : Bool}) -> {B.inline(B.trim(xs)) == True{} : Bool}:
  il_rtrim(B.ltrim(xs), il_ltrim(xs, h))

def sak(+cond: Bool, +h: U32, +t: List<&2, U32>, +p: List<&2, U32>, +acc: List<&2, U32>) -> List<&2, U32> & List<&2, U32>:
  B.when(List<&2, U32> & List<&2, U32>, cond, u => (List.reverse(&2, U32, acc), B.drop(List.length(&2, U32, p), Con{h, t})), u => B.split.at(t, p, Con{h, acc}))

def sa_k(cond: Bool, +h: U32, +t: List<&2, U32>, +p: List<&2, U32>, +acc: List<&2, U32>, +ha: {B.inline(acc) == True{} : Bool},
    +hx: {B.inline(Con{h, t}) == True{} : Bool}, ih: {pil(B.split.at(t, p, Con{h, acc})) == True{} : Bool}) -> {pil(sak(cond, h, t, p, acc)) == True{} : Bool}:
  match cond:
    case True{}:
      and_intro(B.inline(List.reverse(&2, U32, acc)), B.inline(B.drop(List.length(&2, U32, p), Con{h, t})), il_rev(acc, ha), il_drop(List.length(&2, U32, p), Con{h, t}, hx))
    case False{}:
      ih

def sa_il(xs: List<&2, U32>, +p: List<&2, U32>, +acc: List<&2, U32>, +hx: {B.inline(xs) == True{} : Bool}, +ha: {B.inline(acc) == True{} : Bool}) ->
    {pil(B.split.at(xs, p, acc)) == True{} : Bool}:
  match xs:
    case Nil{}:
      and_intro(B.inline(List.reverse(&2, U32, acc)), True{}, il_rev(acc, ha), {==})
    case Con{+h, +t}:
      sa_k(B.starts(Con{h, t}, p), h, t, p, acc, ha, hx, sa_il(t, p, Con{h, acc}, il_tail(h, t, hx), il_cons(h, acc, ne10(h, t, hx), ha)))

def nsk(+cond: Bool, +h: U32, +t: List<&2, U32>, +ct: List<&2, B.Cl>, +acc: List<&2, U32>) -> List<&2, U32> & List<&2, U32>:
  B.when(List<&2, U32> & List<&2, U32>, cond, u => B.name.split(t, ct, Con{h, acc}), u => (List.reverse(&2, U32, acc), Con{h, t}))

def ns_k(cond: Bool, +h: U32, +t: List<&2, U32>, +ct: List<&2, B.Cl>, +acc: List<&2, U32>, +ha: {B.inline(acc) == True{} : Bool},
    +hx: {B.inline(Con{h, t}) == True{} : Bool}, ih: {pil(B.name.split(t, ct, Con{h, acc})) == True{} : Bool}) -> {pil(nsk(cond, h, t, ct, acc)) == True{} : Bool}:
  match cond:
    case True{}:
      ih
    case False{}:
      and_intro(B.inline(List.reverse(&2, U32, acc)), B.inline(Con{h, t}), il_rev(acc, ha), hx)

def ns_il(xs: List<&2, U32>, cs: List<&2, B.Cl>, +acc: List<&2, U32>, +hx: {B.inline(xs) == True{} : Bool}, +ha: {B.inline(acc) == True{} : Bool}) ->
    {pil(B.name.split(xs, cs, acc)) == True{} : Bool}:
  match xs:
    case Nil{}:
      match cs:
        case Nil{}:
          and_intro(B.inline(List.reverse(&2, U32, acc)), True{}, il_rev(acc, ha), {==})
        case Con{c, ct}:
          and_intro(B.inline(List.reverse(&2, U32, acc)), True{}, il_rev(acc, ha), {==})
    case Con{+h, +t}:
      match cs:
        case Nil{}:
          and_intro(B.inline(List.reverse(&2, U32, acc)), True{}, il_rev(acc, ha), {==})
        case Con{c, +ct}:
          ns_k(B.cl.name(c), h, t, ct, acc, ha, hx, ns_il(t, ct, Con{h, acc}, il_tail(h, t, hx), il_cons(h, acc, ne10(h, t, hx), ha)))

def pgk(+cond: Bool, +h: U32, +t: List<&2, U32>, +prev: U32, +depth: U32, +acc: List<&2, U32>) -> List<&2, U32>:
  B.when(List<&2, U32>, cond, u => List.reverse(&2, U32, acc), u => B.parens.go(t, h, B.depth.next(prev, h, depth), Con{h, acc}))

def pg_k(cond: Bool, +h: U32, +t: List<&2, U32>, +prev: U32, +depth: U32, +acc: List<&2, U32>, +ha: {B.inline(acc) == True{} : Bool},
    ih: {B.inline(B.parens.go(t, h, B.depth.next(prev, h, depth), Con{h, acc})) == True{} : Bool}) -> {B.inline(pgk(cond, h, t, prev, depth, acc)) == True{} : Bool}:
  match cond:
    case True{}:
      il_rev(acc, ha)
    case False{}:
      ih

def pg_il(xs: List<&2, U32>, +prev: U32, +depth: U32, +acc: List<&2, U32>, +hx: {B.inline(xs) == True{} : Bool}, +ha: {B.inline(acc) == True{} : Bool}) ->
    {B.inline(B.parens.go(xs, prev, depth, acc)) == True{} : Bool}:
  match xs:
    case Nil{}:
      il_rev(acc, ha)
    case Con{+h, +t}:
      pg_k(Bool.and(U32.is_eq(h, 41), U32.is_eq(depth, 0)), h, t, prev, depth, acc, ha,
        pg_il(t, h, B.depth.next(prev, h, depth), Con{h, acc}, il_tail(h, t, hx), il_cons(h, acc, ne10(h, t, hx), ha)))

def il_parens(+xs: List<&2, U32>, +h: {B.inline(xs) == True{} : Bool}) -> {B.inline(B.parens(xs)) == True{} : Bool}:
  pg_il(xs, 0, 0, Nil{}, h, {==})

def tkk(+c: Bool, +r: List<&2, U32>) -> List<&2, U32>:
  B.when(List<&2, U32>, c, u => B.trim(B.drop(1n, r)), u => B.codes("Type"))

def tk_il(c: Bool, +r: List<&2, U32>, +h: {B.inline(r) == True{} : Bool}) -> {B.inline(tkk(c, r)) == True{} : Bool}:
  match c:
    case True{}:
      il_trim(B.drop(1n, r), il_drop(1n, r, h))
    case False{}:
      {==}

def il_kind(+r: List<&2, U32>, +h: {B.inline(r) == True{} : Bool}) -> {B.inline(B.type.kind(r)) == True{} : Bool}:
  tk_il(B.starts.s(r, ":"), r, h)

def udk(+c: Bool, +xs: List<&2, U32>) -> List<&2, U32>:
  B.when(List<&2, U32>, c, u => B.drop(4n, xs), u => xs)

def ud_il(c: Bool, +xs: List<&2, U32>, +h: {B.inline(xs) == True{} : Bool}) -> {B.inline(udk(c, xs)) == True{} : Bool}:
  match c:
    case True{}:
      il_drop(4n, xs, h)
    case False{}:
      h

def il_upd(+xs: List<&2, U32>, +h: {B.inline(xs) == True{} : Bool}) -> {B.inline(B.upd.def(xs)) == True{} : Bool}:
  ud_il(B.starts.s(xs, "def "), xs, h)

# Items: each text a part of its line, or a literal

def idef_il(+name: List<&2, U32>, +rest: List<&2, U32>, +body: List<&2, B.Ln>, +hn: {B.inline(name) == True{} : Bool}, +hr: {B.inline(rest) == True{} : Bool},
    +hb: {B.lns.inline(body) == True{} : Bool}) -> {Bool.and(Bool.and(B.inline(name), B.inline(rest)), B.lns.inline(body)) == True{} : Bool}:
  and_intro(Bool.and(B.inline(name), B.inline(rest)), B.lns.inline(body), and_intro(B.inline(name), B.inline(rest), hn, hr), hb)

def lm_il(c: Bool, +name: List<&2, U32>, +txt: List<&2, U32>, +body: List<&2, B.Ln>, +no: B.Loc, +ind: U32, +hn: {B.inline(name) == True{} : Bool},
    +hb: {B.lns.inline(body) == True{} : Bool}) -> {B.item.inline(lm_k(c, name, txt, body, no, ind)) == True{} : Bool}:
  match c:
    case True{}:
      idef_il(name, B.codes(":"), body, hn, {==}, hb)
    case False{}:
      {==}

def law_il(p: List<&2, U32> & List<&2, U32>, +txt: List<&2, U32>, +body: List<&2, B.Ln>, +no: B.Loc, +ind: U32, +hp: {pil(p) == True{} : Bool},
    +hb: {B.lns.inline(body) == True{} : Bool}) -> {B.item.inline(B.law.r(p, txt, body, no, ind)) == True{} : Bool}:
  match p:
    case (+name, +rest):
      lm_il(Bool.and(B.name.ok(B.trim(name)), B.blank(B.trim(rest))), B.trim(name), txt, body, no, ind, il_trim(name, and_l(B.inline(name), B.inline(rest), hp)), hb)

def pr_il(c1: Bool, c2: Bool, +upd: Bool, +name: List<&2, U32>, +rest: List<&2, U32>, +txt: List<&2, U32>, +body: List<&2, B.Ln>, +no: B.Loc, +ind: U32,
    +hn: {B.inline(name) == True{} : Bool}, +hr: {B.inline(rest) == True{} : Bool}, +hb: {B.lns.inline(body) == True{} : Bool}) ->
    {B.item.inline(pr_k(c1, c2, upd, name, rest, txt, body, no, ind)) == True{} : Bool}:
  match c1 c2:
    case True{} True{}:
      idef_il(B.trim(name), Con{40, rest}, body, il_trim(name, hn), hr, hb)
    case True{} False{}:
      idef_il(List.append(&2, U32, B.trim(name), [35]), Con{40, rest}, body, il_app(B.trim(name), [35], il_trim(name, hn), {==}), hr, hb)
    case False{} _:
      {==}

def proofr_il(p: List<&2, U32> & List<&2, U32>, +upd: Bool, +lemma: Bool, +txt: List<&2, U32>, +body: List<&2, B.Ln>, +no: B.Loc, +ind: U32, +hp: {pil(p) == True{} : Bool},
    +hb: {B.lns.inline(body) == True{} : Bool}) -> {B.item.inline(B.proof.r(p, upd, lemma, txt, body, no, ind)) == True{} : Bool}:
  match p:
    case (+name, +rest):
      pr_il(Bool.and(Bool.and(B.name.ok(B.trim(name)), Bool.not(B.blank(rest))), Bool.not(Bool.xor(lemma, B.holds(rest, B.codes(") ->"))))), lemma, upd, name, rest, txt, body, no, ind,
        and_l(B.inline(name), B.inline(rest), hp), and_r(B.inline(name), B.inline(rest), hp), hb)

def proof_il(+txt: List<&2, U32>, upd: Bool, +body: List<&2, B.Ln>, +no: B.Loc, +ind: U32, +hx: {B.inline(txt) == True{} : Bool},
    +hb: {B.lns.inline(body) == True{} : Bool}) -> {B.item.inline(B.proof.item(txt, upd, body, no, ind)) == True{} : Bool}:
  match upd:
    case True{}:
      proofr_il(B.until(B.drop(10n, txt), 40), True{}, B.is.lemma(txt), txt, body, no, ind, il_until(B.drop(10n, txt), 40, il_drop(10n, txt, hx)), hb)
    case False{}:
      proofr_il(B.until(B.drop(6n, txt), 40), False{}, B.is.lemma(txt), txt, body, no, ind, il_until(B.drop(6n, txt), 40, il_drop(6n, txt, hx)), hb)

def named_il(ok: Bool, +name: List<&2, U32>, +rest: List<&2, U32>, +xs: List<&2, U32>, +share: U32, +upd: Bool, +body: List<&2, B.Ln>, +no: B.Loc, +ind: U32,
    +hn: {B.inline(name) == True{} : Bool}, +hr: {B.inline(rest) == True{} : Bool}, +hb: {B.lns.inline(body) == True{} : Bool}) ->
    {B.item.inline(B.def.named(ok, name, rest, xs, share, upd, body, no, ind)) == True{} : Bool}:
  match ok:
    case True{}:
      idef_il(name, Con{40, rest}, body, hn, hr, hb)
    case False{}:
      {==}

def dr_il(p: List<&2, U32> & List<&2, U32>, +xs: List<&2, U32>, +share: U32, +upd: Bool, +body: List<&2, B.Ln>, +no: B.Loc, +ind: U32, +hp: {pil(p) == True{} : Bool},
    +hb: {B.lns.inline(body) == True{} : Bool}) -> {B.item.inline(B.def.r(p, xs, share, upd, body, no, ind)) == True{} : Bool}:
  match p:
    case (+name, +rest):
      named_il(Bool.and(B.name.ok(B.trim(name)), Bool.not(B.blank(rest))), B.trim(name), rest, xs, share, upd, body, no, ind,
        il_trim(name, and_l(B.inline(name), B.inline(rest), hp)), and_r(B.inline(name), B.inline(rest), hp), hb)

def kwd_il(d: Bool, u: Bool, +xs: List<&2, U32>, +share: U32, +body: List<&2, B.Ln>, +no: B.Loc, +ind: U32, +hx: {B.inline(xs) == True{} : Bool},
    +hb: {B.lns.inline(body) == True{} : Bool}) -> {B.item.inline(B.def.kw.d(d, u, xs, share, body, no, ind)) == True{} : Bool}:
  match d u:
    case True{} _:
      dr_il(B.until(B.drop(4n, xs), 40), B.drop(4n, xs), share, False{}, body, no, ind, il_until(B.drop(4n, xs), 40, il_drop(4n, xs, hx)), hb)
    case False{} True{}:
      dr_il(B.until(B.upd.def(B.drop(4n, xs)), 40), B.upd.def(B.drop(4n, xs)), share, True{}, body, no, ind,
        il_until(B.upd.def(B.drop(4n, xs)), 40, il_upd(B.drop(4n, xs), il_drop(4n, xs, hx))), hb)
    case False{} False{}:
      {==}

def shs_il(s: Bool, c: Bool, +xs: List<&2, U32>, +body: List<&2, B.Ln>, +no: B.Loc, +ind: U32, +hx: {B.inline(xs) == True{} : Bool},
    +hb: {B.lns.inline(body) == True{} : Bool}) -> {B.item.inline(B.def.share.s(s, c, xs, body, no, ind)) == True{} : Bool}:
  match s c:
    case True{} _:
      kwd_il(B.starts.s(B.drop(7n, xs), "def "), B.starts.s(B.drop(7n, xs), "upd "), B.drop(7n, xs), 1, body, no, ind, il_drop(7n, xs, hx), hb)
    case False{} True{}:
      kwd_il(B.starts.s(B.drop(7n, xs), "def "), B.starts.s(B.drop(7n, xs), "upd "), B.drop(7n, xs), 2, body, no, ind, il_drop(7n, xs, hx), hb)
    case False{} False{}:
      kwd_il(B.starts.s(xs, "def "), B.starts.s(xs, "upd "), xs, 0, body, no, ind, hx, hb)

def fb_il(c1: Bool, c2: Bool, c3: Bool, c4: Bool, +txt: List<&2, U32>, +body: List<&2, B.Ln>, +no: B.Loc, +ind: U32, +hx: {B.inline(txt) == True{} : Bool},
    +hb: {B.lns.inline(body) == True{} : Bool}) -> {B.item.inline(fbk(c1, c2, c3, c4, txt, body, no, ind)) == True{} : Bool}:
  match c1 c2 c3 c4:
    case True{} _ _ _:
      {==}
    case False{} True{} _ _:
      law_il(B.until(B.drop(4n, txt), 58), txt, body, no, ind, il_until(B.drop(4n, txt), 58, il_drop(4n, txt, hx)), hb)
    case False{} False{} True{} _:
      {==}
    case False{} False{} False{} True{}:
      proof_il(txt, B.starts.s(txt, "upd "), body, no, ind, hx, hb)
    case False{} False{} False{} False{}:
      shs_il(B.starts.s(txt, "shared "), B.starts.s(txt, "copied "), txt, body, no, ind, hx, hb)

def block_il(+txt: List<&2, U32>, +body: List<&2, B.Ln>, +no: B.Loc, +ind: U32, +hx: {B.inline(txt) == True{} : Bool}, +hb: {B.lns.inline(body) == True{} : Bool}) ->
    {B.item.inline(B.flat.block(txt, body, no, ind)) == True{} : Bool}:
  fb_il(B.is.datatype(txt), B.starts.s(txt, "law "), B.starts.s(txt, "upd law "), B.proof.kw(txt), txt, body, no, ind, hx, hb)

def onamed_il(ok: Bool, +with: Bool, +ext: Bool, +name: List<&2, U32>, +ps: List<&2, List<&2, U32>>, +xs: List<&2, U32>, +abs: Bool, +no: B.Loc, +ind: U32,
    +hn: {B.inline(name) == True{} : Bool}) -> {B.item.inline(B.obj.named(ok, with, ext, name, ps, xs, abs, no, ind)) == True{} : Bool}:
  match ok:
    case True{}:
      hn
    case False{}:
      {==}

def oe_il(p: List<&2, U32> & List<&2, U32>, +xs: List<&2, U32>, +abs: Bool, +ext: Bool, +no: B.Loc, +ind: U32, +hp: {pil(p) == True{} : Bool}) ->
    {B.item.inline(B.obj.ext(p, xs, abs, ext, no, ind)) == True{} : Bool}:
  match p:
    case (+name, +rest):
      onamed_il(Bool.and(B.name.ok(name), Bool.or(Bool.or(B.blank(B.rtrim(rest)), B.same(B.rtrim(rest), B.codes("with"))),
          Bool.and(B.starts.s(B.rtrim(rest), "extends "), B.names.ok(B.obj.parents(B.rtrim(rest)))))),
        Bool.or(B.same(B.rtrim(rest), B.codes("with")), B.starts.s(List.reverse(&2, U32, B.rtrim(rest)), "htiw ")), ext,
        name, B.obj.parents(B.rtrim(rest)), xs, abs, no, ind, and_l(B.inline(name), B.inline(rest), hp))

def obj_il(+xs: List<&2, U32>, +line: List<&2, U32>, +abs: Bool, +ext: Bool, +no: B.Loc, +ind: U32, +hx: {B.inline(xs) == True{} : Bool}) ->
    {B.item.inline(B.obj.item(xs, line, abs, ext, no, ind)) == True{} : Bool}:
  oe_il(B.until(xs, 32), line, abs, ext, no, ind, il_until(xs, 32, hx))

def dnamed_il(ok: Bool, +ns: List<&2, List<&2, U32>>, +line: List<&2, U32>, +no: B.Loc, +ind: U32) -> {B.item.inline(B.decl.named(ok, ns, line, no, ind)) == True{} : Bool}:
  match ok:
    case True{}:
      {==}
    case False{}:
      {==}

def ditem_il(+ns: List<&2, List<&2, U32>>, +line: List<&2, U32>, +no: B.Loc, +ind: U32) -> {B.item.inline(B.decl.item(ns, line, no, ind)) == True{} : Bool}:
  dnamed_il(Bool.and(B.decl.some(ns), B.names.ok(ns)), ns, line, no, ind)

def dw_il(c: Bool, +name: List<&2, U32>, +ps: List<&2, U32>, +ret: List<&2, U32>, +txt: List<&2, U32>, +no: B.Loc, +ind: U32, +out: List<&2, B.Item>,
    +hn: {B.inline(name) == True{} : Bool}, +hp: {B.inline(ps) == True{} : Bool}, +hr: {B.inline(ret) == True{} : Bool}, +ho: {B.items.inline(out) == True{} : Bool}) ->
    {B.items.inline(dwk(c, name, ps, ret, txt, no, ind, out)) == True{} : Bool}:
  match c:
    case True{}:
      and_intro(Bool.and(Bool.and(B.inline(List.append(&2, U32, name, [33])),
          B.inline(List.append(&2, U32, Con{40, ps}, List.append(&2, U32, B.codes(") -> "), List.append(&2, U32, ret, B.codes(":")))))), True{}),
        B.items.inline(out),
        idef_il(List.append(&2, U32, name, [33]), List.append(&2, U32, Con{40, ps}, List.append(&2, U32, B.codes(") -> "), List.append(&2, U32, ret, B.codes(":")))), Nil{},
          il_app(name, [33], hn, {==}),
          il_app(Con{40, ps}, List.append(&2, U32, B.codes(") -> "), List.append(&2, U32, ret, B.codes(":"))), hp,
            il_app(B.codes(") -> "), List.append(&2, U32, ret, B.codes(":")), {==}, il_app(ret, B.codes(":"), hr, {==}))), {==}),
        ho)
    case False{}:
      ho

def witness_il(+name: List<&2, U32>, +ps: List<&2, U32>, +ret: List<&2, U32>, +txt: List<&2, U32>, +no: B.Loc, +ind: U32, +out: List<&2, B.Item>,
    +hn: {B.inline(name) == True{} : Bool}, +hp: {B.inline(ps) == True{} : Bool}, +hr: {B.inline(ret) == True{} : Bool}, +ho: {B.items.inline(out) == True{} : Bool}) ->
    {B.items.inline(B.decl.witness(name, ps, ret, txt, no, ind, out)) == True{} : Bool}:
  dw_il(Bool.and(B.name.ok(name), Bool.not(B.blank(ret))), name, ps, ret, txt, no, ind, out, hn, hp, hr, ho)

def dtk_il(c: Bool, +name: List<&2, U32>, +after: List<&2, U32>, +txt: List<&2, U32>, +no: B.Loc, +ind: U32, +out: List<&2, B.Item>,
    +hn: {B.inline(name) == True{} : Bool}, +ha: {B.inline(after) == True{} : Bool}, +ho: {B.items.inline(out) == True{} : Bool}) ->
    {B.items.inline(dtk(c, name, after, txt, no, ind, out)) == True{} : Bool}:
  match c:
    case True{}:
      witness_il(name, B.parens(List.tail(&2, U32, after)),
        B.type.kind(B.trim(B.drop(Nat.add(List.length(&2, U32, B.parens(List.tail(&2, U32, after))), 2n), after))), txt, no, ind, out, hn,
        il_parens(List.tail(&2, U32, after), il_ltail(after, ha)),
        il_kind(B.trim(B.drop(Nat.add(List.length(&2, U32, B.parens(List.tail(&2, U32, after))), 2n), after)),
          il_trim(B.drop(Nat.add(List.length(&2, U32, B.parens(List.tail(&2, U32, after))), 2n), after),
            il_drop(Nat.add(List.length(&2, U32, B.parens(List.tail(&2, U32, after))), 2n), after, ha))), ho)
    case False{}:
      witness_il(name, Nil{}, B.type.kind(B.trim(after)), txt, no, ind, out, hn, {==}, il_kind(B.trim(after), il_trim(after, ha)), ho)

def dtype_il(p: List<&2, U32> & List<&2, U32>, +txt: List<&2, U32>, +no: B.Loc, +ind: U32, +out: List<&2, B.Item>, +hp: {pil(p) == True{} : Bool},
    +ho: {B.items.inline(out) == True{} : Bool}) -> {B.items.inline(B.decl.type.k(p, txt, no, ind, out)) == True{} : Bool}:
  match p:
    case (+name, +after):
      dtk_il(B.starts.s(after, "("), name, after, txt, no, ind, out, and_l(B.inline(name), B.inline(after), hp), and_r(B.inline(name), B.inline(after), hp), ho)

def dtl_il(c: Bool, +r: List<&2, U32>, +txt: List<&2, U32>, +no: B.Loc, +ind: U32, +out: List<&2, B.Item>, +hr: {B.inline(r) == True{} : Bool},
    +ho: {B.items.inline(out) == True{} : Bool}) -> {B.items.inline(dtl(c, r, txt, no, ind, out)) == True{} : Bool}:
  match c:
    case True{}:
      dtype_il(B.name.split(r, B.classes(r), Nil{}), txt, no, ind, out, ns_il(r, B.classes(r), Nil{}, hr, {==}), ho)
    case False{}:
      and_intro(B.item.inline(B.decl.item(B.commas(r), txt, no, ind)), B.items.inline(out), ditem_il(B.commas(r), txt, no, ind), ho)

def ddk_il(c: Bool, +name: List<&2, U32>, +rest: List<&2, U32>, +txt: List<&2, U32>, +no: B.Loc, +ind: U32, +out: List<&2, B.Item>,
    +hn: {B.inline(name) == True{} : Bool}, +hr: {B.inline(rest) == True{} : Bool}, +ho: {B.items.inline(out) == True{} : Bool}) ->
    {B.items.inline(ddk(c, name, rest, txt, no, ind, out)) == True{} : Bool}:
  match c:
    case True{}:
      witness_il(B.trim(name), B.parens(rest), B.trim(B.drop(Nat.add(List.length(&2, U32, B.parens(rest)), 4n), rest)), txt, no, ind, out,
        il_trim(name, hn), il_parens(rest, hr),
        il_trim(B.drop(Nat.add(List.length(&2, U32, B.parens(rest)), 4n), rest), il_drop(Nat.add(List.length(&2, U32, B.parens(rest)), 4n), rest, hr)), ho)
    case False{}:
      ho

def ddef_il(p: List<&2, U32> & List<&2, U32>, +txt: List<&2, U32>, +no: B.Loc, +ind: U32, +out: List<&2, B.Item>, +hp: {pil(p) == True{} : Bool},
    +ho: {B.items.inline(out) == True{} : Bool}) -> {B.items.inline(B.decl.def.k(p, txt, no, ind, out)) == True{} : Bool}:
  match p:
    case (+name, +rest):
      ddk_il(B.holds(rest, B.codes(") ->")), name, rest, txt, no, ind, out, and_l(B.inline(name), B.inline(rest), hp), and_r(B.inline(name), B.inline(rest), hp), ho)

def dl_il(c1: Bool, c2: Bool, +rest: List<&2, U32>, +txt: List<&2, U32>, +no: B.Loc, +ind: U32, +out: List<&2, B.Item>, +hr: {B.inline(rest) == True{} : Bool},
    +ho: {B.items.inline(out) == True{} : Bool}) -> {B.items.inline(dlk(c1, c2, rest, txt, no, ind, out)) == True{} : Bool}:
  match c1 c2:
    case True{} _:
      dtl_il(Bool.or(B.holds(B.trim(B.drop(5n, rest)), B.codes(":")), B.holds(B.trim(B.drop(5n, rest)), B.codes("("))), B.trim(B.drop(5n, rest)), txt, no, ind, out,
        il_trim(B.drop(5n, rest), il_drop(5n, rest, hr)), ho)
    case False{} True{}:
      ddef_il(B.until(B.when(List<&2, U32>, B.starts.s(rest, "def "), w => B.drop(4n, rest), w => rest), 40), txt, no, ind, out,
        il_until(B.when(List<&2, U32>, B.starts.s(rest, "def "), w => B.drop(4n, rest), w => rest), 40, ud_il(B.starts.s(rest, "def "), rest, hr)), ho)
    case False{} False{}:
      and_intro(B.item.inline(B.decl.item(B.commas(rest), txt, no, ind)), B.items.inline(out), ditem_il(B.commas(rest), txt, no, ind), ho)

def decl_il(+rest: List<&2, U32>, +txt: List<&2, U32>, +no: B.Loc, +ind: U32, +out: List<&2, B.Item>, +hr: {B.inline(rest) == True{} : Bool},
    +ho: {B.items.inline(out) == True{} : Bool}) -> {B.items.inline(B.decl.line(rest, txt, no, ind, out)) == True{} : Bool}:
  dl_il(B.starts.s(rest, "type "), B.holds(rest, B.codes("(")), rest, txt, no, ind, out, hr, ho)

def fl_il(skip: Bool, imp: Bool, abs: Bool, obj: Bool, decl: Bool, +txt: List<&2, U32>, +no: B.Loc, +ind: U32, +out: List<&2, B.Item>,
    +hx: {B.inline(txt) == True{} : Bool}, +ho: {B.items.inline(out) == True{} : Bool}) ->
    {B.items.inline(B.flat.line(skip, imp, abs, obj, decl, txt, no, ind, out)) == True{} : Bool}:
  match skip imp abs obj decl:
    case True{} _ _ _ _:
      ho
    case False{} True{} _ _ _:
      and_intro(B.inline(txt), B.items.inline(out), hx, ho)
    case False{} False{} True{} _ _:
      and_intro(B.item.inline(B.obj.item(B.drop(16n, txt), txt, True{}, False{}, no, ind)), B.items.inline(out),
        obj_il(B.drop(16n, txt), txt, True{}, False{}, no, ind, il_drop(16n, txt, hx)), ho)
    case False{} False{} False{} True{} _:
      and_intro(B.item.inline(B.obj.item(B.drop(7n, txt), txt, False{}, False{}, no, ind)), B.items.inline(out),
        obj_il(B.drop(7n, txt), txt, False{}, False{}, no, ind, il_drop(7n, txt, hx)), ho)
    case False{} False{} False{} False{} True{}:
      decl_il(B.drop(8n, txt), txt, no, ind, out, il_drop(8n, txt, hx), ho)
    case False{} False{} False{} False{} False{}:
      ho

def ex_il(c: Bool, +txt: List<&2, U32>, +no: B.Loc, +ind: U32, +hx: {B.inline(txt) == True{} : Bool}) -> {B.item.inline(exk(c, txt, no, ind)) == True{} : Bool}:
  match c:
    case True{}:
      obj_il(B.drop(16n, txt), txt, True{}, True{}, no, ind, il_drop(16n, txt, hx))
    case False{}:
      obj_il(B.drop(7n, txt), txt, False{}, True{}, no, ind, il_drop(7n, txt, hx))

def fik_il(c: Bool, +txt: List<&2, U32>, +no: B.Loc, +ind: U32, +out: List<&2, B.Item>, +hx: {B.inline(txt) == True{} : Bool},
    +ho: {B.items.inline(out) == True{} : Bool}) -> {B.items.inline(fik(c, txt, no, ind, out)) == True{} : Bool}:
  match c:
    case True{}:
      and_intro(B.item.inline(B.ext.item(txt, no, ind)), B.items.inline(out), ex_il(B.starts.s(txt, "extend abstract "), txt, no, ind, hx), ho)
    case False{}:
      fl_il(Bool.or(B.blank(txt), B.comment(txt)), B.starts.s(txt, "import "), B.starts.s(txt, "abstract object "), B.starts.s(txt, "object "),
        B.starts.s(txt, "declare "), txt, no, ind, out, hx, ho)

def tm_il(c: Bool, +upd: Bool, +name: List<&2, U32>, +ps: List<&2, U32>, +after: List<&2, U32>, +ty: List<&2, U32>, +xs: List<&2, U32>, +no: B.Loc, +ind: U32,
    +hn: {B.inline(name) == True{} : Bool}, +hp: {B.inline(ps) == True{} : Bool}, +ha: {B.inline(after) == True{} : Bool}, +hty: {B.inline(ty) == True{} : Bool}) ->
    {B.item.inline(tmk(c, upd, name, ps, after, ty, xs, no, ind)) == True{} : Bool}:
  match c:
    case True{}:
      idef_il(name, List.append(&2, U32, Con{40, ps}, List.append(&2, U32, B.codes(") -> "), List.append(&2, U32, B.type.kind(B.trim(after)), B.codes(":")))),
        [B.Ln{no, U32.add(ind, 2), ty}], hn,
        il_app(Con{40, ps}, List.append(&2, U32, B.codes(") -> "), List.append(&2, U32, B.type.kind(B.trim(after)), B.codes(":"))), hp,
          il_app(B.codes(") -> "), List.append(&2, U32, B.type.kind(B.trim(after)), B.codes(":")), {==},
            il_app(B.type.kind(B.trim(after)), B.codes(":"), il_kind(B.trim(after), il_trim(after, ha)), {==}))),
        and_intro(B.ln.inline(B.Ln{no, U32.add(ind, 2), ty}), True{}, hty, {==}))
    case False{}:
      {==}

def made_il(+upd: Bool, +name: List<&2, U32>, +ps: List<&2, U32>, +after: List<&2, U32>, +ty: List<&2, U32>, +xs: List<&2, U32>, +no: B.Loc, +ind: U32,
    +hn: {B.inline(name) == True{} : Bool}, +hp: {B.inline(ps) == True{} : Bool}, +ha: {B.inline(after) == True{} : Bool}, +hty: {B.inline(ty) == True{} : Bool}) ->
    {B.item.inline(B.type.made(upd, name, ps, after, ty, xs, no, ind)) == True{} : Bool}:
  tm_il(Bool.and(B.name.ok(name), Bool.not(B.blank(ty))), upd, name, ps, after, ty, xs, no, ind, hn, hp, ha, hty)

def tl_il(c: Bool, +upd: Bool, +name: List<&2, U32>, +after: List<&2, U32>, +ty: List<&2, U32>, +xs: List<&2, U32>, +no: B.Loc, +ind: U32,
    +hn: {B.inline(name) == True{} : Bool}, +ha: {B.inline(after) == True{} : Bool}, +hty: {B.inline(ty) == True{} : Bool}) ->
    {B.item.inline(tlk(c, upd, name, after, ty, xs, no, ind)) == True{} : Bool}:
  match c:
    case True{}:
      made_il(upd, name, B.parens(List.tail(&2, U32, after)), B.drop(Nat.add(List.length(&2, U32, B.parens(List.tail(&2, U32, after))), 2n), after), ty, xs, no, ind,
        hn, il_parens(List.tail(&2, U32, after), il_ltail(after, ha)), il_drop(Nat.add(List.length(&2, U32, B.parens(List.tail(&2, U32, after))), 2n), after, ha), hty)
    case False{}:
      made_il(upd, name, Nil{}, after, ty, xs, no, ind, hn, {==}, ha, hty)

def lhs_il(+upd: Bool, p: List<&2, U32> & List<&2, U32>, +ty: List<&2, U32>, +xs: List<&2, U32>, +no: B.Loc, +ind: U32, +hp: {pil(p) == True{} : Bool},
    +hty: {B.inline(ty) == True{} : Bool}) -> {B.item.inline(B.type.lhs(upd, p, ty, xs, no, ind)) == True{} : Bool}:
  match p:
    case (+name, +after):
      tl_il(B.starts.s(after, "("), upd, name, after, ty, xs, no, ind, and_l(B.inline(name), B.inline(after), hp), and_r(B.inline(name), B.inline(after), hp), hty)

def teq_il(+upd: Bool, p: List<&2, U32> & List<&2, U32>, +xs: List<&2, U32>, +no: B.Loc, +ind: U32, +hp: {pil(p) == True{} : Bool}) ->
    {B.item.inline(B.type.eq(upd, p, xs, no, ind)) == True{} : Bool}:
  match p:
    case (+lhs, +ty):
      lhs_il(upd, B.name.split(B.trim(lhs), B.classes(B.trim(lhs)), Nil{}), B.trim(ty), xs, no, ind,
        ns_il(B.trim(lhs), B.classes(B.trim(lhs)), Nil{}, il_trim(lhs, and_l(B.inline(lhs), B.inline(ty), hp)), {==}), il_trim(ty, and_r(B.inline(lhs), B.inline(ty), hp)))

def ti_il(c: Bool, +txt: List<&2, U32>, +no: B.Loc, +ind: U32, +hx: {B.inline(txt) == True{} : Bool}) -> {B.item.inline(tik(c, txt, no, ind)) == True{} : Bool}:
  match c:
    case True{}:
      teq_il(True{}, B.split.at(B.drop(9n, txt), B.codes(" = "), Nil{}), txt, no, ind, sa_il(B.drop(9n, txt), B.codes(" = "), Nil{}, il_drop(9n, txt, hx), {==}))
    case False{}:
      teq_il(False{}, B.split.at(B.drop(5n, txt), B.codes(" = "), Nil{}), txt, no, ind, sa_il(B.drop(5n, txt), B.codes(" = "), Nil{}, il_drop(5n, txt, hx), {==}))

def plain_il(c: Bool, +txt: List<&2, U32>, +no: B.Loc, +ind: U32, +out: List<&2, B.Item>, +hx: {B.inline(txt) == True{} : Bool},
    +ho: {B.items.inline(out) == True{} : Bool}) -> {B.items.inline(plk(c, txt, no, ind, out)) == True{} : Bool}:
  match c:
    case True{}:
      and_intro(B.item.inline(B.type.item(txt, no, ind)), B.items.inline(out), ti_il(B.starts.s(txt, "upd "), txt, no, ind, hx), ho)
    case False{}:
      fik_il(B.starts.s(txt, "extend "), txt, no, ind, out, hx, ho)

# A header's body: lines of the file

def lpil(p: List<&2, B.Ln> & List<&2, B.Ln>) -> Bool:
  match p:
    case (a, b):
      Bool.and(B.lns.inline(a), B.lns.inline(b))

def lpil_a(p: List<&2, B.Ln> & List<&2, B.Ln>, h: {lpil(p) == True{} : Bool}) -> {B.lns.inline(Pair.fst(List<&2, B.Ln>, List<&2, B.Ln>, p)) == True{} : Bool}:
  match p:
    case (+a, +b):
      and_l(B.lns.inline(a), B.lns.inline(b), h)

def lpil_b(p: List<&2, B.Ln> & List<&2, B.Ln>, h: {lpil(p) == True{} : Bool}) -> {B.lns.inline(Pair.snd(List<&2, B.Ln>, List<&2, B.Ln>, p)) == True{} : Bool}:
  match p:
    case (+a, +b):
      and_r(B.lns.inline(a), B.lns.inline(b), h)

def bgi_k(c: Bool, +no: B.Loc, +li: U32, +txt: List<&2, U32>, +t: List<&2, B.Ln>, +ind: U32, +acc: List<&2, B.Ln>, +ha: {B.lns.inline(acc) == True{} : Bool},
    +hl: {B.lns.inline(Con{B.Ln{no, li, txt}, t}) == True{} : Bool}, ih: {lpil(B.body.go(t, ind, Con{B.Ln{no, li, txt}, acc})) == True{} : Bool}) ->
    {lpil(bgk(c, no, li, txt, t, ind, acc)) == True{} : Bool}:
  match c:
    case True{}:
      ih
    case False{}:
      and_intro(B.lns.inline(List.reverse(&2, B.Ln, acc)), B.lns.inline(Con{B.Ln{no, li, txt}, t}), lns_rev(acc, ha), hl)

def bg_il(ls: List<&2, B.Ln>, +ind: U32, +acc: List<&2, B.Ln>, +hx: {B.lns.inline(ls) == True{} : Bool}, +ha: {B.lns.inline(acc) == True{} : Bool}) ->
    {lpil(B.body.go(ls, ind, acc)) == True{} : Bool}:
  match ls:
    case Nil{}:
      and_intro(B.lns.inline(List.reverse(&2, B.Ln, acc)), True{}, lns_rev(acc, ha), {==})
    case Con{l, +t}:
      match l:
        case B.Ln{+no, +li, +txt}:
          bgi_k(Bool.or(B.blank(txt), U32.is_gt(li, ind)), no, li, txt, t, ind, acc, ha, hx,
            bg_il(t, ind, Con{B.Ln{no, li, txt}, acc}, and_r(B.inline(txt), B.lns.inline(t), hx),
              and_intro(B.inline(txt), B.lns.inline(acc), and_l(B.inline(txt), B.lns.inline(t), hx), ha)))

def bl_il(c: Bool, +no: B.Loc, +ind: U32, +txt: List<&2, U32>, +t: List<&2, B.Ln>, +hl: {B.lns.inline(Con{B.Ln{no, ind, txt}, t}) == True{} : Bool},
    ih: {B.lns.inline(B.body.lead(t)) == True{} : Bool}) -> {B.lns.inline(blk(c, no, ind, txt, t)) == True{} : Bool}:
  match c:
    case True{}:
      ih
    case False{}:
      hl

def blead_il(ls: List<&2, B.Ln>, +h: {B.lns.inline(ls) == True{} : Bool}) -> {B.lns.inline(B.body.lead(ls)) == True{} : Bool}:
  match ls:
    case Nil{}:
      {==}
    case Con{l, +t}:
      match l:
        case B.Ln{+no, +ind, +txt}:
          bl_il(B.blank(txt), no, ind, txt, t, h, blead_il(t, and_r(B.inline(txt), B.lns.inline(t), h)))

def btrim_il(+xs: List<&2, B.Ln>, +h: {B.lns.inline(xs) == True{} : Bool}) -> {B.lns.inline(B.body.trim(xs)) == True{} : Bool}:
  lns_rev(B.body.lead(List.reverse(&2, B.Ln, xs)), blead_il(List.reverse(&2, B.Ln, xs), lns_rev(xs, h)))

def its_rgo(xs: List<&2, B.Item>, +acc: List<&2, B.Item>, +hx: {B.items.inline(xs) == True{} : Bool}, +ha: {B.items.inline(acc) == True{} : Bool}) ->
    {B.items.inline(List.reverse.go(&2, B.Item, xs, acc)) == True{} : Bool}:
  match xs:
    case Nil{}:
      ha
    case Con{+i, +t}:
      its_rgo(t, Con{i, acc}, and_r(B.item.inline(i), B.items.inline(t), hx), and_intro(B.item.inline(i), B.items.inline(acc), and_l(B.item.inline(i), B.items.inline(t), hx), ha))

def fg_il(c: Bool, +m: Nat, +txt: List<&2, U32>, +t: List<&2, B.Ln>, +no: B.Loc, +ind: U32, +out: List<&2, B.Item>,
    ht: {B.items.inline(B.flat.go(m, Pair.snd(List<&2, B.Ln>, List<&2, B.Ln>, B.body.go(t, ind, Nil{})), Con{B.flat.block(txt, B.body.trim(Pair.fst(List<&2, B.Ln>, List<&2, B.Ln>, B.body.go(t, ind, Nil{}))), no, ind), out})) == True{} : Bool},
    hf: {B.items.inline(B.flat.go(m, t, plk(B.is.member.type(txt), txt, no, ind, out))) == True{} : Bool}) ->
    {B.items.inline(fgk(c, m, txt, t, no, ind, out)) == True{} : Bool}:
  match c:
    case True{}:
      %Equal.sym(List<&2, B.Item>, B.on.pair(List<&2, B.Ln>, List<&2, B.Ln>, List<&2, B.Item>, B.body.go(t, ind, Nil{}), body => rest => B.flat.go(m, rest, Con{B.flat.block(txt, B.body.trim(body), no, ind), out})), B.flat.go(m, Pair.snd(List<&2, B.Ln>, List<&2, B.Ln>, B.body.go(t, ind, Nil{})), Con{B.flat.block(txt, B.body.trim(Pair.fst(List<&2, B.Ln>, List<&2, B.Ln>, B.body.go(t, ind, Nil{}))), no, ind), out}), pair_eta(B.body.go(t, ind, Nil{}), body => rest => B.flat.go(m, rest, Con{B.flat.block(txt, B.body.trim(body), no, ind), out}))) :
        {B.items.inline(_) == True{} : Bool}
      ht
    case False{}:
      hf

# the items read from lines holding no newline: texts holding none
def flat_il(n: Nat, ls: List<&2, B.Ln>, +out: List<&2, B.Item>, +hl: {B.lns.inline(ls) == True{} : Bool}, +ho: {B.items.inline(out) == True{} : Bool}) ->
    {B.items.inline(B.flat.go(n, ls, out)) == True{} : Bool}:
  match n:
    case 0n:
      its_rgo(out, Nil{}, ho, {==})
    case 1n+(+m):
      match ls:
        case Nil{}:
          its_rgo(out, Nil{}, ho, {==})
        case Con{l, +t}:
          match l:
            case B.Ln{+no, +ind, +txt}:
              fg_il(Bool.and(Bool.not(B.is.member.type(txt)), Bool.or(B.is_def(txt), B.is.datatype(txt))), m, txt, t, no, ind, out,
                flat_il(m, Pair.snd(List<&2, B.Ln>, List<&2, B.Ln>, B.body.go(t, ind, Nil{})),
                  Con{B.flat.block(txt, B.body.trim(Pair.fst(List<&2, B.Ln>, List<&2, B.Ln>, B.body.go(t, ind, Nil{}))), no, ind), out},
                  lpil_b(B.body.go(t, ind, Nil{}), bg_il(t, ind, Nil{}, and_r(B.inline(txt), B.lns.inline(t), hl), {==})),
                  and_intro(B.item.inline(B.flat.block(txt, B.body.trim(Pair.fst(List<&2, B.Ln>, List<&2, B.Ln>, B.body.go(t, ind, Nil{}))), no, ind)), B.items.inline(out),
                    block_il(txt, B.body.trim(Pair.fst(List<&2, B.Ln>, List<&2, B.Ln>, B.body.go(t, ind, Nil{}))), no, ind, and_l(B.inline(txt), B.lns.inline(t), hl),
                      btrim_il(Pair.fst(List<&2, B.Ln>, List<&2, B.Ln>, B.body.go(t, ind, Nil{})),
                        lpil_a(B.body.go(t, ind, Nil{}), bg_il(t, ind, Nil{}, and_r(B.inline(txt), B.lns.inline(t), hl), {==})))),
                    ho)),
                flat_il(m, t, plk(B.is.member.type(txt), txt, no, ind, out), and_r(B.inline(txt), B.lns.inline(t), hl),
                  plain_il(B.is.member.type(txt), txt, no, ind, out, and_l(B.inline(txt), B.lns.inline(t), hl), ho)))

def Laws.inline.items(ls, h):
  flat_il(List.length(&2, B.Ln, ls), ls, Nil{}, h, {==})

# The tree: a body's tokens spell its lines (`tokens.spell`), each open
# object's name and members held within a line (`fril`)

def il_appl(a: List<&2, U32>, +b: List<&2, U32>, +h: {B.inline(List.append(&2, U32, a, b)) == True{} : Bool}) -> {B.inline(a) == True{} : Bool}:
  match a:
    case Nil{}:
      {==}
    case Con{+x, +t}:
      and_intro(Bool.not(U32.is_eq(x, 10)), B.inline(t), and_l(Bool.not(U32.is_eq(x, 10)), B.inline(List.append(&2, U32, t, b)), h),
        il_appl(t, b, and_r(Bool.not(U32.is_eq(x, 10)), B.inline(List.append(&2, U32, t, b)), h)))

def il_appr(a: List<&2, U32>, +b: List<&2, U32>, +h: {B.inline(List.append(&2, U32, a, b)) == True{} : Bool}) -> {B.inline(b) == True{} : Bool}:
  match a:
    case Nil{}:
      h
    case Con{+x, +t}:
      il_appr(t, b, and_r(Bool.not(U32.is_eq(x, 10)), B.inline(List.append(&2, U32, t, b)), h))

def tt_il(ts: List<&2, B.Tok>, +h: {B.inline(B.toks.text(ts)) == True{} : Bool}) -> {B.toks.inline(ts) == True{} : Bool}:
  match ts:
    case Nil{}:
      {==}
    case Con{+t, +r}:
      and_intro(B.inline(B.tok.bytes(t)), B.toks.inline(r), il_appl(B.tok.bytes(t), B.toks.text(r), h), tt_il(r, il_appr(B.tok.bytes(t), B.toks.text(r), h)))

def il_spell(+txt: List<&2, U32>, h: {B.inline(txt) == True{} : Bool}) -> {B.inline(B.toks.text(B.toks(txt))) == True{} : Bool}:
  %Equal.sym(List<&2, U32>, B.toks.text(B.toks(txt)), txt, Laws.tokens.spell(txt)) : {B.inline(_) == True{} : Bool}
  h

def tln_il(ls: List<&2, B.Ln>, +h: {B.lns.inline(ls) == True{} : Bool}) -> {B.bls.inline(B.toks.lines(ls)) == True{} : Bool}:
  match ls:
    case Nil{}:
      {==}
    case Con{l, +t}:
      match l:
        case B.Ln{+no, +ind, +txt}:
          and_intro(B.toks.inline(B.toks(txt)), B.bls.inline(B.toks.lines(t)), tt_il(B.toks(txt), il_spell(txt, and_l(B.inline(txt), B.lns.inline(t), h))),
            tln_il(t, and_r(B.inline(txt), B.lns.inline(t), h)))

def fril(st: List<&2, B.Fr>) -> Bool:
  match st:
    case Nil{}:
      True{}
    case Con{f, t}:
      match f:
        case B.Fr{+top, +ind, +abs, +with, +ext, name, parents, kids, +no}:
          Bool.and(Bool.and(B.inline(name), B.nodes.inline(kids)), fril(t))

def ncons_il(n: B.Node, +ks: List<&2, B.Node>, +hn: {B.nodes.inline(Con{n, Nil{}}) == True{} : Bool}, +hk: {B.nodes.inline(ks) == True{} : Bool}) ->
    {B.nodes.inline(Con{n, ks}) == True{} : Bool}:
  match n:
    case B.NObj{+abs, +ext, +name, +parents, +kids, +no}:
      and_intro(Bool.and(B.inline(name), B.nodes.inline(kids)), B.nodes.inline(ks), and_l(Bool.and(B.inline(name), B.nodes.inline(kids)), True{}, hn), hk)
    case B.NDef{+share, +upd, +name, +rest, +params, +body, +no, +ind, +what}:
      and_intro(Bool.and(Bool.and(B.inline(name), B.inline(rest)), B.bls.inline(body)), B.nodes.inline(ks),
        and_l(Bool.and(Bool.and(B.inline(name), B.inline(rest)), B.bls.inline(body)), True{}, hn), hk)
    case B.NImport{+txt, +no}:
      and_intro(B.inline(txt), B.nodes.inline(ks), and_l(B.inline(txt), True{}, hn), hk)
    case B.NDecl{+names, +no}:
      hk
    case B.NBad{+txt, +no}:
      hk
    case B.NErr{+msg, +no}:
      hk
    case B.NBend{+lines, +no}:
      hk

def nhead_il(n: B.Node, +t: List<&2, B.Node>, +h: {B.nodes.inline(Con{n, t}) == True{} : Bool}) -> {B.nodes.inline(Con{n, Nil{}}) == True{} : Bool}:
  match n:
    case B.NObj{+abs, +ext, +name, +parents, +kids, +no}:
      and_intro(Bool.and(B.inline(name), B.nodes.inline(kids)), True{}, and_l(Bool.and(B.inline(name), B.nodes.inline(kids)), B.nodes.inline(t), h), {==})
    case B.NDef{+share, +upd, +name, +rest, +params, +body, +no, +ind, +what}:
      and_intro(Bool.and(Bool.and(B.inline(name), B.inline(rest)), B.bls.inline(body)), True{},
        and_l(Bool.and(Bool.and(B.inline(name), B.inline(rest)), B.bls.inline(body)), B.nodes.inline(t), h), {==})
    case B.NImport{+txt, +no}:
      and_intro(B.inline(txt), True{}, and_l(B.inline(txt), B.nodes.inline(t), h), {==})
    case B.NDecl{+names, +no}:
      {==}
    case B.NBad{+txt, +no}:
      {==}
    case B.NErr{+msg, +no}:
      {==}
    case B.NBend{+lines, +no}:
      {==}

def ntail_il(n: B.Node, +t: List<&2, B.Node>, +h: {B.nodes.inline(Con{n, t}) == True{} : Bool}) -> {B.nodes.inline(t) == True{} : Bool}:
  match n:
    case B.NObj{+abs, +ext, +name, +parents, +kids, +no}:
      and_r(Bool.and(B.inline(name), B.nodes.inline(kids)), B.nodes.inline(t), h)
    case B.NDef{+share, +upd, +name, +rest, +params, +body, +no, +ind, +what}:
      and_r(Bool.and(Bool.and(B.inline(name), B.inline(rest)), B.bls.inline(body)), B.nodes.inline(t), h)
    case B.NImport{+txt, +no}:
      and_r(B.inline(txt), B.nodes.inline(t), h)
    case B.NDecl{+names, +no}:
      h
    case B.NBad{+txt, +no}:
      h
    case B.NErr{+msg, +no}:
      h
    case B.NBend{+lines, +no}:
      h

def nrev_il(xs: List<&2, B.Node>, +acc: List<&2, B.Node>, +hx: {B.nodes.inline(xs) == True{} : Bool}, +ha: {B.nodes.inline(acc) == True{} : Bool}) ->
    {B.nodes.inline(List.reverse.go(&2, B.Node, xs, acc)) == True{} : Bool}:
  match xs:
    case Nil{}:
      ha
    case Con{+n, +t}:
      nrev_il(t, Con{n, acc}, ntail_il(n, t, hx), ncons_il(n, acc, nhead_il(n, t, hx), ha))

def into_il(st: List<&2, B.Fr>, +n: B.Node, +hn: {B.nodes.inline(Con{n, Nil{}}) == True{} : Bool}, +hs: {fril(st) == True{} : Bool}) ->
    {fril(B.close.into(st, n)) == True{} : Bool}:
  match st:
    case Nil{}:
      {==}
    case Con{f, +rest}:
      match f:
        case B.Fr{+top, +ind, +abs, +with, +ext, +name, +parents, +kids, +no}:
          and_intro(Bool.and(B.inline(name), B.nodes.inline(Con{n, kids})), fril(rest),
            and_intro(B.inline(name), B.nodes.inline(Con{n, kids}), and_l(B.inline(name), B.nodes.inline(kids), and_l(Bool.and(B.inline(name), B.nodes.inline(kids)), fril(rest), hs)),
              ncons_il(n, kids, hn, and_r(B.inline(name), B.nodes.inline(kids), and_l(Bool.and(B.inline(name), B.nodes.inline(kids)), fril(rest), hs)))),
            and_r(Bool.and(B.inline(name), B.nodes.inline(kids)), fril(rest), hs))

def with_il(with: Bool, kids: List<&2, B.Node>, +name: List<&2, U32>, +no: B.Loc, +st: List<&2, B.Fr>, +hs: {fril(st) == True{} : Bool}) ->
    {fril(B.close.with(with, kids, name, no, st)) == True{} : Bool}:
  match with:
    case True{}:
      hs
    case False{}:
      match kids:
        case Nil{}:
          hs
        case Con{k, t}:
          into_il(st, B.NErr{List.append(&2, U32, B.codes("object "), List.append(&2, U32, name, B.codes(" has members, so its header ends with `with`"))), no}, {==}, hs)

def cgo_il(c: Bool, +k: Nat, +top: Bool, +ind: U32, +abs: Bool, +with: Bool, +ext: Bool, +name: List<&2, U32>, +parents: List<&2, List<&2, U32>>,
    +kids: List<&2, B.Node>, +no: B.Loc, +rest: List<&2, B.Fr>, +i: U32,
    ih: {fril(B.close.go(k, B.close.into(B.close.with(with, kids, name, no, rest), B.NObj{abs, ext, name, parents, List.reverse(&2, B.Node, kids), no}), i)) == True{} : Bool},
    hs: {fril(Con{B.Fr{top, ind, abs, with, ext, name, parents, kids, no}, rest}) == True{} : Bool}) ->
    {fril(cgo(c, k, top, ind, abs, with, ext, name, parents, kids, no, rest, i)) == True{} : Bool}:
  match c:
    case True{}:
      ih
    case False{}:
      hs

def close_il(n: Nat, st: List<&2, B.Fr>, +i: U32, +hs: {fril(st) == True{} : Bool}) -> {fril(B.close.go(n, st, i)) == True{} : Bool}:
  match n:
    case 0n:
      hs
    case 1n+(+k):
      match st:
        case Nil{}:
          {==}
        case Con{f, +rest}:
          match f:
            case B.Fr{+top, +ind, +abs, +with, +ext, +name, +parents, +kids, +no}:
              cgo_il(Bool.and(Bool.not(top), U32.is_ge(ind, i)), k, top, ind, abs, with, ext, name, parents, kids, no, rest, i,
                close_il(k, B.close.into(B.close.with(with, kids, name, no, rest), B.NObj{abs, ext, name, parents, List.reverse(&2, B.Node, kids), no}), i,
                  into_il(B.close.with(with, kids, name, no, rest), B.NObj{abs, ext, name, parents, List.reverse(&2, B.Node, kids), no},
                    and_intro(Bool.and(B.inline(name), B.nodes.inline(List.reverse(&2, B.Node, kids))), True{},
                      and_intro(B.inline(name), B.nodes.inline(List.reverse(&2, B.Node, kids)),
                        and_l(B.inline(name), B.nodes.inline(kids), and_l(Bool.and(B.inline(name), B.nodes.inline(kids)), fril(rest), hs)),
                        nrev_il(kids, Nil{}, and_r(B.inline(name), B.nodes.inline(kids), and_l(Bool.and(B.inline(name), B.nodes.inline(kids)), fril(rest), hs)), {==})), {==}),
                    with_il(with, kids, name, no, rest, and_r(Bool.and(B.inline(name), B.nodes.inline(kids)), fril(rest), hs)))),
                hs)

def close_all_il(+st: List<&2, B.Fr>, +i: U32, +hs: {fril(st) == True{} : Bool}) -> {fril(B.close(st, i)) == True{} : Bool}:
  close_il(List.length(&2, B.Fr, st), st, i, hs)

def put_il(st: List<&2, B.Fr>, it: B.Item, +hi: {B.item.inline(it) == True{} : Bool}, +hs: {fril(st) == True{} : Bool}) -> {fril(B.tree.put(st, it)) == True{} : Bool}:
  match it:
    case B.IObj{+abs, +with, +ext, +name, +parents, +no, +ind}:
      and_intro(Bool.and(B.inline(name), True{}), fril(st), and_intro(B.inline(name), True{}, hi, {==}), hs)
    case B.IDef{+share, +upd, +name, +rest, +params, +body, +no, +ind, +what}:
      into_il(st, B.NDef{share, upd, name, rest, params, B.toks.lines(body), no, ind, what},
        and_intro(Bool.and(Bool.and(B.inline(name), B.inline(rest)), B.bls.inline(B.toks.lines(body))), True{},
          and_intro(Bool.and(B.inline(name), B.inline(rest)), B.bls.inline(B.toks.lines(body)),
            and_l(Bool.and(B.inline(name), B.inline(rest)), B.lns.inline(body), hi),
            tln_il(body, and_r(Bool.and(B.inline(name), B.inline(rest)), B.lns.inline(body), hi))), {==}), hs)
    case B.IImport{+txt, +no, +ind}:
      into_il(st, B.NImport{txt, no}, and_intro(B.inline(txt), True{}, hi, {==}), hs)
    case B.IDecl{+names, +no, +ind}:
      into_il(st, B.NDecl{names, no}, {==}, hs)
    case B.IBad{+txt, +no, +ind}:
      into_il(st, B.NBad{txt, no}, {==}, hs)
    case B.IBend{+lines, +no, +ind}:
      into_il(st, B.NBend{lines, no}, {==}, hs)

def tree_go_il(its: List<&2, B.Item>, +st: List<&2, B.Fr>, +hi: {B.items.inline(its) == True{} : Bool}, +hs: {fril(st) == True{} : Bool}) ->
    {fril(B.tree.go(its, st)) == True{} : Bool}:
  match its:
    case Nil{}:
      close_all_il(st, 0, hs)
    case Con{it, +t}:
      match it:
        case B.IImport{+txt, +no, +ind}:
          tree_go_il(t, B.tree.put(B.close(st, ind), B.IImport{txt, no, ind}), and_r(B.item.inline(B.IImport{txt, no, ind}), B.items.inline(t), hi),
            put_il(B.close(st, ind), B.IImport{txt, no, ind}, and_l(B.item.inline(B.IImport{txt, no, ind}), B.items.inline(t), hi), close_all_il(st, ind, hs)))
        case B.IObj{+abs, +with, +ext, +name, +parents, +no, +ind}:
          tree_go_il(t, B.tree.put(B.close(st, ind), B.IObj{abs, with, ext, name, parents, no, ind}), and_r(B.item.inline(B.IObj{abs, with, ext, name, parents, no, ind}), B.items.inline(t), hi),
            put_il(B.close(st, ind), B.IObj{abs, with, ext, name, parents, no, ind}, and_l(B.item.inline(B.IObj{abs, with, ext, name, parents, no, ind}), B.items.inline(t), hi), close_all_il(st, ind, hs)))
        case B.IDecl{+names, +no, +ind}:
          tree_go_il(t, B.tree.put(B.close(st, ind), B.IDecl{names, no, ind}), and_r(B.item.inline(B.IDecl{names, no, ind}), B.items.inline(t), hi),
            put_il(B.close(st, ind), B.IDecl{names, no, ind}, and_l(B.item.inline(B.IDecl{names, no, ind}), B.items.inline(t), hi), close_all_il(st, ind, hs)))
        case B.IDef{+share, +upd, +name, +rest, +params, +body, +no, +ind, +what}:
          tree_go_il(t, B.tree.put(B.close(st, ind), B.IDef{share, upd, name, rest, params, body, no, ind, what}), and_r(B.item.inline(B.IDef{share, upd, name, rest, params, body, no, ind, what}), B.items.inline(t), hi),
            put_il(B.close(st, ind), B.IDef{share, upd, name, rest, params, body, no, ind, what}, and_l(B.item.inline(B.IDef{share, upd, name, rest, params, body, no, ind, what}), B.items.inline(t), hi), close_all_il(st, ind, hs)))
        case B.IBad{+txt, +no, +ind}:
          tree_go_il(t, B.tree.put(B.close(st, ind), B.IBad{txt, no, ind}), and_r(B.item.inline(B.IBad{txt, no, ind}), B.items.inline(t), hi),
            put_il(B.close(st, ind), B.IBad{txt, no, ind}, and_l(B.item.inline(B.IBad{txt, no, ind}), B.items.inline(t), hi), close_all_il(st, ind, hs)))
        case B.IBend{+lines, +no, +ind}:
          tree_go_il(t, B.tree.put(B.close(st, ind), B.IBend{lines, no, ind}), and_r(B.item.inline(B.IBend{lines, no, ind}), B.items.inline(t), hi),
            put_il(B.close(st, ind), B.IBend{lines, no, ind}, and_l(B.item.inline(B.IBend{lines, no, ind}), B.items.inline(t), hi), close_all_il(st, ind, hs)))

def fin_il(st: List<&2, B.Fr>, +hs: {fril(st) == True{} : Bool}) -> {B.nodes.inline(B.tree.fin(st)) == True{} : Bool}:
  match st:
    case Nil{}:
      {==}
    case Con{f, +rest}:
      match f:
        case B.Fr{+top, +ind, +abs, +with, +ext, +name, +parents, +kids, +no}:
          nrev_il(kids, Nil{}, and_r(B.inline(name), B.nodes.inline(kids), and_l(Bool.and(B.inline(name), B.nodes.inline(kids)), fril(rest), hs)), {==})

def Laws.inline.tree(its, h):
  fin_il(B.tree.go(its, [B.Fr{True{}, 0, False{}, True{}, False{}, Nil{}, Nil{}, Nil{}, B.loc.top(0)}]), tree_go_il(its, [B.Fr{True{}, 0, False{}, True{}, False{}, Nil{}, Nil{}, Nil{}, B.loc.top(0)}], h, {==}))

def Laws.inline.read(bs, base):
  Laws.inline.tree(B.flat(B.lines.at(bs, base)), Laws.inline.items(B.lines.at(bs, base), Laws.inline.lines(bs, base)))

# The objects' paths within a line (`inline.objects`): the nodes law's
# walk, its mirrors reused, each path made of names and paths that are

def ils_app(a: List<&2, List<&2, U32>>, +b: List<&2, List<&2, U32>>, +ha: {B.inlines(a) == True{} : Bool}, +hb: {B.inlines(b) == True{} : Bool}) ->
    {B.inlines(List.append(&2, List<&2, U32>, a, b)) == True{} : Bool}:
  match a:
    case Nil{}:
      hb
    case Con{+x, +t}:
      and_intro(B.inline(x), B.inlines(List.append(&2, List<&2, U32>, t, b)), and_l(B.inline(x), B.inlines(t), ha), ils_app(t, b, and_r(B.inline(x), B.inlines(t), ha), hb))

def ils_one(+x: List<&2, U32>, +h: {B.inline(x) == True{} : Bool}) -> {B.inlines([x]) == True{} : Bool}:
  and_intro(B.inline(x), True{}, h, {==})

def il_lgo(xs: List<&2, List<&2, U32>>, +last: List<&2, U32>, +hx: {B.inlines(xs) == True{} : Bool}, +hl: {B.inline(last) == True{} : Bool}) ->
    {B.inline(List.last.go(&2, List<&2, U32>, xs, last)) == True{} : Bool}:
  match xs:
    case Nil{}:
      hl
    case Con{+x, +t}:
      il_lgo(t, x, and_r(B.inline(x), B.inlines(t), hx), and_l(B.inline(x), B.inlines(t), hx))

def il_plast(ps: List<&2, List<&2, U32>>, +h: {B.inlines(ps) == True{} : Bool}) -> {B.inline(B.path.last(ps)) == True{} : Bool}:
  match ps:
    case Nil{}:
      {==}
    case Con{+p, +t}:
      il_lgo(t, p, and_r(B.inline(p), B.inlines(t), h), and_l(B.inline(p), B.inlines(t), h))

def mnik(+c: Bool, +path: List<&2, List<&2, U32>>, +t: List<&2, B.Ob>, +q: U32) -> List<&2, List<&2, U32>>:
  B.when(List<&2, List<&2, U32>>, c, u => Con{B.path.last(path), B.mixin.names.in(t, q)}, u => B.mixin.names.in(t, q))

def mni_k(c: Bool, +path: List<&2, List<&2, U32>>, +t: List<&2, B.Ob>, +q: U32, +hp: {B.inlines(path) == True{} : Bool},
    +ih: {B.inlines(B.mixin.names.in(t, q)) == True{} : Bool}) -> {B.inlines(mnik(c, path, t, q)) == True{} : Bool}:
  match c:
    case True{}:
      and_intro(B.inline(B.path.last(path)), B.inlines(B.mixin.names.in(t, q)), il_plast(path, hp), ih)
    case False{}:
      ih

def mni_il(os: List<&2, B.Ob>, +q: U32, +h: {B.obs.inline(os) == True{} : Bool}) -> {B.inlines(B.mixin.names.in(os, q)) == True{} : Bool}:
  match os:
    case Nil{}:
      {==}
    case Con{o, +t}:
      match o:
        case B.Ob{+id, +host, +path, +abs, parents, mems, +no, +kind, +tpl}:
          mni_k(Bool.and(Bool.and(U32.is_eq(host, q), Bool.not(B.is.object(kind))), U32.is_eq(tpl, id)), path, t, q,
            and_l(B.inlines(path), B.obs.inline(t), h), mni_il(t, q, and_r(B.inlines(path), B.obs.inline(t), h)))

def nfk(+c: Bool, +n: List<&2, U32>, +t: List<&2, List<&2, U32>>, +seen: List<&2, List<&2, U32>>, +acc: List<&2, List<&2, U32>>) -> List<&2, List<&2, U32>>:
  B.when(List<&2, List<&2, U32>>, c, u => B.names.fresh(t, seen, acc), u => Con{n, B.names.fresh(t, seen, Con{n, acc})})

def nf_k_o(c: Bool, +n: List<&2, U32>, +t: List<&2, List<&2, U32>>, +seen: List<&2, List<&2, U32>>, +acc: List<&2, List<&2, U32>>, +hn: {B.inline(n) == True{} : Bool},
    ih1: {B.inlines(B.names.fresh(t, seen, acc)) == True{} : Bool}, ih2: {B.inlines(B.names.fresh(t, seen, Con{n, acc})) == True{} : Bool}) ->
    {B.inlines(nfk(c, n, t, seen, acc)) == True{} : Bool}:
  match c:
    case True{}:
      ih1
    case False{}:
      and_intro(B.inline(n), B.inlines(B.names.fresh(t, seen, Con{n, acc})), hn, ih2)

def nf_il(ns: List<&2, List<&2, U32>>, +seen: List<&2, List<&2, U32>>, +acc: List<&2, List<&2, U32>>, +h: {B.inlines(ns) == True{} : Bool}) ->
    {B.inlines(B.names.fresh(ns, seen, acc)) == True{} : Bool}:
  match ns:
    case Nil{}:
      {==}
    case Con{+n, +t}:
      nf_k_o(Bool.or(B.names.has(seen, n), B.names.has(acc, n)), n, t, seen, acc, and_l(B.inline(n), B.inlines(t), h),
        nf_il(t, seen, acc, and_r(B.inline(n), B.inlines(t), h)), nf_il(t, seen, Con{n, acc}, and_r(B.inline(n), B.inlines(t), h)))

def mn_il(qs: List<&2, U32>, +obs: List<&2, B.Ob>, +seen: List<&2, List<&2, U32>>, +hobs: {B.obs.inline(obs) == True{} : Bool}) ->
    {B.inlines(B.mixin.names(qs, obs, seen)) == True{} : Bool}:
  match qs:
    case Nil{}:
      {==}
    case Con{+q, +t}:
      ils_app(B.names.fresh(B.mixin.names.in(obs, B.ob.tpl(B.ob.at(obs, q))), seen, Nil{}),
        B.mixin.names(t, obs, List.append(&2, List<&2, U32>, B.names.fresh(B.mixin.names.in(obs, B.ob.tpl(B.ob.at(obs, q))), seen, Nil{}), seen)),
        nf_il(B.mixin.names.in(obs, B.ob.tpl(B.ob.at(obs, q))), seen, Nil{}, mni_il(obs, B.ob.tpl(B.ob.at(obs, q)), hobs)),
        mn_il(t, obs, List.append(&2, List<&2, U32>, B.names.fresh(B.mixin.names.in(obs, B.ob.tpl(B.ob.at(obs, q))), seen, Nil{}), seen), hobs))

def wfil(st: List<&2, B.Wf>) -> Bool:
  match st:
    case Nil{}:
      True{}
    case Con{f, t}:
      match f:
        case B.Wf{+host, path, nodes}:
          Bool.and(Bool.and(B.inlines(path), B.nodes.inline(nodes)), wfil(t))

def wf_on(+host: U32, +path: List<&2, List<&2, U32>>, +t: List<&2, B.Node>, +rest: List<&2, B.Wf>, +hp: {B.inlines(path) == True{} : Bool},
    +ht: {B.nodes.inline(t) == True{} : Bool}, +hr: {wfil(rest) == True{} : Bool}) -> {wfil(Con{B.Wf{host, path, t}, rest}) == True{} : Bool}:
  and_intro(Bool.and(B.inlines(path), B.nodes.inline(t)), wfil(rest), and_intro(B.inlines(path), B.nodes.inline(t), hp, ht), hr)

def wf_p(+host: U32, +path: List<&2, List<&2, U32>>, +ns: List<&2, B.Node>, +rest: List<&2, B.Wf>, +h: {wfil(Con{B.Wf{host, path, ns}, rest}) == True{} : Bool}) ->
    {B.inlines(path) == True{} : Bool}:
  and_l(B.inlines(path), B.nodes.inline(ns), and_l(Bool.and(B.inlines(path), B.nodes.inline(ns)), wfil(rest), h))

def wf_n(+host: U32, +path: List<&2, List<&2, U32>>, +ns: List<&2, B.Node>, +rest: List<&2, B.Wf>, +h: {wfil(Con{B.Wf{host, path, ns}, rest}) == True{} : Bool}) ->
    {B.nodes.inline(ns) == True{} : Bool}:
  and_r(B.inlines(path), B.nodes.inline(ns), and_l(Bool.and(B.inlines(path), B.nodes.inline(ns)), wfil(rest), h))

def wf_r(+host: U32, +path: List<&2, List<&2, U32>>, +ns: List<&2, B.Node>, +rest: List<&2, B.Wf>, +h: {wfil(Con{B.Wf{host, path, ns}, rest}) == True{} : Bool}) ->
    {wfil(rest) == True{} : Bool}:
  and_r(Bool.and(B.inlines(path), B.nodes.inline(ns)), wfil(rest), h)

# the objects walked: each one's path its host's and its name
def og_il(n: Nat, st: List<&2, B.Wf>, +next: U32, +out: List<&2, B.Ob>, +hs: {wfil(st) == True{} : Bool}, +ho: {B.obs.inline(out) == True{} : Bool}) ->
    {B.obs.inline(B.obs.go(n, st, next, out)) == True{} : Bool}:
  match n:
    case 0n:
      ho
    case 1n+(+k):
      match st:
        case Nil{}:
          ho
        case Con{f, +rest}:
          match f:
            case B.Wf{+host, +path, nodes}:
              match nodes:
                case Nil{}:
                  og_il(k, rest, next, out, wf_r(host, path, Nil{}, rest, hs), ho)
                case Con{nd, +t}:
                  match nd:
                    case B.NObj{+abs, +ext, +name, +parents, +kids, +no}:
                      +hn = wf_n(host, path, Con{B.NObj{abs, ext, name, parents, kids, no}, t}, rest, hs)
                      +hpn = ils_app(path, [name], wf_p(host, path, Con{B.NObj{abs, ext, name, parents, kids, no}, t}, rest, hs),
                        ils_one(name, and_l(B.inline(name), B.nodes.inline(kids), and_l(Bool.and(B.inline(name), B.nodes.inline(kids)), B.nodes.inline(t), hn))))
                      og_il(k, Con{B.Wf{next, List.append(&2, List<&2, U32>, path, [name]), kids}, Con{B.Wf{host, path, t}, rest}}, U32.add(next, 1),
                        Con{B.Ob{next, host, List.append(&2, List<&2, U32>, path, [name]), abs, parents, kids, no, B.ob.kind.of(ext, path), next}, out},
                        wf_on(next, List.append(&2, List<&2, U32>, path, [name]), kids, Con{B.Wf{host, path, t}, rest}, hpn,
                          and_r(B.inline(name), B.nodes.inline(kids), and_l(Bool.and(B.inline(name), B.nodes.inline(kids)), B.nodes.inline(t), hn)),
                          wf_on(host, path, t, rest, wf_p(host, path, Con{B.NObj{abs, ext, name, parents, kids, no}, t}, rest, hs),
                            and_r(Bool.and(B.inline(name), B.nodes.inline(kids)), B.nodes.inline(t), hn), wf_r(host, path, Con{B.NObj{abs, ext, name, parents, kids, no}, t}, rest, hs))),
                        and_intro(B.inlines(List.append(&2, List<&2, U32>, path, [name])), B.obs.inline(out), hpn, ho))
                    case B.NDef{+share, +upd, +name, +rest2, +params, +body, +no, +ind, +what}:
                      og_il(k, Con{B.Wf{host, path, t}, rest}, next, out,
                        wf_on(host, path, t, rest, wf_p(host, path, Con{B.NDef{share, upd, name, rest2, params, body, no, ind, what}, t}, rest, hs),
                          and_r(Bool.and(Bool.and(B.inline(name), B.inline(rest2)), B.bls.inline(body)), B.nodes.inline(t),
                            wf_n(host, path, Con{B.NDef{share, upd, name, rest2, params, body, no, ind, what}, t}, rest, hs)),
                          wf_r(host, path, Con{B.NDef{share, upd, name, rest2, params, body, no, ind, what}, t}, rest, hs)), ho)
                    case B.NImport{+txt, +no}:
                      og_il(k, Con{B.Wf{host, path, t}, rest}, next, out,
                        wf_on(host, path, t, rest, wf_p(host, path, Con{B.NImport{txt, no}, t}, rest, hs),
                          and_r(B.inline(txt), B.nodes.inline(t), wf_n(host, path, Con{B.NImport{txt, no}, t}, rest, hs)), wf_r(host, path, Con{B.NImport{txt, no}, t}, rest, hs)), ho)
                    case B.NDecl{+names, +no}:
                      og_il(k, Con{B.Wf{host, path, t}, rest}, next, out, hs, ho)
                    case B.NBad{+txt, +no}:
                      og_il(k, Con{B.Wf{host, path, t}, rest}, next, out, hs, ho)
                    case B.NErr{+msg, +no}:
                      og_il(k, Con{B.Wf{host, path, t}, rest}, next, out, hs, ho)
                    case B.NBend{+lines, +no}:
                      og_il(k, Con{B.Wf{host, path, t}, rest}, next, out, hs, ho)

def obs_rgo(xs: List<&2, B.Ob>, +acc: List<&2, B.Ob>, +hx: {B.obs.inline(xs) == True{} : Bool}, +ha: {B.obs.inline(acc) == True{} : Bool}) ->
    {B.obs.inline(List.reverse.go(&2, B.Ob, xs, acc)) == True{} : Bool}:
  match xs:
    case Nil{}:
      ha
    case Con{+o, +t}:
      obs_rgo(t, Con{o, acc}, and_r(B.ob.inline(o), B.obs.inline(t), hx), and_intro(B.ob.inline(o), B.obs.inline(acc), and_l(B.ob.inline(o), B.obs.inline(t), hx), ha))

def obs_app(xs: List<&2, B.Ob>, +b: List<&2, B.Ob>, +hx: {B.obs.inline(xs) == True{} : Bool}, +hb: {B.obs.inline(b) == True{} : Bool}) ->
    {B.obs.inline(List.append(&2, B.Ob, xs, b)) == True{} : Bool}:
  match xs:
    case Nil{}:
      hb
    case Con{+o, +t}:
      and_intro(B.ob.inline(o), B.obs.inline(List.append(&2, B.Ob, t, b)), and_l(B.ob.inline(o), B.obs.inline(t), hx), obs_app(t, b, and_r(B.ob.inline(o), B.obs.inline(t), hx), hb))

def mods_il(ts: List<&2, List<&2, B.Node>>, +k: U32, +out: List<&2, B.Ob>, +ht: {B.trees.inline(ts) == True{} : Bool}, +ho: {B.obs.inline(out) == True{} : Bool}) ->
    {B.obs.inline(B.obs.mods(ts, k, out)) == True{} : Bool}:
  match ts:
    case Nil{}:
      ho
    case Con{+tr, +t}:
      mods_il(t, U32.add(k, 1), B.obs.mod(tr, k, out), and_r(B.nodes.inline(tr), B.trees.inline(t), ht),
        og_il(B.wf.turns([B.Wf{U32.from_nat(List.length(&2, B.Ob, out)), Nil{}, tr}]), [B.Wf{U32.from_nat(List.length(&2, B.Ob, out)), Nil{}, tr}], U32.add(U32.from_nat(List.length(&2, B.Ob, out)), 1),
          Con{B.Ob{U32.from_nat(List.length(&2, B.Ob, out)), U32.from_nat(List.length(&2, B.Ob, out)), Nil{}, False{}, Nil{}, tr, B.loc.top(k), 0,
            U32.from_nat(List.length(&2, B.Ob, out))}, out},
          wf_on(U32.from_nat(List.length(&2, B.Ob, out)), Nil{}, tr, Nil{}, {==}, and_l(B.nodes.inline(tr), B.trees.inline(t), ht), {==}), ho))

def obs_il(+trees: List<&2, List<&2, B.Node>>, +h: {B.trees.inline(trees) == True{} : Bool}) -> {B.obs.inline(B.obs(trees)) == True{} : Bool}:
  obs_rgo(B.obs.mods(trees, 0, Nil{}), Nil{}, mods_il(trees, 0, Nil{}, h, {==}), {==})

def sxi_k(c: Bool, +n: List<&2, U32>, +t: List<&2, List<&2, U32>>, +x: U32, +obs: List<&2, B.Ob>, +made: List<&2, B.Ob>, +next: U32,
    ih1: {B.obs.inline(B.syn.x(t, x, obs, made, next)) == True{} : Bool},
    ih2: {B.obs.inline(B.syn.x(t, x, obs, Con{B.Ob{next, x, List.append(&2, List<&2, U32>, B.ob.path(B.ob.at(obs, x)), [n]), B.ob.abs(B.ob.at(obs, x)), Nil{}, Nil{}, B.ob.no(B.ob.at(obs, x)), 3, next}, made}, U32.add(next, 1))) == True{} : Bool}) ->
    {B.obs.inline(sxk(c, n, t, x, obs, made, next)) == True{} : Bool}:
  match c:
    case True{}:
      ih1
    case False{}:
      ih2

# a round's made objects: each its host's path and a mixin's name
def sx_il(ns: List<&2, List<&2, U32>>, +x: U32, +obs: List<&2, B.Ob>, +made: List<&2, B.Ob>, +next: U32, +hn: {B.inlines(ns) == True{} : Bool},
    +hobs: {B.obs.inline(obs) == True{} : Bool}, +hm: {B.obs.inline(made) == True{} : Bool}) -> {B.obs.inline(B.syn.x(ns, x, obs, made, next)) == True{} : Bool}:
  match ns:
    case Nil{}:
      hm
    case Con{+n, +t}:
      sxi_k(Bool.or(B.made.has(obs, x, n), B.made.has(made, x, n)), n, t, x, obs, made, next,
        sx_il(t, x, obs, made, next, and_r(B.inline(n), B.inlines(t), hn), hobs, hm),
        sx_il(t, x, obs, Con{B.Ob{next, x, List.append(&2, List<&2, U32>, B.ob.path(B.ob.at(obs, x)), [n]), B.ob.abs(B.ob.at(obs, x)), Nil{}, Nil{}, B.ob.no(B.ob.at(obs, x)), 3, next}, made},
          U32.add(next, 1), and_r(B.inline(n), B.inlines(t), hn), hobs,
          and_intro(B.inlines(List.append(&2, List<&2, U32>, B.ob.path(B.ob.at(obs, x)), [n])), B.obs.inline(made),
            ils_app(B.ob.path(B.ob.at(obs, x)), [n], il_at(obs, x, hobs), ils_one(n, and_l(B.inline(n), B.inlines(t), hn))), hm)))

def sri_k(c: Bool, +id: U32, +t: List<&2, B.Ob>, +obs: List<&2, B.Ob>, +ls: List<&2, Maybe<&2, B.Lz>>, +made: List<&2, B.Ob>,
    ih1: {B.obs.inline(B.syn.round(t, obs, ls, B.syn.x(B.mixin.names(B.lz.ord(B.lz.at(ls, id)), obs, Nil{}), id, obs, made, U32.add(U32.from_nat(List.length(&2, B.Ob, obs)), U32.from_nat(List.length(&2, B.Ob, made)))))) == True{} : Bool},
    ih2: {B.obs.inline(B.syn.round(t, obs, ls, made)) == True{} : Bool}) -> {B.obs.inline(srk(c, id, t, obs, ls, made)) == True{} : Bool}:
  match c:
    case True{}:
      ih1
    case False{}:
      ih2

def sr_il(os: List<&2, B.Ob>, +obs: List<&2, B.Ob>, +ls: List<&2, Maybe<&2, B.Lz>>, +made: List<&2, B.Ob>, +hobs: {B.obs.inline(obs) == True{} : Bool},
    +hm: {B.obs.inline(made) == True{} : Bool}) -> {B.obs.inline(B.syn.round(os, obs, ls, made)) == True{} : Bool}:
  match os:
    case Nil{}:
      hm
    case Con{o, +t}:
      match o:
        case B.Ob{+id, +host, path, +abs, parents, mems, +no, +kind, +tpl}:
          sri_k(Bool.and(B.is.object(kind), Bool.not(U32.is_eq(id, host))), id, t, obs, ls, made,
            sr_il(t, obs, ls, B.syn.x(B.mixin.names(B.lz.ord(B.lz.at(ls, id)), obs, Nil{}), id, obs, made, U32.add(U32.from_nat(List.length(&2, B.Ob, obs)), U32.from_nat(List.length(&2, B.Ob, made)))), hobs,
              sx_il(B.mixin.names(B.lz.ord(B.lz.at(ls, id)), obs, Nil{}), id, obs, made, U32.add(U32.from_nat(List.length(&2, B.Ob, obs)), U32.from_nat(List.length(&2, B.Ob, made))),
                mn_il(B.lz.ord(B.lz.at(ls, id)), obs, Nil{}, hobs), hobs, hm)),
            sr_il(t, obs, ls, made, hobs, hm))

def cti_k(c: Bool, +t: U32, +r: List<&2, U32>, +x: U32, +obs: List<&2, B.Ob>, +made: List<&2, B.Ob>, +next: U32,
    ih1: {B.obs.inline(B.copies.t(r, x, obs, made, next)) == True{} : Bool},
    ih2: {B.obs.inline(B.copies.t(r, x, obs, Con{B.Ob{next, x, B.ob.path(B.ob.at(obs, t)), B.ob.abs(B.ob.at(obs, t)), Nil{}, B.ob.mems(B.ob.at(obs, t)), B.ob.no(B.ob.at(obs, t)), B.ob.kind(B.ob.at(obs, t)), t}, made}, U32.add(next, 1))) == True{} : Bool}) ->
    {B.obs.inline(ctk(c, t, r, x, obs, made, next)) == True{} : Bool}:
  match c:
    case True{}:
      ih1
    case False{}:
      ih2

# a mixin's bound copies: its path
def ct_il(ts: List<&2, U32>, +x: U32, +obs: List<&2, B.Ob>, +made: List<&2, B.Ob>, +next: U32, +hobs: {B.obs.inline(obs) == True{} : Bool},
    +hm: {B.obs.inline(made) == True{} : Bool}) -> {B.obs.inline(B.copies.t(ts, x, obs, made, next)) == True{} : Bool}:
  match ts:
    case Nil{}:
      hm
    case Con{+t, +r}:
      cti_k(B.copy.has(obs, made, t, x), t, r, x, obs, made, next, ct_il(r, x, obs, made, next, hobs, hm),
        ct_il(r, x, obs, Con{B.Ob{next, x, B.ob.path(B.ob.at(obs, t)), B.ob.abs(B.ob.at(obs, t)), Nil{}, B.ob.mems(B.ob.at(obs, t)), B.ob.no(B.ob.at(obs, t)), B.ob.kind(B.ob.at(obs, t)), t}, made},
          U32.add(next, 1), hobs, and_intro(B.inlines(B.ob.path(B.ob.at(obs, t))), B.obs.inline(made), il_at(obs, t, hobs), hm)))

def sci_k(c: Bool, +host: U32, +path: List<&2, List<&2, U32>>, +t: List<&2, B.Ob>, +obs: List<&2, B.Ob>, +ls: List<&2, Maybe<&2, B.Lz>>, +made: List<&2, B.Ob>,
    ih1: {B.obs.inline(B.syn.copies(t, obs, ls, B.copies.t(B.mixins.of(B.lz.ord(B.lz.at(ls, host)), obs, B.path.last(path)), host, obs, made, U32.add(U32.from_nat(List.length(&2, B.Ob, obs)), U32.from_nat(List.length(&2, B.Ob, made)))))) == True{} : Bool},
    ih2: {B.obs.inline(B.syn.copies(t, obs, ls, made)) == True{} : Bool}) -> {B.obs.inline(sck(c, host, path, t, obs, ls, made)) == True{} : Bool}:
  match c:
    case True{}:
      ih1
    case False{}:
      ih2

def sc_il(os: List<&2, B.Ob>, +obs: List<&2, B.Ob>, +ls: List<&2, Maybe<&2, B.Lz>>, +made: List<&2, B.Ob>, +hobs: {B.obs.inline(obs) == True{} : Bool},
    +hm: {B.obs.inline(made) == True{} : Bool}) -> {B.obs.inline(B.syn.copies(os, obs, ls, made)) == True{} : Bool}:
  match os:
    case Nil{}:
      hm
    case Con{o, +t}:
      match o:
        case B.Ob{+id, +host, +path, +abs, parents, mems, +no, +kind, +tpl}:
          sci_k(U32.is_eq(kind, 3), host, path, t, obs, ls, made,
            sc_il(t, obs, ls, B.copies.t(B.mixins.of(B.lz.ord(B.lz.at(ls, host)), obs, B.path.last(path)), host, obs, made, U32.add(U32.from_nat(List.length(&2, B.Ob, obs)), U32.from_nat(List.length(&2, B.Ob, made)))), hobs,
              ct_il(B.mixins.of(B.lz.ord(B.lz.at(ls, host)), obs, B.path.last(path)), host, obs, made, U32.add(U32.from_nat(List.length(&2, B.Ob, obs)), U32.from_nat(List.length(&2, B.Ob, made))), hobs, hm)),
            sc_il(t, obs, ls, made, hobs, hm))

def sgi_k(c: Bool, +k: Nat, +als: List<&2, B.Al>, +obs: List<&2, B.Ob>, +npss: List<&2, List<&2, U32>>, +nls: List<&2, Maybe<&2, B.Lz>>, +made: List<&2, B.Ob>,
    +h: {B.obs.inline(obs) == True{} : Bool}, ih: {B.obs.inline(B.sy.obs(B.syn.go(k, als, List.append(&2, B.Ob, obs, List.reverse(&2, B.Ob, made)), npss, nls))) == True{} : Bool}) ->
    {B.obs.inline(B.sy.obs(sgk(c, k, als, obs, npss, nls, made))) == True{} : Bool}:
  match c:
    case True{}:
      h
    case False{}:
      ih

# the made objects' rounds keep every object's path within a line
def sg_il(n: Nat, +als: List<&2, B.Al>, +obs: List<&2, B.Ob>, +pss: List<&2, List<&2, U32>>, +ls: List<&2, Maybe<&2, B.Lz>>, +h: {B.obs.inline(obs) == True{} : Bool}) ->
    {B.obs.inline(B.sy.obs(B.syn.go(n, als, obs, pss, ls))) == True{} : Bool}:
  match n:
    case 0n:
      h
    case 1n+(+k):
      sgi_k(Bool.and(B.obs.none(B.syn.copies(obs, obs, B.lins(B.pids(obs, als, obs, ls)), B.syn.round(obs, obs, B.lins(B.pids(obs, als, obs, ls)), Nil{}))), B.pss.eq(B.pids(obs, als, obs, ls), pss)), k, als, obs, B.pids(obs, als, obs, ls), B.lins(B.pids(obs, als, obs, ls)), B.syn.copies(obs, obs, B.lins(B.pids(obs, als, obs, ls)), B.syn.round(obs, obs, B.lins(B.pids(obs, als, obs, ls)), Nil{})), h,
        sg_il(k, als, List.append(&2, B.Ob, obs, List.reverse(&2, B.Ob, B.syn.copies(obs, obs, B.lins(B.pids(obs, als, obs, ls)), B.syn.round(obs, obs, B.lins(B.pids(obs, als, obs, ls)), Nil{})))), B.pids(obs, als, obs, ls), B.lins(B.pids(obs, als, obs, ls)),
          obs_app(obs, List.reverse(&2, B.Ob, B.syn.copies(obs, obs, B.lins(B.pids(obs, als, obs, ls)), B.syn.round(obs, obs, B.lins(B.pids(obs, als, obs, ls)), Nil{}))), h,
            obs_rgo(B.syn.copies(obs, obs, B.lins(B.pids(obs, als, obs, ls)), B.syn.round(obs, obs, B.lins(B.pids(obs, als, obs, ls)), Nil{})), Nil{},
              sc_il(obs, obs, B.lins(B.pids(obs, als, obs, ls)), B.syn.round(obs, obs, B.lins(B.pids(obs, als, obs, ls)), Nil{}), h, sr_il(obs, obs, B.lins(B.pids(obs, als, obs, ls)), Nil{}, h, {==})), {==}))))

def ma_il(os: List<&2, B.Ob>, +obs: List<&2, B.Ob>, +pss: List<&2, List<&2, U32>>, +h: {B.obs.inline(os) == True{} : Bool}) -> {B.obs.inline(B.made.abs(os, obs, pss)) == True{} : Bool}:
  match os:
    case Nil{}:
      {==}
    case Con{o, +t}:
      match o:
        case B.Ob{+id, +host, +path, +abs, parents, +mems, +no, +kind, +tpl}:
          and_intro(B.inlines(path), B.obs.inline(B.made.abs(t, obs, pss)), and_l(B.inlines(path), B.obs.inline(t), h),
            ma_il(t, obs, pss, and_r(B.inlines(path), B.obs.inline(t), h)))

def Laws.inline.objects(trees, als, h):
  ma_il(B.sy.obs(B.syn.of(als, B.obs(trees))), B.sy.obs(B.syn.of(als, B.obs(trees))), B.sy.pss(B.syn.of(als, B.obs(trees))),
    sg_il(Nat.add(2n, Nat.add(List.length(&2, B.Ob, B.obs(trees)), List.length(&2, B.Ob, B.obs(trees)))), als, B.obs(trees), Nil{}, Nil{}, obs_il(trees, h)))

# The units' texts within a line (`inline.units`): each unit's definition
# one the trees hold (`nodes`), so within a line; resolution keeping a
# token as written, or naming parts of its text; the copies' loop, its
# names the folds' or a prior's token's.

def inil(i: B.In) -> Bool:
  match i:
    case B.In{name, +q, +prior}:
      B.inline(name)

def insil(xs: List<&2, B.In>) -> Bool:
  match xs:
    case Nil{}:
      True{}
    case Con{i, t}:
      Bool.and(inil(i), insil(t))

def rril(r: B.Rr) -> Bool:
  match r:
    case B.Rr{rt, ers, ins}:
      Bool.and(B.rt.inline(rt), insil(ins))

def il_ldrop(xs: List<&2, U32>, n: Nat, +h: {B.inline(xs) == True{} : Bool}) -> {B.inline(List.drop(&2, U32, xs, n)) == True{} : Bool}:
  match xs:
    case Nil{}:
      {==}
    case Con{+x, +t}:
      match n:
        case 0n:
          h
        case 1n+(+p):
          il_ldrop(t, p, il_tail(x, t, h))

def ils_ldrop(xs: List<&2, List<&2, U32>>, n: Nat, +h: {B.inlines(xs) == True{} : Bool}) -> {B.inlines(List.drop(&2, List<&2, U32>, xs, n)) == True{} : Bool}:
  match xs:
    case Nil{}:
      {==}
    case Con{+x, +t}:
      match n:
        case 0n:
          h
        case 1n+(+p):
          ils_ldrop(t, p, and_r(B.inline(x), B.inlines(t), h))

def ils_rgo(xs: List<&2, List<&2, U32>>, +acc: List<&2, List<&2, U32>>, +hx: {B.inlines(xs) == True{} : Bool}, +ha: {B.inlines(acc) == True{} : Bool}) ->
    {B.inlines(List.reverse.go(&2, List<&2, U32>, xs, acc)) == True{} : Bool}:
  match xs:
    case Nil{}:
      ha
    case Con{+x, +t}:
      ils_rgo(t, Con{x, acc}, and_r(B.inline(x), B.inlines(t), hx), and_intro(B.inline(x), B.inlines(acc), and_l(B.inline(x), B.inlines(t), hx), ha))

def ptk(+c: Bool, +h: U32, +t: List<&2, U32>, +cur: List<&2, U32>, +out: List<&2, List<&2, U32>>) -> List<&2, List<&2, U32>>:
  B.when(List<&2, List<&2, U32>>, c, u => B.parts.go(t, Nil{}, Con{List.reverse(&2, U32, cur), out}), u => B.parts.go(t, Con{h, cur}, out))

def pt_il(c: Bool, +h: U32, +t: List<&2, U32>, +cur: List<&2, U32>, +out: List<&2, List<&2, U32>>,
    ih1: {B.inlines(B.parts.go(t, Nil{}, Con{List.reverse(&2, U32, cur), out})) == True{} : Bool}, ih2: {B.inlines(B.parts.go(t, Con{h, cur}, out)) == True{} : Bool}) ->
    {B.inlines(ptk(c, h, t, cur, out)) == True{} : Bool}:
  match c:
    case True{}:
      ih1
    case False{}:
      ih2

def pg_ils(xs: List<&2, U32>, +cur: List<&2, U32>, +out: List<&2, List<&2, U32>>, +hx: {B.inline(xs) == True{} : Bool}, +hc: {B.inline(cur) == True{} : Bool},
    +ho: {B.inlines(out) == True{} : Bool}) -> {B.inlines(B.parts.go(xs, cur, out)) == True{} : Bool}:
  match xs:
    case Nil{}:
      ils_rgo(Con{List.reverse(&2, U32, cur), out}, Nil{}, and_intro(B.inline(List.reverse(&2, U32, cur)), B.inlines(out), il_rev(cur, hc), ho), {==})
    case Con{+h, +t}:
      pt_il(U32.is_eq(h, 46), h, t, cur, out,
        pg_ils(t, Nil{}, Con{List.reverse(&2, U32, cur), out}, il_tail(h, t, hx), {==}, and_intro(B.inline(List.reverse(&2, U32, cur)), B.inlines(out), il_rev(cur, hc), ho)),
        pg_ils(t, Con{h, cur}, out, il_tail(h, t, hx), il_cons(h, cur, ne10(h, t, hx), hc), ho))

def ils_parts(+n: List<&2, U32>, +h: {B.inline(n) == True{} : Bool}) -> {B.inlines(B.parts(n)) == True{} : Bool}:
  pg_ils(n, Nil{}, Nil{}, h, {==}, {==})

def tok_il(+t: B.Tok, +ht: {B.inline(B.tok.bytes(t)) == True{} : Bool}) -> {rril(B.rr.tok(t)) == True{} : Bool}:
  and_intro(B.inline(B.tok.bytes(t)), True{}, ht, {==})

def er_il(+t: B.Tok, +no: B.Loc, +msg: String, +ht: {B.inline(B.tok.bytes(t)) == True{} : Bool}) -> {rril(B.rr.er(t, no, msg)) == True{} : Bool}:
  and_intro(B.inline(B.tok.bytes(t)), True{}, ht, {==})

# rr.final's decision mirrored
def rfn_k(+c: Bool, +cx: B.Cx, +obj: U32, +mark: U32, +n: List<&2, U32>, +t: B.Tok, +no: B.Loc) -> B.Rr:
  B.when(B.Rr, c,
    u => B.rr.er(t, no, B.text(B.tok.txt(t)) ++ " names a definition of " ++ B.ob.name(B.cx.obs(cx), obj) ++ ", which is abstract and emits nothing"),
    u => B.Rr{B.RR{mark, B.Rf{obj, n, False{}, obj}}, Nil{}, Nil{}})

def rfn_il(c: Bool, +cx: B.Cx, +obj: U32, +mark: U32, +n: List<&2, U32>, +t: B.Tok, +no: B.Loc, +ht: {B.inline(B.tok.bytes(t)) == True{} : Bool},
    +hn: {B.inline(n) == True{} : Bool}) -> {rril(rfn_k(c, cx, obj, mark, n, t, no)) == True{} : Bool}:
  match c:
    case True{}:
      er_il(t, no, B.text(B.tok.txt(t)) ++ " names a definition of " ++ B.ob.name(B.cx.obs(cx), obj) ++ ", which is abstract and emits nothing", ht)
    case False{}:
      and_intro(B.inline(n), True{}, hn, {==})

def final_il(+cx: B.Cx, +obj: U32, +mark: U32, +n: List<&2, U32>, +t: B.Tok, +no: B.Loc, +ht: {B.inline(B.tok.bytes(t)) == True{} : Bool},
    +hn: {B.inline(n) == True{} : Bool}) -> {rril(B.rr.final(cx, obj, mark, n, t, no)) == True{} : Bool}:
  rfn_il(B.ob.abs(B.ob.at(B.cx.obs(cx), obj)), cx, obj, mark, n, t, no, ht, hn)

# rr.host's decisions mirrored
def rhs_k(+c: Bool, +cx: B.Cx, +h: U32, +n: List<&2, U32>, +t: B.Tok, +whole: List<&2, U32>, +no: B.Loc) -> B.Rr:
  B.when(B.Rr, c, v => B.rr.final(cx, h, 0, n, t, no),
    v => B.rr.er(t, no, B.text(whole) ++ ": " ++ B.ob.name(B.cx.obs(cx), h) ++ " has no " ++ B.text(n)))

def rhs_il(c: Bool, +cx: B.Cx, +h: U32, +n: List<&2, U32>, +t: B.Tok, +whole: List<&2, U32>, +no: B.Loc, +ht: {B.inline(B.tok.bytes(t)) == True{} : Bool},
    +hn: {B.inline(n) == True{} : Bool}) -> {rril(rhs_k(c, cx, h, n, t, whole, no)) == True{} : Bool}:
  match c:
    case True{}:
      final_il(cx, h, 0, n, t, no, ht, hn)
    case False{}:
      er_il(t, no, B.text(whole) ++ ": " ++ B.ob.name(B.cx.obs(cx), h) ++ " has no " ++ B.text(n), ht)

def rhk(+m: Maybe<&2, U32>, +cx: B.Cx, +n: List<&2, U32>, +t: B.Tok, +whole: List<&2, U32>, +no: B.Loc) -> B.Rr:
  B.on.maybe(U32, B.Rr, m, u => B.rr.er(t, no, B.text(whole) ++ " steps out of the module, which has no host"),
    +h => B.when(B.Rr, B.cx.has(cx, h, n), v => B.rr.final(cx, h, 0, n, t, no),
      v => B.rr.er(t, no, B.text(whole) ++ ": " ++ B.ob.name(B.cx.obs(cx), h) ++ " has no " ++ B.text(n))))

def rh_il(m: Maybe<&2, U32>, +cx: B.Cx, +n: List<&2, U32>, +t: B.Tok, +whole: List<&2, U32>, +no: B.Loc, +ht: {B.inline(B.tok.bytes(t)) == True{} : Bool},
    +hn: {B.inline(n) == True{} : Bool}) -> {rril(rhk(m, cx, n, t, whole, no)) == True{} : Bool}:
  match m:
    case None{}:
      er_il(t, no, B.text(whole) ++ " steps out of the module, which has no host", ht)
    case Some{+h}:
      rhs_il(B.cx.has(cx, h, n), cx, h, n, t, whole, no, ht, hn)

def host_il(+cx: B.Cx, +o: U32, +q: U32, +k: Nat, +n: List<&2, U32>, +t: B.Tok, +whole: List<&2, U32>, +no: B.Loc, +ht: {B.inline(B.tok.bytes(t)) == True{} : Bool},
    +hn: {B.inline(n) == True{} : Bool}) -> {rril(B.rr.host(cx, o, q, k, n, t, whole, no)) == True{} : Bool}:
  rh_il(List.get(&2, U32, B.hosts(B.cx.obs(cx), q), Nat.sub(k, 1n)), cx, n, t, whole, no, ht, hn)

# rr.foreign's decisions mirrored
def rfo1(+m: Maybe<&2, List<&2, U32>>, +mark: U32, +n: List<&2, U32>, +t: B.Tok) -> B.Rr:
  B.on.maybe(List<&2, U32>, B.Rr, m, v => B.rr.tok(t),
    +p => B.Rr{B.RX{mark, p, B.drop(1n+List.length(&2, U32, B.List.head.or(B.parts(n))), n)}, Nil{}, Nil{}})

def rfo1_il(m: Maybe<&2, List<&2, U32>>, +mark: U32, +n: List<&2, U32>, +t: B.Tok, +ht: {B.inline(B.tok.bytes(t)) == True{} : Bool},
    +hn: {B.inline(n) == True{} : Bool}) -> {rril(rfo1(m, mark, n, t)) == True{} : Bool}:
  match m:
    case None{}:
      tok_il(t, ht)
    case Some{+p}:
      and_intro(B.inline(B.drop(1n+List.length(&2, U32, B.List.head.or(B.parts(n))), n)), True{},
        il_drop(1n+List.length(&2, U32, B.List.head.or(B.parts(n))), n, hn), {==})

def rfo2(+c: Bool, +cx: B.Cx, +m: U32, +mark: U32, +n: List<&2, U32>, +t: B.Tok) -> B.Rr:
  B.when(B.Rr, c, v => B.Rr{B.RX{mark, B.bendify(B.path.at(B.cx.paths(cx), m), True{}), n}, Nil{}, Nil{}}, v => B.rr.tok(t))

def rfo2_il(c: Bool, +cx: B.Cx, +m: U32, +mark: U32, +n: List<&2, U32>, +t: B.Tok, +ht: {B.inline(B.tok.bytes(t)) == True{} : Bool},
    +hn: {B.inline(n) == True{} : Bool}) -> {rril(rfo2(c, cx, m, mark, n, t)) == True{} : Bool}:
  match c:
    case True{}:
      and_intro(B.inline(n), True{}, hn, {==})
    case False{}:
      tok_il(t, ht)

def rfok(+c: Bool, +cx: B.Cx, +m: U32, +mark: U32, +n: List<&2, U32>, +t: B.Tok) -> B.Rr:
  B.when(B.Rr, c,
    u => B.on.maybe(List<&2, U32>, B.Rr, B.ci.find(B.mod.cis(cx, m), B.List.head.or(B.parts(n))), v => B.rr.tok(t),
      +p => B.Rr{B.RX{mark, p, B.drop(1n+List.length(&2, U32, B.List.head.or(B.parts(n))), n)}, Nil{}, Nil{}}),
    u => B.when(B.Rr, B.names.has(B.tree.types(B.mod.tree(cx, m)), n),
      v => B.Rr{B.RX{mark, B.bendify(B.path.at(B.cx.paths(cx), m), True{}), n}, Nil{}, Nil{}},
      v => B.rr.tok(t)))

def rfok_il(c: Bool, +cx: B.Cx, +m: U32, +mark: U32, +n: List<&2, U32>, +t: B.Tok, +ht: {B.inline(B.tok.bytes(t)) == True{} : Bool},
    +hn: {B.inline(n) == True{} : Bool}) -> {rril(rfok(c, cx, m, mark, n, t)) == True{} : Bool}:
  match c:
    case True{}:
      rfo1_il(B.ci.find(B.mod.cis(cx, m), B.List.head.or(B.parts(n))), mark, n, t, ht, hn)
    case False{}:
      rfo2_il(B.names.has(B.tree.types(B.mod.tree(cx, m)), n), cx, m, mark, n, t, ht, hn)

def foreign_il(+cx: B.Cx, +m: U32, +mark: U32, +n: List<&2, U32>, +t: B.Tok, +ht: {B.inline(B.tok.bytes(t)) == True{} : Bool},
    +hn: {B.inline(n) == True{} : Bool}) -> {rril(B.rr.foreign(cx, m, mark, n, t)) == True{} : Bool}:
  rfok_il(Bool.not(B.blank.parts(List.tail(&2, List<&2, U32>, B.parts(n)))), cx, m, mark, n, t, ht, hn)

# rr.bend's decisions mirrored
def rbs_k(+c: Bool, +n: List<&2, U32>, +t: B.Tok, +no: B.Loc) -> B.Rr:
  B.when(B.Rr, c, v => B.rr.er(t, no, B.text(n) ++ ": names beginning Blend_ are Blend's own"), v => B.rr.tok(t))

def rbs_il(c: Bool, +n: List<&2, U32>, +t: B.Tok, +no: B.Loc, +ht: {B.inline(B.tok.bytes(t)) == True{} : Bool}) -> {rril(rbs_k(c, n, t, no)) == True{} : Bool}:
  match c:
    case True{}:
      er_il(t, no, B.text(n) ++ ": names beginning Blend_ are Blend's own", ht)
    case False{}:
      tok_il(t, ht)

def rbd_k(+c: Bool, +cx: B.Cx, +q: U32, +mark: U32, +n: List<&2, U32>, +t: B.Tok, +no: B.Loc) -> B.Rr:
  B.when(B.Rr, c,
    u => B.when(B.Rr, B.starts.s(n, "Blend_"), v => B.rr.er(t, no, B.text(n) ++ ": names beginning Blend_ are Blend's own"), v => B.rr.tok(t)),
    u => B.rr.foreign(cx, B.loc.mod(B.ob.no(B.ob.at(B.cx.obs(cx), q))), mark, n, t))

def rbd_il(c: Bool, +cx: B.Cx, +q: U32, +mark: U32, +n: List<&2, U32>, +t: B.Tok, +no: B.Loc, +ht: {B.inline(B.tok.bytes(t)) == True{} : Bool},
    +hn: {B.inline(n) == True{} : Bool}) -> {rril(rbd_k(c, cx, q, mark, n, t, no)) == True{} : Bool}:
  match c:
    case True{}:
      rbs_il(B.starts.s(n, "Blend_"), n, t, no, ht)
    case False{}:
      foreign_il(cx, B.loc.mod(B.ob.no(B.ob.at(B.cx.obs(cx), q))), mark, n, t, ht, hn)

def bend_il(+cx: B.Cx, +q: U32, +mark: U32, +n: List<&2, U32>, +t: B.Tok, +no: B.Loc, +ht: {B.inline(B.tok.bytes(t)) == True{} : Bool},
    +hn: {B.inline(n) == True{} : Bool}) -> {rril(B.rr.bend(cx, q, mark, n, t, no)) == True{} : Bool}:
  rbd_il(U32.is_eq(B.loc.mod(B.ob.no(B.ob.at(B.cx.obs(cx), q))), 0), cx, q, mark, n, t, no, ht, hn)

# look.obj's decisions mirrored: a definition found named by a dotted
# name's last parts
def mrfil(m: Maybe<&2, B.Rf>) -> Bool:
  match m:
    case None{}:
      True{}
    case Some{f}:
      B.inline(B.rf.name(f))

def lox_k(+c: Bool, +x: U32, +j: Nat, +k: Nat, +cx: B.Cx, +q: U32, +ps: List<&2, List<&2, U32>>) -> Maybe<&2, B.Rf>:
  B.when(Maybe<&2, B.Rf>, c, v => Some{B.Rf{x, B.dots(List.drop(&2, List<&2, U32>, ps, k)), False{}, x}}, v => B.look.obj(j, cx, q, ps))

def lox_il(c: Bool, +x: U32, +j: Nat, +k: Nat, +cx: B.Cx, +q: U32, +ps: List<&2, List<&2, U32>>, +hps: {B.inlines(ps) == True{} : Bool},
    +ih: {mrfil(B.look.obj(j, cx, q, ps)) == True{} : Bool}) -> {mrfil(lox_k(c, x, j, k, cx, q, ps)) == True{} : Bool}:
  match c:
    case True{}:
      il_dots(List.drop(&2, List<&2, U32>, ps, k), ils_ldrop(ps, k, hps))
    case False{}:
      ih

def lok(+m: Maybe<&2, U32>, +j: Nat, +k: Nat, +cx: B.Cx, +q: U32, +ps: List<&2, List<&2, U32>>) -> Maybe<&2, B.Rf>:
  B.on.maybe(U32, Maybe<&2, B.Rf>, m, u => B.look.obj(j, cx, q, ps),
    +x => B.when(Maybe<&2, B.Rf>, B.cx.has(cx, x, B.dots(List.drop(&2, List<&2, U32>, ps, k))),
      v => Some{B.Rf{x, B.dots(List.drop(&2, List<&2, U32>, ps, k)), False{}, x}},
      v => B.look.obj(j, cx, q, ps)))

def lok_il(m: Maybe<&2, U32>, +j: Nat, +k: Nat, +cx: B.Cx, +q: U32, +ps: List<&2, List<&2, U32>>, +hps: {B.inlines(ps) == True{} : Bool},
    +ih: {mrfil(B.look.obj(j, cx, q, ps)) == True{} : Bool}) -> {mrfil(lok(m, j, k, cx, q, ps)) == True{} : Bool}:
  match m:
    case None{}:
      ih
    case Some{+x}:
      lox_il(B.cx.has(cx, x, B.dots(List.drop(&2, List<&2, U32>, ps, k))), x, j, k, cx, q, ps, hps, ih)

def lo_il_u(k: Nat, +cx: B.Cx, +q: U32, +ps: List<&2, List<&2, U32>>, +hps: {B.inlines(ps) == True{} : Bool}) -> {mrfil(B.look.obj(k, cx, q, ps)) == True{} : Bool}:
  match k:
    case 0n:
      {==}
    case 1n+(+j):
      lok_il(B.resolve(List.length(&2, B.Ob, B.cx.obs(cx)), B.cx.als(cx), B.cx.obs(cx), q, List.take(&2, List<&2, U32>, ps, 1n+j)), j, 1n+j, cx, q, ps, hps,
        lo_il_u(j, cx, q, ps, hps))

def rf_il(+cx: B.Cx, +mark: U32, +t: B.Tok, +no: B.Loc, f: B.Rf, +ht: {B.inline(B.tok.bytes(t)) == True{} : Bool}, +hf: {B.inline(B.rf.name(f)) == True{} : Bool}) ->
    {rril(B.rr.rf(cx, mark, t, no, f)) == True{} : Bool}:
  match f:
    case B.Rf{+obj, +name, +prior, +origin}:
      final_il(cx, obj, mark, name, t, no, ht, hf)

# rr.dotted's decision mirrored
def rdk(+m: Maybe<&2, B.Rf>, +cx: B.Cx, +q: U32, +mark: U32, +n: List<&2, U32>, +t: B.Tok, +no: B.Loc) -> B.Rr:
  B.on.maybe(B.Rf, B.Rr, m, u => B.rr.bend(cx, q, mark, n, t, no), f => B.rr.rf(cx, mark, t, no, f))

def rd_il(m: Maybe<&2, B.Rf>, +cx: B.Cx, +q: U32, +mark: U32, +n: List<&2, U32>, +t: B.Tok, +no: B.Loc, +hm: {mrfil(m) == True{} : Bool},
    +ht: {B.inline(B.tok.bytes(t)) == True{} : Bool}, +hn: {B.inline(n) == True{} : Bool}) -> {rril(rdk(m, cx, q, mark, n, t, no)) == True{} : Bool}:
  match m:
    case None{}:
      bend_il(cx, q, mark, n, t, no, ht, hn)
    case Some{f}:
      rf_il(cx, mark, t, no, f, ht, hm)

def dotted_il(+cx: B.Cx, +q: U32, +mark: U32, +n: List<&2, U32>, +t: B.Tok, +no: B.Loc, +ht: {B.inline(B.tok.bytes(t)) == True{} : Bool},
    +hn: {B.inline(n) == True{} : Bool}) -> {rril(B.rr.dotted(cx, q, mark, n, t, no)) == True{} : Bool}:
  rd_il(B.look.obj(List.length(&2, List<&2, U32>, List.tail(&2, List<&2, U32>, B.parts(n))), cx, q, B.parts(n)), cx, q, mark, n, t, no,
    lo_il_u(List.length(&2, List<&2, U32>, List.tail(&2, List<&2, U32>, B.parts(n))), cx, q, B.parts(n), ils_parts(n, hn)), ht, hn)

# rr.plain.k's lookup mirrored
def rpk(+m: Maybe<&2, U32>, +cx: B.Cx, +q: U32, +mark: U32, +n: List<&2, U32>, +t: B.Tok, +no: B.Loc) -> B.Rr:
  B.on.maybe(U32, B.Rr, m, v => B.rr.dotted(cx, q, mark, n, t, no), +h => B.rr.final(cx, h, mark, n, t, no))

def rp_il(m: Maybe<&2, U32>, +cx: B.Cx, +q: U32, +mark: U32, +n: List<&2, U32>, +t: B.Tok, +no: B.Loc, +ht: {B.inline(B.tok.bytes(t)) == True{} : Bool},
    +hn: {B.inline(n) == True{} : Bool}) -> {rril(rpk(m, cx, q, mark, n, t, no)) == True{} : Bool}:
  match m:
    case None{}:
      dotted_il(cx, q, mark, n, t, no, ht, hn)
    case Some{+h}:
      final_il(cx, h, mark, n, t, no, ht, hn)

def plaink_il(local: Bool, +cx: B.Cx, +o: U32, +q: U32, +mark: U32, +n: List<&2, U32>, +t: B.Tok, +no: B.Loc, +ht: {B.inline(B.tok.bytes(t)) == True{} : Bool},
    +hn: {B.inline(n) == True{} : Bool}) -> {rril(B.rr.plain.k(local, cx, o, q, mark, n, t, no)) == True{} : Bool}:
  match local:
    case True{}:
      tok_il(t, ht)
    case False{}:
      rp_il(B.look(cx, Con{o, B.hosts(B.cx.obs(cx), q)}, n), cx, q, mark, n, t, no, ht, hn)

def plain_ril(+cx: B.Cx, +o: U32, +q: U32, +locals: List<&2, List<&2, U32>>, +mark: U32, +n: List<&2, U32>, +t: B.Tok, +no: B.Loc,
    +ht: {B.inline(B.tok.bytes(t)) == True{} : Bool}, +hn: {B.inline(n) == True{} : Bool}) -> {rril(B.rr.plain(cx, o, q, locals, mark, n, t, no)) == True{} : Bool}:
  plaink_il(B.names.has(locals, n), cx, o, q, mark, n, t, no, ht, hn)

# rr.prior.of's lookup mirrored: a prior named by the token's text
def rpok(+m: Maybe<&2, U32>, +cx: B.Cx, +o: U32, +q: U32, +n: List<&2, U32>, +t: B.Tok, +no: B.Loc) -> B.Rr:
  B.on.maybe(U32, B.Rr, m,
    u => B.rr.er(t, no, "_" ++ B.text(B.name.plain(n)) ++ ": " ++ B.ob.name(B.cx.obs(cx), o) ++ " has no " ++
      B.when(String, B.ends(n, [35]), v => "proof of ", v => "definition of ") ++ B.text(B.name.plain(n)) ++ " before " ++ B.ob.name(B.cx.obs(cx), q) ++ "'s"),
    +c => B.Rr{B.RR{0, B.Rf{o, n, True{}, c}}, Nil{}, [B.In{n, c, True{}}]})

def rpo_il(m: Maybe<&2, U32>, +cx: B.Cx, +o: U32, +q: U32, +n: List<&2, U32>, +t: B.Tok, +no: B.Loc, +ht: {B.inline(B.tok.bytes(t)) == True{} : Bool},
    +hn: {B.inline(n) == True{} : Bool}) -> {rril(rpok(m, cx, o, q, n, t, no)) == True{} : Bool}:
  match m:
    case None{}:
      er_il(t, no, "_" ++ B.text(B.name.plain(n)) ++ ": " ++ B.ob.name(B.cx.obs(cx), o) ++ " has no " ++
        B.when(String, B.ends(n, [35]), v => "proof of ", v => "definition of ") ++ B.text(B.name.plain(n)) ++ " before " ++ B.ob.name(B.cx.obs(cx), q) ++ "'s", ht)
    case Some{+c}:
      and_intro(B.inline(n), Bool.and(B.inline(n), True{}), hn, and_intro(B.inline(n), True{}, hn, {==}))

def prior_of_il(+cx: B.Cx, +o: U32, +q: U32, +n: List<&2, U32>, +t: B.Tok, +no: B.Loc, +ht: {B.inline(B.tok.bytes(t)) == True{} : Bool},
    +hn: {B.inline(n) == True{} : Bool}) -> {rril(B.rr.prior.of(cx, o, q, n, t, no)) == True{} : Bool}:
  rpo_il(B.prior.find(B.en.chain(B.cx.find(cx, o, n)), B.after(B.cx.ord(cx, o), q)), cx, o, q, n, t, no, ht, hn)

def rprk(+c: Bool, +cx: B.Cx, +o: U32, +q: U32, +n: List<&2, U32>, +t: B.Tok, +no: B.Loc) -> B.Rr:
  B.when(B.Rr, c, u => B.rr.prior.of(cx, o, q, List.append(&2, U32, n, [35]), t, no), u => B.rr.prior.of(cx, o, q, n, t, no))

def rpr_il(c: Bool, +cx: B.Cx, +o: U32, +q: U32, +n: List<&2, U32>, +t: B.Tok, +no: B.Loc, +ht: {B.inline(B.tok.bytes(t)) == True{} : Bool},
    +hn: {B.inline(n) == True{} : Bool}) -> {rril(rprk(c, cx, o, q, n, t, no)) == True{} : Bool}:
  match c:
    case True{}:
      prior_of_il(cx, o, q, List.append(&2, U32, n, [35]), t, no, ht, il_app(n, [35], hn, {==}))
    case False{}:
      prior_of_il(cx, o, q, n, t, no, ht, hn)

def under_il(local: Bool, +cx: B.Cx, +o: U32, +q: U32, +r: List<&2, U32>, +t: B.Tok, +no: B.Loc, +ht: {B.inline(B.tok.bytes(t)) == True{} : Bool},
    +hr: {B.inline(r) == True{} : Bool}) -> {rril(B.rr.under(local, cx, o, q, r, t, no)) == True{} : Bool}:
  match local:
    case True{}:
      tok_il(t, ht)
    case False{}:
      rpr_il(B.cx.has(cx, o, List.append(&2, U32, r, [35])), cx, o, q, r, t, no, ht, hr)

# a name token resolved, by its first byte's tests
def markk_il(up: Bool, tpl: Bool, under: Bool, +cx: B.Cx, +o: U32, +q: U32, +locals: List<&2, List<&2, U32>>, +h: U32, +r: List<&2, U32>, +no: B.Loc,
    +hx: {B.inline(Con{h, r}) == True{} : Bool}) -> {rril(B.rr.mark.k(up, tpl, under, cx, o, q, locals, h, r, B.TName{Con{h, r}}, no)) == True{} : Bool}:
  match up tpl under:
    case True{} _ _:
      host_il(cx, o, q, B.carets(Con{h, r}), List.drop(&2, U32, Con{h, r}, B.carets(Con{h, r})), B.TName{Con{h, r}}, Con{h, r}, no, hx,
        il_ldrop(Con{h, r}, B.carets(Con{h, r}), hx))
    case False{} True{} _:
      plain_ril(cx, o, q, locals, 126, r, B.TName{Con{h, r}}, no, hx, il_tail(h, r, hx))
    case False{} False{} True{}:
      under_il(Bool.or(Bool.or(B.blank(r), B.names.has(locals, Con{h, r})), B.is.root(B.cx.obs(cx), o)), cx, o, q, r, B.TName{Con{h, r}}, no, hx, il_tail(h, r, hx))
    case False{} False{} False{}:
      plain_ril(cx, o, q, locals, 0, Con{h, r}, B.TName{Con{h, r}}, no, hx, hx)

# a token resolved: within a line where its text is
def rrof_il(+cx: B.Cx, +o: U32, +q: U32, +locals: List<&2, List<&2, U32>>, t: B.Tok, +no: B.Loc, +ht: {B.inline(B.tok.bytes(t)) == True{} : Bool}) ->
    {rril(B.rr.of(cx, o, q, locals, t, no)) == True{} : Bool}:
  match t:
    case B.TName{+x}:
      match x:
        case Nil{}:
          {==}
        case Con{+h, +r}:
          markk_il(U32.is_eq(h, 94), U32.is_eq(h, 126), U32.is_eq(h, 95), cx, o, q, locals, h, r, no, ht)
    case B.TNum{+x}:
      tok_il(B.TNum{x}, ht)
    case B.TStr{+x}:
      tok_il(B.TStr{x}, ht)
    case B.TCom{+x}:
      tok_il(B.TCom{x}, ht)
    case B.TSp{+x}:
      tok_il(B.TSp{x}, ht)
    case B.TSym{+c}:
      tok_il(B.TSym{c}, ht)

# A body resolved: lines and priors within a line

def rbil(b: B.Rb) -> Bool:
  match b:
    case B.Rb{ls, ers, ins}:
      Bool.and(B.rls.inline(ls), insil(ins))

def insapp_il(a: List<&2, B.In>, +b: List<&2, B.In>, +ha: {insil(a) == True{} : Bool}, +hb: {insil(b) == True{} : Bool}) -> {insil(List.append(&2, B.In, a, b)) == True{} : Bool}:
  match a:
    case Nil{}:
      hb
    case Con{+i, +t}:
      and_intro(inil(i), insil(List.append(&2, B.In, t, b)), and_l(inil(i), insil(t), ha), insapp_il(t, b, and_r(inil(i), insil(t), ha), hb))

def rlsapp_il(a: List<&2, B.Rl>, +b: List<&2, B.Rl>, +ha: {B.rls.inline(a) == True{} : Bool}, +hb: {B.rls.inline(b) == True{} : Bool}) ->
    {B.rls.inline(List.append(&2, B.Rl, a, b)) == True{} : Bool}:
  match a:
    case Nil{}:
      hb
    case Con{l, +t}:
      match l:
        case B.Rl{+no, +ind, +ts}:
          and_intro(B.rts.inline(ts), B.rls.inline(List.append(&2, B.Rl, t, b)), and_l(B.rts.inline(ts), B.rls.inline(t), ha),
            rlsapp_il(t, b, and_r(B.rts.inline(ts), B.rls.inline(t), ha), hb))

def rtsapp_il(a: List<&2, B.Rt>, +b: List<&2, B.Rt>, +ha: {B.rts.inline(a) == True{} : Bool}, +hb: {B.rts.inline(b) == True{} : Bool}) ->
    {B.rts.inline(List.append(&2, B.Rt, a, b)) == True{} : Bool}:
  match a:
    case Nil{}:
      hb
    case Con{+x, +t}:
      and_intro(B.rt.inline(x), B.rts.inline(List.append(&2, B.Rt, t, b)), and_l(B.rt.inline(x), B.rts.inline(t), ha), rtsapp_il(t, b, and_r(B.rt.inline(x), B.rts.inline(t), ha), hb))

def join_il(ls: List<&2, B.Rl>, +h: {B.rls.inline(ls) == True{} : Bool}) -> {B.rts.inline(B.rl.join(ls)) == True{} : Bool}:
  match ls:
    case Nil{}:
      {==}
    case Con{l, +t}:
      match l:
        case B.Rl{+no, +ind, +ts}:
          rtsapp_il(ts, B.rl.join(t), and_l(B.rts.inline(ts), B.rls.inline(t), h), join_il(t, and_r(B.rts.inline(ts), B.rls.inline(t), h)))

def cons_il(x: B.Rr, rest: B.Rb, +hx: {rril(x) == True{} : Bool}, +hr: {rbil(rest) == True{} : Bool}) -> {rbil(B.rb.cons(x, rest)) == True{} : Bool}:
  match x rest:
    case B.Rr{+rt, +e, +i} B.Rb{+ls, +es, +more}:
      and_intro(Bool.and(Bool.and(B.rt.inline(rt), True{}), B.rls.inline(ls)), insil(List.append(&2, B.In, i, more)),
        and_intro(Bool.and(B.rt.inline(rt), True{}), B.rls.inline(ls), and_intro(B.rt.inline(rt), True{}, and_l(B.rt.inline(rt), insil(i), hx), {==}),
          and_l(B.rls.inline(ls), insil(more), hr)),
        insapp_il(i, more, and_r(B.rt.inline(rt), insil(i), hx), and_r(B.rls.inline(ls), insil(more), hr)))

def toks_rb(ts: List<&2, B.Tok>, +cx: B.Cx, +o: U32, +q: U32, +locals: List<&2, List<&2, U32>>, +no: B.Loc, +h: {B.toks.inline(ts) == True{} : Bool}) ->
    {rbil(B.rb.toks(ts, cx, o, q, locals, no)) == True{} : Bool}:
  match ts:
    case Nil{}:
      {==}
    case Con{+t, +r}:
      cons_il(B.rr.of(cx, o, q, locals, t, no), B.rb.toks(r, cx, o, q, locals, no), rrof_il(cx, o, q, locals, t, no, and_l(B.inline(B.tok.bytes(t)), B.toks.inline(r), h)),
        toks_rb(r, cx, o, q, locals, no, and_r(B.inline(B.tok.bytes(t)), B.toks.inline(r), h)))

def line_rb(+no: B.Loc, +ind: U32, b: B.Rb, +h: {rbil(b) == True{} : Bool}) -> {rbil(B.rb.line(no, ind, b)) == True{} : Bool}:
  match b:
    case B.Rb{+ls, +es, +more}:
      and_intro(Bool.and(B.rts.inline(B.rl.join(ls)), True{}), insil(more), and_intro(B.rts.inline(B.rl.join(ls)), True{}, join_il(ls, and_l(B.rls.inline(ls), insil(more), h)), {==}),
        and_r(B.rls.inline(ls), insil(more), h))

def join_rb(a: B.Rb, b: B.Rb, +ha: {rbil(a) == True{} : Bool}, +hb: {rbil(b) == True{} : Bool}) -> {rbil(B.rb.join(a, b)) == True{} : Bool}:
  match a b:
    case B.Rb{+l1, +e1, +i1} B.Rb{+l2, +e2, +i2}:
      and_intro(B.rls.inline(List.append(&2, B.Rl, l1, l2)), insil(List.append(&2, B.In, i1, i2)),
        rlsapp_il(l1, l2, and_l(B.rls.inline(l1), insil(i1), ha), and_l(B.rls.inline(l2), insil(i2), hb)),
        insapp_il(i1, i2, and_r(B.rls.inline(l1), insil(i1), ha), and_r(B.rls.inline(l2), insil(i2), hb)))

def lines_rb(bs: List<&2, B.Bl>, +cx: B.Cx, +o: U32, +q: U32, +locals: List<&2, List<&2, U32>>, +h: {B.bls.inline(bs) == True{} : Bool}) ->
    {rbil(B.rb.lines(bs, cx, o, q, locals)) == True{} : Bool}:
  match bs:
    case Nil{}:
      {==}
    case Con{b, +t}:
      match b:
        case B.Bl{+no, +ind, +ts}:
          join_rb(B.rb.line(no, ind, B.rb.toks(ts, cx, o, q, locals, no)), B.rb.lines(t, cx, o, q, locals),
            line_rb(no, ind, B.rb.toks(ts, cx, o, q, locals, no), toks_rb(ts, cx, o, q, locals, no, and_l(B.toks.inline(ts), B.bls.inline(t), h))),
            lines_rb(t, cx, o, q, locals, and_r(B.toks.inline(ts), B.bls.inline(t), h)))

# A definition held by definitions within a line: within a line

def ndil(nd: B.Node) -> Bool:
  match nd:
    case B.NDef{+share, +upd, name, rest, params, body, +no, +ind, +what}:
      Bool.and(Bool.and(B.inline(name), B.inline(rest)), B.bls.inline(body))
    case _:
      True{}

def dsil(ds: List<&2, B.Node>) -> Bool:
  match ds:
    case Nil{}:
      True{}
    case Con{+d, t}:
      Bool.and(ndil(d), dsil(t))

def nope(+P: Bool, h: {False{} == True{} : Bool}) -> {P == True{} : Bool}:
  Empty.absurd({P == True{} : Bool}, MB.false_ne_true()(h))

def same_il(nd: B.Node, d: B.Node, +hs: {B.ndef.same(d, nd) == True{} : Bool}, +hd: {ndil(d) == True{} : Bool}) -> {ndil(nd) == True{} : Bool}:
  %Laws.nodes.same_eq(d, nd, hs) : {ndil(_) == True{} : Bool}
  hd

def in_k(c: Bool, +d: B.Node, +t: List<&2, B.Node>, +nd: B.Node, +e: {B.ndef.same(d, nd) == c : Bool}, +hin: {Bool.or(c, B.def.in(t, nd)) == True{} : Bool},
    +hd: {ndil(d) == True{} : Bool}, ih: @h:{B.def.in(t, nd) == True{} : Bool} -> {ndil(nd) == True{} : Bool}) -> {ndil(nd) == True{} : Bool}:
  match c:
    case True{}:
      same_il(nd, d, e, hd)
    case False{}:
      ih(hin)

def in_il(ds: List<&2, B.Node>, +nd: B.Node, +hin: {B.def.in(ds, nd) == True{} : Bool}, +hd: {dsil(ds) == True{} : Bool}) -> {ndil(nd) == True{} : Bool}:
  match ds:
    case Nil{}:
      nope(ndil(nd), hin)
    case Con{+d, +t}:
      in_k(B.ndef.same(d, nd), d, t, nd, {==}, hin, and_l(ndil(d), dsil(t), hd), h => in_il(t, nd, h, and_r(ndil(d), dsil(t), hd)))

def held_il(nd: B.Node, +ds: List<&2, B.Node>, +hh: {B.node.held(nd, ds) == True{} : Bool}, +hd: {dsil(ds) == True{} : Bool}) -> {ndil(nd) == True{} : Bool}:
  match nd:
    case B.NDef{+share, +upd, +name, +rest, +params, +body, +no, +ind, +what}:
      in_il(ds, B.NDef{share, upd, name, rest, params, body, no, ind, what}, hh, hd)
    case B.NObj{+abs, +ext, +name, +parents, +kids, +no}:
      {==}
    case B.NImport{+txt, +no}:
      {==}
    case B.NDecl{+names, +no}:
      {==}
    case B.NBad{+txt, +no}:
      {==}
    case B.NErr{+msg, +no}:
      {==}
    case B.NBend{+lines, +no}:
      {==}

# The copies: each copy's name, head and lines within a line

def rdil(r: B.Rd) -> Bool:
  match r:
    case B.Rd{i, nd, hd, ls}:
      Bool.and(inil(i), Bool.and(B.rts.inline(hd), B.rls.inline(ls)))

def cpp(p: B.Rd & B.Rb) -> Bool:
  match p:
    case (a, b):
      Bool.and(rdil(a), insil(B.rb.ins(b)))

def cpp_a(p: B.Rd & B.Rb, h: {cpp(p) == True{} : Bool}) -> {rdil(Pair.fst(B.Rd, B.Rb, p)) == True{} : Bool}:
  match p:
    case (+a, +b):
      and_l(rdil(a), insil(B.rb.ins(b)), h)

def cpp_b(p: B.Rd & B.Rb, h: {cpp(p) == True{} : Bool}) -> {insil(B.rb.ins(Pair.snd(B.Rd, B.Rb, p))) == True{} : Bool}:
  match p:
    case (+a, +b):
      and_r(rdil(a), insil(B.rb.ins(b)), h)

def ck_il(+i: B.In, +nd: B.Node, h: B.Rb, b: B.Rb, +sh: List<&2, B.Er>, +hi: {inil(i) == True{} : Bool}, +hh: {rbil(h) == True{} : Bool}, +hb: {rbil(b) == True{} : Bool}) ->
    {cpp(B.copy.k(i, nd, h, b, sh)) == True{} : Bool}:
  match h b:
    case B.Rb{+hl, +he, +hi2} B.Rb{+ls, +es, +more}:
      and_intro(Bool.and(inil(i), Bool.and(B.rts.inline(B.rl.join(hl)), B.rls.inline(ls))), insil(List.append(&2, B.In, hi2, more)),
        and_intro(inil(i), Bool.and(B.rts.inline(B.rl.join(hl)), B.rls.inline(ls)), hi,
          and_intro(B.rts.inline(B.rl.join(hl)), B.rls.inline(ls), join_il(hl, and_l(B.rls.inline(hl), insil(hi2), hh)), and_l(B.rls.inline(ls), insil(more), hb))),
        insapp_il(hi2, more, and_r(B.rls.inline(hl), insil(hi2), hh), and_r(B.rls.inline(ls), insil(more), hb)))

def bare_il(+n: List<&2, U32>, +q: U32, +prior: Bool, +nd: B.Node, +hn: {B.inline(n) == True{} : Bool}) ->
    {cpp((B.Rd{B.In{n, q, prior}, nd, Nil{}, Nil{}}, B.Rb{Nil{}, Nil{}, Nil{}})) == True{} : Bool}:
  and_intro(Bool.and(B.inline(n), Bool.and(True{}, True{})), True{}, and_intro(B.inline(n), Bool.and(True{}, True{}), hn, {==}), {==})

def cn_il(+cx: B.Cx, +o: U32, i: B.In, nd: B.Node, +hi: {inil(i) == True{} : Bool}, +hn: {ndil(nd) == True{} : Bool}) -> {cpp(B.copy.node(cx, o, i, nd)) == True{} : Bool}:
  match i:
    case B.In{+n, +q, +prior}:
      match nd:
        case B.NDef{+share, +upd, +name, +rest, +params, +body, +no, +ind, +what}:
          ck_il(B.In{n, q, prior}, B.NDef{share, upd, name, rest, params, body, no, ind, what},
            B.rb.line(no, 0, B.rb.toks(B.toks(rest), cx, o, q, List.append(&2, List<&2, U32>, B.unmarks(params), B.lc.names(B.body.binders(body))), no)),
            B.rb.lines(body, cx, o, q, List.append(&2, List<&2, U32>, B.unmarks(params), B.lc.names(B.body.binders(body)))),
            B.when(List<&2, B.Er>, B.is.root(B.cx.obs(cx), o), u => Nil{},
              u => List.append(&2, B.Er, B.shadow.params(B.unmarks(params), cx, o, q, B.text(B.rf.text(B.cx.obs(cx), B.in.ref(o, B.In{n, q, prior}))), no),
                B.shadow.locals(B.body.binders(body), cx, o, q, B.text(B.rf.text(B.cx.obs(cx), B.in.ref(o, B.In{n, q, prior})))))),
            hi,
            line_rb(no, 0, B.rb.toks(B.toks(rest), cx, o, q, List.append(&2, List<&2, U32>, B.unmarks(params), B.lc.names(B.body.binders(body))), no),
              toks_rb(B.toks(rest), cx, o, q, List.append(&2, List<&2, U32>, B.unmarks(params), B.lc.names(B.body.binders(body))), no,
                tt_il(B.toks(rest), il_spell(rest, and_r(B.inline(name), B.inline(rest), and_l(Bool.and(B.inline(name), B.inline(rest)), B.bls.inline(body), hn)))))),
            lines_rb(body, cx, o, q, List.append(&2, List<&2, U32>, B.unmarks(params), B.lc.names(B.body.binders(body))),
              and_r(Bool.and(B.inline(name), B.inline(rest)), B.bls.inline(body), hn)))
        case B.NObj{+abs, +ext, +name, +parents, +kids, +no}:
          bare_il(n, q, prior, B.NObj{abs, ext, name, parents, kids, no}, hi)
        case B.NImport{+txt, +no}:
          bare_il(n, q, prior, B.NImport{txt, no}, hi)
        case B.NDecl{+names, +no}:
          bare_il(n, q, prior, B.NDecl{names, no}, hi)
        case B.NBad{+txt, +no}:
          bare_il(n, q, prior, B.NBad{txt, no}, hi)
        case B.NErr{+msg, +no}:
          bare_il(n, q, prior, B.NErr{msg, no}, hi)
        case B.NBend{+lines, +no}:
          bare_il(n, q, prior, B.NBend{lines, no}, hi)

def ocil(mb: Maybe<&2, B.Node>, +cx: B.Cx, +o: U32, +n: List<&2, U32>, +q: U32, +prior: Bool, +ds: List<&2, B.Node>, +hm: {mheld(mb, ds) == True{} : Bool},
    +hd: {dsil(ds) == True{} : Bool}, +hn: {B.inline(n) == True{} : Bool}) -> {cpp(ocm(mb, cx, o, n, q, prior)) == True{} : Bool}:
  match mb:
    case None{}:
      bare_il(n, q, prior, B.NBad{Nil{}, B.loc.top(0)}, hn)
    case Some{+nd}:
      cn_il(cx, o, B.In{n, q, prior}, nd, hn, held_il(nd, ds, hm, hd))

# a copy: its definition found held, so within a line; its name its
# instance's
def rdi(+cx: B.Cx, +o: U32, i: B.In, +ds: List<&2, B.Node>, +hx: {cxh(cx, ds) == True{} : Bool}, +hd: {dsil(ds) == True{} : Bool}, +hi: {inil(i) == True{} : Bool}) ->
    {cpp(B.copy.of(cx, o, i)) == True{} : Bool}:
  match i:
    case B.In{+n, +q, +prior}:
      ocil(B.cx.mem(cx, q, n), cx, o, n, q, prior, ds, cxmem_held(cx, q, n, ds, hx), hd, hi)

def rdsil(rs: List<&2, B.Rd>) -> Bool:
  match rs:
    case Nil{}:
      True{}
    case Con{+r, t}:
      Bool.and(rdil(r), rdsil(t))

def cpil(c: B.Cp) -> Bool:
  match c:
    case B.Cp{rds, ers, done}:
      rdsil(rds)

def cpadd_il(+rd: B.Rd, b: B.Rb, c: B.Cp, +hr: {rdil(rd) == True{} : Bool}, +hc: {cpil(c) == True{} : Bool}) -> {cpil(B.cp.add(rd, b, c)) == True{} : Bool}:
  match b:
    case B.Rb{ls, es, more}:
      match c:
        case B.Cp{+rds, ers, done}:
          and_intro(rdil(rd), rdsil(rds), hr, hc)

def then_il(+t: List<&2, B.In>, xs: List<&2, B.In>, +ht: {insil(t) == True{} : Bool}, +hx: {insil(xs) == True{} : Bool}) -> {insil(B.ins.then(t, xs)) == True{} : Bool}:
  match xs:
    case Nil{}:
      ht
    case Con{+x, +r}:
      insapp_il(t, Con{x, r}, ht, hx)

def cgi(c: Bool, +k: Nat, +cx: B.Cx, +o: U32, +i: B.In, +t: List<&2, B.In>, +rds: List<&2, B.Rd>, +ers: List<&2, B.Er>, +done: B.Ht<B.In>,
    ht: {cpil(B.copies.go(k, cx, o, t, B.Cp{rds, ers, done})) == True{} : Bool}, hf: {cpil(B.copies.go(k, cx, o, B.ins.then(t, B.rb.ins(Pair.snd(B.Rd, B.Rb, B.copy.of(cx, o, i)))), B.cp.add(Pair.fst(B.Rd, B.Rb, B.copy.of(cx, o, i)), Pair.snd(B.Rd, B.Rb, B.copy.of(cx, o, i)), B.Cp{rds, ers, B.done.put(done, i)}))) == True{} : Bool}) ->
    {cpil(cgk(c, k, cx, o, i, t, rds, ers, done)) == True{} : Bool}:
  match c:
    case True{}:
      ht
    case False{}:
      %Equal.sym(B.Cp, B.on.pair(B.Rd, B.Rb, B.Cp, B.copy.of(cx, o, i), rd => +b => B.copies.go(k, cx, o, B.ins.then(t, B.rb.ins(b)), B.cp.add(rd, b, B.Cp{rds, ers, B.done.put(done, i)}))), B.copies.go(k, cx, o, B.ins.then(t, B.rb.ins(Pair.snd(B.Rd, B.Rb, B.copy.of(cx, o, i)))), B.cp.add(Pair.fst(B.Rd, B.Rb, B.copy.of(cx, o, i)), Pair.snd(B.Rd, B.Rb, B.copy.of(cx, o, i)), B.Cp{rds, ers, B.done.put(done, i)})), pair_eta_rd(B.copy.of(cx, o, i), rd => +b => B.copies.go(k, cx, o, B.ins.then(t, B.rb.ins(b)), B.cp.add(rd, b, B.Cp{rds, ers, B.done.put(done, i)})))) : {cpil(_) == True{} : Bool}
      hf

# past the fuel, the copies as they were, an error at most added
def short_cpil(todo: List<&2, B.In>, +cx: B.Cx, +o: U32, c: B.Cp, hc: {cpil(c) == True{} : Bool}) -> {cpil(B.cp.short(todo, cx, o, c)) == True{} : Bool}:
  match todo:
    case Nil{}:
      hc
    case Con{i, t}:
      match c:
        case B.Cp{rds, ers, done}:
          hc

# the copies' loop: each instance named within a line, each copy within
def copies_il(n: Nat, +cx: B.Cx, +o: U32, todo: List<&2, B.In>, +c: B.Cp, +ds: List<&2, B.Node>, +hx: {cxh(cx, ds) == True{} : Bool}, +hd: {dsil(ds) == True{} : Bool},
    +htd: {insil(todo) == True{} : Bool}, +hc: {cpil(c) == True{} : Bool}) -> {cpil(B.copies.go(n, cx, o, todo, c)) == True{} : Bool}:
  match n:
    case 0n:
      short_cpil(todo, cx, o, c, hc)
    case 1n+(+k):
      match todo:
        case Nil{}:
          hc
        case Con{+i, +t}:
          match c:
            case B.Cp{+rds, +ers, +done}:
              cgi(B.done.has(done, i), k, cx, o, i, t, rds, ers, done,
                copies_il(k, cx, o, t, B.Cp{rds, ers, done}, ds, hx, hd, and_r(inil(i), insil(t), htd), hc),
                copies_il(k, cx, o, B.ins.then(t, B.rb.ins(Pair.snd(B.Rd, B.Rb, B.copy.of(cx, o, i)))),
                  B.cp.add(Pair.fst(B.Rd, B.Rb, B.copy.of(cx, o, i)), Pair.snd(B.Rd, B.Rb, B.copy.of(cx, o, i)), B.Cp{rds, ers, B.done.put(done, i)}), ds, hx, hd,
                  then_il(t, B.rb.ins(Pair.snd(B.Rd, B.Rb, B.copy.of(cx, o, i))), and_r(inil(i), insil(t), htd),
                    cpp_b(B.copy.of(cx, o, i), rdi(cx, o, i, ds, hx, hd, and_l(inil(i), insil(t), htd)))),
                  cpadd_il(Pair.fst(B.Rd, B.Rb, B.copy.of(cx, o, i)), Pair.snd(B.Rd, B.Rb, B.copy.of(cx, o, i)), B.Cp{rds, ers, B.done.put(done, i)},
                    cpp_a(B.copy.of(cx, o, i), rdi(cx, o, i, ds, hx, hd, and_l(inil(i), insil(t), htd))),
                    hc)))

# the folds' maps: each name within a line
def cxf(cx: B.Cx) -> Bool:
  match cx:
    case B.Cx{obs, ls, fs, als, paths, pss, nxs, mds}:
      B.fds.inline(fs)

def fdget_il(fs: List<&2, Maybe<&2, B.Fd>>, n: Nat, +h: {B.fds.inline(fs) == True{} : Bool}) -> {B.fd.inline(B.fd.or(List.get(&2, Maybe<&2, B.Fd>, fs, n))) == True{} : Bool}:
  match fs:
    case Nil{}:
      {==}
    case Con{+f, +t}:
      match n:
        case 0n:
          and_l(B.fd.inline(f), B.fds.inline(t), h)
        case 1n+k:
          fdget_il(t, k, and_r(B.fd.inline(f), B.fds.inline(t), h))

def fdmap_il(m: Maybe<&2, B.Fd>, +h: {B.fd.inline(m) == True{} : Bool}) -> {B.ens.inline(B.fd.map(m)) == True{} : Bool}:
  match m:
    case None{}:
      {==}
    case Some{d}:
      match d:
        case B.Fd{+map, fes, ix}:
          h

def map_il(cx: B.Cx, +id: U32, +h: {cxf(cx) == True{} : Bool}) -> {B.ens.inline(B.cx.map(cx, id)) == True{} : Bool}:
  match cx:
    case B.Cx{obs, ls, +fs, als, paths, pss, nxs, mds}:
      fdmap_il(B.fd.or(List.get(&2, Maybe<&2, B.Fd>, fs, U32.to_nat(id))), fdget_il(fs, U32.to_nat(id), h))

def finals_il(es: List<&2, B.En>, +h: {B.ens.inline(es) == True{} : Bool}) -> {insil(B.ins.finals(es)) == True{} : Bool}:
  match es:
    case Nil{}:
      {==}
    case Con{e, +t}:
      match e:
        case B.En{+name, +chain, +no, +what}:
          and_intro(B.inline(name), insil(B.ins.finals(t)), and_l(B.inline(name), B.ens.inline(t), h), finals_il(t, and_r(B.inline(name), B.ens.inline(t), h)))

def ocsil(os: List<&2, B.Oc>) -> Bool:
  match os:
    case Nil{}:
      True{}
    case Con{oc, t}:
      match oc:
        case B.Oc{+id, c}:
          Bool.and(cpil(c), ocsil(t))

def mci(c1: Bool, abs: Bool, +id: U32, +t: List<&2, B.Ob>, +cx: B.Cx, +ds: List<&2, B.Node>, +hx: {cxh(cx, ds) == True{} : Bool}, +hd: {dsil(ds) == True{} : Bool},
    +hf: {cxf(cx) == True{} : Bool}, +ih: {ocsil(B.module.copies(t, cx)) == True{} : Bool}) -> {ocsil(mck(c1, abs, id, t, cx)) == True{} : Bool}:
  match c1 abs:
    case True{} _:
      ih
    case False{} True{}:
      ih
    case False{} False{}:
      and_intro(cpil(B.copies(cx, id)), ocsil(B.module.copies(t, cx)),
        copies_il(B.copies.fuel(), cx, id, B.ins.finals(B.cx.map(cx, id)),
          B.Cp{Nil{}, Nil{}, B.copies.room(cx)}, ds, hx, hd, finals_il(B.cx.map(cx, id), map_il(cx, id, hf)), {==}), ih)

def mcopies_il(os: List<&2, B.Ob>, +cx: B.Cx, +ds: List<&2, B.Node>, +hx: {cxh(cx, ds) == True{} : Bool}, +hd: {dsil(ds) == True{} : Bool}, +hf: {cxf(cx) == True{} : Bool}) ->
    {ocsil(B.module.copies(os, cx)) == True{} : Bool}:
  match os:
    case Nil{}:
      {==}
    case Con{o, +t}:
      match o:
        case B.Ob{+id, +host, path, +abs, parents, mems, +no, +kind, +tpl}:
          mci(Bool.or(Bool.not(U32.is_eq(B.loc.mod(no), 0)), Bool.not(B.is.object(kind))), abs, id, t, cx, ds, hx, hd, hf, mcopies_il(t, cx, ds, hx, hd, hf))

# The units: each copy's
def uns_app(a: List<&2, B.Un>, +b: List<&2, B.Un>, +ha: {B.uns.inline(a) == True{} : Bool}, +hb: {B.uns.inline(b) == True{} : Bool}) -> {B.uns.inline(List.append(&2, B.Un, a, b)) == True{} : Bool}:
  match a:
    case Nil{}:
      hb
    case Con{+u, +t}:
      and_intro(B.un.inline(u), B.uns.inline(List.append(&2, B.Un, t, b)), and_l(B.un.inline(u), B.uns.inline(t), ha), uns_app(t, b, and_r(B.un.inline(u), B.uns.inline(t), ha), hb))

def urds_il(+o: U32, rs: List<&2, B.Rd>, +h: {rdsil(rs) == True{} : Bool}) -> {B.uns.inline(B.un.rds(o, rs)) == True{} : Bool}:
  match rs:
    case Nil{}:
      {==}
    case Con{r, +t}:
      match r:
        case B.Rd{i, +nd, +hd, +ls}:
          match i:
            case B.In{+name, +q, +prior}:
              and_intro(Bool.and(Bool.and(B.inline(name), B.rts.inline(hd)), B.rls.inline(ls)), B.uns.inline(B.un.rds(o, t)),
                and_intro(Bool.and(B.inline(name), B.rts.inline(hd)), B.rls.inline(ls),
                  and_intro(B.inline(name), B.rts.inline(hd), and_l(B.inline(name), Bool.and(B.rts.inline(hd), B.rls.inline(ls)), and_l(rdil(B.Rd{B.In{name, q, prior}, nd, hd, ls}), rdsil(t), h)),
                    and_l(B.rts.inline(hd), B.rls.inline(ls), and_r(B.inline(name), Bool.and(B.rts.inline(hd), B.rls.inline(ls)), and_l(rdil(B.Rd{B.In{name, q, prior}, nd, hd, ls}), rdsil(t), h)))),
                  and_r(B.rts.inline(hd), B.rls.inline(ls), and_r(B.inline(name), Bool.and(B.rts.inline(hd), B.rls.inline(ls)), and_l(rdil(B.Rd{B.In{name, q, prior}, nd, hd, ls}), rdsil(t), h)))),
                urds_il(o, t, and_r(rdil(B.Rd{B.In{name, q, prior}, nd, hd, ls}), rdsil(t), h)))

def rdsil_rgo(xs: List<&2, B.Rd>, +acc: List<&2, B.Rd>, +hx: {rdsil(xs) == True{} : Bool}, +ha: {rdsil(acc) == True{} : Bool}) -> {rdsil(List.reverse.go(&2, B.Rd, xs, acc)) == True{} : Bool}:
  match xs:
    case Nil{}:
      ha
    case Con{+r, +t}:
      rdsil_rgo(t, Con{r, acc}, and_r(rdil(r), rdsil(t), hx), and_intro(rdil(r), rdsil(acc), and_l(rdil(r), rdsil(t), hx), ha))

def units_il(os: List<&2, B.Oc>, +h: {ocsil(os) == True{} : Bool}) -> {B.uns.inline(B.units(os)) == True{} : Bool}:
  match os:
    case Nil{}:
      {==}
    case Con{x, +t}:
      match x:
        case B.Oc{+id, c}:
          match c:
            case B.Cp{+rds, ers, done}:
              uns_app(B.un.rds(id, List.reverse(&2, B.Rd, rds)), B.units(t), urds_il(id, List.reverse(&2, B.Rd, rds), rdsil_rgo(rds, Nil{}, and_l(rdsil(rds), ocsil(t), h), {==})),
                units_il(t, and_r(rdsil(rds), ocsil(t), h)))

# The trees' definitions within a line
def dsil_app(a: List<&2, B.Node>, +b: List<&2, B.Node>, +ha: {dsil(a) == True{} : Bool}, +hb: {dsil(b) == True{} : Bool}) -> {dsil(List.append(&2, B.Node, a, b)) == True{} : Bool}:
  match a:
    case Nil{}:
      hb
    case Con{+d, +t}:
      and_intro(ndil(d), dsil(List.append(&2, B.Node, t, b)), and_l(ndil(d), dsil(t), ha), dsil_app(t, b, and_r(ndil(d), dsil(t), ha), hb))

def dsil_tree(ns: List<&2, B.Node>, +h: {B.nodes.inline(ns) == True{} : Bool}) -> {dsil(B.tree.defs(ns)) == True{} : Bool}:
  match ns:
    case Nil{}:
      {==}
    case Con{nd, +t}:
      match nd:
        case B.NObj{+abs, +ext, +name, +parents, +kids, +no}:
          dsil_app(B.tree.defs(kids), B.tree.defs(t),
            dsil_tree(kids, and_r(B.inline(name), B.nodes.inline(kids), and_l(Bool.and(B.inline(name), B.nodes.inline(kids)), B.nodes.inline(t), h))),
            dsil_tree(t, and_r(Bool.and(B.inline(name), B.nodes.inline(kids)), B.nodes.inline(t), h)))
        case B.NDef{+share, +upd, +name, +rest, +params, +body, +no, +ind, +what}:
          and_intro(Bool.and(Bool.and(B.inline(name), B.inline(rest)), B.bls.inline(body)), dsil(B.tree.defs(t)),
            and_l(Bool.and(Bool.and(B.inline(name), B.inline(rest)), B.bls.inline(body)), B.nodes.inline(t), h),
            dsil_tree(t, and_r(Bool.and(Bool.and(B.inline(name), B.inline(rest)), B.bls.inline(body)), B.nodes.inline(t), h)))
        case B.NImport{+txt, +no}:
          dsil_tree(t, and_r(B.inline(txt), B.nodes.inline(t), h))
        case B.NDecl{+names, +no}:
          dsil_tree(t, h)
        case B.NBad{+txt, +no}:
          dsil_tree(t, h)
        case B.NErr{+msg, +no}:
          dsil_tree(t, h)
        case B.NBend{+lines, +no}:
          dsil_tree(t, h)

def dsil_trees(ts: List<&2, List<&2, B.Node>>, +h: {B.trees.inline(ts) == True{} : Bool}) -> {dsil(B.trees.defs(ts)) == True{} : Bool}:
  match ts:
    case Nil{}:
      {==}
    case Con{+tr, +t}:
      dsil_app(B.tree.defs(tr), B.trees.defs(t), dsil_tree(tr, and_l(B.nodes.inline(tr), B.trees.inline(t), h)), dsil_trees(t, and_r(B.nodes.inline(tr), B.trees.inline(t), h)))

def Laws.inline.units(trees, als, ls, fs, als2, paths, pss, h, hf):
  units_il(B.module.copies(B.obs.made(B.syn.of(als, B.obs(trees))),
      B.cx.of(B.obs.made(B.syn.of(als, B.obs(trees))), ls, fs, als2, paths, pss)),
    mcopies_il(B.obs.made(B.syn.of(als, B.obs(trees))),
      B.cx.of(B.obs.made(B.syn.of(als, B.obs(trees))), ls, fs, als2, paths, pss), B.trees.defs(trees),
      mdsh_of(B.obs.made(B.syn.of(als, B.obs(trees))), B.trees.defs(trees), Laws.nodes.objects(trees, als)), dsil_trees(trees, h), hf))

# The context (`inline.members`, ...): the objects' members within a
# line, along the walk of their paths

def ogm(n: Nat, st: List<&2, B.Wf>, +next: U32, +out: List<&2, B.Ob>, +hs: {wfil(st) == True{} : Bool}, +ho: {B.obs.mems.inline(out) == True{} : Bool}) ->
    {B.obs.mems.inline(B.obs.go(n, st, next, out)) == True{} : Bool}:
  match n:
    case 0n:
      ho
    case 1n+(+k):
      match st:
        case Nil{}:
          ho
        case Con{f, +rest}:
          match f:
            case B.Wf{+host, +path, nodes}:
              match nodes:
                case Nil{}:
                  ogm(k, rest, next, out, wf_r(host, path, Nil{}, rest, hs), ho)
                case Con{nd, +t}:
                  match nd:
                    case B.NObj{+abs, +ext, +name, +parents, +kids, +no}:
                      +hn = wf_n(host, path, Con{B.NObj{abs, ext, name, parents, kids, no}, t}, rest, hs)
                      +hpn = ils_app(path, [name], wf_p(host, path, Con{B.NObj{abs, ext, name, parents, kids, no}, t}, rest, hs),
                        ils_one(name, and_l(B.inline(name), B.nodes.inline(kids), and_l(Bool.and(B.inline(name), B.nodes.inline(kids)), B.nodes.inline(t), hn))))
                      +hk = and_r(B.inline(name), B.nodes.inline(kids), and_l(Bool.and(B.inline(name), B.nodes.inline(kids)), B.nodes.inline(t), hn))
                      ogm(k, Con{B.Wf{next, List.append(&2, List<&2, U32>, path, [name]), kids}, Con{B.Wf{host, path, t}, rest}}, U32.add(next, 1),
                        Con{B.Ob{next, host, List.append(&2, List<&2, U32>, path, [name]), abs, parents, kids, no, B.ob.kind.of(ext, path), next}, out},
                        wf_on(next, List.append(&2, List<&2, U32>, path, [name]), kids, Con{B.Wf{host, path, t}, rest}, hpn, hk,
                          wf_on(host, path, t, rest, wf_p(host, path, Con{B.NObj{abs, ext, name, parents, kids, no}, t}, rest, hs),
                            and_r(Bool.and(B.inline(name), B.nodes.inline(kids)), B.nodes.inline(t), hn), wf_r(host, path, Con{B.NObj{abs, ext, name, parents, kids, no}, t}, rest, hs))),
                        and_intro(B.nodes.inline(kids), B.obs.mems.inline(out), hk, ho))
                    case B.NDef{+share, +upd, +name, +rest2, +params, +body, +no, +ind, +what}:
                      ogm(k, Con{B.Wf{host, path, t}, rest}, next, out,
                        wf_on(host, path, t, rest, wf_p(host, path, Con{B.NDef{share, upd, name, rest2, params, body, no, ind, what}, t}, rest, hs),
                          and_r(Bool.and(Bool.and(B.inline(name), B.inline(rest2)), B.bls.inline(body)), B.nodes.inline(t),
                            wf_n(host, path, Con{B.NDef{share, upd, name, rest2, params, body, no, ind, what}, t}, rest, hs)),
                          wf_r(host, path, Con{B.NDef{share, upd, name, rest2, params, body, no, ind, what}, t}, rest, hs)), ho)
                    case B.NImport{+txt, +no}:
                      ogm(k, Con{B.Wf{host, path, t}, rest}, next, out,
                        wf_on(host, path, t, rest, wf_p(host, path, Con{B.NImport{txt, no}, t}, rest, hs),
                          and_r(B.inline(txt), B.nodes.inline(t), wf_n(host, path, Con{B.NImport{txt, no}, t}, rest, hs)), wf_r(host, path, Con{B.NImport{txt, no}, t}, rest, hs)), ho)
                    case B.NDecl{+names, +no}:
                      ogm(k, Con{B.Wf{host, path, t}, rest}, next, out, hs, ho)
                    case B.NBad{+txt, +no}:
                      ogm(k, Con{B.Wf{host, path, t}, rest}, next, out, hs, ho)
                    case B.NErr{+msg, +no}:
                      ogm(k, Con{B.Wf{host, path, t}, rest}, next, out, hs, ho)
                    case B.NBend{+lines, +no}:
                      ogm(k, Con{B.Wf{host, path, t}, rest}, next, out, hs, ho)

def obsm_rgo(xs: List<&2, B.Ob>, +acc: List<&2, B.Ob>, +hx: {B.obs.mems.inline(xs) == True{} : Bool}, +ha: {B.obs.mems.inline(acc) == True{} : Bool}) ->
    {B.obs.mems.inline(List.reverse.go(&2, B.Ob, xs, acc)) == True{} : Bool}:
  match xs:
    case Nil{}:
      ha
    case Con{+o, +t}:
      obsm_rgo(t, Con{o, acc}, and_r(B.ob.mems.inline(o), B.obs.mems.inline(t), hx), and_intro(B.ob.mems.inline(o), B.obs.mems.inline(acc), and_l(B.ob.mems.inline(o), B.obs.mems.inline(t), hx), ha))

def obsm_app(xs: List<&2, B.Ob>, +b: List<&2, B.Ob>, +hx: {B.obs.mems.inline(xs) == True{} : Bool}, +hb: {B.obs.mems.inline(b) == True{} : Bool}) ->
    {B.obs.mems.inline(List.append(&2, B.Ob, xs, b)) == True{} : Bool}:
  match xs:
    case Nil{}:
      hb
    case Con{+o, +t}:
      and_intro(B.ob.mems.inline(o), B.obs.mems.inline(List.append(&2, B.Ob, t, b)), and_l(B.ob.mems.inline(o), B.obs.mems.inline(t), hx), obsm_app(t, b, and_r(B.ob.mems.inline(o), B.obs.mems.inline(t), hx), hb))

def modsm(ts: List<&2, List<&2, B.Node>>, +k: U32, +out: List<&2, B.Ob>, +ht: {B.trees.inline(ts) == True{} : Bool}, +ho: {B.obs.mems.inline(out) == True{} : Bool}) ->
    {B.obs.mems.inline(B.obs.mods(ts, k, out)) == True{} : Bool}:
  match ts:
    case Nil{}:
      ho
    case Con{+tr, +t}:
      modsm(t, U32.add(k, 1), B.obs.mod(tr, k, out), and_r(B.nodes.inline(tr), B.trees.inline(t), ht),
        ogm(B.wf.turns([B.Wf{U32.from_nat(List.length(&2, B.Ob, out)), Nil{}, tr}]), [B.Wf{U32.from_nat(List.length(&2, B.Ob, out)), Nil{}, tr}], U32.add(U32.from_nat(List.length(&2, B.Ob, out)), 1),
          Con{B.Ob{U32.from_nat(List.length(&2, B.Ob, out)), U32.from_nat(List.length(&2, B.Ob, out)), Nil{}, False{}, Nil{}, tr, B.loc.top(k), 0,
            U32.from_nat(List.length(&2, B.Ob, out))}, out},
          wf_on(U32.from_nat(List.length(&2, B.Ob, out)), Nil{}, tr, Nil{}, {==}, and_l(B.nodes.inline(tr), B.trees.inline(t), ht), {==}),
          and_intro(B.nodes.inline(tr), B.obs.mems.inline(out), and_l(B.nodes.inline(tr), B.trees.inline(t), ht), ho)))

def obsm_il(+trees: List<&2, List<&2, B.Node>>, +h: {B.trees.inline(trees) == True{} : Bool}) -> {B.obs.mems.inline(B.obs(trees)) == True{} : Bool}:
  obsm_rgo(B.obs.mods(trees, 0, Nil{}), Nil{}, modsm(trees, 0, Nil{}, h, {==}), {==})

def sxm_k(c: Bool, +n: List<&2, U32>, +t: List<&2, List<&2, U32>>, +x: U32, +obs: List<&2, B.Ob>, +made: List<&2, B.Ob>, +next: U32,
    ih1: {B.obs.mems.inline(B.syn.x(t, x, obs, made, next)) == True{} : Bool},
    ih2: {B.obs.mems.inline(B.syn.x(t, x, obs, Con{B.Ob{next, x, List.append(&2, List<&2, U32>, B.ob.path(B.ob.at(obs, x)), [n]), B.ob.abs(B.ob.at(obs, x)), Nil{}, Nil{}, B.ob.no(B.ob.at(obs, x)), 3, next}, made}, U32.add(next, 1))) == True{} : Bool}) ->
    {B.obs.mems.inline(sxk(c, n, t, x, obs, made, next)) == True{} : Bool}:
  match c:
    case True{}:
      ih1
    case False{}:
      ih2

def sxm(ns: List<&2, List<&2, U32>>, +x: U32, +obs: List<&2, B.Ob>, +made: List<&2, B.Ob>, +next: U32, +hm: {B.obs.mems.inline(made) == True{} : Bool}) ->
    {B.obs.mems.inline(B.syn.x(ns, x, obs, made, next)) == True{} : Bool}:
  match ns:
    case Nil{}:
      hm
    case Con{+n, +t}:
      sxm_k(Bool.or(B.made.has(obs, x, n), B.made.has(made, x, n)), n, t, x, obs, made, next, sxm(t, x, obs, made, next, hm),
        sxm(t, x, obs, Con{B.Ob{next, x, List.append(&2, List<&2, U32>, B.ob.path(B.ob.at(obs, x)), [n]), B.ob.abs(B.ob.at(obs, x)), Nil{}, Nil{}, B.ob.no(B.ob.at(obs, x)), 3, next}, made},
          U32.add(next, 1), and_intro(True{}, B.obs.mems.inline(made), {==}, hm)))

def srm_k(c: Bool, +id: U32, +t: List<&2, B.Ob>, +obs: List<&2, B.Ob>, +ls: List<&2, Maybe<&2, B.Lz>>, +made: List<&2, B.Ob>,
    ih1: {B.obs.mems.inline(B.syn.round(t, obs, ls, B.syn.x(B.mixin.names(B.lz.ord(B.lz.at(ls, id)), obs, Nil{}), id, obs, made, U32.add(U32.from_nat(List.length(&2, B.Ob, obs)), U32.from_nat(List.length(&2, B.Ob, made)))))) == True{} : Bool},
    ih2: {B.obs.mems.inline(B.syn.round(t, obs, ls, made)) == True{} : Bool}) -> {B.obs.mems.inline(srk(c, id, t, obs, ls, made)) == True{} : Bool}:
  match c:
    case True{}:
      ih1
    case False{}:
      ih2

def srm(os: List<&2, B.Ob>, +obs: List<&2, B.Ob>, +ls: List<&2, Maybe<&2, B.Lz>>, +made: List<&2, B.Ob>, +hm: {B.obs.mems.inline(made) == True{} : Bool}) ->
    {B.obs.mems.inline(B.syn.round(os, obs, ls, made)) == True{} : Bool}:
  match os:
    case Nil{}:
      hm
    case Con{o, +t}:
      match o:
        case B.Ob{+id, +host, path, +abs, parents, mems, +no, +kind, +tpl}:
          srm_k(Bool.and(B.is.object(kind), Bool.not(U32.is_eq(id, host))), id, t, obs, ls, made,
            srm(t, obs, ls, B.syn.x(B.mixin.names(B.lz.ord(B.lz.at(ls, id)), obs, Nil{}), id, obs, made, U32.add(U32.from_nat(List.length(&2, B.Ob, obs)), U32.from_nat(List.length(&2, B.Ob, made)))),
              sxm(B.mixin.names(B.lz.ord(B.lz.at(ls, id)), obs, Nil{}), id, obs, made, U32.add(U32.from_nat(List.length(&2, B.Ob, obs)), U32.from_nat(List.length(&2, B.Ob, made))), hm)),
            srm(t, obs, ls, made, hm))

def obm_get(os: List<&2, B.Ob>, n: Nat, +h: {B.obs.mems.inline(os) == True{} : Bool}) -> {B.nodes.inline(B.ob.mems(B.ob.or(List.get(&2, B.Ob, os, n)))) == True{} : Bool}:
  match os:
    case Nil{}:
      {==}
    case Con{o, +t}:
      match o:
        case B.Ob{+id, +host, +path, +abs, +parents, +mems, +no, +kind, +tpl}:
          match n:
            case 0n:
              and_l(B.nodes.inline(mems), B.obs.mems.inline(t), h)
            case 1n+k:
              obm_get(t, k, and_r(B.nodes.inline(mems), B.obs.mems.inline(t), h))

def obm_at(+obs: List<&2, B.Ob>, +id: U32, +h: {B.obs.mems.inline(obs) == True{} : Bool}) -> {B.nodes.inline(B.ob.mems(B.ob.at(obs, id))) == True{} : Bool}:
  obm_get(obs, U32.to_nat(id), h)

def ctm_k(c: Bool, +t: U32, +r: List<&2, U32>, +x: U32, +obs: List<&2, B.Ob>, +made: List<&2, B.Ob>, +next: U32,
    ih1: {B.obs.mems.inline(B.copies.t(r, x, obs, made, next)) == True{} : Bool},
    ih2: {B.obs.mems.inline(B.copies.t(r, x, obs, Con{B.Ob{next, x, B.ob.path(B.ob.at(obs, t)), B.ob.abs(B.ob.at(obs, t)), Nil{}, B.ob.mems(B.ob.at(obs, t)), B.ob.no(B.ob.at(obs, t)), B.ob.kind(B.ob.at(obs, t)), t}, made}, U32.add(next, 1))) == True{} : Bool}) ->
    {B.obs.mems.inline(ctk(c, t, r, x, obs, made, next)) == True{} : Bool}:
