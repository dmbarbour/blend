    case True{}:
      ih1
    case False{}:
      ih2

def ctm(ts: List<&2, U32>, +x: U32, +obs: List<&2, B.Ob>, +made: List<&2, B.Ob>, +next: U32, +hobs: {B.obs.mems.inline(obs) == True{} : Bool},
    +hm: {B.obs.mems.inline(made) == True{} : Bool}) -> {B.obs.mems.inline(B.copies.t(ts, x, obs, made, next)) == True{} : Bool}:
  match ts:
    case Nil{}:
