      and_nil(B.ims.fresh(B.ims.of(x), Nil{}, x), B.trees.plain.ers(ts), List.is_empty(&2, B.Er, B.trees.plain.ers(ts)), h2, h3 =>
        nil_empty(B.trees.plain.ers(ts), h3))))

