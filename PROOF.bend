        ctm(r, x, obs, Con{B.Ob{next, x, B.ob.path(B.ob.at(obs, t)), B.ob.abs(B.ob.at(obs, t)), Nil{}, B.ob.mems(B.ob.at(obs, t)), B.ob.no(B.ob.at(obs, t)), B.ob.kind(B.ob.at(obs, t)), t}, made},
          U32.add(next, 1), hobs, and_intro(B.nodes.inline(B.ob.mems(B.ob.at(obs, t))), B.obs.mems.inline(made), obm_at(obs, t, hobs), hm)))

def scm_k(c: Bool, +host: U32, +path: List<&2, List<&2, U32>>, +t: List<&2, B.Ob>, +obs: List<&2, B.Ob>, +ls: List<&2, Maybe<&2, B.Lz>>, +made: List<&2, B.Ob>,
    ih1: {B.obs.mems.inline(B.syn.copies(t, obs, ls, B.copies.t(B.mixins.of(B.lz.ord(B.lz.at(ls, host)), obs, B.path.last(path)), host, obs, made, U32.add(U32.from_nat(List.length(&2, B.Ob, obs)), U32.from_nat(List.length(&2, B.Ob, made)))))) == True{} : Bool},
    ih2: {B.obs.mems.inline(B.syn.copies(t, obs, ls, made)) == True{} : Bool}) -> {B.obs.mems.inline(sck(c, host, path, t, obs, ls, made)) == True{} : Bool}:
  match c:
    case True{}:
      ih1
    case False{}:
      ih2

def scm(os: List<&2, B.Ob>, +obs: List<&2, B.Ob>, +ls: List<&2, Maybe<&2, B.Lz>>, +made: List<&2, B.Ob>, +hobs: {B.obs.mems.inline(obs) == True{} : Bool},
    +hm: {B.obs.mems.inline(made) == True{} : Bool}) -> {B.obs.mems.inline(B.syn.copies(os, obs, ls, made)) == True{} : Bool}:
  match os:
    case Nil{}:
      hm
    case Con{o, +t}:
      match o:
        case B.Ob{+id, +host, +path, +abs, parents, mems, +no, +kind, +tpl}:
          scm_k(U32.is_eq(kind, 3), host, path, t, obs, ls, made,
            scm(t, obs, ls, B.copies.t(B.mixins.of(B.lz.ord(B.lz.at(ls, host)), obs, B.path.last(path)), host, obs, made, U32.add(U32.from_nat(List.length(&2, B.Ob, obs)), U32.from_nat(List.length(&2, B.Ob, made)))), hobs,
              ctm(B.mixins.of(B.lz.ord(B.lz.at(ls, host)), obs, B.path.last(path)), host, obs, made, U32.add(U32.from_nat(List.length(&2, B.Ob, obs)), U32.from_nat(List.length(&2, B.Ob, made))), hobs, hm)),
            scm(t, obs, ls, made, hobs, hm))

def sgm_k(c: Bool, +k: Nat, +als: List<&2, B.Al>, +obs: List<&2, B.Ob>, +npss: List<&2, List<&2, U32>>, +nls: List<&2, Maybe<&2, B.Lz>>, +made: List<&2, B.Ob>,
    +h: {B.obs.mems.inline(obs) == True{} : Bool}, ih: {B.obs.mems.inline(B.sy.obs(B.syn.go(k, als, List.append(&2, B.Ob, obs, List.reverse(&2, B.Ob, made)), npss, nls))) == True{} : Bool}) ->
    {B.obs.mems.inline(B.sy.obs(sgk(c, k, als, obs, npss, nls, made))) == True{} : Bool}:
  match c:
    case True{}:
      h
    case False{}:
      ih

def sgm(n: Nat, +als: List<&2, B.Al>, +obs: List<&2, B.Ob>, +pss: List<&2, List<&2, U32>>, +ls: List<&2, Maybe<&2, B.Lz>>, +h: {B.obs.mems.inline(obs) == True{} : Bool}) ->
    {B.obs.mems.inline(B.sy.obs(B.syn.go(n, als, obs, pss, ls))) == True{} : Bool}:
  match n:
    case 0n:
      h
    case 1n+(+k):
      sgm_k(Bool.and(B.obs.none(B.syn.copies(obs, obs, B.lins(B.pids(obs, als, obs, ls)), B.syn.round(obs, obs, B.lins(B.pids(obs, als, obs, ls)), Nil{}))), B.pss.eq(B.pids(obs, als, obs, ls), pss)), k, als, obs, B.pids(obs, als, obs, ls), B.lins(B.pids(obs, als, obs, ls)), B.syn.copies(obs, obs, B.lins(B.pids(obs, als, obs, ls)), B.syn.round(obs, obs, B.lins(B.pids(obs, als, obs, ls)), Nil{})), h,
        sgm(k, als, List.append(&2, B.Ob, obs, List.reverse(&2, B.Ob, B.syn.copies(obs, obs, B.lins(B.pids(obs, als, obs, ls)), B.syn.round(obs, obs, B.lins(B.pids(obs, als, obs, ls)), Nil{})))), B.pids(obs, als, obs, ls), B.lins(B.pids(obs, als, obs, ls)),
          obsm_app(obs, List.reverse(&2, B.Ob, B.syn.copies(obs, obs, B.lins(B.pids(obs, als, obs, ls)), B.syn.round(obs, obs, B.lins(B.pids(obs, als, obs, ls)), Nil{}))), h,
            obsm_rgo(B.syn.copies(obs, obs, B.lins(B.pids(obs, als, obs, ls)), B.syn.round(obs, obs, B.lins(B.pids(obs, als, obs, ls)), Nil{})), Nil{},
              scm(obs, obs, B.lins(B.pids(obs, als, obs, ls)), B.syn.round(obs, obs, B.lins(B.pids(obs, als, obs, ls)), Nil{}), h, srm(obs, obs, B.lins(B.pids(obs, als, obs, ls)), Nil{}, {==})), {==}))))

def mam(os: List<&2, B.Ob>, +obs: List<&2, B.Ob>, +pss: List<&2, List<&2, U32>>, +h: {B.obs.mems.inline(os) == True{} : Bool}) -> {B.obs.mems.inline(B.made.abs(os, obs, pss)) == True{} : Bool}:
  match os:
    case Nil{}:
      {==}
    case Con{o, +t}:
      match o:
        case B.Ob{+id, +host, +path, +abs, parents, +mems, +no, +kind, +tpl}:
          and_intro(B.nodes.inline(mems), B.obs.mems.inline(B.made.abs(t, obs, pss)), and_l(B.nodes.inline(mems), B.obs.mems.inline(t), h),
            mam(t, obs, pss, and_r(B.nodes.inline(mems), B.obs.mems.inline(t), h)))

def Laws.inline.members(trees, als, h):
  mam(B.sy.obs(B.syn.of(als, B.obs(trees))), B.sy.obs(B.syn.of(als, B.obs(trees))), B.sy.pss(B.syn.of(als, B.obs(trees))),
    sgm(Nat.add(2n, Nat.add(List.length(&2, B.Ob, B.obs(trees)), List.length(&2, B.Ob, B.obs(trees)))), als, B.obs(trees), Nil{}, Nil{}, obsm_il(trees, h)))

# The folds' maps: each entry a member's name

def eil(e: B.En) -> Bool:
  match e:
    case B.En{name, chain, +no, +what}:
      B.inline(name)

def fdil(d: B.Fd) -> Bool:
  match d:
    case B.Fd{map, fes, ix}:
      B.ens.inline(map)

def ens_cons(e: B.En, +t: List<&2, B.En>, +he: {eil(e) == True{} : Bool}, +ht: {B.ens.inline(t) == True{} : Bool}) -> {B.ens.inline(Con{e, t}) == True{} : Bool}:
  match e:
    case B.En{+name, +chain, +no, +what}:
      and_intro(B.inline(name), B.ens.inline(t), he, ht)

def esk(+c: Bool, +x: B.En, +t: List<&2, B.En>, +e: B.En, +n: List<&2, U32>) -> List<&2, B.En>:
  B.when(List<&2, B.En>, c, u => Con{e, t}, u => Con{x, B.en.set(t, e, n)})

def es_k(c: Bool, +x: B.En, +t: List<&2, B.En>, +e: B.En, +n: List<&2, U32>, +hx: {eil(x) == True{} : Bool}, +ht: {B.ens.inline(t) == True{} : Bool},
    +he: {eil(e) == True{} : Bool}, +ih: {B.ens.inline(B.en.set(t, e, n)) == True{} : Bool}) -> {B.ens.inline(esk(c, x, t, e, n)) == True{} : Bool}:
  match c:
    case True{}:
      ens_cons(e, t, he, ht)
    case False{}:
      ens_cons(x, B.en.set(t, e, n), hx, ih)

def enset_il(es: List<&2, B.En>, +e: B.En, +n: List<&2, U32>, +hes: {B.ens.inline(es) == True{} : Bool}, +he: {eil(e) == True{} : Bool}) ->
    {B.ens.inline(B.en.set(es, e, n)) == True{} : Bool}:
  match es:
    case Nil{}:
      ens_cons(e, Nil{}, he, {==})
    case Con{x, +t}:
      match x:
        case B.En{+name, +chain, +no, +what}:
          es_k(B.same(name, n), B.En{name, chain, no, what}, t, e, n, and_l(B.inline(name), B.ens.inline(t), hes), and_r(B.inline(name), B.ens.inline(t), hes), he,
            enset_il(t, e, n, and_r(B.inline(name), B.ens.inline(t), hes), he))

def fddefat_il(+q: U32, +no: B.Loc, +name: List<&2, U32>, +what: U32, e: B.En, +map: List<&2, B.En>, +fes: List<&2, B.Fe>, +ix: B.Ht<B.En>,
    +hn: {B.inline(name) == True{} : Bool}, +hm: {B.ens.inline(map) == True{} : Bool}) -> {fdil(B.fd.def.at(q, no, name, what, e, map, fes, ix)) == True{} : Bool}:
  match e:
    case B.En{+n, +chain, +eno, +was}:
      enset_il(map, B.En{name, [q], no, what}, name, hm, hn)

def fuk(+c1: Bool, +c2: Bool, +q: U32, +no: B.Loc, +name: List<&2, U32>, +what: U32, +chain: List<&2, U32>, +eno: B.Loc, +was: U32, +map: List<&2, B.En>, +fes: List<&2, B.Fe>, +ix: B.Ht<B.En>) -> B.Fd:
  B.when(B.Fd, c1, u => B.Fd{map, Con{B.Fe{q, no, 3, name, True{}, B.en.head(chain), eno, what, was}, fes}, ix},
    u => B.when(B.Fd, c2,
      v => B.Fd{B.en.set(map, B.En{name, chain, no, was}, name), Con{B.Fe{q, no, 1, name, True{}, q, eno, what, was}, fes}, B.ix.put(ix, B.En{name, chain, no, was})},
      v => B.Fd{B.en.set(map, B.En{name, Con{q, chain}, no, was}, name), fes, B.ix.put(ix, B.En{name, Con{q, chain}, no, was})}))

def fu_il(c1: Bool, c2: Bool, +q: U32, +no: B.Loc, +name: List<&2, U32>, +what: U32, +chain: List<&2, U32>, +eno: B.Loc, +was: U32, +map: List<&2, B.En>, +fes: List<&2, B.Fe>, +ix: B.Ht<B.En>,
    +hn: {B.inline(name) == True{} : Bool}, +hm: {B.ens.inline(map) == True{} : Bool}) -> {fdil(fuk(c1, c2, q, no, name, what, chain, eno, was, map, fes, ix)) == True{} : Bool}:
  match c1 c2:
    case True{} _:
      hm
    case False{} True{}:
      enset_il(map, B.En{name, chain, no, was}, name, hm, hn)
    case False{} False{}:
      enset_il(map, B.En{name, Con{q, chain}, no, was}, name, hm, hn)

def fdupd_il(+q: U32, +no: B.Loc, +name: List<&2, U32>, +what: U32, e: B.En, +map: List<&2, B.En>, +fes: List<&2, B.Fe>, +ix: B.Ht<B.En>,
    +hn: {B.inline(name) == True{} : Bool}, +hm: {B.ens.inline(map) == True{} : Bool}) -> {fdil(B.fd.upd.at(q, no, name, what, e, map, fes, ix)) == True{} : Bool}:
  match e:
    case B.En{+n, +chain, +eno, +was}:
      fu_il(Bool.not(B.upd.fits(what, was)), U32.is_eq(B.en.head(chain), q), q, no, name, what, chain, eno, was, map, fes, ix, hn, hm)

def fdk(+m: Maybe<&2, B.En>, +q: U32, +upd: Bool, +name: List<&2, U32>, +no: B.Loc, +what: U32, +map: List<&2, B.En>, +fes: List<&2, B.Fe>, +ix: B.Ht<B.En>) -> B.Fd:
  B.on.maybe(B.En, B.Fd, m,
    u => B.when(B.Fd, upd,
      v => B.Fd{Con{B.En{name, [q], no, what}, map}, Con{B.Fe{q, no, 2, name, True{}, q, no, what, what}, fes}, B.ix.put(ix, B.En{name, [q], no, what})},
      v => B.Fd{Con{B.En{name, [q], no, what}, map}, fes, B.ix.put(ix, B.En{name, [q], no, what})}),
    +e => B.when(B.Fd, upd, v => B.fd.upd.at(q, no, name, what, e, map, fes, ix), v => B.fd.def.at(q, no, name, what, e, map, fes, ix)))

def fdk_il(m: Maybe<&2, B.En>, +q: U32, upd: Bool, +name: List<&2, U32>, +no: B.Loc, +what: U32, +map: List<&2, B.En>, +fes: List<&2, B.Fe>, +ix: B.Ht<B.En>,
    +hn: {B.inline(name) == True{} : Bool}, +hm: {B.ens.inline(map) == True{} : Bool}) -> {fdil(fdk(m, q, upd, name, no, what, map, fes, ix)) == True{} : Bool}:
  match m:
    case None{}:
      match upd:
        case True{}:
          and_intro(B.inline(name), B.ens.inline(map), hn, hm)
        case False{}:
          and_intro(B.inline(name), B.ens.inline(map), hn, hm)
    case Some{+e}:
      match upd:
        case True{}:
          fdupd_il(q, no, name, what, e, map, fes, ix, hn, hm)
        case False{}:
          fddefat_il(q, no, name, what, e, map, fes, ix, hn, hm)

def fddef_il(+q: U32, +upd: Bool, +name: List<&2, U32>, +no: B.Loc, +what: U32, d: B.Fd, +hn: {B.inline(name) == True{} : Bool}, +hd: {fdil(d) == True{} : Bool}) ->
    {fdil(B.fd.def(q, upd, name, no, what, d)) == True{} : Bool}:
  match d:
    case B.Fd{+map, +fes, +ix}:
      fdk_il(B.ix.find(ix, name), q, upd, name, no, what, map, fes, ix, hn, hd)

def fdmems_il(ns: List<&2, B.Node>, +q: U32, +d: B.Fd, +hns: {B.nodes.inline(ns) == True{} : Bool}, +hd: {fdil(d) == True{} : Bool}) -> {fdil(B.fd.mems(ns, q, d)) == True{} : Bool}:
  match ns:
    case Nil{}:
      hd
    case Con{nd, +t}:
      match nd:
        case B.NDef{+share, +upd, +name, +rest, +params, +body, +no, +ind, +what}:
          fdmems_il(t, q, B.fd.def(q, upd, name, no, what, d), and_r(Bool.and(Bool.and(B.inline(name), B.inline(rest)), B.bls.inline(body)), B.nodes.inline(t), hns),
            fddef_il(q, upd, name, no, what, d, and_l(B.inline(name), B.inline(rest), and_l(Bool.and(B.inline(name), B.inline(rest)), B.bls.inline(body),
              and_l(Bool.and(Bool.and(B.inline(name), B.inline(rest)), B.bls.inline(body)), B.nodes.inline(t), hns))), hd))
        case B.NObj{+abs, +ext, +name, +parents, +kids, +no}:
          fdmems_il(t, q, d, and_r(Bool.and(B.inline(name), B.nodes.inline(kids)), B.nodes.inline(t), hns), hd)
        case B.NImport{+txt, +no}:
          fdmems_il(t, q, d, and_r(B.inline(txt), B.nodes.inline(t), hns), hd)
        case B.NDecl{+names, +no}:
          fdmems_il(t, q, d, hns, hd)
        case B.NBad{+txt, +no}:
          fdmems_il(t, q, d, hns, hd)
        case B.NErr{+msg, +no}:
          fdmems_il(t, q, d, hns, hd)
        case B.NBend{+lines, +no}:
          fdmems_il(t, q, d, hns, hd)

def fdobs_il(qs: List<&2, U32>, +obs: List<&2, B.Ob>, +d: B.Fd, +hobs: {B.obs.mems.inline(obs) == True{} : Bool}, +hd: {fdil(d) == True{} : Bool}) ->
    {fdil(B.fd.obs(qs, obs, d)) == True{} : Bool}:
  match qs:
    case Nil{}:
      hd
    case Con{+q, +t}:
      fdobs_il(t, obs, B.fd.mems(B.ob.mems(B.ob.at(obs, q)), q, d), hobs, fdmems_il(B.ob.mems(B.ob.at(obs, q)), q, d, obm_at(obs, q, hobs), hd))

def ens_rgo(xs: List<&2, B.En>, +acc: List<&2, B.En>, +hx: {B.ens.inline(xs) == True{} : Bool}, +ha: {B.ens.inline(acc) == True{} : Bool}) ->
    {B.ens.inline(List.reverse.go(&2, B.En, xs, acc)) == True{} : Bool}:
  match xs:
    case Nil{}:
      ha
    case Con{x, +t}:
      match x:
        case B.En{+name, +chain, +no, +what}:
          ens_rgo(t, Con{B.En{name, chain, no, what}, acc}, and_r(B.inline(name), B.ens.inline(t), hx),
            and_intro(B.inline(name), B.ens.inline(acc), and_l(B.inline(name), B.ens.inline(t), hx), ha))

def fdsome(d: B.Fd, +h: {fdil(B.fd.done(d)) == True{} : Bool}) -> {B.fd.inline(Some{B.fd.done(d)}) == True{} : Bool}:
  match d:
    case B.Fd{+map, +fes, +ix}:
      h

def fddone_il(d: B.Fd, +h: {fdil(d) == True{} : Bool}) -> {fdil(B.fd.done(d)) == True{} : Bool}:
  match d:
    case B.Fd{+map, +fes, +ix}:
      ens_rgo(map, Nil{}, h, {==})

def flk(+c: Bool, +ord: List<&2, U32>, +obs: List<&2, B.Ob>) -> Maybe<&2, B.Fd>:
  B.when(Maybe<&2, B.Fd>, c, u => Some{B.fd.done(B.fd.obs(List.reverse(&2, U32, ord), obs, B.Fd{Nil{}, Nil{}, B.ht.for(B.En, B.mems.count(ord, obs))}))}, u => None{})

def fl_k(c: Bool, +ord: List<&2, U32>, +obs: List<&2, B.Ob>, +hobs: {B.obs.mems.inline(obs) == True{} : Bool}) -> {B.fd.inline(flk(c, ord, obs)) == True{} : Bool}:
  match c:
    case True{}:
      fdsome(B.fd.obs(List.reverse(&2, U32, ord), obs, B.Fd{Nil{}, Nil{}, B.ht.for(B.En, B.mems.count(ord, obs))}),
        fddone_il(B.fd.obs(List.reverse(&2, U32, ord), obs, B.Fd{Nil{}, Nil{}, B.ht.for(B.En, B.mems.count(ord, obs))}),
          fdobs_il(List.reverse(&2, U32, ord), obs, B.Fd{Nil{}, Nil{}, B.ht.for(B.En, B.mems.count(ord, obs))}, hobs, {==})))
    case False{}:
      {==}

def fold_il(+obs: List<&2, B.Ob>, l: Maybe<&2, B.Lz>, +hobs: {B.obs.mems.inline(obs) == True{} : Bool}) -> {B.fd.inline(B.fold(obs, l)) == True{} : Bool}:
  match l:
    case None{}:
      {==}
    case Some{z}:
      match z:
        case B.Lz{+ok, +ord}:
          fl_k(ok, ord, obs, hobs)

def fgk2(+c: Bool, +obs: List<&2, B.Ob>, +l: Maybe<&2, B.Lz>) -> Maybe<&2, B.Fd>:
  B.when(Maybe<&2, B.Fd>, c, u => None{}, u => B.fold(obs, l))

def fg2_il(c: Bool, +obs: List<&2, B.Ob>, +l: Maybe<&2, B.Lz>, +hobs: {B.obs.mems.inline(obs) == True{} : Bool}) -> {B.fd.inline(fgk2(c, obs, l)) == True{} : Bool}:
  match c:
    case True{}:
      {==}
    case False{}:
      fold_il(obs, l, hobs)

def foldsgo_il(ls: List<&2, Maybe<&2, B.Lz>>, +obs: List<&2, B.Ob>, +bad: List<&2, U32>, +id: U32, +hobs: {B.obs.mems.inline(obs) == True{} : Bool}) ->
    {B.fds.inline(B.folds.go(ls, obs, bad, id)) == True{} : Bool}:
  match ls:
    case Nil{}:
      {==}
    case Con{+l, +t}:
      and_intro(B.fd.inline(fgk2(Bool.or(Bool.not(B.is.object(B.ob.kind(B.ob.at(obs, id)))), B.has(bad, id)), obs, l)), B.fds.inline(B.folds.go(t, obs, bad, U32.add(id, 1))),
        fg2_il(Bool.or(Bool.not(B.is.object(B.ob.kind(B.ob.at(obs, id)))), B.has(bad, id)), obs, l, hobs), foldsgo_il(t, obs, bad, U32.add(id, 1), hobs))

def Laws.inline.folds(ls, obs, bad, h):
  foldsgo_il(ls, obs, bad, 0, h)

# The folds chained (`folds.chained`)
# -----------------------------------
#
# Every object an entry's chain names has a definition of its name: an
# entry is made by an object's member of that name, and an update adds
# its object to the chain it finds in the fold's index, which is kept
# chained beside the map (`fdok`), as the trie's laws twinned for entries
# carry it through a put and a lookup (`hch_put`, `hch_leaf`, the twins
# of `hw_put`, `hw_leaf`); a lookup finds an entry of the name sought
# (`enfind_ch`). The mirrors are `inline.folds`' (`fuk`, `fdk`, `esk`,
# `flk`, `fgk2`).

# a table of entries chained, each of its leaves'
def hch(t: B.Ht<B.En>, +obs: List<&2, B.Ob>) -> Bool:
  match t:
    case B.HLeaf{es}:
      B.ens.chained(es, obs)
    case B.HNode{z, o}:
      Bool.and(hch(z, obs), hch(o, obs))

def hch_empty(d: Nat, +obs: List<&2, B.Ob>) -> {hch(B.ht.empty(B.En, d), obs) == True{} : Bool}:
  match d:
    case 0n:
      {==}
    case 1n+(+k):
      and_intro(hch(B.ht.empty(B.En, k), obs), hch(B.ht.empty(B.En, k), obs), hch_empty(k, obs), hch_empty(k, obs))

def join_hch(c: Bool, +x: B.Ht<B.En>, +y: B.Ht<B.En>, +obs: List<&2, B.Ob>, +hx: {hch(x, obs) == True{} : Bool}, +hy: {hch(y, obs) == True{} : Bool}) ->
    {hch(B.ht.join(B.En, c, x, y), obs) == True{} : Bool}:
  match c:
    case True{}:
      and_intro(hch(x, obs), hch(y, obs), hx, hy)
    case False{}:
      and_intro(hch(y, obs), hch(x, obs), hy, hx)

def pick_hch(c: Bool, +z: B.Ht<B.En>, +o: B.Ht<B.En>, +obs: List<&2, B.Ob>, +h: {hch(B.HNode{z, o}, obs) == True{} : Bool}) ->
    {hch(B.ht.pick(B.En, c, z, o), obs) == True{} : Bool}:
  match c:
    case True{}:
      and_l(hch(z, obs), hch(o, obs), h)
    case False{}:
      and_r(hch(z, obs), hch(o, obs), h)

def pick_hch2(c: Bool, +z: B.Ht<B.En>, +o: B.Ht<B.En>, +obs: List<&2, B.Ob>, +h: {hch(B.HNode{z, o}, obs) == True{} : Bool}) ->
    {hch(B.ht.pick(B.En, c, o, z), obs) == True{} : Bool}:
  match c:
    case True{}:
      and_r(hch(z, obs), hch(o, obs), h)
    case False{}:
      and_l(hch(z, obs), hch(o, obs), h)

# an entry chained put in a table chained
def hch_put(fuel: Nat, t: B.Ht<B.En>, +b: U32, +h: U32, +e: B.En, +obs: List<&2, B.Ob>, +he: {B.en.chained(e, obs) == True{} : Bool},
    +ht: {hch(t, obs) == True{} : Bool}) -> {hch(B.ht.put.go(B.En, fuel, t, b, h, e), obs) == True{} : Bool}:
  match fuel:
    case 0n:
      match t:
        case B.HLeaf{+es}:
          and_intro(B.en.chained(e, obs), B.ens.chained(es, obs), he, ht)
        case B.HNode{z, o}:
          and_intro(B.en.chained(e, obs), True{}, he, {==})
    case 1n+(+k):
      match t:
        case B.HLeaf{+es}:
          and_intro(B.en.chained(e, obs), B.ens.chained(es, obs), he, ht)
        case B.HNode{+z, +o}:
          join_hch(U32.is_eq(b, 0), B.ht.put.go(B.En, k, B.ht.pick(B.En, U32.is_eq(b, 0), z, o), nb(h), nh(h), e), B.ht.pick(B.En, U32.is_eq(b, 0), o, z), obs,
            hch_put(k, B.ht.pick(B.En, U32.is_eq(b, 0), z, o), nb(h), nh(h), e, obs, he, pick_hch(U32.is_eq(b, 0), z, o, obs, ht)),
            pick_hch2(U32.is_eq(b, 0), z, o, obs, ht))

# a leaf of a table chained: entries chained
def hch_leaf(fuel: Nat, t: B.Ht<B.En>, +b: U32, +h: U32, +obs: List<&2, B.Ob>, +ht: {hch(t, obs) == True{} : Bool}) ->
    {B.ens.chained(B.ht.leaf.go(B.En, fuel, t, b, h), obs) == True{} : Bool}:
  match fuel:
    case 0n:
      match t:
        case B.HLeaf{es}:
          ht
        case B.HNode{z, o}:
          {==}
    case 1n+(+k):
      match t:
        case B.HLeaf{es}:
          ht
        case B.HNode{+z, +o}:
          hch_leaf(k, B.ht.pick(B.En, U32.is_eq(b, 0), z, o), nb(h), nh(h), obs, pick_hch(U32.is_eq(b, 0), z, o, obs, ht))

# a lookup's result: none, or an entry whose chain is chained for the
# name sought
def mch(m: Maybe<&2, B.En>, +obs: List<&2, B.Ob>, +n: List<&2, U32>) -> Bool:
  match m:
    case None{}:
      True{}
    case Some{e}:
      match e:
        case B.En{name, chain, +no, +what}:
          B.chain.ok(chain, obs, n)

def efk_ch(c: Bool, +name: List<&2, U32>, +chain: List<&2, U32>, +no: B.Loc, +what: U32, t: List<&2, B.En>, +obs: List<&2, B.Ob>, +n: List<&2, U32>,
    eq: {c == B.same(name, n) : Bool}, hx: {B.chain.ok(chain, obs, name) == True{} : Bool}, ih: {mch(B.en.find(t, n), obs, n) == True{} : Bool}) ->
    {mch(B.when(Maybe<&2, B.En>, c, u => Some{B.En{name, chain, no, what}}, u => B.en.find(t, n)), obs, n) == True{} : Bool}:
  match c:
    case True{}:
      %Laws.names.same_eq(name, n, Equal.sym(Bool, True{}, B.same(name, n), eq)) : {B.chain.ok(chain, obs, _) == True{} : Bool}
      hx
    case False{}:
      ih

# an entry found among entries chained: chained for the name sought
def enfind_ch(es: List<&2, B.En>, +obs: List<&2, B.Ob>, +n: List<&2, U32>, +h: {B.ens.chained(es, obs) == True{} : Bool}) ->
    {mch(B.en.find(es, n), obs, n) == True{} : Bool}:
  match es:
    case Nil{}:
      {==}
    case Con{x, +t}:
      match x:
        case B.En{+name, +chain, +no, +what}:
          efk_ch(B.same(name, n), name, chain, no, what, t, obs, n, {==},
            and_l(B.en.chained(B.En{name, chain, no, what}, obs), B.ens.chained(t, obs), h),
            enfind_ch(t, obs, n, and_r(B.en.chained(B.En{name, chain, no, what}, obs), B.ens.chained(t, obs), h)))

def ixfind_ch(+ix: B.Ht<B.En>, +obs: List<&2, B.Ob>, +n: List<&2, U32>, +h: {hch(ix, obs) == True{} : Bool}) ->
    {mch(B.ix.find(ix, n), obs, n) == True{} : Bool}:
  enfind_ch(B.ht.leaf(B.En, ix, U32.and(B.hash.name(n), 1), B.hash.name(n)), obs, n, hch_leaf(32n, ix, U32.and(B.hash.name(n), 1), B.hash.name(n), obs, h))

def ixput_ch(ix: B.Ht<B.En>, +e: B.En, +obs: List<&2, B.Ob>, +he: {B.en.chained(e, obs) == True{} : Bool}, +hi: {hch(ix, obs) == True{} : Bool}) ->
    {hch(B.ix.put(ix, e), obs) == True{} : Bool}:
  match e:
    case B.En{+name, +chain, +no, +what}:
      hch_put(32n, ix, U32.and(B.hash.name(name), 1), B.hash.name(name), B.En{name, chain, no, what}, obs, he, hi)

def es_ch(c: Bool, +x: B.En, +t: List<&2, B.En>, +e: B.En, +n: List<&2, U32>, +obs: List<&2, B.Ob>, +hx: {B.en.chained(x, obs) == True{} : Bool},
    +ht: {B.ens.chained(t, obs) == True{} : Bool}, +he: {B.en.chained(e, obs) == True{} : Bool}, +ih: {B.ens.chained(B.en.set(t, e, n), obs) == True{} : Bool}) ->
    {B.ens.chained(esk(c, x, t, e, n), obs) == True{} : Bool}:
  match c:
    case True{}:
      and_intro(B.en.chained(e, obs), B.ens.chained(t, obs), he, ht)
    case False{}:
      and_intro(B.en.chained(x, obs), B.ens.chained(B.en.set(t, e, n), obs), hx, ih)

def enset_ch(es: List<&2, B.En>, +e: B.En, +n: List<&2, U32>, +obs: List<&2, B.Ob>, +hes: {B.ens.chained(es, obs) == True{} : Bool},
    +he: {B.en.chained(e, obs) == True{} : Bool}) -> {B.ens.chained(B.en.set(es, e, n), obs) == True{} : Bool}:
  match es:
    case Nil{}:
      and_intro(B.en.chained(e, obs), True{}, he, {==})
    case Con{x, +t}:
      match x:
        case B.En{+name, +chain, +no, +what}:
          es_ch(B.same(name, n), B.En{name, chain, no, what}, t, e, n, obs,
            and_l(B.en.chained(B.En{name, chain, no, what}, obs), B.ens.chained(t, obs), hes),
            and_r(B.en.chained(B.En{name, chain, no, what}, obs), B.ens.chained(t, obs), hes), he,
            enset_ch(t, e, n, obs, and_r(B.en.chained(B.En{name, chain, no, what}, obs), B.ens.chained(t, obs), hes), he))

# a fold's state chained: its map and its index
def fdok(d: B.Fd, +obs: List<&2, B.Ob>) -> Bool:
  match d:
    case B.Fd{map, fes, ix}:
      Bool.and(B.ens.chained(map, obs), hch(ix, obs))

# an object's own entry, made by its member of the name
def one_ch(+q: U32, +name: List<&2, U32>, +no: B.Loc, +what: U32, +obs: List<&2, B.Ob>, +hq: {Maybe.is_some(&2, B.Node, B.mem.find(B.ob.mems(B.ob.at(obs, q)), name)) == True{} : Bool}) ->
    {B.en.chained(B.En{name, [q], no, what}, obs) == True{} : Bool}:
  and_intro(Maybe.is_some(&2, B.Node, B.mem.find(B.ob.mems(B.ob.at(obs, q)), name)), True{}, hq, {==})

def ok_defs(cs: List<&2, U32>, +obs: List<&2, B.Ob>, +n: List<&2, U32>, +h: {B.chain.ok(cs, obs, n) == True{} : Bool}) ->
    {B.chain.defines(cs, obs, n) == True{} : Bool}:
  match cs:
    case Nil{}:
      {==}
    case Con{+c, +t}:
      h

def fddefat_ch(+q: U32, +no: B.Loc, +name: List<&2, U32>, +what: U32, e: B.En, +map: List<&2, B.En>, +fes: List<&2, B.Fe>, +ix: B.Ht<B.En>, +obs: List<&2, B.Ob>,
    +hq: {Maybe.is_some(&2, B.Node, B.mem.find(B.ob.mems(B.ob.at(obs, q)), name)) == True{} : Bool}, +hm: {B.ens.chained(map, obs) == True{} : Bool}, +hi: {hch(ix, obs) == True{} : Bool}) ->
    {fdok(B.fd.def.at(q, no, name, what, e, map, fes, ix), obs) == True{} : Bool}:
  match e:
    case B.En{+n, +chain, +eno, +was}:
      and_intro(B.ens.chained(B.en.set(map, B.En{name, [q], no, what}, name), obs), hch(B.ix.put(ix, B.En{name, [q], no, what}), obs),
        enset_ch(map, B.En{name, [q], no, what}, name, obs, hm, one_ch(q, name, no, what, obs, hq)),
        ixput_ch(ix, B.En{name, [q], no, what}, obs, one_ch(q, name, no, what, obs, hq), hi))

def fu_ch(c1: Bool, c2: Bool, +q: U32, +no: B.Loc, +name: List<&2, U32>, +what: U32, +chain: List<&2, U32>, +eno: B.Loc, +was: U32, +map: List<&2, B.En>, +fes: List<&2, B.Fe>,
    +ix: B.Ht<B.En>, +obs: List<&2, B.Ob>, +hq: {Maybe.is_some(&2, B.Node, B.mem.find(B.ob.mems(B.ob.at(obs, q)), name)) == True{} : Bool}, +hc: {B.chain.ok(chain, obs, name) == True{} : Bool},
    +hm: {B.ens.chained(map, obs) == True{} : Bool}, +hi: {hch(ix, obs) == True{} : Bool}) ->
    {fdok(fuk(c1, c2, q, no, name, what, chain, eno, was, map, fes, ix), obs) == True{} : Bool}:
  match c1 c2:
    case True{} _:
      and_intro(B.ens.chained(map, obs), hch(ix, obs), hm, hi)
    case False{} True{}:
      and_intro(B.ens.chained(B.en.set(map, B.En{name, chain, no, was}, name), obs), hch(B.ix.put(ix, B.En{name, chain, no, was}), obs),
        enset_ch(map, B.En{name, chain, no, was}, name, obs, hm, hc), ixput_ch(ix, B.En{name, chain, no, was}, obs, hc, hi))
    case False{} False{}:
      and_intro(B.ens.chained(B.en.set(map, B.En{name, Con{q, chain}, no, was}, name), obs), hch(B.ix.put(ix, B.En{name, Con{q, chain}, no, was}), obs),
        enset_ch(map, B.En{name, Con{q, chain}, no, was}, name, obs, hm, and_intro(Maybe.is_some(&2, B.Node, B.mem.find(B.ob.mems(B.ob.at(obs, q)), name)), B.chain.defines(chain, obs, name), hq, ok_defs(chain, obs, name, hc))),
        ixput_ch(ix, B.En{name, Con{q, chain}, no, was}, obs, and_intro(Maybe.is_some(&2, B.Node, B.mem.find(B.ob.mems(B.ob.at(obs, q)), name)), B.chain.defines(chain, obs, name), hq, ok_defs(chain, obs, name, hc)), hi))

def fdupd_ch(+q: U32, +no: B.Loc, +name: List<&2, U32>, +what: U32, e: B.En, +map: List<&2, B.En>, +fes: List<&2, B.Fe>, +ix: B.Ht<B.En>, +obs: List<&2, B.Ob>,
    +hq: {Maybe.is_some(&2, B.Node, B.mem.find(B.ob.mems(B.ob.at(obs, q)), name)) == True{} : Bool}, +hc: {mch(Some{e}, obs, name) == True{} : Bool}, +hm: {B.ens.chained(map, obs) == True{} : Bool}, +hi: {hch(ix, obs) == True{} : Bool}) ->
    {fdok(B.fd.upd.at(q, no, name, what, e, map, fes, ix), obs) == True{} : Bool}:
  match e:
    case B.En{+n, +chain, +eno, +was}:
      fu_ch(Bool.not(B.upd.fits(what, was)), U32.is_eq(B.en.head(chain), q), q, no, name, what, chain, eno, was, map, fes, ix, obs, hq, hc, hm, hi)

def fdk_ch(m: Maybe<&2, B.En>, +q: U32, upd: Bool, +name: List<&2, U32>, +no: B.Loc, +what: U32, +map: List<&2, B.En>, +fes: List<&2, B.Fe>, +ix: B.Ht<B.En>, +obs: List<&2, B.Ob>,
    +hq: {Maybe.is_some(&2, B.Node, B.mem.find(B.ob.mems(B.ob.at(obs, q)), name)) == True{} : Bool}, +hm: {B.ens.chained(map, obs) == True{} : Bool}, +hi: {hch(ix, obs) == True{} : Bool}, +hmc: {mch(m, obs, name) == True{} : Bool}) ->
    {fdok(fdk(m, q, upd, name, no, what, map, fes, ix), obs) == True{} : Bool}:
  match m:
    case None{}:
      match upd:
        case True{}:
          and_intro(B.ens.chained(Con{B.En{name, [q], no, what}, map}, obs), hch(B.ix.put(ix, B.En{name, [q], no, what}), obs),
            and_intro(B.en.chained(B.En{name, [q], no, what}, obs), B.ens.chained(map, obs), one_ch(q, name, no, what, obs, hq), hm),
            ixput_ch(ix, B.En{name, [q], no, what}, obs, one_ch(q, name, no, what, obs, hq), hi))
        case False{}:
          and_intro(B.ens.chained(Con{B.En{name, [q], no, what}, map}, obs), hch(B.ix.put(ix, B.En{name, [q], no, what}), obs),
            and_intro(B.en.chained(B.En{name, [q], no, what}, obs), B.ens.chained(map, obs), one_ch(q, name, no, what, obs, hq), hm),
            ixput_ch(ix, B.En{name, [q], no, what}, obs, one_ch(q, name, no, what, obs, hq), hi))
    case Some{+e}:
      match upd:
        case True{}:
          fdupd_ch(q, no, name, what, e, map, fes, ix, obs, hq, hmc, hm, hi)
        case False{}:
          fddefat_ch(q, no, name, what, e, map, fes, ix, obs, hq, hm, hi)

def fddef_ch(+q: U32, +upd: Bool, +name: List<&2, U32>, +no: B.Loc, +what: U32, d: B.Fd, +obs: List<&2, B.Ob>, +hq: {Maybe.is_some(&2, B.Node, B.mem.find(B.ob.mems(B.ob.at(obs, q)), name)) == True{} : Bool},
    +hd: {fdok(d, obs) == True{} : Bool}) -> {fdok(B.fd.def(q, upd, name, no, what, d), obs) == True{} : Bool}:
  match d:
    case B.Fd{+map, +fes, +ix}:
      fdk_ch(B.ix.find(ix, name), q, upd, name, no, what, map, fes, ix, obs, hq, and_l(B.ens.chained(map, obs), hch(ix, obs), hd), and_r(B.ens.chained(map, obs), hch(ix, obs), hd),
        ixfind_ch(ix, obs, name, and_r(B.ens.chained(map, obs), hch(ix, obs), hd)))

# each definition among ns found in full
def dfd(ns: List<&2, B.Node>, +full: List<&2, B.Node>) -> Bool:
  match ns:
    case Nil{}:
      True{}
    case Con{nd, t}:
      match nd:
        case B.NDef{+share, +upd, +name, +rest, +params, +body, +no, +ind, +what}:
          Bool.and(Maybe.is_some(&2, B.Node, B.mem.find(full, name)), dfd(t, full))
        case _:
          dfd(t, full)

def mfc_k(c: Bool, +share: U32, +upd: Bool, +name: List<&2, U32>, +rest: List<&2, U32>, +params: List<&2, List<&2, U32>>, +body: List<&2, B.Bl>, +no: B.Loc, +ind: U32, +what: U32, full: List<&2, B.Node>, +n: List<&2, U32>,
    h: {Maybe.is_some(&2, B.Node, B.mem.find(full, n)) == True{} : Bool}) ->
    {Maybe.is_some(&2, B.Node, B.when(Maybe<&2, B.Node>, c, u => Some{B.NDef{share, upd, name, rest, params, body, no, ind, what}}, u => B.mem.find(full, n))) == True{} : Bool}:
  match c:
    case True{}:
      {==}
    case False{}:
      h

# a definition found stays found with a member before
def mf_cons(x: B.Node, +full: List<&2, B.Node>, +n: List<&2, U32>, +h: {Maybe.is_some(&2, B.Node, B.mem.find(full, n)) == True{} : Bool}) ->
    {Maybe.is_some(&2, B.Node, B.mem.find(Con{x, full}, n)) == True{} : Bool}:
  match x:
    case B.NDef{+share, +upd, +name, +rest, +params, +body, +no, +ind, +what}:
      mfc_k(B.same(name, n), share, upd, name, rest, params, body, no, ind, what, full, n, h)
    case B.NObj{+abs, +ext, +name, +parents, +kids, +no}:
      h
    case B.NImport{+txt, +no}:
      h
    case B.NDecl{+names, +no}:
      h
    case B.NBad{+txt, +no}:
      h
    case B.NErr{+msg, +no}:
      h
    case B.NBend{+lines, +no}:
      h

def dfd_cons(ns: List<&2, B.Node>, +x: B.Node, +full: List<&2, B.Node>, +h: {dfd(ns, full) == True{} : Bool}) -> {dfd(ns, Con{x, full}) == True{} : Bool}:
  match ns:
    case Nil{}:
      {==}
    case Con{nd, +t}:
      match nd:
        case B.NDef{+share, +upd, +name, +rest, +params, +body, +no, +ind, +what}:
          and_intro(Maybe.is_some(&2, B.Node, B.mem.find(Con{x, full}, name)), dfd(t, Con{x, full}),
            mf_cons(x, full, name, and_l(Maybe.is_some(&2, B.Node, B.mem.find(full, name)), dfd(t, full), h)),
            dfd_cons(t, x, full, and_r(Maybe.is_some(&2, B.Node, B.mem.find(full, name)), dfd(t, full), h)))
        case B.NObj{+abs, +ext, +name, +parents, +kids, +no}:
          dfd_cons(t, x, full, h)
        case B.NImport{+txt, +no}:
          dfd_cons(t, x, full, h)
        case B.NDecl{+names, +no}:
          dfd_cons(t, x, full, h)
        case B.NBad{+txt, +no}:
          dfd_cons(t, x, full, h)
        case B.NErr{+msg, +no}:
          dfd_cons(t, x, full, h)
        case B.NBend{+lines, +no}:
          dfd_cons(t, x, full, h)

# a definition is found among members holding it first
def mf_self(+share: U32, +upd: Bool, +name: List<&2, U32>, +rest: List<&2, U32>, +params: List<&2, List<&2, U32>>, +body: List<&2, B.Bl>, +no: B.Loc, +ind: U32, +what: U32, +t: List<&2, B.Node>) ->
    {Maybe.is_some(&2, B.Node, B.mem.find(Con{B.NDef{share, upd, name, rest, params, body, no, ind, what}, t}, name)) == True{} : Bool}:
  %Equal.sym(Bool, B.same(name, name), True{}, Laws.names.same_refl(name)) :
    {Maybe.is_some(&2, B.Node, B.when(Maybe<&2, B.Node>, _, u => Some{B.NDef{share, upd, name, rest, params, body, no, ind, what}}, u => B.mem.find(t, name))) == True{} : Bool}
  {==}

# each definition among members found among them
def dfd_self(ns: List<&2, B.Node>) -> {dfd(ns, ns) == True{} : Bool}:
  match ns:
    case Nil{}:
      {==}
    case Con{nd, +t}:
      match nd:
        case B.NDef{+share, +upd, +name, +rest, +params, +body, +no, +ind, +what}:
          and_intro(Maybe.is_some(&2, B.Node, B.mem.find(Con{B.NDef{share, upd, name, rest, params, body, no, ind, what}, t}, name)), dfd(t, Con{B.NDef{share, upd, name, rest, params, body, no, ind, what}, t}),
            mf_self(share, upd, name, rest, params, body, no, ind, what, t), dfd_cons(t, B.NDef{share, upd, name, rest, params, body, no, ind, what}, t, dfd_self(t)))
        case B.NObj{+abs, +ext, +name, +parents, +kids, +no}:
          dfd_cons(t, B.NObj{abs, ext, name, parents, kids, no}, t, dfd_self(t))
        case B.NImport{+txt, +no}:
          dfd_cons(t, B.NImport{txt, no}, t, dfd_self(t))
        case B.NDecl{+names, +no}:
          dfd_cons(t, B.NDecl{names, no}, t, dfd_self(t))
        case B.NBad{+txt, +no}:
          dfd_cons(t, B.NBad{txt, no}, t, dfd_self(t))
        case B.NErr{+msg, +no}:
          dfd_cons(t, B.NErr{msg, no}, t, dfd_self(t))
        case B.NBend{+lines, +no}:
          dfd_cons(t, B.NBend{lines, no}, t, dfd_self(t))

def fdmems_ch(ns: List<&2, B.Node>, +q: U32, +d: B.Fd, +obs: List<&2, B.Ob>, +hns: {dfd(ns, B.ob.mems(B.ob.at(obs, q))) == True{} : Bool},
    +hd: {fdok(d, obs) == True{} : Bool}) -> {fdok(B.fd.mems(ns, q, d), obs) == True{} : Bool}:
  match ns:
    case Nil{}:
      hd
    case Con{nd, +t}:
      match nd:
        case B.NDef{+share, +upd, +name, +rest, +params, +body, +no, +ind, +what}:
          fdmems_ch(t, q, B.fd.def(q, upd, name, no, what, d), obs, and_r(Maybe.is_some(&2, B.Node, B.mem.find(B.ob.mems(B.ob.at(obs, q)), name)), dfd(t, B.ob.mems(B.ob.at(obs, q))), hns),
            fddef_ch(q, upd, name, no, what, d, obs, and_l(Maybe.is_some(&2, B.Node, B.mem.find(B.ob.mems(B.ob.at(obs, q)), name)), dfd(t, B.ob.mems(B.ob.at(obs, q))), hns), hd))
        case B.NObj{+abs, +ext, +name, +parents, +kids, +no}:
          fdmems_ch(t, q, d, obs, hns, hd)
        case B.NImport{+txt, +no}:
          fdmems_ch(t, q, d, obs, hns, hd)
        case B.NDecl{+names, +no}:
          fdmems_ch(t, q, d, obs, hns, hd)
        case B.NBad{+txt, +no}:
          fdmems_ch(t, q, d, obs, hns, hd)
        case B.NErr{+msg, +no}:
          fdmems_ch(t, q, d, obs, hns, hd)
        case B.NBend{+lines, +no}:
          fdmems_ch(t, q, d, obs, hns, hd)

def fdobs_ch(qs: List<&2, U32>, +obs: List<&2, B.Ob>, +d: B.Fd, +hd: {fdok(d, obs) == True{} : Bool}) -> {fdok(B.fd.obs(qs, obs, d), obs) == True{} : Bool}:
  match qs:
    case Nil{}:
      hd
    case Con{+q, +t}:
      fdobs_ch(t, obs, B.fd.mems(B.ob.mems(B.ob.at(obs, q)), q, d), fdmems_ch(B.ob.mems(B.ob.at(obs, q)), q, d, obs, dfd_self(B.ob.mems(B.ob.at(obs, q))), hd))

def ens_rch(xs: List<&2, B.En>, +acc: List<&2, B.En>, +obs: List<&2, B.Ob>, +hx: {B.ens.chained(xs, obs) == True{} : Bool}, +ha: {B.ens.chained(acc, obs) == True{} : Bool}) ->
    {B.ens.chained(List.reverse.go(&2, B.En, xs, acc), obs) == True{} : Bool}:
  match xs:
    case Nil{}:
      ha
    case Con{x, +t}:
      match x:
        case B.En{+name, +chain, +no, +what}:
          ens_rch(t, Con{B.En{name, chain, no, what}, acc}, obs, and_r(B.en.chained(B.En{name, chain, no, what}, obs), B.ens.chained(t, obs), hx),
            and_intro(B.en.chained(B.En{name, chain, no, what}, obs), B.ens.chained(acc, obs), and_l(B.en.chained(B.En{name, chain, no, what}, obs), B.ens.chained(t, obs), hx), ha))

def fddone_ch(d: B.Fd, +obs: List<&2, B.Ob>, +h: {fdok(d, obs) == True{} : Bool}) -> {B.fd.chained(Some{B.fd.done(d)}, obs) == True{} : Bool}:
  match d:
    case B.Fd{+map, +fes, +ix}:
      ens_rch(map, Nil{}, obs, and_l(B.ens.chained(map, obs), hch(ix, obs), h), {==})

def fl_ch(c: Bool, +ord: List<&2, U32>, +obs: List<&2, B.Ob>) -> {B.fd.chained(flk(c, ord, obs), obs) == True{} : Bool}:
  match c:
    case True{}:
      fddone_ch(B.fd.obs(List.reverse(&2, U32, ord), obs, B.Fd{Nil{}, Nil{}, B.ht.for(B.En, B.mems.count(ord, obs))}), obs,
        fdobs_ch(List.reverse(&2, U32, ord), obs, B.Fd{Nil{}, Nil{}, B.ht.for(B.En, B.mems.count(ord, obs))},
          and_intro(True{}, hch(B.ht.for(B.En, B.mems.count(ord, obs)), obs), {==}, hch_empty(B.ht.depth(32n, U32.from_nat(B.mems.count(ord, obs))), obs))))
    case False{}:
      {==}

def fold_ch(+obs: List<&2, B.Ob>, l: Maybe<&2, B.Lz>) -> {B.fd.chained(B.fold(obs, l), obs) == True{} : Bool}:
  match l:
    case None{}:
      {==}
    case Some{z}:
      match z:
        case B.Lz{+ok, +ord}:
          fl_ch(ok, ord, obs)

def fg2_ch(c: Bool, +obs: List<&2, B.Ob>, +l: Maybe<&2, B.Lz>) -> {B.fd.chained(fgk2(c, obs, l), obs) == True{} : Bool}:
  match c:
    case True{}:
      {==}
    case False{}:
      fold_ch(obs, l)

def foldsgo_ch(ls: List<&2, Maybe<&2, B.Lz>>, +obs: List<&2, B.Ob>, +bad: List<&2, U32>, +id: U32) ->
    {B.fds.chained(B.folds.go(ls, obs, bad, id), obs) == True{} : Bool}:
  match ls:
    case Nil{}:
      {==}
    case Con{+l, +t}:
      and_intro(B.fd.chained(fgk2(Bool.or(Bool.not(B.is.object(B.ob.kind(B.ob.at(obs, id)))), B.has(bad, id)), obs, l), obs), B.fds.chained(B.folds.go(t, obs, bad, U32.add(id, 1)), obs),
        fg2_ch(Bool.or(Bool.not(B.is.object(B.ob.kind(B.ob.at(obs, id)))), B.has(bad, id)), obs, l), foldsgo_ch(t, obs, bad, U32.add(id, 1)))

def Laws.folds.chained(ls, obs, bad):
  foldsgo_ch(ls, obs, bad, 0)

# The copies found (`copies.found`)
# ---------------------------------
#
# Every copy a definition, no error assumed: every instance the worklist
# takes has its member. The finals' objects are their chains' heads
# (`folds.chained`); a prior's is in the chain of the entry `cx.find`
# finds, which the name tables of chained folds keep chained (`nxs_ch`),
# as the resolver walked for its instances alone shows (the `rril` walk's
# twin, its mirrors reused: only `rr.prior.of` makes an instance); and a
# member table finds what the members' search finds (`members.indexed`,
# `cxmem_eq`). The worklist's induction is `copies.defined`'s, unguarded.

# an instance found: its object has a definition of its name
def infd(i: B.In, +obs: List<&2, B.Ob>) -> Bool:
  match i:
    case B.In{name, +q, +prior}:
      Maybe.is_some(&2, B.Node, B.mem.find(B.ob.mems(B.ob.at(obs, q)), name))

def insfd(xs: List<&2, B.In>, +obs: List<&2, B.Ob>) -> Bool:
  match xs:
    case Nil{}:
      True{}
    case Con{i, t}:
      Bool.and(infd(i, obs), insfd(t, obs))

def rrfd(r: B.Rr, +obs: List<&2, B.Ob>) -> Bool:
  match r:
    case B.Rr{rt, ers, ins}:
      insfd(ins, obs)

def rbfd(b: B.Rb, +obs: List<&2, B.Ob>) -> Bool:
  match b:
    case B.Rb{ls, ers, ins}:
      insfd(ins, obs)

def insapp_fd(a: List<&2, B.In>, +b: List<&2, B.In>, +obs: List<&2, B.Ob>, +ha: {insfd(a, obs) == True{} : Bool}, +hb: {insfd(b, obs) == True{} : Bool}) ->
    {insfd(List.append(&2, B.In, a, b), obs) == True{} : Bool}:
  match a:
    case Nil{}:
      hb
    case Con{+i, +t}:
      and_intro(infd(i, obs), insfd(List.append(&2, B.In, t, b), obs), and_l(infd(i, obs), insfd(t, obs), ha), insapp_fd(t, b, obs, and_r(infd(i, obs), insfd(t, obs), ha), hb))

# the context's name tables chained, and its member tables of its objects
def hchs(ms: List<&2, B.Ht<B.En>>, +obs: List<&2, B.Ob>) -> Bool:
  match ms:
    case Nil{}:
      True{}
    case Con{m, t}:
      Bool.and(hch(m, obs), hchs(t, obs))

def cxch(c: B.Cx) -> Bool:
  match c:
    case B.Cx{+obs, ls, fs, als, paths, pss, nxs, mds}:
      hchs(nxs, obs)

def cxmds(c: B.Cx) -> List<&2, B.Ht<B.Node>>:
  match c:
    case B.Cx{obs, ls, fs, als, paths, pss, nxs, mds}:
      mds

def nxget_ch(ms: List<&2, B.Ht<B.En>>, n: Nat, +obs: List<&2, B.Ob>, +h: {hchs(ms, obs) == True{} : Bool}) ->
    {hch(B.nx.or(List.get(&2, B.Ht<B.En>, ms, n)), obs) == True{} : Bool}:
  match ms:
    case Nil{}:
      {==}
    case Con{+m, +t}:
      match n:
        case 0n:
          and_l(hch(m, obs), hchs(t, obs), h)
        case 1n+k:
          nxget_ch(t, k, obs, and_r(hch(m, obs), hchs(t, obs), h))

def cxnx_ch(+cx: B.Cx, +o: U32, +hc: {cxch(cx) == True{} : Bool}) -> {hch(B.cx.nx(cx, o), B.cx.obs(cx)) == True{} : Bool}:
  match cx:
    case B.Cx{+obs, +ls, +fs, +als, +paths, +pss, +nxs, +mds}:
      nxget_ch(nxs, U32.to_nat(o), obs, hc)

def cxfind_ch(+cx: B.Cx, +o: U32, +n: List<&2, U32>, +hc: {cxch(cx) == True{} : Bool}) -> {mch(B.cx.find(cx, o, n), B.cx.obs(cx), n) == True{} : Bool}:
  enfind_ch(B.ht.leaf(B.En, B.cx.nx(cx, o), U32.and(B.hash.name(n), 1), B.hash.name(n)), B.cx.obs(cx), n,
    hch_leaf(32n, B.cx.nx(cx, o), U32.and(B.hash.name(n), 1), B.hash.name(n), B.cx.obs(cx), cxnx_ch(cx, o, hc)))

# a member table of the context's, by members.indexed
def mdget(obs: List<&2, B.Ob>, k: Nat, +n: List<&2, U32>) ->
    {B.mem.find(B.ob.mems(B.ob.or(List.get(&2, B.Ob, obs, k))), n) == B.md.find(B.md.or(List.get(&2, B.Ht<B.Node>, B.mds.of(obs), k)), n) : Maybe<&2, B.Node>}:
  match obs:
    case Nil{}:
      {==}
    case Con{+o, +t}:
      match k:
        case 0n:
          Equal.sym(Maybe<&2, B.Node>, B.md.find(B.md.table(B.ob.mems(o)), n), B.mem.find(B.ob.mems(o), n), Laws.members.indexed(B.ob.mems(o), n))
        case 1n+j:
          mdget(t, j, n)

def cxmem_eq(+cx: B.Cx, +q: U32, +n: List<&2, U32>, +hmd: {cxmds(cx) == B.mds.of(B.cx.obs(cx)) : List<&2, B.Ht<B.Node>>}) ->
    {B.mem.find(B.ob.mems(B.ob.at(B.cx.obs(cx), q)), n) == B.cx.mem(cx, q, n) : Maybe<&2, B.Node>}:
  match cx:
    case B.Cx{+obs, +ls, +fs, +als, +paths, +pss, +nxs, +mds}:
      %Equal.sym(List<&2, B.Ht<B.Node>>, mds, B.mds.of(obs), hmd) :
        {B.mem.find(B.ob.mems(B.ob.at(obs, q)), n) == B.md.find(B.md.or(List.get(&2, B.Ht<B.Node>, _, U32.to_nat(q))), n) : Maybe<&2, B.Node>}
      mdget(obs, U32.to_nat(q), n)

# The resolver walked for its instances: none but a prior's

def rfn_fd(c: Bool, +cx: B.Cx, +obj: U32, +mark: U32, +n: List<&2, U32>, +t: B.Tok, +no: B.Loc) -> {rrfd(rfn_k(c, cx, obj, mark, n, t, no), B.cx.obs(cx)) == True{} : Bool}:
  match c:
    case True{}:
      {==}
    case False{}:
      {==}

def final_fd(+cx: B.Cx, +obj: U32, +mark: U32, +n: List<&2, U32>, +t: B.Tok, +no: B.Loc) -> {rrfd(B.rr.final(cx, obj, mark, n, t, no), B.cx.obs(cx)) == True{} : Bool}:
  rfn_fd(B.ob.abs(B.ob.at(B.cx.obs(cx), obj)), cx, obj, mark, n, t, no)

def rhs_fd(c: Bool, +cx: B.Cx, +h: U32, +n: List<&2, U32>, +t: B.Tok, +whole: List<&2, U32>, +no: B.Loc) -> {rrfd(rhs_k(c, cx, h, n, t, whole, no), B.cx.obs(cx)) == True{} : Bool}:
  match c:
    case True{}:
      final_fd(cx, h, 0, n, t, no)
    case False{}:
      {==}

def rh_fd(m: Maybe<&2, U32>, +cx: B.Cx, +n: List<&2, U32>, +t: B.Tok, +whole: List<&2, U32>, +no: B.Loc) -> {rrfd(rhk(m, cx, n, t, whole, no), B.cx.obs(cx)) == True{} : Bool}:
  match m:
    case None{}:
      {==}
    case Some{+h}:
      rhs_fd(B.cx.has(cx, h, n), cx, h, n, t, whole, no)

def host_fd(+cx: B.Cx, +o: U32, +q: U32, +k: Nat, +n: List<&2, U32>, +t: B.Tok, +whole: List<&2, U32>, +no: B.Loc) ->
    {rrfd(B.rr.host(cx, o, q, k, n, t, whole, no), B.cx.obs(cx)) == True{} : Bool}:
  rh_fd(List.get(&2, U32, B.hosts(B.cx.obs(cx), q), Nat.sub(k, 1n)), cx, n, t, whole, no)

def rfo1_fd(m: Maybe<&2, List<&2, U32>>, +mark: U32, +n: List<&2, U32>, +t: B.Tok, +obs: List<&2, B.Ob>) -> {rrfd(rfo1(m, mark, n, t), obs) == True{} : Bool}:
  match m:
    case None{}:
      {==}
    case Some{+p}:
      {==}

def rfo2_fd(c: Bool, +cx: B.Cx, +m: U32, +mark: U32, +n: List<&2, U32>, +t: B.Tok, +obs: List<&2, B.Ob>) -> {rrfd(rfo2(c, cx, m, mark, n, t), obs) == True{} : Bool}:
  match c:
    case True{}:
      {==}
    case False{}:
      {==}

def rfok_fd(c: Bool, +cx: B.Cx, +m: U32, +mark: U32, +n: List<&2, U32>, +t: B.Tok, +obs: List<&2, B.Ob>) -> {rrfd(rfok(c, cx, m, mark, n, t), obs) == True{} : Bool}:
  match c:
    case True{}:
      rfo1_fd(B.ci.find(B.mod.cis(cx, m), B.List.head.or(B.parts(n))), mark, n, t, obs)
    case False{}:
      rfo2_fd(B.names.has(B.tree.types(B.mod.tree(cx, m)), n), cx, m, mark, n, t, obs)

def foreign_fd(+cx: B.Cx, +m: U32, +mark: U32, +n: List<&2, U32>, +t: B.Tok) -> {rrfd(B.rr.foreign(cx, m, mark, n, t), B.cx.obs(cx)) == True{} : Bool}:
  rfok_fd(Bool.not(B.blank.parts(List.tail(&2, List<&2, U32>, B.parts(n)))), cx, m, mark, n, t, B.cx.obs(cx))

def rbs_fd(c: Bool, +n: List<&2, U32>, +t: B.Tok, +no: B.Loc, +obs: List<&2, B.Ob>) -> {rrfd(rbs_k(c, n, t, no), obs) == True{} : Bool}:
  match c:
    case True{}:
      {==}
    case False{}:
      {==}

def rbd_fd(c: Bool, +cx: B.Cx, +q: U32, +mark: U32, +n: List<&2, U32>, +t: B.Tok, +no: B.Loc) -> {rrfd(rbd_k(c, cx, q, mark, n, t, no), B.cx.obs(cx)) == True{} : Bool}:
  match c:
    case True{}:
      rbs_fd(B.starts.s(n, "Blend_"), n, t, no, B.cx.obs(cx))
    case False{}:
      foreign_fd(cx, B.loc.mod(B.ob.no(B.ob.at(B.cx.obs(cx), q))), mark, n, t)

def bend_fd(+cx: B.Cx, +q: U32, +mark: U32, +n: List<&2, U32>, +t: B.Tok, +no: B.Loc) -> {rrfd(B.rr.bend(cx, q, mark, n, t, no), B.cx.obs(cx)) == True{} : Bool}:
  rbd_fd(U32.is_eq(B.loc.mod(B.ob.no(B.ob.at(B.cx.obs(cx), q))), 0), cx, q, mark, n, t, no)

def rf_fd(+cx: B.Cx, +mark: U32, +t: B.Tok, +no: B.Loc, f: B.Rf) -> {rrfd(B.rr.rf(cx, mark, t, no, f), B.cx.obs(cx)) == True{} : Bool}:
  match f:
    case B.Rf{+obj, +name, +prior, +origin}:
      final_fd(cx, obj, mark, name, t, no)

def rd_fd(m: Maybe<&2, B.Rf>, +cx: B.Cx, +q: U32, +mark: U32, +n: List<&2, U32>, +t: B.Tok, +no: B.Loc) -> {rrfd(rdk(m, cx, q, mark, n, t, no), B.cx.obs(cx)) == True{} : Bool}:
  match m:
    case None{}:
      bend_fd(cx, q, mark, n, t, no)
    case Some{f}:
      rf_fd(cx, mark, t, no, f)

def dotted_fd(+cx: B.Cx, +q: U32, +mark: U32, +n: List<&2, U32>, +t: B.Tok, +no: B.Loc) -> {rrfd(B.rr.dotted(cx, q, mark, n, t, no), B.cx.obs(cx)) == True{} : Bool}:
  rd_fd(B.look.obj(List.length(&2, List<&2, U32>, List.tail(&2, List<&2, U32>, B.parts(n))), cx, q, B.parts(n)), cx, q, mark, n, t, no)

def rp_fd(m: Maybe<&2, U32>, +cx: B.Cx, +q: U32, +mark: U32, +n: List<&2, U32>, +t: B.Tok, +no: B.Loc) -> {rrfd(rpk(m, cx, q, mark, n, t, no), B.cx.obs(cx)) == True{} : Bool}:
  match m:
    case None{}:
      dotted_fd(cx, q, mark, n, t, no)
    case Some{+h}:
      final_fd(cx, h, mark, n, t, no)

def plaink_fd(local: Bool, +cx: B.Cx, +o: U32, +q: U32, +mark: U32, +n: List<&2, U32>, +t: B.Tok, +no: B.Loc) ->
    {rrfd(B.rr.plain.k(local, cx, o, q, mark, n, t, no), B.cx.obs(cx)) == True{} : Bool}:
  match local:
    case True{}:
      {==}
    case False{}:
      rp_fd(B.look(cx, Con{o, B.hosts(B.cx.obs(cx), q)}, n), cx, q, mark, n, t, no)

def plain_fd(+cx: B.Cx, +o: U32, +q: U32, +locals: List<&2, List<&2, U32>>, +mark: U32, +n: List<&2, U32>, +t: B.Tok, +no: B.Loc) ->
    {rrfd(B.rr.plain(cx, o, q, locals, mark, n, t, no), B.cx.obs(cx)) == True{} : Bool}:
  plaink_fd(B.names.has(locals, n), cx, o, q, mark, n, t, no)

# a prior found: the first of a chain's objects after another's, each
# defining the name
def pfd(m: Maybe<&2, U32>, +obs: List<&2, B.Ob>, +n: List<&2, U32>) -> Bool:
  match m:
    case None{}:
      True{}
    case Some{c}:
      Maybe.is_some(&2, B.Node, B.mem.find(B.ob.mems(B.ob.at(obs, c)), n))

def pf_k(c: Bool, +x: U32, t: List<&2, U32>, +after: List<&2, U32>, +obs: List<&2, B.Ob>, +n: List<&2, U32>,
    hx: {Maybe.is_some(&2, B.Node, B.mem.find(B.ob.mems(B.ob.at(obs, x)), n)) == True{} : Bool}, ih: {pfd(B.prior.find(t, after), obs, n) == True{} : Bool}) ->
    {pfd(B.when(Maybe<&2, U32>, c, u => Some{x}, u => B.prior.find(t, after)), obs, n) == True{} : Bool}:
  match c:
    case True{}:
      hx
    case False{}:
      ih

def pfind_fd(cs: List<&2, U32>, +after: List<&2, U32>, +obs: List<&2, B.Ob>, +n: List<&2, U32>, +h: {B.chain.defines(cs, obs, n) == True{} : Bool}) ->
    {pfd(B.prior.find(cs, after), obs, n) == True{} : Bool}:
  match cs:
    case Nil{}:
      {==}
    case Con{+c, +t}:
      pf_k(B.has(after, c), c, t, after, obs, n,
        and_l(Maybe.is_some(&2, B.Node, B.mem.find(B.ob.mems(B.ob.at(obs, c)), n)), B.chain.defines(t, obs, n), h),
        pfind_fd(t, after, obs, n, and_r(Maybe.is_some(&2, B.Node, B.mem.find(B.ob.mems(B.ob.at(obs, c)), n)), B.chain.defines(t, obs, n), h)))

def mch_defs(m: Maybe<&2, B.En>, +obs: List<&2, B.Ob>, +n: List<&2, U32>, +h: {mch(m, obs, n) == True{} : Bool}) -> {B.chain.defines(B.en.chain(m), obs, n) == True{} : Bool}:
  match m:
    case None{}:
      {==}
    case Some{e}:
      match e:
        case B.En{+name, +chain, +no, +what}:
          ok_defs(chain, obs, n, h)

def rpo_fd(m: Maybe<&2, U32>, +cx: B.Cx, +o: U32, +q: U32, +n: List<&2, U32>, +t: B.Tok, +no: B.Loc, +hm: {pfd(m, B.cx.obs(cx), n) == True{} : Bool}) ->
    {rrfd(rpok(m, cx, o, q, n, t, no), B.cx.obs(cx)) == True{} : Bool}:
  match m:
    case None{}:
      {==}
    case Some{+c}:
      and_intro(infd(B.In{n, c, True{}}, B.cx.obs(cx)), True{}, hm, {==})

def prior_of_fd(+cx: B.Cx, +o: U32, +q: U32, +n: List<&2, U32>, +t: B.Tok, +no: B.Loc, +hc: {cxch(cx) == True{} : Bool}) -> {rrfd(B.rr.prior.of(cx, o, q, n, t, no), B.cx.obs(cx)) == True{} : Bool}:
  rpo_fd(B.prior.find(B.en.chain(B.cx.find(cx, o, n)), B.after(B.cx.ord(cx, o), q)), cx, o, q, n, t, no,
    pfind_fd(B.en.chain(B.cx.find(cx, o, n)), B.after(B.cx.ord(cx, o), q), B.cx.obs(cx), n,
      mch_defs(B.cx.find(cx, o, n), B.cx.obs(cx), n, cxfind_ch(cx, o, n, hc))))

def rpr_fd(c: Bool, +cx: B.Cx, +o: U32, +q: U32, +n: List<&2, U32>, +t: B.Tok, +no: B.Loc, +hc: {cxch(cx) == True{} : Bool}) -> {rrfd(rprk(c, cx, o, q, n, t, no), B.cx.obs(cx)) == True{} : Bool}:
  match c:
    case True{}:
      prior_of_fd(cx, o, q, List.append(&2, U32, n, [35]), t, no, hc)
    case False{}:
      prior_of_fd(cx, o, q, n, t, no, hc)

def under_fd(local: Bool, +cx: B.Cx, +o: U32, +q: U32, +r: List<&2, U32>, +t: B.Tok, +no: B.Loc, +hc: {cxch(cx) == True{} : Bool}) ->
    {rrfd(B.rr.under(local, cx, o, q, r, t, no), B.cx.obs(cx)) == True{} : Bool}:
  match local:
    case True{}:
      {==}
    case False{}:
      rpr_fd(B.cx.has(cx, o, List.append(&2, U32, r, [35])), cx, o, q, r, t, no, hc)

def markk_fd(up: Bool, tpl: Bool, under: Bool, +cx: B.Cx, +o: U32, +q: U32, +locals: List<&2, List<&2, U32>>, +h: U32, +r: List<&2, U32>, +no: B.Loc, +hc: {cxch(cx) == True{} : Bool}) ->
    {rrfd(B.rr.mark.k(up, tpl, under, cx, o, q, locals, h, r, B.TName{Con{h, r}}, no), B.cx.obs(cx)) == True{} : Bool}:
  match up tpl under:
    case True{} _ _:
      host_fd(cx, o, q, B.carets(Con{h, r}), List.drop(&2, U32, Con{h, r}, B.carets(Con{h, r})), B.TName{Con{h, r}}, Con{h, r}, no)
    case False{} True{} _:
      plain_fd(cx, o, q, locals, 126, r, B.TName{Con{h, r}}, no)
    case False{} False{} True{}:
      under_fd(Bool.or(Bool.or(B.blank(r), B.names.has(locals, Con{h, r})), B.is.root(B.cx.obs(cx), o)), cx, o, q, r, B.TName{Con{h, r}}, no, hc)
    case False{} False{} False{}:
      plain_fd(cx, o, q, locals, 0, Con{h, r}, B.TName{Con{h, r}}, no)

def rrof_fd(+cx: B.Cx, +o: U32, +q: U32, +locals: List<&2, List<&2, U32>>, t: B.Tok, +no: B.Loc, +hc: {cxch(cx) == True{} : Bool}) ->
    {rrfd(B.rr.of(cx, o, q, locals, t, no), B.cx.obs(cx)) == True{} : Bool}:
  match t:
    case B.TName{+x}:
      match x:
        case Nil{}:
          {==}
        case Con{+h, +r}:
          markk_fd(U32.is_eq(h, 94), U32.is_eq(h, 126), U32.is_eq(h, 95), cx, o, q, locals, h, r, no, hc)
    case B.TNum{+x}:
      {==}
    case B.TStr{+x}:
      {==}
    case B.TCom{+x}:
      {==}
    case B.TSp{+x}:
      {==}
    case B.TSym{+c}:
      {==}

def cons_fd(x: B.Rr, rest: B.Rb, +obs: List<&2, B.Ob>, +hx: {rrfd(x, obs) == True{} : Bool}, +hr: {rbfd(rest, obs) == True{} : Bool}) -> {rbfd(B.rb.cons(x, rest), obs) == True{} : Bool}:
  match x rest:
    case B.Rr{+rt, +e, +i} B.Rb{+ls, +es, +more}:
      insapp_fd(i, more, obs, hx, hr)

def toks_fd(ts: List<&2, B.Tok>, +cx: B.Cx, +o: U32, +q: U32, +locals: List<&2, List<&2, U32>>, +no: B.Loc, +hc: {cxch(cx) == True{} : Bool}) ->
    {rbfd(B.rb.toks(ts, cx, o, q, locals, no), B.cx.obs(cx)) == True{} : Bool}:
  match ts:
    case Nil{}:
      {==}
    case Con{+t, +r}:
      cons_fd(B.rr.of(cx, o, q, locals, t, no), B.rb.toks(r, cx, o, q, locals, no), B.cx.obs(cx), rrof_fd(cx, o, q, locals, t, no, hc), toks_fd(r, cx, o, q, locals, no, hc))

def line_fd(+no: B.Loc, +ind: U32, b: B.Rb, +obs: List<&2, B.Ob>, +h: {rbfd(b, obs) == True{} : Bool}) -> {rbfd(B.rb.line(no, ind, b), obs) == True{} : Bool}:
  match b:
    case B.Rb{+ls, +es, +more}:
      h

def join_fd(a: B.Rb, b: B.Rb, +obs: List<&2, B.Ob>, +ha: {rbfd(a, obs) == True{} : Bool}, +hb: {rbfd(b, obs) == True{} : Bool}) -> {rbfd(B.rb.join(a, b), obs) == True{} : Bool}:
  match a b:
    case B.Rb{+l1, +e1, +i1} B.Rb{+l2, +e2, +i2}:
      insapp_fd(i1, i2, obs, ha, hb)

def lines_fd(bs: List<&2, B.Bl>, +cx: B.Cx, +o: U32, +q: U32, +locals: List<&2, List<&2, U32>>, +hc: {cxch(cx) == True{} : Bool}) ->
    {rbfd(B.rb.lines(bs, cx, o, q, locals), B.cx.obs(cx)) == True{} : Bool}:
  match bs:
    case Nil{}:
      {==}
    case Con{b, +t}:
      match b:
        case B.Bl{+no, +ind, +ts}:
          join_fd(B.rb.line(no, ind, B.rb.toks(ts, cx, o, q, locals, no)), B.rb.lines(t, cx, o, q, locals), B.cx.obs(cx),
            line_fd(no, ind, B.rb.toks(ts, cx, o, q, locals, no), B.cx.obs(cx), toks_fd(ts, cx, o, q, locals, no, hc)),
            lines_fd(t, cx, o, q, locals, hc))

# a copy's priors found
def ck_fd(i: B.In, nd: B.Node, h: B.Rb, b: B.Rb, sh: List<&2, B.Er>, +obs: List<&2, B.Ob>, hh: {rbfd(h, obs) == True{} : Bool}, hb: {rbfd(b, obs) == True{} : Bool}) ->
    {insfd(B.rb.ins(Pair.snd(B.Rd, B.Rb, B.copy.k(i, nd, h, b, sh))), obs) == True{} : Bool}:
  match h b:
    case B.Rb{hl, he, +hi} B.Rb{ls, es, +more}:
      insapp_fd(hi, more, obs, hh, hb)

def cn_fd(+cx: B.Cx, +o: U32, +n: List<&2, U32>, +q: U32, +prior: Bool, nd: B.Node, +hc: {cxch(cx) == True{} : Bool}) ->
    {insfd(B.rb.ins(Pair.snd(B.Rd, B.Rb, B.copy.node(cx, o, B.In{n, q, prior}, nd))), B.cx.obs(cx)) == True{} : Bool}:
  match nd:
    case B.NDef{+share, +upd, +name, +rest, +params, +body, +no, +ind, +what}:
      ck_fd(B.In{n, q, prior}, B.NDef{share, upd, name, rest, params, body, no, ind, what},
        B.rb.line(no, 0, B.rb.toks(B.toks(rest), cx, o, q, List.append(&2, List<&2, U32>, B.unmarks(params), B.lc.names(B.body.binders(body))), no)),
        B.rb.lines(body, cx, o, q, List.append(&2, List<&2, U32>, B.unmarks(params), B.lc.names(B.body.binders(body)))),
        B.when(List<&2, B.Er>, B.is.root(B.cx.obs(cx), o), u => Nil{},
          u => List.append(&2, B.Er, B.shadow.params(B.unmarks(params), cx, o, q, B.text(B.rf.text(B.cx.obs(cx), B.in.ref(o, B.In{n, q, prior}))), no),
            B.shadow.locals(B.body.binders(body), cx, o, q, B.text(B.rf.text(B.cx.obs(cx), B.in.ref(o, B.In{n, q, prior})))))),
        B.cx.obs(cx), line_fd(no, 0, B.rb.toks(B.toks(rest), cx, o, q, List.append(&2, List<&2, U32>, B.unmarks(params), B.lc.names(B.body.binders(body))), no), B.cx.obs(cx), toks_fd(B.toks(rest), cx, o, q, List.append(&2, List<&2, U32>, B.unmarks(params), B.lc.names(B.body.binders(body))), no, hc)),
        lines_fd(body, cx, o, q, List.append(&2, List<&2, U32>, B.unmarks(params), B.lc.names(B.body.binders(body))), hc))
    case B.NObj{+abs, +ext, +name, +parents, +kids, +no}:
      {==}
    case B.NImport{+txt, +no}:
      {==}
    case B.NDecl{+names, +no}:
      {==}
    case B.NBad{+txt, +no}:
      {==}
    case B.NErr{+msg, +no}:
      {==}
    case B.NBend{+lines, +no}:
      {==}

def oc_fd(mb: Maybe<&2, B.Node>, +cx: B.Cx, +o: U32, +n: List<&2, U32>, +q: U32, +prior: Bool, +hc: {cxch(cx) == True{} : Bool}) ->
    {insfd(B.rb.ins(Pair.snd(B.Rd, B.Rb, ocm(mb, cx, o, n, q, prior))), B.cx.obs(cx)) == True{} : Bool}:
  match mb:
    case None{}:
      {==}
    case Some{nd}:
      cn_fd(cx, o, n, q, prior, nd, hc)

def snd_fd(+cx: B.Cx, +o: U32, i: B.In, +hc: {cxch(cx) == True{} : Bool}) -> {insfd(B.rb.ins(Pair.snd(B.Rd, B.Rb, B.copy.of(cx, o, i))), B.cx.obs(cx)) == True{} : Bool}:
  match i:
    case B.In{+n, +q, +prior}:
      oc_fd(B.cx.mem(cx, q, n), cx, o, n, q, prior, hc)

def then_fd(t: List<&2, B.In>, xs: List<&2, B.In>, +obs: List<&2, B.Ob>, +ht: {insfd(t, obs) == True{} : Bool}, +hx: {insfd(xs, obs) == True{} : Bool}) -> {insfd(B.ins.then(t, xs), obs) == True{} : Bool}:
  match xs:
    case Nil{}:
      ht
    case Con{+x, +r}:
      insapp_fd(t, Con{x, r}, obs, ht, hx)

# a copy made of an instance found: a definition of its name
def oc_fnd(mb: Maybe<&2, B.Node>, +cx: B.Cx, +o: U32, +n: List<&2, U32>, +q: U32, +prior: Bool, +rds: List<&2, B.Rd>,
    hs: {Maybe.is_some(&2, B.Node, mb) == True{} : Bool}, hm: {mdef(mb, n) == True{} : Bool}, hr: {B.rds.defs(rds) == True{} : Bool}) ->
    {B.rds.defs(Con{Pair.fst(B.Rd, B.Rb, ocm(mb, cx, o, n, q, prior)), rds}) == True{} : Bool}:
  match mb:
    case None{}:
      Empty.absurd({B.rds.defs(Con{B.Rd{B.In{n, q, prior}, B.NBad{Nil{}, B.loc.top(0)}, Nil{}, Nil{}}, rds}) == True{} : Bool}, MB.false_ne_true()(hs))
    case Some{nd}:
      cn_def(cx, o, n, q, prior, nd, rds, hm, hr)

def fst_fnd(+cx: B.Cx, +o: U32, i: B.In, +rds: List<&2, B.Rd>, +hmd: {cxmds(cx) == B.mds.of(B.cx.obs(cx)) : List<&2, B.Ht<B.Node>>},
    hi: {infd(i, B.cx.obs(cx)) == True{} : Bool}, hr: {B.rds.defs(rds) == True{} : Bool}) -> {B.rds.defs(Con{Pair.fst(B.Rd, B.Rb, B.copy.of(cx, o, i)), rds}) == True{} : Bool}:
  match i:
    case B.In{+n, +q, +prior}:
      %cxmem_eq(cx, q, n, hmd) : {B.rds.defs(Con{Pair.fst(B.Rd, B.Rb, ocm(_, cx, o, n, q, prior)), rds}) == True{} : Bool}
      oc_fnd(B.mem.find(B.ob.mems(B.ob.at(B.cx.obs(cx), q)), n), cx, o, n, q, prior, rds, hi, mem_find_def(B.ob.mems(B.ob.at(B.cx.obs(cx), q)), n), hr)

def fg_add(+k: Nat, +cx: B.Cx, +o: U32, +i: B.In, +t: List<&2, B.In>, +rds: List<&2, B.Rd>, +ers: List<&2, B.Er>, +done: B.Ht<B.In>,
    +hmd: {cxmds(cx) == B.mds.of(B.cx.obs(cx)) : List<&2, B.Ht<B.Node>>}, hc: {B.rds.defs(rds) == True{} : Bool}, hi: {infd(i, B.cx.obs(cx)) == True{} : Bool}) ->
    {pdef(B.cp.add(Pair.fst(B.Rd, B.Rb, B.copy.of(cx, o, i)), Pair.snd(B.Rd, B.Rb, B.copy.of(cx, o, i)), B.Cp{rds, ers, B.done.put(done, i)})) == True{} : Bool}:
  %cpadd_pdef(Pair.fst(B.Rd, B.Rb, B.copy.of(cx, o, i)), Pair.snd(B.Rd, B.Rb, B.copy.of(cx, o, i)), rds, ers, B.done.put(done, i)) : {_ == True{} : Bool}
  fst_fnd(cx, o, i, rds, hmd, hi, hc)

def fg_step(c: Bool, +k: Nat, +cx: B.Cx, +o: U32, +i: B.In, +t: List<&2, B.In>, +rds: List<&2, B.Rd>, +ers: List<&2, B.Er>, +done: B.Ht<B.In>,
    +hmd: {cxmds(cx) == B.mds.of(B.cx.obs(cx)) : List<&2, B.Ht<B.Node>>}, +hx: {cxch(cx) == True{} : Bool}, hc: {B.rds.defs(rds) == True{} : Bool},
    +hi: {infd(i, B.cx.obs(cx)) == True{} : Bool}, +ht: {insfd(t, B.cx.obs(cx)) == True{} : Bool},
    ft: @hc2:{B.rds.defs(rds) == True{} : Bool} -> @ht2:{insfd(t, B.cx.obs(cx)) == True{} : Bool} -> {pdef(B.copies.go(k, cx, o, t, B.Cp{rds, ers, done})) == True{} : Bool},
    ff: @hc2:{pdef(B.cp.add(Pair.fst(B.Rd, B.Rb, B.copy.of(cx, o, i)), Pair.snd(B.Rd, B.Rb, B.copy.of(cx, o, i)), B.Cp{rds, ers, B.done.put(done, i)})) == True{} : Bool} -> @ht2:{insfd(B.ins.then(t, B.rb.ins(Pair.snd(B.Rd, B.Rb, B.copy.of(cx, o, i)))), B.cx.obs(cx)) == True{} : Bool} -> {pdef(B.copies.go(k, cx, o, B.ins.then(t, B.rb.ins(Pair.snd(B.Rd, B.Rb, B.copy.of(cx, o, i)))), B.cp.add(Pair.fst(B.Rd, B.Rb, B.copy.of(cx, o, i)), Pair.snd(B.Rd, B.Rb, B.copy.of(cx, o, i)), B.Cp{rds, ers, B.done.put(done, i)}))) == True{} : Bool}) ->
    {pdef(cgk(c, k, cx, o, i, t, rds, ers, done)) == True{} : Bool}:
  match c:
    case True{}:
      ft(hc, ht)
    case False{}:
      %Equal.sym(B.Cp, B.on.pair(B.Rd, B.Rb, B.Cp, B.copy.of(cx, o, i), rd => +b => B.copies.go(k, cx, o, B.ins.then(t, B.rb.ins(b)), B.cp.add(rd, b, B.Cp{rds, ers, B.done.put(done, i)}))), B.copies.go(k, cx, o, B.ins.then(t, B.rb.ins(Pair.snd(B.Rd, B.Rb, B.copy.of(cx, o, i)))), B.cp.add(Pair.fst(B.Rd, B.Rb, B.copy.of(cx, o, i)), Pair.snd(B.Rd, B.Rb, B.copy.of(cx, o, i)), B.Cp{rds, ers, B.done.put(done, i)})), pair_eta_rd(B.copy.of(cx, o, i), rd => +b => B.copies.go(k, cx, o, B.ins.then(t, B.rb.ins(b)), B.cp.add(rd, b, B.Cp{rds, ers, B.done.put(done, i)})))) : {pdef(_) == True{} : Bool}
      ff(fg_add(k, cx, o, i, t, rds, ers, done, hmd, hc, hi), then_fd(t, B.rb.ins(Pair.snd(B.Rd, B.Rb, B.copy.of(cx, o, i))), B.cx.obs(cx), ht, snd_fd(cx, o, i, hx)))

# by induction on the fuel: every copy a definition, every instance taken
# found
def fg_go(n: Nat, +cx: B.Cx, +o: U32, todo: List<&2, B.In>, +c: B.Cp, +hmd: {cxmds(cx) == B.mds.of(B.cx.obs(cx)) : List<&2, B.Ht<B.Node>>},
    +hx: {cxch(cx) == True{} : Bool}, hc: {pdef(c) == True{} : Bool}, +ht: {insfd(todo, B.cx.obs(cx)) == True{} : Bool}) -> {pdef(B.copies.go(n, cx, o, todo, c)) == True{} : Bool}:
  match n:
    case 0n:
      short_pdef(todo, cx, o, c, hc)
    case 1n+(+k):
      match todo:
        case Nil{}:
          hc
        case Con{+i, +t}:
          match c:
            case B.Cp{+rds, +ers, +done}:
              fg_step(B.done.has(done, i), k, cx, o, i, t, rds, ers, done, hmd, hx, hc,
                and_l(infd(i, B.cx.obs(cx)), insfd(t, B.cx.obs(cx)), ht), and_r(infd(i, B.cx.obs(cx)), insfd(t, B.cx.obs(cx)), ht),
                hc2 => ht2 => fg_go(k, cx, o, t, B.Cp{rds, ers, done}, hmd, hx, hc2, ht2),
                hc2 => ht2 => fg_go(k, cx, o, B.ins.then(t, B.rb.ins(Pair.snd(B.Rd, B.Rb, B.copy.of(cx, o, i)))), B.cp.add(Pair.fst(B.Rd, B.Rb, B.copy.of(cx, o, i)), Pair.snd(B.Rd, B.Rb, B.copy.of(cx, o, i)), B.Cp{rds, ers, B.done.put(done, i)}), hmd, hx, hc2, ht2))

# The context emission builds: its name tables of chained folds
def fdmap_ch(m: Maybe<&2, B.Fd>, +obs: List<&2, B.Ob>, +h: {B.fd.chained(m, obs) == True{} : Bool}) -> {B.ens.chained(B.fd.map(m), obs) == True{} : Bool}:
  match m:
    case None{}:
      {==}
    case Some{d}:
      match d:
        case B.Fd{map, fes, ix}:
          h

def nxputs_ch(es: List<&2, B.En>, +t: B.Ht<B.En>, +obs: List<&2, B.Ob>, +h: {B.ens.chained(es, obs) == True{} : Bool}, +ht: {hch(t, obs) == True{} : Bool}) ->
    {hch(B.nx.puts(es, t), obs) == True{} : Bool}:
  match es:
    case Nil{}:
      ht
    case Con{+e, +rest}:
      hch_put(32n, B.nx.puts(rest, t), U32.and(B.hash.name(B.en.name(e)), 1), B.hash.name(B.en.name(e)), e, obs,
        and_l(B.en.chained(e, obs), B.ens.chained(rest, obs), h), nxputs_ch(rest, t, obs, and_r(B.en.chained(e, obs), B.ens.chained(rest, obs), h), ht))

def nxs_ch(fs: List<&2, Maybe<&2, B.Fd>>, +obs: List<&2, B.Ob>, +h: {B.fds.chained(fs, obs) == True{} : Bool}) -> {hchs(B.nxs.of(fs), obs) == True{} : Bool}:
  match fs:
    case Nil{}:
      {==}
    case Con{+m, +t}:
      and_intro(hch(B.nx.of(B.fd.map(m)), obs), hchs(B.nxs.of(t), obs),
        nxputs_ch(B.fd.map(m), B.ht.for(B.En, List.length(&2, B.En, B.fd.map(m))), obs, fdmap_ch(m, obs, and_l(B.fd.chained(m, obs), B.fds.chained(t, obs), h)),
          hch_empty(B.ht.depth(32n, U32.from_nat(List.length(&2, B.En, B.fd.map(m)))), obs)),
        nxs_ch(t, obs, and_r(B.fd.chained(m, obs), B.fds.chained(t, obs), h)))

def fdat_ch(fs: List<&2, Maybe<&2, B.Fd>>, k: Nat, +obs: List<&2, B.Ob>, +h: {B.fds.chained(fs, obs) == True{} : Bool}) ->
    {B.ens.chained(B.fd.map(B.fd.or(List.get(&2, Maybe<&2, B.Fd>, fs, k))), obs) == True{} : Bool}:
  match fs:
    case Nil{}:
      {==}
    case Con{+m, +t}:
      match k:
        case 0n:
          fdmap_ch(m, obs, and_l(B.fd.chained(m, obs), B.fds.chained(t, obs), h))
        case 1n+j:
          fdat_ch(t, j, obs, and_r(B.fd.chained(m, obs), B.fds.chained(t, obs), h))

# a final's object, its chain's head: one defining it
def head_fd(cs: List<&2, U32>, +obs: List<&2, B.Ob>, +n: List<&2, U32>, +h: {B.chain.ok(cs, obs, n) == True{} : Bool}) ->
    {Maybe.is_some(&2, B.Node, B.mem.find(B.ob.mems(B.ob.at(obs, B.en.head(cs))), n)) == True{} : Bool}:
  match cs:
    case Nil{}:
      Empty.absurd({Maybe.is_some(&2, B.Node, B.mem.find(B.ob.mems(B.ob.at(obs, B.en.head(Nil{}))), n)) == True{} : Bool}, MB.false_ne_true()(h))
    case Con{+c, +t}:
      and_l(Maybe.is_some(&2, B.Node, B.mem.find(B.ob.mems(B.ob.at(obs, c)), n)), B.chain.defines(t, obs, n), h)

def finals_fd(es: List<&2, B.En>, +obs: List<&2, B.Ob>, +h: {B.ens.chained(es, obs) == True{} : Bool}) -> {insfd(B.ins.finals(es), obs) == True{} : Bool}:
  match es:
    case Nil{}:
      {==}
    case Con{e, +t}:
      match e:
        case B.En{+name, +chain, +no, +what}:
          and_intro(infd(B.In{name, B.en.head(chain), False{}}, obs), insfd(B.ins.finals(t), obs),
            head_fd(chain, obs, name, and_l(B.en.chained(B.En{name, chain, no, what}, obs), B.ens.chained(t, obs), h)),
            finals_fd(t, obs, and_r(B.en.chained(B.En{name, chain, no, what}, obs), B.ens.chained(t, obs), h)))

def Laws.copies.found(ls, obs, bad, als, paths, pss, o):
  pdef_rds(B.copies(B.cx.of(obs, ls, B.folds(ls, obs, bad), als, paths, pss), o),
    fg_go(B.copies.fuel(), B.cx.of(obs, ls, B.folds(ls, obs, bad), als, paths, pss), o, B.ins.finals(B.cx.map(B.cx.of(obs, ls, B.folds(ls, obs, bad), als, paths, pss), o)), B.Cp{Nil{}, Nil{}, B.copies.room(B.cx.of(obs, ls, B.folds(ls, obs, bad), als, paths, pss))}, {==},
      nxs_ch(B.folds(ls, obs, bad), obs, Laws.folds.chained(ls, obs, bad)), {==},
      finals_fd(B.cx.map(B.cx.of(obs, ls, B.folds(ls, obs, bad), als, paths, pss), o), obs, fdat_ch(B.folds(ls, obs, bad), U32.to_nat(o), obs, Laws.folds.chained(ls, obs, bad)))))

# The root's imports: aliases, parts of their lines

def mimil(m: Maybe<&2, B.Im>) -> Bool:
  match m:
    case None{}:
      True{}
    case Some{i}:
      B.im.inline(i)

def imm(+c: Bool, +path: List<&2, U32>, +rest: List<&2, U32>, +no: B.Loc) -> Maybe<&2, B.Im>:
  B.when(Maybe<&2, B.Im>, c, u => Some{B.Im{path, B.trim(B.drop(3n, rest)), B.ends(path, B.codes(".blend")), no}}, u => None{})

def imm_il(c: Bool, +path: List<&2, U32>, +rest: List<&2, U32>, +no: B.Loc, +hp: {B.inline(path) == True{} : Bool}, +hr: {B.inline(rest) == True{} : Bool}) ->
    {mimil(imm(c, path, rest, no)) == True{} : Bool}:
  match c:
    case True{}:
      and_intro(B.inline(path), B.inline(B.trim(B.drop(3n, rest))), hp, il_trim(B.drop(3n, rest), il_drop(3n, rest, hr)))
    case False{}:
      {==}

def imade_il(p: List<&2, U32> & List<&2, U32>, +no: B.Loc, +hp: {pil(p) == True{} : Bool}) -> {mimil(B.im.made(p, no)) == True{} : Bool}:
  match p:
    case (+path, +rest):
      imm_il(Bool.and(B.starts.s(rest, "as "), B.name.ok(B.trim(B.drop(3n, rest)))), path, rest, no, and_l(B.inline(path), B.inline(rest), hp), and_r(B.inline(path), B.inline(rest), hp))

def imk(+m: Maybe<&2, B.Im>, +t: List<&2, B.Node>) -> List<&2, B.Im>:
  B.on.maybe(B.Im, List<&2, B.Im>, m, u => B.ims.of(t), x => Con{x, B.ims.of(t)})

def imk_il(m: Maybe<&2, B.Im>, +t: List<&2, B.Node>, +hm: {mimil(m) == True{} : Bool}, +ht: {B.ims.inline(B.ims.of(t)) == True{} : Bool}) -> {B.ims.inline(imk(m, t)) == True{} : Bool}:
  match m:
    case None{}:
      ht
    case Some{+i}:
      and_intro(B.im.inline(i), B.ims.inline(B.ims.of(t)), hm, ht)

def imsof_il(ns: List<&2, B.Node>, +h: {B.nodes.inline(ns) == True{} : Bool}) -> {B.ims.inline(B.ims.of(ns)) == True{} : Bool}:
  match ns:
    case Nil{}:
      {==}
    case Con{nd, +t}:
      match nd:
        case B.NImport{+txt, +no}:
          imk_il(B.im.of(txt, no), t, imade_il(B.until(B.drop(7n, txt), 32), no, il_until(B.drop(7n, txt), 32, il_drop(7n, txt, and_l(B.inline(txt), B.nodes.inline(t), h)))),
            imsof_il(t, and_r(B.inline(txt), B.nodes.inline(t), h)))
        case B.NObj{+abs, +ext, +name, +parents, +kids, +no}:
          imsof_il(t, and_r(Bool.and(B.inline(name), B.nodes.inline(kids)), B.nodes.inline(t), h))
        case B.NDef{+share, +upd, +name, +rest, +params, +body, +no, +ind, +what}:
          imsof_il(t, and_r(Bool.and(Bool.and(B.inline(name), B.inline(rest)), B.bls.inline(body)), B.nodes.inline(t), h))
        case B.NDecl{+names, +no}:
          imsof_il(t, h)
        case B.NBad{+txt, +no}:
          imsof_il(t, h)
        case B.NErr{+msg, +no}:
          imsof_il(t, h)
        case B.NBend{+lines, +no}:
          imsof_il(t, h)

def cisof_il(xs: List<&2, B.Im>, +mpath: List<&2, U32>, +h: {B.ims.inline(xs) == True{} : Bool}) -> {B.cis.inline(B.cis.of(xs, mpath)) == True{} : Bool}:
  match xs:
    case Nil{}:
      {==}
    case Con{i, +t}:
      match i:
        case B.Im{+p, +alias, +blend, +no}:
          and_intro(B.inline(alias), B.cis.inline(B.cis.of(t, mpath)), and_r(B.inline(p), B.inline(alias), and_l(Bool.and(B.inline(p), B.inline(alias)), B.ims.inline(t), h)),
            cisof_il(t, mpath, and_r(Bool.and(B.inline(p), B.inline(alias)), B.ims.inline(t), h)))

def Laws.inline.own(ns, mpath, h):
  cisof_il(B.ims.of(ns), mpath, imsof_il(ns, h))

# The units' table: each unit put within a line

def hte_il(d: Nat) -> {B.ht.inline(B.ht.empty(B.Pk<B.Un>, d)) == True{} : Bool}:
  match d:
    case 0n:
      {==}
    case 1n+(+k):
      and_intro(B.ht.inline(B.ht.empty(B.Pk<B.Un>, k)), B.ht.inline(B.ht.empty(B.Pk<B.Un>, k)), hte_il(k), hte_il(k))

def il_pick2(c: Bool, +z: B.Ht<B.Pk<B.Un>>, +o: B.Ht<B.Pk<B.Un>>, +h: {B.ht.inline(B.HNode{z, o}) == True{} : Bool}) -> {B.ht.inline(B.ht.pick(B.Pk<B.Un>, c, o, z)) == True{} : Bool}:
  match c:
    case True{}:
      and_r(B.ht.inline(z), B.ht.inline(o), h)
    case False{}:
      and_l(B.ht.inline(z), B.ht.inline(o), h)

def il_join(c: Bool, +x: B.Ht<B.Pk<B.Un>>, +y: B.Ht<B.Pk<B.Un>>, +hx: {B.ht.inline(x) == True{} : Bool}, +hy: {B.ht.inline(y) == True{} : Bool}) -> {B.ht.inline(B.ht.join(B.Pk<B.Un>, c, x, y)) == True{} : Bool}:
  match c:
    case True{}:
      and_intro(B.ht.inline(x), B.ht.inline(y), hx, hy)
    case False{}:
      and_intro(B.ht.inline(y), B.ht.inline(x), hy, hx)

def pkil(e: B.Pk<B.Un>) -> Bool:
  match e:
    case B.Pk{+k, u}:
      B.un.inline(u)

def pks_cons(e: B.Pk<B.Un>, +es: List<&2, B.Pk<B.Un>>, +he: {pkil(e) == True{} : Bool}, +hes: {B.pks.inline(es) == True{} : Bool}) -> {B.pks.inline(Con{e, es}) == True{} : Bool}:
  match e:
    case B.Pk{+k, +u}:
      and_intro(B.un.inline(u), B.pks.inline(es), he, hes)

def htput_il(fuel: Nat, t: B.Ht<B.Pk<B.Un>>, +b: U32, +h: U32, +e: B.Pk<B.Un>, +he: {pkil(e) == True{} : Bool}, +ht: {B.ht.inline(t) == True{} : Bool}) ->
    {B.ht.inline(B.ht.put.go(B.Pk<B.Un>, fuel, t, b, h, e)) == True{} : Bool}:
  match fuel:
    case 0n:
      match t:
        case B.HLeaf{+es}:
          pks_cons(e, es, he, ht)
        case B.HNode{z, o}:
          pks_cons(e, Nil{}, he, {==})
    case 1n+(+k):
      match t:
        case B.HLeaf{+es}:
          pks_cons(e, es, he, ht)
        case B.HNode{+z, +o}:
          il_join(U32.is_eq(b, 0), B.ht.put.go(B.Pk<B.Un>, k, B.ht.pick(B.Pk<B.Un>, U32.is_eq(b, 0), z, o), nb(h), nh(h), e), B.ht.pick(B.Pk<B.Un>, U32.is_eq(b, 0), o, z),
            htput_il(k, B.ht.pick(B.Pk<B.Un>, U32.is_eq(b, 0), z, o), nb(h), nh(h), e, he, il_pick(U32.is_eq(b, 0), z, o, ht)), il_pick2(U32.is_eq(b, 0), z, o, ht))

def ptputs_il(xs: List<&2, B.Un>, +k: U32, +t: B.Ht<B.Pk<B.Un>>, +hx: {B.uns.inline(xs) == True{} : Bool}, +ht: {B.ht.inline(t) == True{} : Bool}) ->
    {B.ht.inline(B.pt.puts(B.Un, xs, k, t)) == True{} : Bool}:
  match xs:
    case Nil{}:
      ht
    case Con{+x, +r}:
      htput_il(32n, B.pt.puts(B.Un, r, U32.add(k, 1), t), U32.and(k, 1), k, B.Pk{k, x}, and_l(B.un.inline(x), B.uns.inline(r), hx),
        ptputs_il(r, U32.add(k, 1), t, and_r(B.un.inline(x), B.uns.inline(r), hx), ht))

def ptof_il(+xs: List<&2, B.Un>, +h: {B.uns.inline(xs) == True{} : Bool}) -> {B.ht.inline(B.pt.of(B.Un, xs)) == True{} : Bool}:
  ptputs_il(xs, 0, B.ht.for(B.Pk<B.Un>, List.length(&2, B.Un, xs)), h, hte_il(B.ht.depth(32n, U32.from_nat(List.length(&2, B.Un, xs)))))

def uok(+c: Bool, +u: B.Un, +t: List<&2, B.Un>, +laws: Bool) -> List<&2, B.Un>:
  B.when(List<&2, B.Un>, c, v => Con{u, B.units.of(t, laws)}, v => B.units.of(t, laws))

def uo_k(c: Bool, +u: B.Un, +t: List<&2, B.Un>, +laws: Bool, +hu: {B.un.inline(u) == True{} : Bool}, +ih: {B.uns.inline(B.units.of(t, laws)) == True{} : Bool}) ->
    {B.uns.inline(uok(c, u, t, laws)) == True{} : Bool}:
  match c:
    case True{}:
      and_intro(B.un.inline(u), B.uns.inline(B.units.of(t, laws)), hu, ih)
    case False{}:
      ih

def unitsof_il(us: List<&2, B.Un>, +laws: Bool, +h: {B.uns.inline(us) == True{} : Bool}) -> {B.uns.inline(B.units.of(us, laws)) == True{} : Bool}:
  match us:
    case Nil{}:
      {==}
    case Con{+u, +t}:
      uo_k(Bool.not(Bool.xor(laws, U32.is_gt(B.node.what(B.un.node(u)), 0))), u, t, laws, and_l(B.un.inline(u), B.uns.inline(t), h),
        unitsof_il(t, laws, and_r(B.un.inline(u), B.uns.inline(t), h)))

def Laws.inline.table(us, laws, h):
  ptof_il(B.units.of(us, laws), unitsof_il(us, laws, h))

# The files' names and the modules' paths: parts of paths

def ssk(+c: Bool, +h: U32, +t: List<&2, U32>, +cur: List<&2, U32>, +out: List<&2, List<&2, U32>>) -> List<&2, List<&2, U32>>:
  B.when(List<&2, List<&2, U32>>, c, u => B.split.slash(t, Nil{}, Con{List.reverse(&2, U32, cur), out}), u => B.split.slash(t, Con{h, cur}, out))

def ssk_il(c: Bool, +h: U32, +t: List<&2, U32>, +cur: List<&2, U32>, +out: List<&2, List<&2, U32>>,
    ih1: {B.inlines(B.split.slash(t, Nil{}, Con{List.reverse(&2, U32, cur), out})) == True{} : Bool}, ih2: {B.inlines(B.split.slash(t, Con{h, cur}, out)) == True{} : Bool}) ->
    {B.inlines(ssk(c, h, t, cur, out)) == True{} : Bool}:
  match c:
    case True{}:
      ih1
    case False{}:
      ih2

def ss_il(xs: List<&2, U32>, +cur: List<&2, U32>, +out: List<&2, List<&2, U32>>, +hx: {B.inline(xs) == True{} : Bool}, +hc: {B.inline(cur) == True{} : Bool},
    +ho: {B.inlines(out) == True{} : Bool}) -> {B.inlines(B.split.slash(xs, cur, out)) == True{} : Bool}:
  match xs:
    case Nil{}:
      ils_rgo(Con{List.reverse(&2, U32, cur), out}, Nil{}, and_intro(B.inline(List.reverse(&2, U32, cur)), B.inlines(out), il_rev(cur, hc), ho), {==})
    case Con{+h, +t}:
      ssk_il(U32.is_eq(h, 47), h, t, cur, out,
        ss_il(t, Nil{}, Con{List.reverse(&2, U32, cur), out}, il_tail(h, t, hx), {==}, and_intro(B.inline(List.reverse(&2, U32, cur)), B.inlines(out), il_rev(cur, hc), ho)),
        ss_il(t, Con{h, cur}, out, il_tail(h, t, hx), il_cons(h, cur, ne10(h, t, hx), hc), ho))

def upr_il(from: List<&2, List<&2, U32>>, +to: List<&2, List<&2, U32>>, +h: {B.inlines(to) == True{} : Bool}) -> {B.inlines(B.path.ups.rest(from, to)) == True{} : Bool}:
  match from:
    case Nil{}:
      h
    case Con{f, +t}:
      and_intro(B.inline(B.codes("..")), B.inlines(B.path.ups.rest(t, to)), {==}, upr_il(t, to, h))

def prk(+c: Bool, +f: List<&2, U32>, +ft: List<&2, List<&2, U32>>, +t: List<&2, U32>, +tt: List<&2, List<&2, U32>>) -> List<&2, List<&2, U32>>:
  B.when(List<&2, List<&2, U32>>, c, u => B.path.rel(ft, tt), u => B.path.ups(Con{f, ft}, Con{t, tt}))

def prk_il(c: Bool, +f: List<&2, U32>, +ft: List<&2, List<&2, U32>>, +t: List<&2, U32>, +tt: List<&2, List<&2, U32>>, +h: {B.inlines(Con{t, tt}) == True{} : Bool},
    +ih: {B.inlines(B.path.rel(ft, tt)) == True{} : Bool}) -> {B.inlines(prk(c, f, ft, t, tt)) == True{} : Bool}:
  match c:
    case True{}:
      ih
    case False{}:
      upr_il(Con{f, ft}, Con{t, tt}, h)

def prel_il(from: List<&2, List<&2, U32>>, to: List<&2, List<&2, U32>>, +h: {B.inlines(to) == True{} : Bool}) -> {B.inlines(B.path.rel(from, to)) == True{} : Bool}:
  match from:
    case Nil{}:
      match to:
        case Nil{}:
          {==}
        case Con{+t, +tt}:
          h
    case Con{+f, +ft}:
      match to:
        case Nil{}:
          upr_il(Con{f, ft}, Nil{}, {==})
        case Con{+t, +tt}:
          prk_il(B.same(f, t), f, ft, t, tt, h, prel_il(ft, tt, and_r(B.inline(t), B.inlines(tt), h)))

def il_slashes(ps: List<&2, List<&2, U32>>, +h: {B.inlines(ps) == True{} : Bool}) -> {B.inline(B.slashes(ps)) == True{} : Bool}:
  match ps:
    case Nil{}:
      {==}
    case Con{+p, +t}:
      match t:
        case Nil{}:
          and_l(B.inline(p), True{}, h)
        case Con{+q, +r}:
          il_app(p, Con{47, B.slashes(Con{q, r})}, and_l(B.inline(p), B.inlines(Con{q, r}), h),
            il_slashes(Con{q, r}, and_r(B.inline(p), B.inlines(Con{q, r}), h)))

def mdname_il(+root: List<&2, U32>, +path: List<&2, U32>, +h: {B.inline(path) == True{} : Bool}) -> {B.inline(B.md.name(root, path)) == True{} : Bool}:
  il_slashes(B.path.rel(B.path.dir(root), B.split.slash(path, Nil{}, Nil{})), prel_il(B.path.dir(root), B.split.slash(path, Nil{}, Nil{}), ss_il(path, Nil{}, Nil{}, h, {==}, {==})))

def mdsnames_il(ms: List<&2, B.Md>, +root: List<&2, U32>, +h: {B.mds.inline(ms) == True{} : Bool}) -> {B.inlines(B.mds.names(ms, root)) == True{} : Bool}:
  match ms:
    case Nil{}:
      {==}
    case Con{m, +t}:
      match m:
        case B.Md{+path, +bs, +ok, +from}:
          and_intro(B.inline(B.md.name(root, path)), B.inlines(B.mds.names(t, root)), mdname_il(root, path, and_l(B.inline(path), B.mds.inline(t), h)),
            mdsnames_il(t, root, and_r(B.inline(path), B.mds.inline(t), h)))

def Laws.inline.files(ms, root, h):
  mdsnames_il(ms, root, h)

# An import's path: its line's, joined to its importer's

def ils_tail(xs: List<&2, List<&2, U32>>, +h: {B.inlines(xs) == True{} : Bool}) -> {B.inlines(List.tail(&2, List<&2, U32>, xs)) == True{} : Bool}:
  match xs:
    case Nil{}:
      {==}
    case Con{+x, +t}:
      and_r(B.inline(x), B.inlines(t), h)

def pnk(+c1: Bool, +c2: Bool, +p: List<&2, U32>, +t: List<&2, List<&2, U32>>, +acc: List<&2, List<&2, U32>>) -> List<&2, List<&2, U32>>:
  B.when(List<&2, List<&2, U32>>, c1, u => B.path.norm(t, acc),
    u => B.when(List<&2, List<&2, U32>>, c2, v => B.path.norm(t, List.tail(&2, List<&2, U32>, acc)), v => B.path.norm(t, Con{p, acc})))

def pnk_il(c1: Bool, c2: Bool, +p: List<&2, U32>, +t: List<&2, List<&2, U32>>, +acc: List<&2, List<&2, U32>>,
    +ih1: {B.inlines(B.path.norm(t, acc)) == True{} : Bool}, +ih2: {B.inlines(B.path.norm(t, List.tail(&2, List<&2, U32>, acc))) == True{} : Bool},
    +ih3: {B.inlines(B.path.norm(t, Con{p, acc})) == True{} : Bool}) -> {B.inlines(pnk(c1, c2, p, t, acc)) == True{} : Bool}:
  match c1 c2:
    case True{} _:
      ih1
    case False{} True{}:
      ih2
    case False{} False{}:
      ih3

def pn_il(ps: List<&2, List<&2, U32>>, +acc: List<&2, List<&2, U32>>, +hp: {B.inlines(ps) == True{} : Bool}, +ha: {B.inlines(acc) == True{} : Bool}) ->
    {B.inlines(B.path.norm(ps, acc)) == True{} : Bool}:
  match ps:
    case Nil{}:
      ils_rgo(acc, Nil{}, ha, {==})
    case Con{+p, +t}:
      pnk_il(Bool.or(B.same(p, B.codes(".")), B.blank(p)), Bool.and(Bool.and(B.same(p, B.codes("..")), Bool.not(B.blank.parts(acc))), Bool.not(B.path.up(acc))), p, t, acc,
        pn_il(t, acc, and_r(B.inline(p), B.inlines(t), hp), ha),
        pn_il(t, List.tail(&2, List<&2, U32>, acc), and_r(B.inline(p), B.inlines(t), hp), ils_tail(acc, ha)),
        pn_il(t, Con{p, acc}, and_r(B.inline(p), B.inlines(t), hp), and_intro(B.inline(p), B.inlines(acc), and_l(B.inline(p), B.inlines(t), hp), ha)))

def pdir_il(+path: List<&2, U32>, +h: {B.inline(path) == True{} : Bool}) -> {B.inlines(B.path.dir(path)) == True{} : Bool}:
  ils_rgo(List.tail(&2, List<&2, U32>, List.reverse(&2, List<&2, U32>, B.split.slash(path, Nil{}, Nil{}))), Nil{},
    ils_tail(List.reverse(&2, List<&2, U32>, B.split.slash(path, Nil{}, Nil{})), ils_rgo(B.split.slash(path, Nil{}, Nil{}), Nil{}, ss_il(path, Nil{}, Nil{}, h, {==}, {==}), {==})), {==})

def pfk_il(+path: List<&2, U32>, +rel: List<&2, U32>, +hp: {B.inline(path) == True{} : Bool}, +hr: {B.inline(rel) == True{} : Bool}) ->
    {B.inline(B.path.from.k(path, rel)) == True{} : Bool}:
  il_slashes(B.path.norm(List.append(&2, List<&2, U32>, B.path.dir(path), B.split.slash(rel, Nil{}, Nil{})), Nil{}),
    pn_il(List.append(&2, List<&2, U32>, B.path.dir(path), B.split.slash(rel, Nil{}, Nil{})), Nil{},
      ils_app(B.path.dir(path), B.split.slash(rel, Nil{}, Nil{}), pdir_il(path, hp), ss_il(rel, Nil{}, Nil{}, hr, {==}, {==})), {==}))

def pfm(+c: Bool, +path: List<&2, U32>, +rel: List<&2, U32>) -> List<&2, U32>:
  B.when(List<&2, U32>, c, u => Con{47, B.path.from.k(path, rel)}, u => B.path.from.k(path, rel))

def pfm_il(c: Bool, +path: List<&2, U32>, +rel: List<&2, U32>, +hp: {B.inline(path) == True{} : Bool}, +hr: {B.inline(rel) == True{} : Bool}) ->
    {B.inline(pfm(c, path, rel)) == True{} : Bool}:
  match c:
    case True{}:
      pfk_il(path, rel, hp, hr)
    case False{}:
      pfk_il(path, rel, hp, hr)

def pfrom_il(+path: List<&2, U32>, +rel: List<&2, U32>, +hp: {B.inline(path) == True{} : Bool}, +hr: {B.inline(rel) == True{} : Bool}) ->
    {B.inline(B.path.from(path, rel)) == True{} : Bool}:
  pfm_il(B.starts(path, [47]), path, rel, hp, hr)

def ibk(+c: Bool, +i: B.Im, +t: List<&2, B.Im>) -> List<&2, B.Im>:
  B.when(List<&2, B.Im>, c, u => Con{i, B.ims.blend(t)}, u => B.ims.blend(t))

def ibk_il(c: Bool, +i: B.Im, +t: List<&2, B.Im>, +hi: {B.im.inline(i) == True{} : Bool}, +ih: {B.ims.inline(B.ims.blend(t)) == True{} : Bool}) ->
    {B.ims.inline(ibk(c, i, t)) == True{} : Bool}:
  match c:
    case True{}:
      and_intro(B.im.inline(i), B.ims.inline(B.ims.blend(t)), hi, ih)
    case False{}:
      ih

def imsblend_il(xs: List<&2, B.Im>, +h: {B.ims.inline(xs) == True{} : Bool}) -> {B.ims.inline(B.ims.blend(xs)) == True{} : Bool}:
  match xs:
    case Nil{}:
      {==}
    case Con{i, +t}:
      match i:
        case B.Im{+path, +alias, +blend, +no}:
          ibk_il(Bool.and(blend, B.import.plain(path, B.codes(".blend"))), B.Im{path, alias, blend, no}, t,
            and_l(Bool.and(B.inline(path), B.inline(alias)), B.ims.inline(t), h), imsblend_il(t, and_r(Bool.and(B.inline(path), B.inline(alias)), B.ims.inline(t), h)))

def tdsof_il(+path: List<&2, U32>, xs: List<&2, B.Im>, +hp: {B.inline(path) == True{} : Bool}, +h: {B.ims.inline(xs) == True{} : Bool}) ->
    {B.tds.inline(B.tds.of(path, xs)) == True{} : Bool}:
  match xs:
    case Nil{}:
      {==}
    case Con{i, +t}:
      match i:
        case B.Im{+p, +alias, +blend, +no}:
          and_intro(B.inline(B.path.from(path, p)), B.tds.inline(B.tds.of(path, t)),
            pfrom_il(path, p, hp, and_l(B.inline(p), B.inline(alias), and_l(Bool.and(B.inline(p), B.inline(alias)), B.ims.inline(t), h))),
            tdsof_il(path, t, hp, and_r(Bool.and(B.inline(p), B.inline(alias)), B.ims.inline(t), h)))

def Laws.inline.imports(path, bs, k, h):
  tdsof_il(path, B.ims.blend(B.ims.of(B.read.at(bs, B.loc.top(k)))), h,
    imsblend_il(B.ims.of(B.read.at(bs, B.loc.top(k))), imsof_il(B.read.at(bs, B.loc.top(k)), Laws.inline.read(bs, B.loc.top(k)))))

# The context joined: files, objects, the root's imports, the table

# the root's imports' aliases, as emission carries them
def eown_il(+cx: B.Cx, +h: {B.nodes.inline(B.ob.mems(B.ob.at(B.cx.obs(cx), 0))) == True{} : Bool}) -> {B.cis.inline(B.emit.own(cx)) == True{} : Bool}:
  Laws.inline.own(B.ob.mems(B.ob.at(B.cx.obs(cx), 0)), B.path.at(B.cx.paths(cx), 0), h)

def Laws.markers.inline(files, trees, als, paths, us, res, mode, rtypes, ux, mt, laws, hf, ht):
  and_intro(Bool.and(Bool.and(B.inlines(files), B.obs.inline(B.obs.made(B.syn.of(als, B.obs(trees))))),
      B.cis.inline(B.emit.own(B.objects.cx(als, paths, B.obs(trees))))),
    B.ht.inline(B.pt.of(B.Un, B.units.of(B.units(B.module.copies(B.obs.made(B.syn.of(als, B.obs(trees))),
      B.objects.cx(als, paths, B.obs(trees)))), laws))),
    and_intro(Bool.and(B.inlines(files), B.obs.inline(B.obs.made(B.syn.of(als, B.obs(trees))))),
      B.cis.inline(B.emit.own(B.objects.cx(als, paths, B.obs(trees)))),
      and_intro(B.inlines(files), B.obs.inline(B.obs.made(B.syn.of(als, B.obs(trees)))), hf, Laws.inline.objects(trees, als, ht)),
      eown_il(B.objects.cx(als, paths, B.obs(trees)), obm_at(B.obs.made(B.syn.of(als, B.obs(trees))), 0, Laws.inline.members(trees, als, ht)))),
    Laws.inline.table(B.units(B.module.copies(B.obs.made(B.syn.of(als, B.obs(trees))),
      B.objects.cx(als, paths, B.obs(trees)))), laws,
      Laws.inline.units(trees, als, B.sy.ls(B.syn.of(als, B.obs(trees))),
        B.folds(B.sy.ls(B.syn.of(als, B.obs(trees))), B.obs.made(B.syn.of(als, B.obs(trees))), B.chains.bad(B.obs.made(B.syn.of(als, B.obs(trees))), B.obs.made(B.syn.of(als, B.obs(trees))), B.sy.pss(B.syn.of(als, B.obs(trees))))),
        als, paths, B.sy.pss(B.syn.of(als, B.obs(trees))),
        ht, Laws.inline.folds(B.sy.ls(B.syn.of(als, B.obs(trees))), B.obs.made(B.syn.of(als, B.obs(trees))),
          B.chains.bad(B.obs.made(B.syn.of(als, B.obs(trees))), B.obs.made(B.syn.of(als, B.obs(trees))), B.sy.pss(B.syn.of(als, B.obs(trees)))), Laws.inline.members(trees, als, ht)))))



# Resolution makes no names (`resolve.names`): along the resolver's
# mirrors, each name a suffix of the token's text (`suffix_drop`, a
# dotted name's last parts by `names.dots_parts`, `suffix_dots`), or
# such a suffix and `#` (`suffix_hash`)

def suffix_refl(xs: List<&2, U32>) -> {B.suffix(xs, xs) == True{} : Bool}:
  match xs:
    case Nil{}:
      {==}
    case Con{+h, +t}:
      or_l_true(B.same(Con{h, t}, Con{h, t}), B.suffix(Con{h, t}, t), Laws.names.same_refl(Con{h, t}))

def suffix_nil(xs: List<&2, U32>) -> {B.suffix(Nil{}, xs) == True{} : Bool}:
  match xs:
    case Nil{}:
      {==}
    case Con{+h, +t}:
      suffix_nil(t)

def suffix_tail(+h: U32, +t: List<&2, U32>) -> {B.suffix(t, Con{h, t}) == True{} : Bool}:
  or_r_true(B.same(t, Con{h, t}), B.suffix(t, t), suffix_refl(t))

def st_k(c: Bool, +a: List<&2, U32>, +b: List<&2, U32>, +h: U32, +t: List<&2, U32>, e: {B.same(b, Con{h, t}) == c : Bool},
    hbc: {Bool.or(c, B.suffix(b, t)) == True{} : Bool}, +hab: {B.suffix(a, b) == True{} : Bool},
    ih: @k:{B.suffix(b, t) == True{} : Bool} -> {B.suffix(a, t) == True{} : Bool}) -> {B.suffix(a, Con{h, t}) == True{} : Bool}:
  match c:
    case True{}:
      %Laws.names.same_eq(b, Con{h, t}, e) : {B.suffix(a, _) == True{} : Bool}
      hab
    case False{}:
      or_r_true(B.same(a, Con{h, t}), B.suffix(a, t), ih(hbc))

def suffix_trans(+a: List<&2, U32>, +b: List<&2, U32>, c: List<&2, U32>, +hab: {B.suffix(a, b) == True{} : Bool}, +hbc: {B.suffix(b, c) == True{} : Bool}) ->
    {B.suffix(a, c) == True{} : Bool}:
  match c:
    case Nil{}:
      %Laws.names.same_eq(b, Nil{}, hbc) : {B.suffix(a, _) == True{} : Bool}
      hab
    case Con{+h, +t}:
      st_k(B.same(b, Con{h, t}), a, b, h, t, {==}, hbc, hab, k => suffix_trans(a, b, t, hab, k))

def suffix_bdrop(k: Nat, xs: List<&2, U32>) -> {B.suffix(B.drop(k, xs), xs) == True{} : Bool}:
  match k:
    case 0n:
      suffix_refl(xs)
    case 1n+(+j):
      match xs:
        case Nil{}:
          {==}
        case Con{+h, +t}:
          suffix_trans(B.drop(j, t), t, Con{h, t}, suffix_bdrop(j, t), suffix_tail(h, t))

def suffix_ldrop(xs: List<&2, U32>, k: Nat) -> {B.suffix(List.drop(&2, U32, xs, k), xs) == True{} : Bool}:
  match xs:
    case Nil{}:
      {==}
    case Con{+h, +t}:
      match k:
        case 0n:
          suffix_refl(Con{h, t})
        case 1n+(+j):
          suffix_trans(List.drop(&2, U32, t, j), t, Con{h, t}, suffix_ldrop(t, j), suffix_tail(h, t))

def suffix_app(a: List<&2, U32>, +b: List<&2, U32>) -> {B.suffix(b, List.append(&2, U32, a, b)) == True{} : Bool}:
  match a:
    case Nil{}:
      suffix_refl(b)
    case Con{+x, +t}:
      suffix_trans(b, List.append(&2, U32, t, b), Con{x, List.append(&2, U32, t, b)}, suffix_app(t, b), suffix_tail(x, List.append(&2, U32, t, b)))

def dots_tail(+p: List<&2, U32>, t: List<&2, List<&2, U32>>) -> {B.suffix(B.dots(t), B.dots(Con{p, t})) == True{} : Bool}:
  match t:
    case Nil{}:
      suffix_nil(p)
    case Con{+q, +r}:
      suffix_trans(B.dots(Con{q, r}), Con{46, B.dots(Con{q, r})}, List.append(&2, U32, p, Con{46, B.dots(Con{q, r})}),
        suffix_tail(46, B.dots(Con{q, r})), suffix_app(p, Con{46, B.dots(Con{q, r})}))

# a dotted name's last parts: a suffix of its parts joined
def suffix_dots(ps: List<&2, List<&2, U32>>, k: Nat) -> {B.suffix(B.dots(List.drop(&2, List<&2, U32>, ps, k)), B.dots(ps)) == True{} : Bool}:
  match ps:
    case Nil{}:
      {==}
    case Con{+p, +t}:
      match k:
        case 0n:
          suffix_refl(B.dots(Con{p, t}))
        case 1n+(+j):
          suffix_trans(B.dots(List.drop(&2, List<&2, U32>, t, j)), B.dots(t), B.dots(Con{p, t}), suffix_dots(t, j), dots_tail(p, t))

def suffix_parts(+n: List<&2, U32>, +k: Nat) -> {B.suffix(B.dots(List.drop(&2, List<&2, U32>, B.parts(n), k)), n) == True{} : Bool}:
  %Laws.names.dots_parts(n) : {B.suffix(B.dots(List.drop(&2, List<&2, U32>, B.parts(n), k)), _) == True{} : Bool}
  suffix_dots(B.parts(n), k)

def sh_k(c: Bool, +p: List<&2, U32>, +x: U32, +t: List<&2, U32>, e: {B.same(p, Con{x, t}) == c : Bool}, h: {Bool.or(c, B.suffix(p, t)) == True{} : Bool},
    ih: @k:{B.suffix(p, t) == True{} : Bool} -> {B.suffix(List.append(&2, U32, p, [35]), List.append(&2, U32, t, [35])) == True{} : Bool}) ->
    {B.suffix(List.append(&2, U32, p, [35]), Con{x, List.append(&2, U32, t, [35])}) == True{} : Bool}:
  match c:
    case True{}:
      %Equal.sym(List<&2, U32>, p, Con{x, t}, Laws.names.same_eq(p, Con{x, t}, e)) : {B.suffix(List.append(&2, U32, _, [35]), Con{x, List.append(&2, U32, t, [35])}) == True{} : Bool}
      suffix_refl(Con{x, List.append(&2, U32, t, [35])})
    case False{}:
      or_r_true(B.same(List.append(&2, U32, p, [35]), Con{x, List.append(&2, U32, t, [35])}), B.suffix(List.append(&2, U32, p, [35]), List.append(&2, U32, t, [35])), ih(h))

# a suffix and `#`: a suffix of the text and `#`
def suffix_hash(+p: List<&2, U32>, xs: List<&2, U32>, h: {B.suffix(p, xs) == True{} : Bool}) ->
    {B.suffix(List.append(&2, U32, p, [35]), List.append(&2, U32, xs, [35])) == True{} : Bool}:
  match xs:
    case Nil{}:
      %Equal.sym(List<&2, U32>, p, Nil{}, Laws.names.same_eq(p, Nil{}, h)) : {B.suffix(List.append(&2, U32, _, [35]), [35]) == True{} : Bool}
      {==}
    case Con{+x, +t}:
      sh_k(B.same(p, Con{x, t}), p, x, t, {==}, h, k => suffix_hash(p, t, k))

def made_s(+n: List<&2, U32>, +txt: List<&2, U32>, +h: {B.suffix(n, txt) == True{} : Bool}) -> {B.name.made(n, txt) == True{} : Bool}:
  or_l_true(B.suffix(n, txt), B.suffix(n, List.append(&2, U32, txt, [35])), h)

def made_h(+r: List<&2, U32>, +txt: List<&2, U32>, +h: {B.suffix(r, txt) == True{} : Bool}) -> {B.name.made(List.append(&2, U32, r, [35]), txt) == True{} : Bool}:
  or_r_true(B.suffix(List.append(&2, U32, r, [35]), txt), B.suffix(List.append(&2, U32, r, [35]), List.append(&2, U32, txt, [35])), suffix_hash(r, txt, h))

# The resolver's decisions, each making a name of the token's text

def tok_mk(+t: B.Tok) -> {B.rr.made(B.rr.tok(t), t) == True{} : Bool}:
  and_intro(B.tok.same(t, t), True{}, tok_refl(t), {==})

def er_mk(+t: B.Tok, +no: B.Loc, +msg: String) -> {B.rr.made(B.rr.er(t, no, msg), t) == True{} : Bool}:
  and_intro(B.tok.same(t, t), True{}, tok_refl(t), {==})

def rfn_mk(c: Bool, +cx: B.Cx, +obj: U32, +mark: U32, +n: List<&2, U32>, +t: B.Tok, +no: B.Loc, +hn: {B.suffix(n, B.tok.bytes(t)) == True{} : Bool}) ->
    {B.rr.made(rfn_k(c, cx, obj, mark, n, t, no), t) == True{} : Bool}:
  match c:
    case True{}:
      er_mk(t, no, B.text(B.tok.txt(t)) ++ " names a definition of " ++ B.ob.name(B.cx.obs(cx), obj) ++ ", which is abstract and emits nothing")
    case False{}:
      and_intro(B.name.made(n, B.tok.bytes(t)), True{}, made_s(n, B.tok.bytes(t), hn), {==})

def final_mk(+cx: B.Cx, +obj: U32, +mark: U32, +n: List<&2, U32>, +t: B.Tok, +no: B.Loc, +hn: {B.suffix(n, B.tok.bytes(t)) == True{} : Bool}) ->
    {B.rr.made(B.rr.final(cx, obj, mark, n, t, no), t) == True{} : Bool}:
  rfn_mk(B.ob.abs(B.ob.at(B.cx.obs(cx), obj)), cx, obj, mark, n, t, no, hn)

def rhs_mk(c: Bool, +cx: B.Cx, +h: U32, +n: List<&2, U32>, +t: B.Tok, +whole: List<&2, U32>, +no: B.Loc, +hn: {B.suffix(n, B.tok.bytes(t)) == True{} : Bool}) ->
    {B.rr.made(rhs_k(c, cx, h, n, t, whole, no), t) == True{} : Bool}:
  match c:
    case True{}:
      final_mk(cx, h, 0, n, t, no, hn)
    case False{}:
      er_mk(t, no, B.text(whole) ++ ": " ++ B.ob.name(B.cx.obs(cx), h) ++ " has no " ++ B.text(n))

def rh_mk(m: Maybe<&2, U32>, +cx: B.Cx, +n: List<&2, U32>, +t: B.Tok, +whole: List<&2, U32>, +no: B.Loc, +hn: {B.suffix(n, B.tok.bytes(t)) == True{} : Bool}) ->
    {B.rr.made(rhk(m, cx, n, t, whole, no), t) == True{} : Bool}:
  match m:
    case None{}:
      er_mk(t, no, B.text(whole) ++ " steps out of the module, which has no host")
    case Some{+h}:
      rhs_mk(B.cx.has(cx, h, n), cx, h, n, t, whole, no, hn)

def host_mk(+cx: B.Cx, +o: U32, +q: U32, +k: Nat, +n: List<&2, U32>, +t: B.Tok, +whole: List<&2, U32>, +no: B.Loc, +hn: {B.suffix(n, B.tok.bytes(t)) == True{} : Bool}) ->
    {B.rr.made(B.rr.host(cx, o, q, k, n, t, whole, no), t) == True{} : Bool}:
  rh_mk(List.get(&2, U32, B.hosts(B.cx.obs(cx), q), Nat.sub(k, 1n)), cx, n, t, whole, no, hn)

def rfo1_mk(m: Maybe<&2, List<&2, U32>>, +mark: U32, +n: List<&2, U32>, +t: B.Tok, +hn: {B.suffix(n, B.tok.bytes(t)) == True{} : Bool}) ->
    {B.rr.made(rfo1(m, mark, n, t), t) == True{} : Bool}:
  match m:
    case None{}:
      tok_mk(t)
    case Some{+p}:
      and_intro(B.name.made(B.drop(1n+List.length(&2, U32, B.List.head.or(B.parts(n))), n), B.tok.bytes(t)), True{},
        made_s(B.drop(1n+List.length(&2, U32, B.List.head.or(B.parts(n))), n), B.tok.bytes(t),
          suffix_trans(B.drop(1n+List.length(&2, U32, B.List.head.or(B.parts(n))), n), n, B.tok.bytes(t), suffix_bdrop(1n+List.length(&2, U32, B.List.head.or(B.parts(n))), n), hn)), {==})

def rfo2_mk(c: Bool, +cx: B.Cx, +m: U32, +mark: U32, +n: List<&2, U32>, +t: B.Tok, +hn: {B.suffix(n, B.tok.bytes(t)) == True{} : Bool}) ->
    {B.rr.made(rfo2(c, cx, m, mark, n, t), t) == True{} : Bool}:
  match c:
    case True{}:
      and_intro(B.name.made(n, B.tok.bytes(t)), True{}, made_s(n, B.tok.bytes(t), hn), {==})
    case False{}:
      tok_mk(t)

def rfok_mk(c: Bool, +cx: B.Cx, +m: U32, +mark: U32, +n: List<&2, U32>, +t: B.Tok, +hn: {B.suffix(n, B.tok.bytes(t)) == True{} : Bool}) ->
    {B.rr.made(rfok(c, cx, m, mark, n, t), t) == True{} : Bool}:
  match c:
    case True{}:
      rfo1_mk(B.ci.find(B.mod.cis(cx, m), B.List.head.or(B.parts(n))), mark, n, t, hn)
    case False{}:
      rfo2_mk(B.names.has(B.tree.types(B.mod.tree(cx, m)), n), cx, m, mark, n, t, hn)

def foreign_mk(+cx: B.Cx, +m: U32, +mark: U32, +n: List<&2, U32>, +t: B.Tok, +hn: {B.suffix(n, B.tok.bytes(t)) == True{} : Bool}) ->
    {B.rr.made(B.rr.foreign(cx, m, mark, n, t), t) == True{} : Bool}:
  rfok_mk(Bool.not(B.blank.parts(List.tail(&2, List<&2, U32>, B.parts(n)))), cx, m, mark, n, t, hn)

def rbs_mk(c: Bool, +n: List<&2, U32>, +t: B.Tok, +no: B.Loc) -> {B.rr.made(rbs_k(c, n, t, no), t) == True{} : Bool}:
  match c:
    case True{}:
      er_mk(t, no, B.text(n) ++ ": names beginning Blend_ are Blend's own")
    case False{}:
      tok_mk(t)

def rbd_mk(c: Bool, +cx: B.Cx, +q: U32, +mark: U32, +n: List<&2, U32>, +t: B.Tok, +no: B.Loc, +hn: {B.suffix(n, B.tok.bytes(t)) == True{} : Bool}) ->
    {B.rr.made(rbd_k(c, cx, q, mark, n, t, no), t) == True{} : Bool}:
  match c:
    case True{}:
      rbs_mk(B.starts.s(n, "Blend_"), n, t, no)
    case False{}:
      foreign_mk(cx, B.loc.mod(B.ob.no(B.ob.at(B.cx.obs(cx), q))), mark, n, t, hn)

def bend_mk(+cx: B.Cx, +q: U32, +mark: U32, +n: List<&2, U32>, +t: B.Tok, +no: B.Loc, +hn: {B.suffix(n, B.tok.bytes(t)) == True{} : Bool}) ->
    {B.rr.made(B.rr.bend(cx, q, mark, n, t, no), t) == True{} : Bool}:
  rbd_mk(U32.is_eq(B.loc.mod(B.ob.no(B.ob.at(B.cx.obs(cx), q))), 0), cx, q, mark, n, t, no, hn)

def mrfmk(m: Maybe<&2, B.Rf>, +n: List<&2, U32>) -> Bool:
  match m:
    case None{}:
      True{}
    case Some{f}:
      B.suffix(B.rf.name(f), n)

def lox_mk(c: Bool, +x: U32, +j: Nat, +k: Nat, +cx: B.Cx, +q: U32, +ps: List<&2, List<&2, U32>>, +ih: {mrfmk(B.look.obj(j, cx, q, ps), B.dots(ps)) == True{} : Bool}) ->
    {mrfmk(lox_k(c, x, j, k, cx, q, ps), B.dots(ps)) == True{} : Bool}:
  match c:
    case True{}:
      suffix_dots(ps, k)
    case False{}:
      ih

def lok_mk(m: Maybe<&2, U32>, +j: Nat, +k: Nat, +cx: B.Cx, +q: U32, +ps: List<&2, List<&2, U32>>, +ih: {mrfmk(B.look.obj(j, cx, q, ps), B.dots(ps)) == True{} : Bool}) ->
    {mrfmk(lok(m, j, k, cx, q, ps), B.dots(ps)) == True{} : Bool}:
  match m:
    case None{}:
      ih
    case Some{+x}:
      lox_mk(B.cx.has(cx, x, B.dots(List.drop(&2, List<&2, U32>, ps, k))), x, j, k, cx, q, ps, ih)

def lo_mk(k: Nat, +cx: B.Cx, +q: U32, +ps: List<&2, List<&2, U32>>) -> {mrfmk(B.look.obj(k, cx, q, ps), B.dots(ps)) == True{} : Bool}:
  match k:
    case 0n:
      {==}
    case 1n+(+j):
      lok_mk(B.resolve(List.length(&2, B.Ob, B.cx.obs(cx)), B.cx.als(cx), B.cx.obs(cx), q, List.take(&2, List<&2, U32>, ps, 1n+j)), j, 1n+j, cx, q, ps, lo_mk(j, cx, q, ps))

def lo_n(+k: Nat, +cx: B.Cx, +q: U32, +n: List<&2, U32>) -> {mrfmk(B.look.obj(k, cx, q, B.parts(n)), n) == True{} : Bool}:
  %Laws.names.dots_parts(n) : {mrfmk(B.look.obj(k, cx, q, B.parts(n)), _) == True{} : Bool}
  lo_mk(k, cx, q, B.parts(n))

def rf_mk(+cx: B.Cx, +mark: U32, +t: B.Tok, +no: B.Loc, f: B.Rf, +hf: {B.suffix(B.rf.name(f), B.tok.bytes(t)) == True{} : Bool}) -> {B.rr.made(B.rr.rf(cx, mark, t, no, f), t) == True{} : Bool}:
  match f:
    case B.Rf{+obj, +name, +prior, +origin}:
      final_mk(cx, obj, mark, name, t, no, hf)

def rd_mk(m: Maybe<&2, B.Rf>, +cx: B.Cx, +q: U32, +mark: U32, +n: List<&2, U32>, +t: B.Tok, +no: B.Loc, +hm: {mrfmk(m, n) == True{} : Bool},
    +hn: {B.suffix(n, B.tok.bytes(t)) == True{} : Bool}) -> {B.rr.made(rdk(m, cx, q, mark, n, t, no), t) == True{} : Bool}:
  match m:
    case None{}:
      bend_mk(cx, q, mark, n, t, no, hn)
    case Some{+f}:
      rf_mk(cx, mark, t, no, f, suffix_trans(B.rf.name(f), n, B.tok.bytes(t), hm, hn))

def dotted_mk(+cx: B.Cx, +q: U32, +mark: U32, +n: List<&2, U32>, +t: B.Tok, +no: B.Loc, +hn: {B.suffix(n, B.tok.bytes(t)) == True{} : Bool}) ->
    {B.rr.made(B.rr.dotted(cx, q, mark, n, t, no), t) == True{} : Bool}:
  rd_mk(B.look.obj(List.length(&2, List<&2, U32>, List.tail(&2, List<&2, U32>, B.parts(n))), cx, q, B.parts(n)), cx, q, mark, n, t, no,
    lo_n(List.length(&2, List<&2, U32>, List.tail(&2, List<&2, U32>, B.parts(n))), cx, q, n), hn)

def rp_mk(m: Maybe<&2, U32>, +cx: B.Cx, +q: U32, +mark: U32, +n: List<&2, U32>, +t: B.Tok, +no: B.Loc, +hn: {B.suffix(n, B.tok.bytes(t)) == True{} : Bool}) ->
    {B.rr.made(rpk(m, cx, q, mark, n, t, no), t) == True{} : Bool}:
  match m:
    case None{}:
      dotted_mk(cx, q, mark, n, t, no, hn)
    case Some{+h}:
      final_mk(cx, h, mark, n, t, no, hn)

def plaink_mk(local: Bool, +cx: B.Cx, +o: U32, +q: U32, +mark: U32, +n: List<&2, U32>, +t: B.Tok, +no: B.Loc, +hn: {B.suffix(n, B.tok.bytes(t)) == True{} : Bool}) ->
    {B.rr.made(B.rr.plain.k(local, cx, o, q, mark, n, t, no), t) == True{} : Bool}:
  match local:
    case True{}:
      tok_mk(t)
    case False{}:
      rp_mk(B.look(cx, Con{o, B.hosts(B.cx.obs(cx), q)}, n), cx, q, mark, n, t, no, hn)

def plain_mk(+cx: B.Cx, +o: U32, +q: U32, +locals: List<&2, List<&2, U32>>, +mark: U32, +n: List<&2, U32>, +t: B.Tok, +no: B.Loc,
    +hn: {B.suffix(n, B.tok.bytes(t)) == True{} : Bool}) -> {B.rr.made(B.rr.plain(cx, o, q, locals, mark, n, t, no), t) == True{} : Bool}:
  plaink_mk(B.names.has(locals, n), cx, o, q, mark, n, t, no, hn)

def rpo_mk(m: Maybe<&2, U32>, +cx: B.Cx, +o: U32, +q: U32, +n: List<&2, U32>, +t: B.Tok, +no: B.Loc, +hn: {B.name.made(n, B.tok.bytes(t)) == True{} : Bool}) ->
    {B.rr.made(rpok(m, cx, o, q, n, t, no), t) == True{} : Bool}:
  match m:
    case None{}:
      er_mk(t, no, "_" ++ B.text(B.name.plain(n)) ++ ": " ++ B.ob.name(B.cx.obs(cx), o) ++ " has no " ++
        B.when(String, B.ends(n, [35]), v => "proof of ", v => "definition of ") ++ B.text(B.name.plain(n)) ++ " before " ++ B.ob.name(B.cx.obs(cx), q) ++ "'s")
    case Some{+c}:
      and_intro(B.name.made(n, B.tok.bytes(t)), Bool.and(B.name.made(n, B.tok.bytes(t)), True{}), hn, and_intro(B.name.made(n, B.tok.bytes(t)), True{}, hn, {==}))

def prior_of_mk(+cx: B.Cx, +o: U32, +q: U32, +n: List<&2, U32>, +t: B.Tok, +no: B.Loc, +hn: {B.name.made(n, B.tok.bytes(t)) == True{} : Bool}) ->
    {B.rr.made(B.rr.prior.of(cx, o, q, n, t, no), t) == True{} : Bool}:
  rpo_mk(B.prior.find(B.en.chain(B.cx.find(cx, o, n)), B.after(B.cx.ord(cx, o), q)), cx, o, q, n, t, no, hn)

def rpr_mk(c: Bool, +cx: B.Cx, +o: U32, +q: U32, +n: List<&2, U32>, +t: B.Tok, +no: B.Loc, +hn: {B.suffix(n, B.tok.bytes(t)) == True{} : Bool}) ->
    {B.rr.made(rprk(c, cx, o, q, n, t, no), t) == True{} : Bool}:
  match c:
    case True{}:
      prior_of_mk(cx, o, q, List.append(&2, U32, n, [35]), t, no, made_h(n, B.tok.bytes(t), hn))
    case False{}:
      prior_of_mk(cx, o, q, n, t, no, made_s(n, B.tok.bytes(t), hn))

def under_mk(local: Bool, +cx: B.Cx, +o: U32, +q: U32, +r: List<&2, U32>, +t: B.Tok, +no: B.Loc, +hr: {B.suffix(r, B.tok.bytes(t)) == True{} : Bool}) ->
    {B.rr.made(B.rr.under(local, cx, o, q, r, t, no), t) == True{} : Bool}:
  match local:
    case True{}:
      tok_mk(t)
    case False{}:
      rpr_mk(B.cx.has(cx, o, List.append(&2, U32, r, [35])), cx, o, q, r, t, no, hr)

def markk_mk(up: Bool, tpl: Bool, under: Bool, +cx: B.Cx, +o: U32, +q: U32, +locals: List<&2, List<&2, U32>>, +h: U32, +r: List<&2, U32>, +no: B.Loc) ->
    {B.rr.made(B.rr.mark.k(up, tpl, under, cx, o, q, locals, h, r, B.TName{Con{h, r}}, no), B.TName{Con{h, r}}) == True{} : Bool}:
  match up tpl under:
    case True{} _ _:
      host_mk(cx, o, q, B.carets(Con{h, r}), List.drop(&2, U32, Con{h, r}, B.carets(Con{h, r})), B.TName{Con{h, r}}, Con{h, r}, no,
        suffix_ldrop(Con{h, r}, B.carets(Con{h, r})))
    case False{} True{} _:
      plain_mk(cx, o, q, locals, 126, r, B.TName{Con{h, r}}, no, suffix_tail(h, r))
    case False{} False{} True{}:
      under_mk(Bool.or(Bool.or(B.blank(r), B.names.has(locals, Con{h, r})), B.is.root(B.cx.obs(cx), o)), cx, o, q, r, B.TName{Con{h, r}}, no, suffix_tail(h, r))
    case False{} False{} False{}:
      plain_mk(cx, o, q, locals, 0, Con{h, r}, B.TName{Con{h, r}}, no, suffix_refl(Con{h, r}))

def Laws.resolve.names(cx, o, q, locals, t, no):
  match t:
    case B.TName{+x}:
      match x:
        case Nil{}:
          tok_mk(B.TName{Nil{}})
        case Con{+h, +r}:
          markk_mk(U32.is_eq(h, 94), U32.is_eq(h, 126), U32.is_eq(h, 95), cx, o, q, locals, h, r, no)
    case B.TNum{+x}:
      tok_mk(B.TNum{x})
    case B.TStr{+x}:
      tok_mk(B.TStr{x})
    case B.TCom{+x}:
      tok_mk(B.TCom{x})
    case B.TSp{+x}:
      tok_mk(B.TSp{x})
    case B.TSym{+c}:
      tok_mk(B.TSym{c})

def Laws.units.positions(us, i):
  Equal.cong(Maybe<&2, B.Un>, B.Un, z => B.un.or(z), B.pt.at(B.Un, B.pt.of(B.Un, us), i), List.get(&2, B.Un, us, U32.to_nat(i)),
    Equal.trans(Maybe<&2, B.Un>, B.pt.at(B.Un, B.pt.puts(B.Un, us, 0, B.ht.for(B.Pk<B.Un>, List.length(&2, B.Un, us))), i),
      plist(B.Un, us, 0, i, B.ht.for(B.Pk<B.Un>, List.length(&2, B.Un, us))), List.get(&2, B.Un, us, U32.to_nat(i)),
      puts_at(B.Un, us, 0, i, B.ht.for(B.Pk<B.Un>, List.length(&2, B.Un, us))),
      pl_get(B.Un, us, U32.to_nat(i), 0, i, B.ht.for(B.Pk<B.Un>, List.length(&2, B.Un, us)), empty_at(B.Un, List.length(&2, B.Un, us), i), MNat.add_zero(U32.to_nat(i)))))

# The markers joined at emission (`markers.emitted`): a unit whose node
# is no definition has no lines (`units_e`), so every unit's lines are
# numbered on from its definition's (`lined`), the table's too
# (`units.positions`); with the context (`markers.inline`), the writer's
# law has its hypotheses.

def rle(ls: List<&2, B.Rl>) -> Bool:
  match ls:
    case Nil{}:
      True{}
    case Con{l, t}:
      False{}

def rde(r: B.Rd) -> Bool:
  match r:
    case B.Rd{i, nd, hd, ls}:
      match nd:
        case B.NDef{+share, +upd, name, rest, params, body, +no, +ind, +what}:
          True{}
        case _:
          rle(ls)

def ck_e(i: B.In, +share: U32, +upd: Bool, +name: List<&2, U32>, +rest: List<&2, U32>, +params: List<&2, List<&2, U32>>, +body: List<&2, B.Bl>, +no: B.Loc, +ind: U32, +what: U32,
    h: B.Rb, b: B.Rb, sh: List<&2, B.Er>) -> {rde(Pair.fst(B.Rd, B.Rb, B.copy.k(i, B.NDef{share, upd, name, rest, params, body, no, ind, what}, h, b, sh))) == True{} : Bool}:
  match h b:
    case B.Rb{hl, he, hi} B.Rb{ls, es, more}:
      {==}

def cn_e(+cx: B.Cx, +o: U32, i: B.In, nd: B.Node) -> {rde(Pair.fst(B.Rd, B.Rb, B.copy.node(cx, o, i, nd))) == True{} : Bool}:
  match i:
    case B.In{+n, +q, +prior}:
      match nd:
        case B.NDef{+share, +upd, +name, +rest, +params, +body, +no, +ind, +what}:
          ck_e(B.In{n, q, prior}, share, upd, name, rest, params, body, no, ind, what,
            B.rb.line(no, 0, B.rb.toks(B.toks(rest), cx, o, q, List.append(&2, List<&2, U32>, B.unmarks(params), B.lc.names(B.body.binders(body))), no)),
            B.rb.lines(body, cx, o, q, List.append(&2, List<&2, U32>, B.unmarks(params), B.lc.names(B.body.binders(body)))),
            B.when(List<&2, B.Er>, B.is.root(B.cx.obs(cx), o), u => Nil{},
              u => List.append(&2, B.Er, B.shadow.params(B.unmarks(params), cx, o, q, B.text(B.rf.text(B.cx.obs(cx), B.in.ref(o, B.In{n, q, prior}))), no),
                B.shadow.locals(B.body.binders(body), cx, o, q, B.text(B.rf.text(B.cx.obs(cx), B.in.ref(o, B.In{n, q, prior})))))))
        case B.NImport{+txt, +no}:
          {==}
        case B.NDecl{+names, +no}:
          {==}
        case B.NBad{+txt, +no}:
          {==}
        case B.NErr{+msg, +no}:
          {==}
        case B.NBend{+lines, +no}:
          {==}
        case B.NObj{+abs, +ext, +name, +parents, +kids, +no}:
          {==}

def oc_e(mb: Maybe<&2, B.Node>, +cx: B.Cx, +o: U32, +n: List<&2, U32>, +q: U32, +prior: Bool) -> {rde(Pair.fst(B.Rd, B.Rb, ocm(mb, cx, o, n, q, prior))) == True{} : Bool}:
  match mb:
    case None{}:
      {==}
    case Some{nd}:
      cn_e(cx, o, B.In{n, q, prior}, nd)

def rd_e(+cx: B.Cx, +o: U32, i: B.In) -> {rde(Pair.fst(B.Rd, B.Rb, B.copy.of(cx, o, i))) == True{} : Bool}:
  match i:
    case B.In{+n, +q, +prior}:
      oc_e(B.cx.mem(cx, q, n), cx, o, n, q, prior)

def rdse(rs: List<&2, B.Rd>) -> Bool:
  match rs:
    case Nil{}:
      True{}
    case Con{+r, t}:
      Bool.and(rde(r), rdse(t))

def cpe(c: B.Cp) -> Bool:
  match c:
    case B.Cp{rds, ers, done}:
      rdse(rds)

def cpadd_e(+rd: B.Rd, b: B.Rb, c: B.Cp, +hr: {rde(rd) == True{} : Bool}, +hc: {cpe(c) == True{} : Bool}) -> {cpe(B.cp.add(rd, b, c)) == True{} : Bool}:
  match b:
    case B.Rb{ls, es, more}:
      match c:
        case B.Cp{+rds, ers, done}:
          and_intro(rde(rd), rdse(rds), hr, hc)

def cg_e(c: Bool, +k: Nat, +cx: B.Cx, +o: U32, +i: B.In, +t: List<&2, B.In>, +rds: List<&2, B.Rd>, +ers: List<&2, B.Er>, +done: B.Ht<B.In>,
    ht: {cpe(B.copies.go(k, cx, o, t, B.Cp{rds, ers, done})) == True{} : Bool}, hf: {cpe(B.copies.go(k, cx, o, B.ins.then(t, B.rb.ins(Pair.snd(B.Rd, B.Rb, B.copy.of(cx, o, i)))), B.cp.add(Pair.fst(B.Rd, B.Rb, B.copy.of(cx, o, i)), Pair.snd(B.Rd, B.Rb, B.copy.of(cx, o, i)), B.Cp{rds, ers, B.done.put(done, i)}))) == True{} : Bool}) ->
    {cpe(cgk(c, k, cx, o, i, t, rds, ers, done)) == True{} : Bool}:
  match c:
    case True{}:
      ht
    case False{}:
      %Equal.sym(B.Cp, B.on.pair(B.Rd, B.Rb, B.Cp, B.copy.of(cx, o, i), rd => +b => B.copies.go(k, cx, o, B.ins.then(t, B.rb.ins(b)), B.cp.add(rd, b, B.Cp{rds, ers, B.done.put(done, i)}))), B.copies.go(k, cx, o, B.ins.then(t, B.rb.ins(Pair.snd(B.Rd, B.Rb, B.copy.of(cx, o, i)))), B.cp.add(Pair.fst(B.Rd, B.Rb, B.copy.of(cx, o, i)), Pair.snd(B.Rd, B.Rb, B.copy.of(cx, o, i)), B.Cp{rds, ers, B.done.put(done, i)})), pair_eta_rd(B.copy.of(cx, o, i), rd => +b => B.copies.go(k, cx, o, B.ins.then(t, B.rb.ins(b)), B.cp.add(rd, b, B.Cp{rds, ers, B.done.put(done, i)})))) : {cpe(_) == True{} : Bool}
      hf

# past the fuel, the copies as they were, an error at most added
def short_cpe(todo: List<&2, B.In>, +cx: B.Cx, +o: U32, c: B.Cp, hc: {cpe(c) == True{} : Bool}) -> {cpe(B.cp.short(todo, cx, o, c)) == True{} : Bool}:
  match todo:
    case Nil{}:
      hc
    case Con{i, t}:
      match c:
        case B.Cp{rds, ers, done}:
          hc

def copies_e(n: Nat, +cx: B.Cx, +o: U32, todo: List<&2, B.In>, +c: B.Cp, +hc: {cpe(c) == True{} : Bool}) -> {cpe(B.copies.go(n, cx, o, todo, c)) == True{} : Bool}:
  match n:
    case 0n:
      short_cpe(todo, cx, o, c, hc)
    case 1n+(+k):
      match todo:
        case Nil{}:
          hc
        case Con{+i, +t}:
          match c:
            case B.Cp{+rds, +ers, +done}:
              cg_e(B.done.has(done, i), k, cx, o, i, t, rds, ers, done,
                copies_e(k, cx, o, t, B.Cp{rds, ers, done}, hc),
                copies_e(k, cx, o, B.ins.then(t, B.rb.ins(Pair.snd(B.Rd, B.Rb, B.copy.of(cx, o, i)))), B.cp.add(Pair.fst(B.Rd, B.Rb, B.copy.of(cx, o, i)), Pair.snd(B.Rd, B.Rb, B.copy.of(cx, o, i)), B.Cp{rds, ers, B.done.put(done, i)}),
                  cpadd_e(Pair.fst(B.Rd, B.Rb, B.copy.of(cx, o, i)), Pair.snd(B.Rd, B.Rb, B.copy.of(cx, o, i)), B.Cp{rds, ers, B.done.put(done, i)}, rd_e(cx, o, i), hc)))

def ocse(os: List<&2, B.Oc>) -> Bool:
  match os:
    case Nil{}:
      True{}
    case Con{oc, t}:
      match oc:
        case B.Oc{+id, c}:
          Bool.and(cpe(c), ocse(t))

def mc_e(c1: Bool, abs: Bool, +id: U32, +t: List<&2, B.Ob>, +cx: B.Cx, +ih: {ocse(B.module.copies(t, cx)) == True{} : Bool}) -> {ocse(mck(c1, abs, id, t, cx)) == True{} : Bool}:
  match c1 abs:
    case True{} _:
      ih
    case False{} True{}:
      ih
    case False{} False{}:
      and_intro(cpe(B.copies(cx, id)), ocse(B.module.copies(t, cx)),
        copies_e(B.copies.fuel(), cx, id, B.ins.finals(B.cx.map(cx, id)),
          B.Cp{Nil{}, Nil{}, B.copies.room(cx)}, {==}), ih)

def mcopies_e(os: List<&2, B.Ob>, +cx: B.Cx) -> {ocse(B.module.copies(os, cx)) == True{} : Bool}:
  match os:
    case Nil{}:
      {==}
    case Con{o, +t}:
      match o:
        case B.Ob{+id, +host, path, +abs, parents, mems, +no, +kind, +tpl}:
          mc_e(Bool.or(Bool.not(U32.is_eq(B.loc.mod(no), 0)), Bool.not(B.is.object(kind))), abs, id, t, cx, mcopies_e(t, cx))

def une(u: B.Un) -> Bool:
  match u:
    case B.Un{+o, i, nd, hd, ls}:
      match nd:
        case B.NDef{+share, +upd, name, rest, params, body, +no, +ind, +what}:
          True{}
        case _:
          rle(ls)

def unse(us: List<&2, B.Un>) -> Bool:
  match us:
    case Nil{}:
      True{}
    case Con{+u, t}:
      Bool.and(une(u), unse(t))

def rdse_rev(xs: List<&2, B.Rd>, +acc: List<&2, B.Rd>, +hx: {rdse(xs) == True{} : Bool}, +ha: {rdse(acc) == True{} : Bool}) -> {rdse(List.reverse.go(&2, B.Rd, xs, acc)) == True{} : Bool}:
  match xs:
    case Nil{}:
      ha
    case Con{+r, +t}:
      rdse_rev(t, Con{r, acc}, and_r(rde(r), rdse(t), hx), and_intro(rde(r), rdse(acc), and_l(rde(r), rdse(t), hx), ha))

def urds_e(+o: U32, rs: List<&2, B.Rd>, +h: {rdse(rs) == True{} : Bool}) -> {unse(B.un.rds(o, rs)) == True{} : Bool}:
  match rs:
    case Nil{}:
      {==}
    case Con{r, +t}:
      match r:
        case B.Rd{+i, nd, +hd, +ls}:
          match nd:
            case B.NDef{+share, +upd, +name, +rest, +params, +body, +no, +ind, +what}:
              and_intro(True{}, unse(B.un.rds(o, t)), {==}, urds_e(o, t, and_r(True{}, rdse(t), h)))
            case B.NImport{+txt, +no}:
              and_intro(rle(ls), unse(B.un.rds(o, t)), and_l(rle(ls), rdse(t), h), urds_e(o, t, and_r(rle(ls), rdse(t), h)))
            case B.NDecl{+names, +no}:
              and_intro(rle(ls), unse(B.un.rds(o, t)), and_l(rle(ls), rdse(t), h), urds_e(o, t, and_r(rle(ls), rdse(t), h)))
            case B.NBad{+txt, +no}:
              and_intro(rle(ls), unse(B.un.rds(o, t)), and_l(rle(ls), rdse(t), h), urds_e(o, t, and_r(rle(ls), rdse(t), h)))
            case B.NErr{+msg, +no}:
              and_intro(rle(ls), unse(B.un.rds(o, t)), and_l(rle(ls), rdse(t), h), urds_e(o, t, and_r(rle(ls), rdse(t), h)))
            case B.NBend{+lines, +no}:
              and_intro(rle(ls), unse(B.un.rds(o, t)), and_l(rle(ls), rdse(t), h), urds_e(o, t, and_r(rle(ls), rdse(t), h)))
            case B.NObj{+abs, +ext, +name, +parents, +kids, +no}:
              and_intro(rle(ls), unse(B.un.rds(o, t)), and_l(rle(ls), rdse(t), h), urds_e(o, t, and_r(rle(ls), rdse(t), h)))

def unse_app(a: List<&2, B.Un>, +b: List<&2, B.Un>, +ha: {unse(a) == True{} : Bool}, +hb: {unse(b) == True{} : Bool}) -> {unse(List.append(&2, B.Un, a, b)) == True{} : Bool}:
  match a:
    case Nil{}:
      hb
    case Con{+u, +t}:
      and_intro(une(u), unse(List.append(&2, B.Un, t, b)), and_l(une(u), unse(t), ha), unse_app(t, b, and_r(une(u), unse(t), ha), hb))

# the units copied: none but a definition's has lines
def units_e(os: List<&2, B.Oc>, +h: {ocse(os) == True{} : Bool}) -> {unse(B.units(os)) == True{} : Bool}:
  match os:
    case Nil{}:
      {==}
    case Con{oc, +t}:
      match oc:
        case B.Oc{+id, c}:
          match c:
            case B.Cp{+rds, ers, done}:
              unse_app(B.un.rds(id, List.reverse(&2, B.Rd, rds)), B.units(t),
                urds_e(id, List.reverse(&2, B.Rd, rds), rdse_rev(rds, Nil{}, and_l(rdse(rds), ocse(t), h), {==})), units_e(t, and_r(rdse(rds), ocse(t), h)))

# a unit's lines numbered on from its definition's line, or the line after
def lined(+u: B.Un) -> Bool:
  B.rls.from(B.un.lines(u), B.node.no(B.un.node(u)))

def lined_of(u: B.Un, +hk: {B.un.ok(u) == True{} : Bool}, +he: {une(u) == True{} : Bool}) -> {lined(u) == True{} : Bool}:
  match u:
    case B.Un{+o, +i, nd, +hd, ls}:
      match nd:
        case B.NDef{+share, +upd, +name, +rest, +params, +body, +no, +ind, +what}:
          hk
        case B.NImport{+txt, +no}:
          match ls:
            case Nil{}:
              {==}
            case Con{+l, +t}:
              nope(lined(B.Un{o, i, B.NImport{txt, no}, hd, Con{l, t}}), he)
        case B.NDecl{+names, +no}:
          match ls:
            case Nil{}:
              {==}
            case Con{+l, +t}:
              nope(lined(B.Un{o, i, B.NDecl{names, no}, hd, Con{l, t}}), he)
        case B.NBad{+txt, +no}:
          match ls:
            case Nil{}:
              {==}
            case Con{+l, +t}:
              nope(lined(B.Un{o, i, B.NBad{txt, no}, hd, Con{l, t}}), he)
        case B.NErr{+msg, +no}:
          match ls:
            case Nil{}:
              {==}
            case Con{+l, +t}:
              nope(lined(B.Un{o, i, B.NErr{msg, no}, hd, Con{l, t}}), he)
        case B.NBend{+lines, +no}:
          match ls:
            case Nil{}:
              {==}
            case Con{+l, +t}:
              nope(lined(B.Un{o, i, B.NBend{lines, no}, hd, Con{l, t}}), he)
        case B.NObj{+abs, +ext, +name, +parents, +kids, +no}:
          match ls:
            case Nil{}:
              {==}
            case Con{+l, +t}:
              nope(lined(B.Un{o, i, B.NObj{abs, ext, name, parents, kids, no}, hd, Con{l, t}}), he)

def unsl(us: List<&2, B.Un>) -> Bool:
  match us:
    case Nil{}:
      True{}
    case Con{+u, t}:
      Bool.and(lined(u), unsl(t))

def unsl_of(us: List<&2, B.Un>, +hk: {B.units.ok(us) == True{} : Bool}, +he: {unse(us) == True{} : Bool}) -> {unsl(us) == True{} : Bool}:
  match us:
    case Nil{}:
      {==}
    case Con{+u, +t}:
      and_intro(lined(u), unsl(t), lined_of(u, and_l(B.un.ok(u), B.units.ok(t), hk), and_l(une(u), unse(t), he)),
        unsl_of(t, and_r(B.un.ok(u), B.units.ok(t), hk), and_r(une(u), unse(t), he)))

def uol_k(c: Bool, +u: B.Un, +t: List<&2, B.Un>, +laws: Bool, +hu: {lined(u) == True{} : Bool}, +ih: {unsl(B.units.of(t, laws)) == True{} : Bool}) ->
    {unsl(uok(c, u, t, laws)) == True{} : Bool}:
  match c:
    case True{}:
      and_intro(lined(u), unsl(B.units.of(t, laws)), hu, ih)
    case False{}:
      ih

def unsl_filter(us: List<&2, B.Un>, +laws: Bool, +h: {unsl(us) == True{} : Bool}) -> {unsl(B.units.of(us, laws)) == True{} : Bool}:
  match us:
    case Nil{}:
      {==}
    case Con{+u, +t}:
      uol_k(Bool.not(Bool.xor(laws, U32.is_gt(B.node.what(B.un.node(u)), 0))), u, t, laws, and_l(lined(u), unsl(t), h), unsl_filter(t, laws, and_r(lined(u), unsl(t), h)))

def lined_get(us: List<&2, B.Un>, n: Nat, +h: {unsl(us) == True{} : Bool}) -> {lined(B.un.or(List.get(&2, B.Un, us, n))) == True{} : Bool}:
  match us:
    case Nil{}:
      {==}
    case Con{+u, +t}:
      match n:
        case 0n:
          and_l(lined(u), unsl(t), h)
        case 1n+k:
          lined_get(t, k, and_r(lined(u), unsl(t), h))

# the unit the table finds: the list's, so numbered so
def hl_at(+us: List<&2, B.Un>, +s: U32, +h: {unsl(us) == True{} : Bool}) -> {lined(B.ut.un(B.pt.of(B.Un, us), s)) == True{} : Bool}:
  %Equal.sym(B.Un, B.ut.un(B.pt.of(B.Un, us), s), B.un.at(us, s), Laws.units.positions(us, s)) : {lined(_) == True{} : Bool}
  lined_get(us, U32.to_nat(s), h)

