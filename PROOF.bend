    +paths: List<&2, List<&2, U32>>, +ux: B.Ht<B.Xe>, +roots: List<&2, U32>, +y: U32, hl: {List.length(&2, B.Ru, B.uses.of.e(List.reverse(&2, U32, B.ds.order(B.emit.walk(roots, B.refss(us, ux, 0), obs, us))), B.emit.ec(files, obs, us, als, own, res, paths, ux, B.pt.of(B.Un, us), B.ms.ms(B.emit.ms(B.ds.order(B.emit.walk(roots, B.refss(us, ux, 0), obs, us)), B.refss(us, ux, 0), B.pt.of(B.Un, us), obs, us))), y)) == 1n : Nat}) ->
    {List.length(&2, B.Ru, B.uses.of(List.reverse(&2, U32, B.ds.order(B.emit.walk(roots, B.refss(us, ux, 0), obs, us))), B.refss(us, ux, 0), y)) == 1n : Nat}:
  %ue_of(List.reverse(&2, U32, B.ds.order(B.emit.walk(roots, B.refss(us, ux, 0), obs, us))), files, obs, us, als, own, res, paths, 0, Nil{}, ux, us, B.ms.ms(B.emit.ms(B.ds.order(B.emit.walk(roots, B.refss(us, ux, 0), obs, us)), B.refss(us, ux, 0), B.pt.of(B.Un, us), obs, us)), y) : {List.length(&2, B.Ru, _) == 1n : Nat}
  hl

def Laws.affine.emitted(files, obs, us, als, own, res, paths, ux, roots, y, hy, ha, hl):
  %Equal.sym(List<&2, B.Ru>, B.uses.of.e(List.reverse(&2, U32, B.ds.order(B.emit.walk(roots, B.refss(us, ux, 0), obs, us))), B.emit.ec(files, obs, us, als, own, res, paths, ux, B.pt.of(B.Un, us), B.ms.ms(B.emit.ms(B.ds.order(B.emit.walk(roots, B.refss(us, ux, 0), obs, us)), B.refss(us, ux, 0), B.pt.of(B.Un, us), obs, us))), y), B.uses.of(List.reverse(&2, U32, B.ds.order(B.emit.walk(roots, B.refss(us, ux, 0), obs, us))), B.refss(us, ux, 0), y), ue_of(List.reverse(&2, U32, B.ds.order(B.emit.walk(roots, B.refss(us, ux, 0), obs, us))), files, obs, us, als, own, res, paths, 0, Nil{}, ux, us, B.ms.ms(B.emit.ms(B.ds.order(B.emit.walk(roots, B.refss(us, ux, 0), obs, us)), B.refss(us, ux, 0), B.pt.of(B.Un, us), obs, us)), y)) : {B.ec.mu(B.emit.ec(files, obs, us, als, own, res, paths, ux, B.pt.of(B.Un, us), B.ms.ms(B.emit.ms(B.ds.order(B.emit.walk(roots, B.refss(us, ux, 0), obs, us)), B.refss(us, ux, 0), B.pt.of(B.Un, us), obs, us))), y) == B.mu.after(B.mu.m(B.ec.mu(B.emit.ec(files, obs, us, als, own, res, paths, ux, B.pt.of(B.Un, us), B.ms.ms(B.emit.ms(B.ds.order(B.emit.walk(roots, B.refss(us, ux, 0), obs, us)), B.refss(us, ux, 0), B.pt.of(B.Un, us), obs, us))), B.ru.user(_))), B.Mu{0, 0}) : B.Mu}
  %um_get_none(B.Mu, y) : {B.ec.mu(B.emit.ec(files, obs, us, als, own, res, paths, ux, B.pt.of(B.Un, us), B.ms.ms(B.emit.ms(B.ds.order(B.emit.walk(roots, B.refss(us, ux, 0), obs, us)), B.refss(us, ux, 0), B.pt.of(B.Un, us), obs, us))), y) == B.mu.after(B.mu.m(B.ec.mu(B.emit.ec(files, obs, us, als, own, res, paths, ux, B.pt.of(B.Un, us), B.ms.ms(B.emit.ms(B.ds.order(B.emit.walk(roots, B.refss(us, ux, 0), obs, us)), B.refss(us, ux, 0), B.pt.of(B.Un, us), obs, us))), B.ru.user(B.uses.of(List.reverse(&2, U32, B.ds.order(B.emit.walk(roots, B.refss(us, ux, 0), obs, us))), B.refss(us, ux, 0), y)))), B.mu.or(_)) : B.Mu}
  %Equal.sym(B.Ms, B.emit.ms(B.ds.order(B.emit.walk(roots, B.refss(us, ux, 0), obs, us)), B.refss(us, ux, 0), B.pt.of(B.Un, us), obs, us), B.mults.spec(B.ds.order(B.emit.walk(roots, B.refss(us, ux, 0), obs, us)), List.reverse(&2, U32, B.ds.order(B.emit.walk(roots, B.refss(us, ux, 0), obs, us))), B.refss(us, ux, 0), B.pt.of(B.Un, us), obs, us, B.Ms{B.HLeaf{Nil{}}, Nil{}}), ms_walked(roots, B.refss(us, ux, 0), B.pt.of(B.Un, us), obs, us)) : {B.ms.mu(_, y) == B.mu.after(B.mu.m(B.ms.mu(_, B.ru.user(B.uses.of(List.reverse(&2, U32, B.ds.order(B.emit.walk(roots, B.refss(us, ux, 0), obs, us))), B.refss(us, ux, 0), y)))), B.ms.mu(B.Ms{B.HLeaf{Nil{}}, Nil{}}, y)) : B.Mu}
  Laws.sharing.affine(B.ds.order(B.emit.walk(roots, B.refss(us, ux, 0), obs, us)), B.refss(us, ux, 0), B.pt.of(B.Un, us), obs, us, B.Ms{B.HLeaf{Nil{}}, Nil{}}, y, o_first(roots, B.calls(B.refss(us, ux, 0)), obs, us), o_once(roots, B.calls(B.refss(us, ux, 0)), obs, us), hy, ha,
    hl_u(files, obs, us, als, own, res, paths, ux, roots, y, hl))

# The shared units (`mults.shared`, `sharing.plain`, `shared.emitted`,
# `plain.emitted`): a unit shared, or a module's definition, keeps its
# disposition through every turn, its own leaving it (`mult.of.k`'s
# first case) and another's too (`mult_of_other`); and a plain unit's
# counter is never advanced, a call to it writing its own name
# (`ref.kind.k`'s first case) and a call to another leaving it
# (`kind_other`), through the writer as `sharing.counts` goes, each
# step's counter equal to the last's, no weights to sum.

# a unit's turn leaves a shared unit's disposition, its own or another's
def mo_shared(q: Bool, +x: U32, +rs: List<&2, B.Ru>, +obs: List<&2, B.Ob>, +us: List<&2, B.Un>, +ut: B.Ht<B.Pk<B.Un>>, +s: B.Ms, +z: U32,
    +hs: {B.mult.share(z, ut) == 1 : U32}, eq: {q == U32.is_eq(x, z) : Bool}) ->
    {B.ms.mu(s, z) == B.ms.mu(B.mult.of(x, B.mult.share(x, ut), rs, obs, us, ut, s), z) : B.Mu}:
  match q:
    case True{}:
      %Equal.sym(U32, x, z, u32_eq_of_is_eq(x, z, Equal.sym(Bool, True{}, U32.is_eq(x, z), eq))) :
        {B.ms.mu(s, z) == B.ms.mu(B.mult.of(_, B.mult.share(_, ut), rs, obs, us, ut, s), z) : B.Mu}
      %Equal.sym(U32, B.mult.share(z, ut), 1, hs) :
        {B.ms.mu(s, z) == B.ms.mu(B.mult.of(z, _, rs, obs, us, ut, s), z) : B.Mu}
      {==}
    case False{}:
      mult_of_other(x, B.mult.share(x, ut), rs, obs, us, ut, s, z, Equal.sym(Bool, False{}, U32.is_eq(x, z), eq))

# every turn of `mults` leaves it
def mults_shared(xs: List<&2, U32>, +rt: B.Ht<B.Pk<List<&2, B.Ru>>>, +ut: B.Ht<B.Pk<B.Un>>, +obs: List<&2, B.Ob>, +us: List<&2, B.Un>, +s: B.Ms,
    +p: B.Ht<B.Pk<List<&2, B.Ru>>>, +z: U32, +hs: {B.mult.share(z, ut) == 1 : U32}) ->
    {B.ms.mu(s, z) == B.ms.mu(B.mults(xs, rt, ut, obs, us, s, p), z) : B.Mu}:
  match xs:
    case Nil{}:
      {==}
    case Con{+x, +t}:
      Equal.trans(B.Mu, B.ms.mu(s, z), B.ms.mu(B.mult.of(x, B.mult.share(x, ut), B.pend.at(p, x), obs, us, ut, s), z),
        B.ms.mu(B.mults(t, rt, ut, obs, us, B.mult.of(x, B.mult.share(x, ut), B.pend.at(p, x), obs, us, ut, s), B.pend.uses(B.rus.or(B.pw.get(List<&2, B.Ru>, rt, x)), x, p)), z),
        mo_shared(U32.is_eq(x, z), x, B.pend.at(p, x), obs, us, ut, s, z, hs, {==}),
        mults_shared(t, rt, ut, obs, us, B.mult.of(x, B.mult.share(x, ut), B.pend.at(p, x), obs, us, ut, s), B.pend.uses(B.rus.or(B.pw.get(List<&2, B.Ru>, rt, x)), x, p), z, hs))

def Laws.mults.shared(xs, rt, ut, obs, us, s, p, y, hs):
  Equal.sym(B.Mu, B.ms.mu(s, y), B.ms.mu(B.mults(xs, rt, ut, obs, us, s, p), y), mults_shared(xs, rt, ut, obs, us, s, p, y, hs))

# a call to y, a plain unit, or to another, leaves y's counter
def pk_target(q: Bool, +y2: U32, +e: B.Ec, +x: U32, +j: U32, +b: B.Tb, +y: U32, +hk: {B.mu.kind(B.ec.mu(e, y)) == 0 : U32}, eq: {q == U32.is_eq(y2, y) : Bool}) ->
    {cy(b, y) == cy(B.ref.kind.k(U32.is_eq(B.mu.kind(B.ec.mu(e, y2)), 0), U32.is_eq(B.mu.kind(B.ec.mu(e, y2)), 1), e, x, y2, j, b), y) : U32}:
  match q:
    case True{}:
      %Equal.sym(U32, y2, y, u32_eq_of_is_eq(y2, y, Equal.sym(Bool, True{}, U32.is_eq(y2, y), eq))) :
        {cy(b, y) == cy(B.ref.kind.k(U32.is_eq(B.mu.kind(B.ec.mu(e, _)), 0), U32.is_eq(B.mu.kind(B.ec.mu(e, _)), 1), e, x, _, j, b), y) : U32}
      %Equal.sym(U32, B.mu.kind(B.ec.mu(e, y)), 0, hk) :
        {cy(b, y) == cy(B.ref.kind.k(U32.is_eq(_, 0), U32.is_eq(_, 1), e, x, y, j, b), y) : U32}
      tbput_any(b, B.unit.text(e, y), y)
    case False{}:
      kind_other(U32.is_eq(B.mu.kind(B.ec.mu(e, y2)), 0), U32.is_eq(B.mu.kind(B.ec.mu(e, y2)), 1), e, x, y2, j, b, y, Equal.sym(Bool, False{}, U32.is_eq(y2, y), eq))

def pk_self(s: Bool, +y2: U32, +mark: U32, +e: B.Ec, +x: U32, +j: U32, +b: B.Tb, +y: U32, +hk: {B.mu.kind(B.ec.mu(e, y)) == 0 : U32}) ->
    {cy(b, y) == cy(B.ref.self(s, e, x, j, y2, B.mark.put(mark, b)), y) : U32}:
  match s:
    case True{}:
      Equal.trans(U32, cy(b, y), cy(B.mark.put(mark, b), y), cy(B.tb.put(B.mark.put(mark, b), B.own.name(e, x, j)), y), cy_mark(mark, b, y),
        tbput_any(B.mark.put(mark, b), B.own.name(e, x, j), y))
    case False{}:
      Equal.trans(U32, cy(b, y), cy(B.mark.put(mark, b), y),
        cy(B.ref.kind.k(U32.is_eq(B.mu.kind(B.ec.mu(e, y2)), 0), U32.is_eq(B.mu.kind(B.ec.mu(e, y2)), 1), e, x, y2, j, B.mark.put(mark, b)), y),
        cy_mark(mark, b, y), pk_target(U32.is_eq(y2, y), y2, e, x, j, B.mark.put(mark, b), y, hk, {==}))

def pk_ref(mb: Maybe<&2, U32>, +mark: U32, +ref: B.Rf, +e: B.Ec, +x: U32, +j: U32, +b: B.Tb, +y: U32, +hm: {B.ec.mode(e) == 0 : U32},
    +hk: {B.mu.kind(B.ec.mu(e, y)) == 0 : U32}) -> {cy(b, y) == cy(B.ref.put(e, x, j, mark, ref, mb, b), y) : U32}:
  match mb:
    case None{}:
      refput_none(e, x, j, mark, ref, b, y)
    case Some{+y2}:
      %ref_put_code(e, hm, x, j, mark, ref, y2, b) : {cy(b, y) == cy(_, y) : U32}
      pk_self(U32.is_eq(y2, x), y2, mark, e, x, j, b, y, hk)

# a body's tokens written leave y's counter
def pk_rts(ts: List<&2, B.Rt>, +e: B.Ec, +x: U32, +j: U32, +b: B.Tb, +y: U32, +hm: {B.ec.mode(e) == 0 : U32}, +hk: {B.mu.kind(B.ec.mu(e, y)) == 0 : U32}) ->
    {cy(b, y) == cy(B.rts.put(ts, e, x, j, b), y) : U32}:
  match ts:
    case Nil{}:
      {==}
    case Con{t, +r}:
      match t:
        case B.RT{+tk}:
          Equal.trans(U32, cy(b, y), cy(B.tb.put(b, B.tok.in.proof(e, tk)), y), cy(B.rts.put(r, e, x, j, B.tb.put(b, B.tok.in.proof(e, tk))), y),
            tbput_any(b, B.tok.in.proof(e, tk), y), pk_rts(r, e, x, j, B.tb.put(b, B.tok.in.proof(e, tk)), y, hm, hk))
        case B.RR{+mark, +ref}:
          Equal.trans(U32, cy(b, y), cy(B.ref.put(e, x, j, mark, ref, B.ux.find(B.ec.ux(e), ref), b), y),
            cy(B.rts.put(r, e, x, j, B.ref.put(e, x, j, mark, ref, B.ux.find(B.ec.ux(e), ref), b)), y),
            pk_ref(B.ux.find(B.ec.ux(e), ref), mark, ref, e, x, j, b, y, hm, hk),
            pk_rts(r, e, x, j, B.ref.put(e, x, j, mark, ref, B.ux.find(B.ec.ux(e), ref), b), y, hm, hk))
        case B.RX{+mark, +path, +rest}:
          Equal.trans(U32, cy(b, y), cy(B.tb.put(B.mark.put(mark, b), List.append(&2, U32, B.alias.of(e, path), Con{46, rest})), y),
            cy(B.rts.put(r, e, x, j, B.tb.put(B.mark.put(mark, b), List.append(&2, U32, B.alias.of(e, path), Con{46, rest}))), y),
            Equal.trans(U32, cy(b, y), cy(B.mark.put(mark, b), y), cy(B.tb.put(B.mark.put(mark, b), List.append(&2, U32, B.alias.of(e, path), Con{46, rest})), y),
              cy_mark(mark, b, y), tbput_any(B.mark.put(mark, b), List.append(&2, U32, B.alias.of(e, path), Con{46, rest}), y)),
            pk_rts(r, e, x, j, B.tb.put(B.mark.put(mark, b), List.append(&2, U32, B.alias.of(e, path), Con{46, rest})), y, hm, hk))

# a body's lines written leave it
def pk_rls(ls: List<&2, B.Rl>, +e: B.Ec, +x: U32, +j: U32, +dind: U32, +first: Bool, +b: B.Tb, +y: U32, +hm: {B.ec.mode(e) == 0 : U32},
    +hk: {B.mu.kind(B.ec.mu(e, y)) == 0 : U32}) -> {cy(b, y) == cy(B.rls.put(ls, e, x, j, dind, first, b), y) : U32}:
  match ls:
    case Nil{}:
      {==}
    case Con{l, +t}:
      match l:
        case B.Rl{+no, +ind, ts}:
          match ts:
            case Nil{}:
              +bl = B.tb.put(b, B.rl.lead(Bool.and(first, B.loc.eq(no, B.node.no(B.un.node(B.ec.un(e, x))))), True{}, 0n))
              Equal.trans(U32, cy(b, y), cy(bl, y), cy(B.rls.put(t, e, x, j, dind, False{}, bl), y),
                tbput_any(b, B.rl.lead(Bool.and(first, B.loc.eq(no, B.node.no(B.un.node(B.ec.un(e, x))))), True{}, 0n), y),
                pk_rls(t, e, x, j, dind, False{}, bl, y, hm, hk))
            case Con{+tk, +r}:
              Equal.trans(U32, cy(b, y), cy(B.rts.put(Con{tk, r}, e, x, j, lw(first, no, ind, dind, e, x, b)), y),
                cy(B.rls.put(t, e, x, j, dind, False{}, B.rts.put(Con{tk, r}, e, x, j, lw(first, no, ind, dind, e, x, b))), y),
                Equal.trans(U32, cy(b, y), cy(lw(first, no, ind, dind, e, x, b), y), cy(B.rts.put(Con{tk, r}, e, x, j, lw(first, no, ind, dind, e, x, b)), y),
                  tbput_any(b, B.rl.lead(Bool.and(first, B.loc.eq(no, B.node.no(B.un.node(B.ec.un(e, x))))), False{},
                    U32.to_nat(B.when(U32, U32.is_gt(ind, dind), v => U32.sub(ind, dind), v => 0))), y),
                  pk_rts(Con{tk, r}, e, x, j, lw(first, no, ind, dind, e, x, b), y, hm, hk)),
                pk_rls(t, e, x, j, dind, False{}, B.rts.put(Con{tk, r}, e, x, j, lw(first, no, ind, dind, e, x, b)), y, hm, hk))

# a unit's copy written leaves it
def pk_unit(+e: B.Ec, +x: U32, +j: U32, +b: B.Tb, +y: U32, +hm: {B.ec.mode(e) == 0 : U32}, +hk: {B.mu.kind(B.ec.mu(e, y)) == 0 : U32}) ->
    {cy(b, y) == cy(B.unit.put(e, x, j, b), y) : U32}:
  %src_code(e, hm, x) : {cy(b, y) == cy(B.unit.put.as(e, _, x, j, b), y) : U32}
  Equal.trans(U32, cy(b, y), cy(ln_w(e, x, j, b), y), cy(B.tb.put(ln_w(e, x, j, b), List.append(&2, U32, B.witness.body(e, x), [10])), y),
    Equal.trans(U32, cy(b, y), cy(hd_w(e, x, j, b), y), cy(ln_w(e, x, j, b), y),
      Equal.trans(U32, cy(b, y), cy(t0(e, x, j, b), y), cy(hd_w(e, x, j, b), y),
        tbput_any(b, List.append(&2, U32, B.marker(e, x), List.append(&2, U32, B.unit.kw(e, x), B.own.name(e, x, j))), y),
        pk_rts(B.un.hd(B.ec.un(e, x)), e, x, j, t0(e, x, j, b), y, hm, hk)),
      pk_rls(B.un.lines(B.ec.un(e, x)), e, x, j, B.node.ind(B.un.node(B.ec.un(e, x))), True{}, hd_w(e, x, j, b), y, hm, hk)),
    tbput_any(ln_w(e, x, j, b), List.append(&2, U32, B.witness.body(e, x), [10]), y))

def pk_copies(n: Nat, +e: B.Ec, +x: U32, +j: U32, +b: B.Tb, +y: U32, +hm: {B.ec.mode(e) == 0 : U32}, +hk: {B.mu.kind(B.ec.mu(e, y)) == 0 : U32}) ->
    {cy(b, y) == cy(B.copies.put(n, e, x, j, b), y) : U32}:
  match n:
    case 0n:
      {==}
    case 1n+(+k):
      Equal.trans(U32, cy(b, y), cy(B.unit.put(e, x, j, b), y), cy(B.copies.put(k, e, x, U32.add(j, 1), B.unit.put(e, x, j, b)), y),
        pk_unit(e, x, j, b, y, hm, hk), pk_copies(k, e, x, U32.add(j, 1), B.unit.put(e, x, j, b), y, hm, hk))

def pk_all(+e: B.Ec, +x: U32, mu: B.Mu, +b: B.Tb, +y: U32, +hm: {B.ec.mode(e) == 0 : U32}, +hk: {B.mu.kind(B.ec.mu(e, y)) == 0 : U32}) ->
    {cy(b, y) == cy(B.unit.all(e, x, mu, b), y) : U32}:
  match mu:
    case B.Mu{+m, +kind}:
      Equal.trans(U32, cy(b, y), cy(B.unit.put(e, x, 0, b), y), cy(B.copies.put(U32.to_nat(m), e, x, 1, B.unit.put(e, x, 0, b)), y),
        pk_unit(e, x, 0, b, y, hm, hk), pk_copies(U32.to_nat(m), e, x, 1, B.unit.put(e, x, 0, b), y, hm, hk))

# an order written leaves it
def pk_order(xs: List<&2, U32>, +e: B.Ec, +b: B.Tb, +y: U32, +hm: {B.ec.mode(e) == 0 : U32}, +hk: {B.mu.kind(B.ec.mu(e, y)) == 0 : U32}) ->
    {cy(b, y) == cy(B.order.put(xs, e, b), y) : U32}:
  match xs:
    case Nil{}:
      {==}
    case Con{+x, +t}:
      Equal.trans(U32, cy(b, y), cy(B.unit.all(e, x, B.ec.mu(e, x), b), y), cy(B.order.put(t, e, B.unit.all(e, x, B.ec.mu(e, x), b)), y),
        pk_all(e, x, B.ec.mu(e, x), b, y, hm, hk), pk_order(t, e, B.unit.all(e, x, B.ec.mu(e, x), b), y, hm, hk))

def Laws.sharing.plain(xs, e, b, y, hm, hk):
  Equal.sym(U32, cy(b, y), cy(B.order.put(xs, e, b), y), pk_order(xs, e, b, y, hm, hk))

def Laws.shared.emitted(files, obs, us, als, own, res, paths, ux, roots, y, hs):
  Equal.sym(B.Mu, B.ms.mu(B.Ms{B.HLeaf{Nil{}}, Nil{}}, y), B.ms.mu(B.emit.ms(B.ds.order(B.emit.walk(roots, B.refss(us, ux, 0), obs, us)), B.refss(us, ux, 0), B.pt.of(B.Un, us), obs, us), y),
    mults_shared(B.ds.order(B.emit.walk(roots, B.refss(us, ux, 0), obs, us)), B.pw.of(List<&2, B.Ru>, B.refss(us, ux, 0)), B.pt.of(B.Un, us), obs, us, B.Ms{B.HLeaf{Nil{}}, Nil{}}, B.HLeaf{Nil{}}, y, hs))

def Laws.plain.emitted(files, obs, us, als, own, res, paths, ux, roots, acc, y, hs):
  Laws.sharing.plain(List.reverse(&2, U32, B.ds.order(B.emit.walk(roots, B.refss(us, ux, 0), obs, us))), B.emit.ec(files, obs, us, als, own, res, paths, ux, B.pt.of(B.Un, us), B.ms.ms(B.emit.ms(B.ds.order(B.emit.walk(roots, B.refss(us, ux, 0), obs, us)), B.refss(us, ux, 0), B.pt.of(B.Un, us), obs, us))), B.Tb{acc, B.HLeaf{Nil{}}}, y, {==},
    Equal.cong(B.Mu, U32, m => B.mu.kind(m), B.ec.mu(B.emit.ec(files, obs, us, als, own, res, paths, ux, B.pt.of(B.Un, us), B.ms.ms(B.emit.ms(B.ds.order(B.emit.walk(roots, B.refss(us, ux, 0), obs, us)), B.refss(us, ux, 0), B.pt.of(B.Un, us), obs, us))), y), B.Mu{0, 0}, Laws.shared.emitted(files, obs, us, als, own, res, paths, ux, roots, y, hs)))

# A witness's body on its header's line (`markers.witness`): a witness is
# its own source in any file (`src_wit`, `unit.src`'s test false on its
# kind whatever the file's mode), its kind's test and its empty lines
# rewritten, the text put onto its head read whatever the head
# (`acc_put`).

def us_w(c: Bool, +e: B.Ec, +x: U32) -> {x == us_k(Bool.and(c, False{}), e, x) : U32}:
  match c:
    case True{}:
      {==}
    case False{}:
      {==}

def src_wit(+e: B.Ec, +x: U32, hw: {B.node.what(B.un.node(B.ec.un(e, x))) == 4 : U32}) -> {x == B.unit.src(e, x) : U32}:
  %Equal.sym(U32, B.node.what(B.un.node(B.ec.un(e, x))), 4, hw) : {x == us_k(Bool.and(U32.is_eq(B.ec.mode(e), 1), U32.is_eq(_, 2)), e, x) : U32}
  us_w(U32.is_eq(B.ec.mode(e), 1), e, x)

def acc_put(b: B.Tb, +xs: List<&2, U32>) -> {B.tb.acc(B.tb.put(b, xs)) == B.rev.onto(xs, B.tb.acc(b)) : List<&2, U32>}:
  match b:
    case B.Tb{acc, ctrs}:
      {==}

def Laws.markers.witness(e, x, j, b, hw, hl):
  %src_wit(e, x, hw) : {B.tb.acc(B.unit.put.as(e, _, x, j, b)) == B.rev.onto(Con{32, List.append(&2, U32, B.wit.line(e, x), [10])}, B.tb.acc(B.unit.head(e, x, x, j, b))) : List<&2, U32>}
  %Equal.sym(U32, B.node.what(B.un.node(B.ec.un(e, x))), 4, hw) :
    {B.tb.acc(B.tb.put(B.unit.body(e, x, x, j, b), List.append(&2, U32, B.witness.body.k(U32.is_eq(_, 4), e, x), [10]))) == B.rev.onto(Con{32, List.append(&2, U32, B.wit.line(e, x), [10])}, B.tb.acc(B.unit.head(e, x, x, j, b))) : List<&2, U32>}
  %Equal.sym(List<&2, B.Rl>, B.un.lines(B.ec.un(e, x)), Nil{}, hl) :
    {B.tb.acc(B.tb.put(B.rls.put(_, e, x, j, B.node.ind(B.un.node(B.ec.un(e, x))), True{}, B.unit.head(e, x, x, j, b)), Con{32, List.append(&2, U32, B.wit.line(e, x), [10])})) == B.rev.onto(Con{32, List.append(&2, U32, B.wit.line(e, x), [10])}, B.tb.acc(B.unit.head(e, x, x, j, b))) : List<&2, U32>}
  acc_put(B.unit.head(e, x, x, j, b), Con{32, List.append(&2, U32, B.wit.line(e, x), [10])})

# No line read as a marker (`markers.unambiguous`): the first byte of the
# text's last line (`line.first`) is set where the line starts, and text
# within a line written after a line holding some keeps it
# (`uq_onto`), through the tokens as `rts_from` keeps the text from the
# last newline (`uq_rts`). A header's line starts `law` or `def`
# (`uq_kw10`); a body line on the header's keeps its first byte, a
# blank one is empty, and one deeper than its header starts with a
# space (`uq_lead10`), its depth less the header's not 0 (`uq_sub`,
# through the hub's `u32_sub_exact`).

def uq_ne(+a: U32, +b: U32, +c: U32, e: {a == b : U32}, h: {U32.is_eq(b, c) == False{} : Bool}) -> {U32.is_eq(a, c) == False{} : Bool}:
  %Equal.sym(U32, a, b, e) : {U32.is_eq(_, c) == False{} : Bool}
  h

def uq_fa(d: Bool, +h: U32, +f: U32, hd: {d == False{} : Bool}) -> {B.first.at(d, h, f) == f : U32}:
  match d:
    case True{}:
      Empty.absurd({B.first.at(True{}, h, f) == f : U32}, MB.false_ne_true()(Equal.sym(Bool, True{}, False{}, hd)))
    case False{}:
      {==}

def uq_fk(c: Bool, +h: U32, +f: U32, hc: {c == False{} : Bool}, hf: {U32.is_eq(f, 10) == False{} : Bool}) -> {B.first.k(c, h, f) == f : U32}:
  match c:
    case True{}:
      Empty.absurd({B.first.k(True{}, h, f) == f : U32}, MB.false_ne_true()(Equal.sym(Bool, True{}, False{}, hc)))
    case False{}:
      uq_fa(U32.is_eq(f, 10), h, f, hf)

# text within a line written after a line holding some: its first byte kept
def uq_onto(xs: List<&2, U32>, +acc: List<&2, U32>, +hx: {B.inline(xs) == True{} : Bool}, +hc: {U32.is_eq(B.line.first(acc), 10) == False{} : Bool}) ->
    {B.line.first(B.rev.onto(xs, acc)) == B.line.first(acc) : U32}:
  match xs:
    case Nil{}:
      {==}
    case Con{+h, +t}:
      Equal.trans(U32, B.line.first(B.rev.onto(t, Con{h, acc})), B.line.first(Con{h, acc}), B.line.first(acc),
        uq_onto(t, Con{h, acc}, il_tail(h, t, hx),
          uq_ne(B.line.first(Con{h, acc}), B.line.first(acc), 10, uq_fk(U32.is_eq(h, 10), h, B.line.first(acc), ne10(h, t, hx), hc), hc)),
        uq_fk(U32.is_eq(h, 10), h, B.line.first(acc), ne10(h, t, hx), hc))

def uq_tf(+b: B.Tb) -> U32:
  B.line.first(B.tb.acc(b))

def uq_put(b: B.Tb, +xs: List<&2, U32>, +h: {B.inline(xs) == True{} : Bool}, +hc: {U32.is_eq(uq_tf(b), 10) == False{} : Bool}) ->
    {uq_tf(B.tb.put(b, xs)) == uq_tf(b) : U32}:
  match b:
    case B.Tb{+acc, ctrs}:
      uq_onto(xs, acc, h, hc)

# A body's tokens written after a line holding some: its first byte kept

def uq_mark(c: Bool, +b: B.Tb, +hc: {U32.is_eq(uq_tf(b), 10) == False{} : Bool}) -> {uq_tf(B.mark.put.k(c, b)) == uq_tf(b) : U32}:
  match c:
    case True{}:
      uq_put(b, [126], {==}, hc)
    case False{}:
      {==}

def uq_amark(+mark: U32, +b: B.Tb, +xs: List<&2, U32>, +h: {B.inline(xs) == True{} : Bool}, +hc: {U32.is_eq(uq_tf(b), 10) == False{} : Bool}) ->
    {uq_tf(B.tb.put(B.mark.put(mark, b), xs)) == uq_tf(b) : U32}:
  Equal.trans(U32, uq_tf(B.tb.put(B.mark.put(mark, b), xs)), uq_tf(B.mark.put(mark, b)), uq_tf(b),
    uq_put(B.mark.put(mark, b), xs, h, uq_ne(uq_tf(B.mark.put(mark, b)), uq_tf(b), 10, uq_mark(U32.is_eq(mark, 126), b, hc), hc)),
    uq_mark(U32.is_eq(mark, 126), b, hc))

def uq_next(+e: B.Ec, +y: U32, b: B.Tb, +hf: {B.ec.inline(e) == True{} : Bool}, +hc: {U32.is_eq(uq_tf(b), 10) == False{} : Bool}) ->
    {uq_tf(B.ref.next(e, y, b)) == uq_tf(b) : U32}:
  match b:
    case B.Tb{+acc, +ctrs}:
      uq_onto(B.copy.name(B.unit.text(e, y), B.ctr.at(ctrs, y)), acc, il_copy(B.unit.text(e, y), B.ctr.at(ctrs, y), il_utext(e, y, hf)), hc)

def uq_rk(o0: Bool, +e: B.Ec, +y: U32, +b: B.Tb, +hf: {B.ec.inline(e) == True{} : Bool}, +hc: {U32.is_eq(uq_tf(b), 10) == False{} : Bool}) ->
    {uq_tf(rk_k(o0, e, y, b)) == uq_tf(b) : U32}:
  match o0:
    case True{}:
      uq_put(b, B.unit.text(e, y), il_utext(e, y, hf), hc)
    case False{}:
      uq_next(e, y, b, hf, hc)

def uq_kind(p0: Bool, p1: Bool, +e: B.Ec, +x: U32, +y: U32, +j: U32, +b: B.Tb, +hf: {B.ec.inline(e) == True{} : Bool}, +hc: {U32.is_eq(uq_tf(b), 10) == False{} : Bool}) ->
    {uq_tf(B.ref.kind.k(p0, p1, e, x, y, j, b)) == uq_tf(b) : U32}:
  match p0 p1:
    case True{} _:
      uq_put(b, B.unit.text(e, y), il_utext(e, y, hf), hc)
    case False{} True{}:
      uq_rk(U32.is_eq(B.un.o(B.ec.un(e, x)), 0), e, y, b, hf, hc)
    case False{} False{}:
      uq_put(b, B.own.name(e, y, j), il_own(e, y, j, hf), hc)

def uq_self(c: Bool, +e: B.Ec, +x: U32, +j: U32, +y: U32, +b: B.Tb, +hf: {B.ec.inline(e) == True{} : Bool}, +hc: {U32.is_eq(uq_tf(b), 10) == False{} : Bool}) ->
    {uq_tf(B.ref.self(c, e, x, j, y, b)) == uq_tf(b) : U32}:
  match c:
    case True{}:
      uq_put(b, B.own.name(e, x, j), il_own(e, x, j, hf), hc)
    case False{}:
      uq_kind(U32.is_eq(B.mu.kind(B.ec.mu(e, y)), 0), U32.is_eq(B.mu.kind(B.ec.mu(e, y)), 1), e, x, y, j, b, hf, hc)

def uq_rpk(c1: Bool, c2: Bool, +e: B.Ec, +x: U32, +j: U32, +mark: U32, +r: B.Rf, +y: U32, +b: B.Tb, +hf: {B.ec.inline(e) == True{} : Bool},
    +hr: {B.inline(B.rf.name(r)) == True{} : Bool}, +hc: {U32.is_eq(uq_tf(b), 10) == False{} : Bool}) -> {uq_tf(rp_k(c1, c2, e, x, j, mark, r, y, b)) == uq_tf(b) : U32}:
  match c1 c2:
    case True{} _:
      uq_amark(mark, b, B.own.name(e, x, j), il_own(e, x, j, hf), hc)
    case False{} True{}:
      uq_amark(mark, b, B.rf.text.law(B.ec.obs(e), r), il_textlaw(B.ec.obs(e), r, ec_obs(e, hf), hr), hc)
    case False{} False{}:
      Equal.trans(U32, uq_tf(B.ref.self(U32.is_eq(y, x), e, x, j, y, B.mark.put(mark, b))), uq_tf(B.mark.put(mark, b)), uq_tf(b),
        uq_self(U32.is_eq(y, x), e, x, j, y, B.mark.put(mark, b), hf, uq_ne(uq_tf(B.mark.put(mark, b)), uq_tf(b), 10, uq_mark(U32.is_eq(mark, 126), b, hc), hc)),
        uq_mark(U32.is_eq(mark, 126), b, hc))

def uq_rpm(m2: Bool, +e: B.Ec, +x: U32, +j: U32, +mark: U32, +r: B.Rf, +y: U32, +b: B.Tb, +hf: {B.ec.inline(e) == True{} : Bool},
    +hr: {B.inline(B.rf.name(r)) == True{} : Bool}, +hc: {U32.is_eq(uq_tf(b), 10) == False{} : Bool}) -> {uq_tf(B.ref.put.m(m2, e, x, j, mark, r, y, b)) == uq_tf(b) : U32}:
  match m2:
    case False{}:
      uq_rpk(False{}, False{}, e, x, j, mark, r, y, b, hf, hr, hc)
    case True{}:
      uq_rpk(B.proves.own(B.ec.ut(e), x, y), Bool.or(U32.is_eq(B.node.what(B.un.node(B.ec.un(e, y))), 1), U32.is_eq(B.node.what(B.un.node(B.ec.un(e, y))), 2)), e, x, j, mark, r, y, b, hf, hr, hc)

def uq_rput(+e: B.Ec, +x: U32, +j: U32, +mark: U32, +r: B.Rf, m: Maybe<&2, U32>, +b: B.Tb, +hf: {B.ec.inline(e) == True{} : Bool},
    +hr: {B.inline(B.rf.name(r)) == True{} : Bool}, +hc: {U32.is_eq(uq_tf(b), 10) == False{} : Bool}) -> {uq_tf(B.ref.put(e, x, j, mark, r, m, b)) == uq_tf(b) : U32}:
  match m:
    case None{}:
      uq_amark(mark, b, B.rf.ext(e, r),
        il_rxk(U32.is_eq(B.loc.mod(B.ob.no(B.ob.at(B.ec.obs(e), B.rf.obj(r)))), 0), e, r, hf, hr), hc)
    case Some{+y}:
      uq_rpm(U32.is_eq(B.ec.mode(e), 2), e, x, j, mark, r, y, b, hf, hr, hc)

def uq_rts(ts: List<&2, B.Rt>, +e: B.Ec, +x: U32, +j: U32, +b: B.Tb, +hf: {B.ec.inline(e) == True{} : Bool}, +ht: {B.rts.inline(ts) == True{} : Bool},
    +hc: {U32.is_eq(uq_tf(b), 10) == False{} : Bool}) -> {uq_tf(B.rts.put(ts, e, x, j, b)) == uq_tf(b) : U32}:
  match ts:
    case Nil{}:
      {==}
    case Con{t, +r}:
      match t:
        case B.RT{+tk}:
          Equal.trans(U32, uq_tf(B.rts.put(r, e, x, j, B.tb.put(b, B.tok.in.proof(e, tk)))), uq_tf(B.tb.put(b, B.tok.in.proof(e, tk))), uq_tf(b),
            uq_rts(r, e, x, j, B.tb.put(b, B.tok.in.proof(e, tk)), hf, and_r(B.rt.inline(B.RT{tk}), B.rts.inline(r), ht),
              uq_ne(uq_tf(B.tb.put(b, B.tok.in.proof(e, tk))), uq_tf(b), 10, uq_put(b, B.tok.in.proof(e, tk), il_tok(e, tk, and_l(B.rt.inline(B.RT{tk}), B.rts.inline(r), ht)), hc), hc)),
            uq_put(b, B.tok.in.proof(e, tk), il_tok(e, tk, and_l(B.rt.inline(B.RT{tk}), B.rts.inline(r), ht)), hc))
        case B.RR{+mark, +ref}:
          Equal.trans(U32, uq_tf(B.rts.put(r, e, x, j, B.ref.put(e, x, j, mark, ref, B.ux.find(B.ec.ux(e), ref), b))),
            uq_tf(B.ref.put(e, x, j, mark, ref, B.ux.find(B.ec.ux(e), ref), b)), uq_tf(b),
            uq_rts(r, e, x, j, B.ref.put(e, x, j, mark, ref, B.ux.find(B.ec.ux(e), ref), b), hf, and_r(B.rt.inline(B.RR{mark, ref}), B.rts.inline(r), ht),
              uq_ne(uq_tf(B.ref.put(e, x, j, mark, ref, B.ux.find(B.ec.ux(e), ref), b)), uq_tf(b), 10,
                uq_rput(e, x, j, mark, ref, B.ux.find(B.ec.ux(e), ref), b, hf, and_l(B.rt.inline(B.RR{mark, ref}), B.rts.inline(r), ht), hc), hc)),
            uq_rput(e, x, j, mark, ref, B.ux.find(B.ec.ux(e), ref), b, hf, and_l(B.rt.inline(B.RR{mark, ref}), B.rts.inline(r), ht), hc))
        case B.RX{+mark, +path, +rest}:
          Equal.trans(U32, uq_tf(B.rts.put(r, e, x, j, B.tb.put(B.mark.put(mark, b), List.append(&2, U32, B.alias.of(e, path), Con{46, rest})))),
            uq_tf(B.tb.put(B.mark.put(mark, b), List.append(&2, U32, B.alias.of(e, path), Con{46, rest}))), uq_tf(b),
            uq_rts(r, e, x, j, B.tb.put(B.mark.put(mark, b), List.append(&2, U32, B.alias.of(e, path), Con{46, rest})), hf,
              and_r(B.rt.inline(B.RX{mark, path, rest}), B.rts.inline(r), ht),
              uq_ne(uq_tf(B.tb.put(B.mark.put(mark, b), List.append(&2, U32, B.alias.of(e, path), Con{46, rest}))), uq_tf(b), 10,
                uq_amark(mark, b, List.append(&2, U32, B.alias.of(e, path), Con{46, rest}),
                  il_app(B.alias.of(e, path), Con{46, rest}, il_alias(e, path, hf), and_l(B.rt.inline(B.RX{mark, path, rest}), B.rts.inline(r), ht)), hc), hc)),
            uq_amark(mark, b, List.append(&2, U32, B.alias.of(e, path), Con{46, rest}),
              il_app(B.alias.of(e, path), Con{46, rest}, il_alias(e, path, hf), and_l(B.rt.inline(B.RX{mark, path, rest}), B.rts.inline(r), ht)), hc))

# A line's start: on the header's line its first byte kept, else a
# newline, then a space where deeper

def uq_fa10(d: Bool, +f: U32, hd: {U32.is_eq(f, 10) == d : Bool}) -> {U32.is_eq(B.first.at(d, 32, f), 10) == False{} : Bool}:
  match d:
    case True{}:
      {==}
    case False{}:
      hd

def uq_fa35(d: Bool, +f: U32, h35: {U32.is_eq(f, 35) == False{} : Bool}) -> {U32.is_eq(B.first.at(d, 32, f), 35) == False{} : Bool}:
  match d:
    case True{}:
      {==}
    case False{}:
      h35

def uq_blank(on: Bool, b: B.Tb, hc: {U32.is_eq(uq_tf(b), 35) == False{} : Bool}) -> {U32.is_eq(uq_tf(B.tb.put(b, B.rl.lead(on, True{}, 0n))), 35) == False{} : Bool}:
  match on:
    case True{}:
      match b:
        case B.Tb{+acc, ctrs}:
          uq_fa35(U32.is_eq(B.line.first(acc), 10), B.line.first(acc), hc)
    case False{}:
      match b:
        case B.Tb{+acc, ctrs}:
          {==}

# a depth less the header's, where deeper, not 0
def uq_nsub(x: Nat, y: Nat, h: {Nat.is_lt(y, x) == True{} : Bool}) -> {Nat.is_eq(Nat.sub(x, y), 0n) == False{} : Bool}:
  match x y:
    case 0n 0n:
      Empty.absurd({Nat.is_eq(Nat.sub(0n, 0n), 0n) == False{} : Bool}, MB.false_ne_true()(h))
    case 0n 1n+yp:
      Empty.absurd({Nat.is_eq(Nat.sub(0n, 1n+yp), 0n) == False{} : Bool}, MB.false_ne_true()(h))
    case 1n+xp 0n:
      {==}
    case 1n+xp 1n+yp:
      uq_nsub(xp, yp, h)

def uq_sub(+i: U32, +dind: U32, +hg: {U32.is_gt(i, dind) == True{} : Bool}) -> {Nat.is_eq(U32.to_nat(U32.sub(i, dind)), 0n) == False{} : Bool}:
  %Equal.sym(Nat, U32.to_nat(U32.sub(i, dind)), Nat.sub(U32.to_nat(i), U32.to_nat(dind)), MU.u32_sub_exact(i, dind, MNat.le_of_lt(U32.to_nat(dind), U32.to_nat(i),
      Equal.trans(Bool, Nat.is_lt(U32.to_nat(dind), U32.to_nat(i)), Nat.is_gt(U32.to_nat(i), U32.to_nat(dind)), True{},
        Equal.sym(Bool, Nat.is_gt(U32.to_nat(i), U32.to_nat(dind)), Nat.is_lt(U32.to_nat(dind), U32.to_nat(i)), MNat.is_gt_eq_is_lt(U32.to_nat(i), U32.to_nat(dind))),
        Equal.trans(Bool, Nat.is_gt(U32.to_nat(i), U32.to_nat(dind)), U32.is_gt(i, dind), True{}, Equal.sym(Bool, U32.is_gt(i, dind), Nat.is_gt(U32.to_nat(i), U32.to_nat(dind)), MU.u32_is_gt_to_nat(i, dind)), hg))))) :
    {Nat.is_eq(_, 0n) == False{} : Bool}
  uq_nsub(U32.to_nat(i), U32.to_nat(dind),
    Equal.trans(Bool, Nat.is_lt(U32.to_nat(dind), U32.to_nat(i)), Nat.is_gt(U32.to_nat(i), U32.to_nat(dind)), True{},
      Equal.sym(Bool, Nat.is_gt(U32.to_nat(i), U32.to_nat(dind)), Nat.is_lt(U32.to_nat(dind), U32.to_nat(i)), MNat.is_gt_eq_is_lt(U32.to_nat(i), U32.to_nat(dind))),
      Equal.trans(Bool, Nat.is_gt(U32.to_nat(i), U32.to_nat(dind)), U32.is_gt(i, dind), True{}, Equal.sym(Bool, U32.is_gt(i, dind), Nat.is_gt(U32.to_nat(i), U32.to_nat(dind)), MU.u32_is_gt_to_nat(i, dind)), hg)))

# a newline and n spaces, n not 0: the line starts with a space
def uq_spaces(n: Nat, +acc: List<&2, U32>, hn: {Nat.is_eq(n, 0n) == False{} : Bool}) -> {B.line.first(B.rev.onto(Con{10, B.spaces(n)}, acc)) == 32 : U32}:
  match n:
    case 0n:
      Empty.absurd({B.line.first(B.rev.onto(Con{10, B.spaces(0n)}, acc)) == 32 : U32}, MB.false_ne_true()(Equal.sym(Bool, True{}, False{}, hn)))
    case 1n+(+k):
      uq_onto(B.spaces(k), Con{32, Con{10, acc}}, il_spaces(k), {==})

def uq_deepn(+i: U32, +dind: U32, +hg: {U32.is_gt(i, dind) == True{} : Bool}) -> {Nat.is_eq(U32.to_nat(B.when(U32, U32.is_gt(i, dind), v => (i - dind : U32), v => 0)), 0n) == False{} : Bool}:
  %Equal.sym(Bool, U32.is_gt(i, dind), True{}, hg) : {Nat.is_eq(U32.to_nat(B.when(U32, _, v => (i - dind : U32), v => 0)), 0n) == False{} : Bool}
  uq_sub(i, dind, hg)

# a body line's start, where on the header's line or deeper: not a
# newline, nor `#`
def uq_lead10(on: Bool, b: B.Tb, +i: U32, +dind: U32, hg: {Bool.or(Bool.or(on, False{}), U32.is_gt(i, dind)) == True{} : Bool}) ->
    {U32.is_eq(uq_tf(B.tb.put(b, B.rl.lead(on, False{}, U32.to_nat(B.when(U32, U32.is_gt(i, dind), v => (i - dind : U32), v => 0))))), 10) == False{} : Bool}:
  match on:
    case True{}:
      match b:
        case B.Tb{+acc, ctrs}:
          uq_fa10(U32.is_eq(B.line.first(acc), 10), B.line.first(acc), {==})
    case False{}:
      match b:
        case B.Tb{+acc, ctrs}:
          uq_ne(B.line.first(B.rev.onto(Con{10, B.spaces(U32.to_nat(B.when(U32, U32.is_gt(i, dind), v => (i - dind : U32), v => 0)))}, acc)), 32, 10, uq_spaces(U32.to_nat(B.when(U32, U32.is_gt(i, dind), v => (i - dind : U32), v => 0)), acc, uq_deepn(i, dind, hg)), {==})

def uq_lead35(on: Bool, b: B.Tb, +i: U32, +dind: U32, hg: {Bool.or(Bool.or(on, False{}), U32.is_gt(i, dind)) == True{} : Bool}, hc: {U32.is_eq(uq_tf(b), 35) == False{} : Bool}) ->
    {U32.is_eq(uq_tf(B.tb.put(b, B.rl.lead(on, False{}, U32.to_nat(B.when(U32, U32.is_gt(i, dind), v => (i - dind : U32), v => 0))))), 35) == False{} : Bool}:
  match on:
    case True{}:
      match b:
        case B.Tb{+acc, ctrs}:
          uq_fa35(U32.is_eq(B.line.first(acc), 10), B.line.first(acc), hc)
    case False{}:
      match b:
        case B.Tb{+acc, ctrs}:
          uq_ne(B.line.first(B.rev.onto(Con{10, B.spaces(U32.to_nat(B.when(U32, U32.is_gt(i, dind), v => (i - dind : U32), v => 0)))}, acc)), 32, 35, uq_spaces(U32.to_nat(B.when(U32, U32.is_gt(i, dind), v => (i - dind : U32), v => 0)), acc, uq_deepn(i, dind, hg)), {==})

# a body line written: its line's first byte no `#`
def uq_line(ts: List<&2, B.Rt>, +n: B.Loc, +i: U32, +e: B.Ec, +x: U32, +j: U32, +dind: U32, +first: Bool, +b: B.Tb, +hf: {B.ec.inline(e) == True{} : Bool},
    +hi: {B.rts.inline(ts) == True{} : Bool}, +hd: {Bool.or(Bool.or(Bool.and(first, B.loc.eq(n, B.node.no(B.un.node(B.ec.un(e, x))))), B.rts.blank(ts)), U32.is_gt(i, dind)) == True{} : Bool},
    +hc: {U32.is_eq(uq_tf(b), 35) == False{} : Bool}) -> {U32.is_eq(uq_tf(B.rl.put(B.Rl{n, i, ts}, e, x, j, dind, first, b)), 35) == False{} : Bool}:
  match ts:
    case Nil{}:
      uq_blank(Bool.and(first, B.loc.eq(n, B.node.no(B.un.node(B.ec.un(e, x))))), b, hc)
    case Con{+t0, +r}:
      uq_ne(uq_tf(B.rts.put(Con{t0, r}, e, x, j, B.tb.put(b, B.rl.lead(Bool.and(first, B.loc.eq(n, B.node.no(B.un.node(B.ec.un(e, x))))), False{}, U32.to_nat(B.when(U32, U32.is_gt(i, dind), v => (i - dind : U32), v => 0)))))), uq_tf(B.tb.put(b, B.rl.lead(Bool.and(first, B.loc.eq(n, B.node.no(B.un.node(B.ec.un(e, x))))), False{}, U32.to_nat(B.when(U32, U32.is_gt(i, dind), v => (i - dind : U32), v => 0))))), 35,
        uq_rts(Con{t0, r}, e, x, j, B.tb.put(b, B.rl.lead(Bool.and(first, B.loc.eq(n, B.node.no(B.un.node(B.ec.un(e, x))))), False{}, U32.to_nat(B.when(U32, U32.is_gt(i, dind), v => (i - dind : U32), v => 0)))), hf, hi, uq_lead10(Bool.and(first, B.loc.eq(n, B.node.no(B.un.node(B.ec.un(e, x))))), b, i, dind, hd)),
        uq_lead35(Bool.and(first, B.loc.eq(n, B.node.no(B.un.node(B.ec.un(e, x))))), b, i, dind, hd, hc))

def uq_clear(+b: B.Tb, h: {U32.is_eq(uq_tf(b), 35) == False{} : Bool}) -> {B.tb.clear(b) == True{} : Bool}:
  %Equal.sym(Bool, U32.is_eq(uq_tf(b), 35), False{}, h) : {Bool.not(_) == True{} : Bool}
  {==}

# the walk over a body's lines, each line's first byte no `#`
def uq_walk(ls: List<&2, B.Rl>, +e: B.Ec, +x: U32, +j: U32, +dind: U32, +first: Bool, +b: B.Tb, +hf: {B.ec.inline(e) == True{} : Bool},
    +hi: {B.rls.inline(ls) == True{} : Bool}, +hd: {B.rl.deep(ls, B.node.no(B.un.node(B.ec.un(e, x))), dind, first) == True{} : Bool}, +hc: {U32.is_eq(uq_tf(b), 35) == False{} : Bool}) ->
    {B.wc.at(ls, e, x, j, dind, first, b) == True{} : Bool}:
  match ls:
    case Nil{}:
      {==}
    case Con{l, +t}:
      match l:
        case B.Rl{+n, +i, +ts}:
          and_intro(B.tb.clear(B.rl.put(B.Rl{n, i, ts}, e, x, j, dind, first, b)), B.wc.at(t, e, x, j, dind, False{}, B.rl.put(B.Rl{n, i, ts}, e, x, j, dind, first, b)),
            uq_clear(B.rl.put(B.Rl{n, i, ts}, e, x, j, dind, first, b),
              uq_line(ts, n, i, e, x, j, dind, first, b, hf, and_l(B.rts.inline(ts), B.rls.inline(t), hi),
                and_l(Bool.or(Bool.or(Bool.and(first, B.loc.eq(n, B.node.no(B.un.node(B.ec.un(e, x))))), B.rts.blank(ts)), U32.is_gt(i, dind)), B.rl.deep(t, B.node.no(B.un.node(B.ec.un(e, x))), dind, False{}), hd), hc)),
            uq_walk(t, e, x, j, dind, False{}, B.rl.put(B.Rl{n, i, ts}, e, x, j, dind, first, b), hf, and_r(B.rts.inline(ts), B.rls.inline(t), hi),
              and_r(Bool.or(Bool.or(Bool.and(first, B.loc.eq(n, B.node.no(B.un.node(B.ec.un(e, x))))), B.rts.blank(ts)), U32.is_gt(i, dind)), B.rl.deep(t, B.node.no(B.un.node(B.ec.un(e, x))), dind, False{}), hd),
              uq_line(ts, n, i, e, x, j, dind, first, b, hf, and_l(B.rts.inline(ts), B.rls.inline(t), hi),
                and_l(Bool.or(Bool.or(Bool.and(first, B.loc.eq(n, B.node.no(B.un.node(B.ec.un(e, x))))), B.rts.blank(ts)), U32.is_gt(i, dind)), B.rl.deep(t, B.node.no(B.un.node(B.ec.un(e, x))), dind, False{}), hd), hc)))

# A header's line: `law` or `def` after its newline, then text within it

def uq_kw10(c1: Bool, c2: Bool, +nm: List<&2, U32>, +xs: List<&2, U32>, +h: {B.inline(nm) == True{} : Bool}) ->
    {U32.is_eq(B.line.first(B.rev.onto(List.append(&2, U32, kw_k(c1, c2), nm), xs)), 10) == False{} : Bool}:
  match c1 c2:
    case True{} _:
      uq_ne(B.line.first(B.rev.onto(List.append(&2, U32, B.codes("aw "), nm), Con{108, Con{10, xs}})), B.line.first(Con{108, Con{10, xs}}), 10,
        uq_onto(List.append(&2, U32, B.codes("aw "), nm), Con{108, Con{10, xs}}, il_app(B.codes("aw "), nm, {==}, h), {==}), {==})
    case False{} True{}:
      uq_ne(B.line.first(B.rev.onto(List.append(&2, U32, B.codes("ef "), nm), Con{100, Con{10, xs}})), B.line.first(Con{100, Con{10, xs}}), 10,
        uq_onto(List.append(&2, U32, B.codes("ef "), nm), Con{100, Con{10, xs}}, il_app(B.codes("ef "), nm, {==}, h), {==}), {==})
    case False{} False{}:
      uq_ne(B.line.first(B.rev.onto(List.append(&2, U32, B.codes("ef "), nm), Con{100, Con{10, xs}})), B.line.first(Con{100, Con{10, xs}}), 10,
        uq_onto(List.append(&2, U32, B.codes("ef "), nm), Con{100, Con{10, xs}}, il_app(B.codes("ef "), nm, {==}, h), {==}), {==})

def uq_kw35(c1: Bool, c2: Bool, +nm: List<&2, U32>, +xs: List<&2, U32>, +h: {B.inline(nm) == True{} : Bool}) ->
    {U32.is_eq(B.line.first(B.rev.onto(List.append(&2, U32, kw_k(c1, c2), nm), xs)), 35) == False{} : Bool}:
  match c1 c2:
    case True{} _:
      uq_ne(B.line.first(B.rev.onto(List.append(&2, U32, B.codes("aw "), nm), Con{108, Con{10, xs}})), B.line.first(Con{108, Con{10, xs}}), 35,
        uq_onto(List.append(&2, U32, B.codes("aw "), nm), Con{108, Con{10, xs}}, il_app(B.codes("aw "), nm, {==}, h), {==}), {==})
    case False{} True{}:
      uq_ne(B.line.first(B.rev.onto(List.append(&2, U32, B.codes("ef "), nm), Con{100, Con{10, xs}})), B.line.first(Con{100, Con{10, xs}}), 35,
        uq_onto(List.append(&2, U32, B.codes("ef "), nm), Con{100, Con{10, xs}}, il_app(B.codes("ef "), nm, {==}, h), {==}), {==})
    case False{} False{}:
      uq_ne(B.line.first(B.rev.onto(List.append(&2, U32, B.codes("ef "), nm), Con{100, Con{10, xs}})), B.line.first(Con{100, Con{10, xs}}), 35,
        uq_onto(List.append(&2, U32, B.codes("ef "), nm), Con{100, Con{10, xs}}, il_app(B.codes("ef "), nm, {==}, h), {==}), {==})

# the head's text before its tokens: the marker, then the header's line
def uq_h0(b: B.Tb, +ml: List<&2, U32>, +kn: List<&2, U32>) ->
    {uq_tf(B.tb.put(b, List.append(&2, U32, ml, kn))) == B.line.first(B.rev.onto(kn, B.rev.onto(ml, B.tb.acc(b)))) : U32}:
  match b:
    case B.Tb{+acc, ctrs}:
      Equal.cong(List<&2, U32>, U32, xs => B.line.first(xs), B.rev.onto(List.append(&2, U32, ml, kn), acc), B.rev.onto(kn, B.rev.onto(ml, acc)), onto_app(ml, kn, acc))

def uq_head10(+e: B.Ec, +s: U32, +x: U32, +j: U32, +b: B.Tb, +hf: {B.ec.inline(e) == True{} : Bool}) ->
    {U32.is_eq(uq_tf(B.tb.put(b, List.append(&2, U32, B.marker(e, s), List.append(&2, U32, B.unit.kw(e, s), B.own.name(e, x, j))))), 10) == False{} : Bool}:
  uq_ne(uq_tf(B.tb.put(b, List.append(&2, U32, B.marker(e, s), List.append(&2, U32, B.unit.kw(e, s), B.own.name(e, x, j))))),
    B.line.first(B.rev.onto(List.append(&2, U32, B.unit.kw(e, s), B.own.name(e, x, j)), B.rev.onto(B.marker(e, s), B.tb.acc(b)))), 10,
    uq_h0(b, B.marker(e, s), List.append(&2, U32, B.unit.kw(e, s), B.own.name(e, x, j))),
    uq_kw10(U32.is_eq(B.node.what(B.un.node(B.ec.un(e, s))), 1), U32.is_eq(B.node.what(B.un.node(B.ec.un(e, s))), 2), B.own.name(e, x, j),
      B.rev.onto(B.marker(e, s), B.tb.acc(b)), il_own(e, x, j, hf)))

def uq_head35(+e: B.Ec, +s: U32, +x: U32, +j: U32, +b: B.Tb, +hf: {B.ec.inline(e) == True{} : Bool}) ->
    {U32.is_eq(uq_tf(B.unit.head(e, s, x, j, b)), 35) == False{} : Bool}:
  uq_ne(uq_tf(B.unit.head(e, s, x, j, b)), uq_tf(B.tb.put(b, List.append(&2, U32, B.marker(e, s), List.append(&2, U32, B.unit.kw(e, s), B.own.name(e, x, j))))), 35,
    uq_rts(B.un.hd(B.ec.un(e, s)), e, s, j, B.tb.put(b, List.append(&2, U32, B.marker(e, s), List.append(&2, U32, B.unit.kw(e, s), B.own.name(e, x, j)))),
      hf, un_hd(B.ec.un(e, s), il_un(e, s, hf)), uq_head10(e, s, x, j, b, hf)),
    uq_ne(uq_tf(B.tb.put(b, List.append(&2, U32, B.marker(e, s), List.append(&2, U32, B.unit.kw(e, s), B.own.name(e, x, j))))),
      B.line.first(B.rev.onto(List.append(&2, U32, B.unit.kw(e, s), B.own.name(e, x, j)), B.rev.onto(B.marker(e, s), B.tb.acc(b)))), 35,
      uq_h0(b, B.marker(e, s), List.append(&2, U32, B.unit.kw(e, s), B.own.name(e, x, j))),
      uq_kw35(U32.is_eq(B.node.what(B.un.node(B.ec.un(e, s))), 1), U32.is_eq(B.node.what(B.un.node(B.ec.un(e, s))), 2), B.own.name(e, x, j),
        B.rev.onto(B.marker(e, s), B.tb.acc(b)), il_own(e, x, j, hf))))

def Laws.markers.unambiguous(e, s, x, j, b, hf, hd):
  and_intro(B.tb.clear(B.unit.head(e, s, x, j, b)), B.wc.at(B.un.lines(B.ec.un(e, s)), e, s, j, B.node.ind(B.un.node(B.ec.un(e, s))), True{}, B.unit.head(e, s, x, j, b)),
    uq_clear(B.unit.head(e, s, x, j, b), uq_head35(e, s, x, j, b, hf)),
    uq_walk(B.un.lines(B.ec.un(e, s)), e, s, j, B.node.ind(B.un.node(B.ec.un(e, s))), True{}, B.unit.head(e, s, x, j, b), hf,
      un_ls(B.ec.un(e, s), il_un(e, s, hf)), hd, uq_head35(e, s, x, j, b, hf)))

# Every definition's body read clear of a marker's place (`deep.items`):
# the lines after a header read as its body while deeper than it or
# blank (`dp_bg`), its leading and trailing blank lines dropped and
# reversed keeping that (`dp_trim`), each kind of item keeping body and
# line (`dp_block`, as `block_ok`), a type member's one line first and
# numbered as its header (`dp_tm`), and the lines no header claims made
# items without a body (`dp_plain`, as `plain_ok`). No hypothesis: the
# reader puts no other line in a body.

# lines each blank or deeper: kept by any reversal onto others so
def dp_rev(xs: List<&2, B.Ln>, +acc: List<&2, B.Ln>, +k: B.Loc, +ind: U32, +hx: {B.ln.deep(xs, k, ind, False{}) == True{} : Bool},
    +ha: {B.ln.deep(acc, k, ind, False{}) == True{} : Bool}) -> {B.ln.deep(List.reverse.go(&2, B.Ln, xs, acc), k, ind, False{}) == True{} : Bool}:
  match xs:
    case Nil{}:
      ha
    case Con{l, +t}:
      match l:
        case B.Ln{+n, +i, +txt}:
          dp_rev(t, Con{B.Ln{n, i, txt}, acc}, k, ind, and_r(Bool.or(B.blank(txt), U32.is_gt(i, ind)), B.ln.deep(t, k, ind, False{}), hx),
            and_intro(Bool.or(B.blank(txt), U32.is_gt(i, ind)), B.ln.deep(acc, k, ind, False{}), and_l(Bool.or(B.blank(txt), U32.is_gt(i, ind)), B.ln.deep(t, k, ind, False{}), hx), ha))

def dp_blk(c: Bool, +no: B.Loc, +i: U32, +txt: List<&2, U32>, +t: List<&2, B.Ln>, +k: B.Loc, +ind: U32, +h: {B.ln.deep(Con{B.Ln{no, i, txt}, t}, k, ind, False{}) == True{} : Bool},
    ih: {B.ln.deep(t, k, ind, False{}) == True{} : Bool} -> {B.ln.deep(B.body.lead(t), k, ind, False{}) == True{} : Bool}) -> {B.ln.deep(blk(c, no, i, txt, t), k, ind, False{}) == True{} : Bool}:
  match c:
    case True{}:
      ih(and_r(Bool.or(B.blank(txt), U32.is_gt(i, ind)), B.ln.deep(t, k, ind, False{}), h))
    case False{}:
      h

def dp_lead(ys: List<&2, B.Ln>, +k: B.Loc, +ind: U32, +h: {B.ln.deep(ys, k, ind, False{}) == True{} : Bool}) -> {B.ln.deep(B.body.lead(ys), k, ind, False{}) == True{} : Bool}:
  match ys:
    case Nil{}:
      {==}
    case Con{l, +t}:
      match l:
        case B.Ln{+no, +i, +txt}:
          dp_blk(B.blank(txt), no, i, txt, t, k, ind, h, p => dp_lead(t, k, ind, p))

def dp_trim(+xs: List<&2, B.Ln>, +k: B.Loc, +ind: U32, +hx: {B.ln.deep(xs, k, ind, False{}) == True{} : Bool}) -> {B.ln.deep(B.body.trim(xs), k, ind, False{}) == True{} : Bool}:
  dp_rev(B.body.lead(List.reverse(&2, B.Ln, xs)), Nil{}, k, ind, dp_lead(List.reverse(&2, B.Ln, xs), k, ind, dp_rev(xs, Nil{}, k, ind, hx, {==})), {==})

def dp_bgk(c: Bool, +no: B.Loc, +li: U32, +txt: List<&2, U32>, +t: List<&2, B.Ln>, +ind: U32, +acc: List<&2, B.Ln>, +k: B.Loc,
    ec: {Bool.or(B.blank(txt), U32.is_gt(li, ind)) == c : Bool}, +ha: {B.ln.deep(acc, k, ind, False{}) == True{} : Bool},
    ih: {B.ln.deep(Con{B.Ln{no, li, txt}, acc}, k, ind, False{}) == True{} : Bool} -> {B.ln.deep(Pair.fst(List<&2, B.Ln>, List<&2, B.Ln>, B.body.go(t, ind, Con{B.Ln{no, li, txt}, acc})), k, ind, False{}) == True{} : Bool}) ->
    {B.ln.deep(Pair.fst(List<&2, B.Ln>, List<&2, B.Ln>, bgk(c, no, li, txt, t, ind, acc)), k, ind, False{}) == True{} : Bool}:
  match c:
    case True{}:
      ih(and_intro(Bool.or(B.blank(txt), U32.is_gt(li, ind)), B.ln.deep(acc, k, ind, False{}), ec, ha))
    case False{}:
      dp_rev(acc, Nil{}, k, ind, ha, {==})

# a header's body: the lines after it while blank or deeper
def dp_bg(ls: List<&2, B.Ln>, +ind: U32, +acc: List<&2, B.Ln>, +k: B.Loc, +ha: {B.ln.deep(acc, k, ind, False{}) == True{} : Bool}) ->
    {B.ln.deep(Pair.fst(List<&2, B.Ln>, List<&2, B.Ln>, B.body.go(ls, ind, acc)), k, ind, False{}) == True{} : Bool}:
  match ls:
    case Nil{}:
      dp_rev(acc, Nil{}, k, ind, ha, {==})
    case Con{l, +t}:
      match l:
        case B.Ln{+no, +li, +txt}:
          dp_bgk(Bool.or(B.blank(txt), U32.is_gt(li, ind)), no, li, txt, t, ind, acc, k, {==}, ha, p => dp_bg(t, ind, Con{B.Ln{no, li, txt}, acc}, k, p))

# lines each blank or deeper, as a definition's body: its first too
def dp_bf(body: List<&2, B.Ln>, +no: B.Loc, +ind: U32, +hb: {B.ln.deep(body, no, ind, False{}) == True{} : Bool}) -> {B.ln.deep(body, no, ind, True{}) == True{} : Bool}:
  match body:
    case Nil{}:
      {==}
    case Con{l, +t}:
      match l:
        case B.Ln{+n, +i, +txt}:
          and_intro(Bool.or(Bool.or(B.loc.eq(n, no), B.blank(txt)), U32.is_gt(i, ind)), B.ln.deep(t, no, ind, False{}),
            or_cases(B.blank(txt), U32.is_gt(i, ind), Bool.or(Bool.or(B.loc.eq(n, no), B.blank(txt)), U32.is_gt(i, ind)),
              and_l(Bool.or(B.blank(txt), U32.is_gt(i, ind)), B.ln.deep(t, no, ind, False{}), hb),
              p => or_l_true(Bool.or(B.loc.eq(n, no), B.blank(txt)), U32.is_gt(i, ind), or_r_true(B.loc.eq(n, no), B.blank(txt), p)),
              q => or_r_true(Bool.or(B.loc.eq(n, no), B.blank(txt)), U32.is_gt(i, ind), q)),
            and_r(Bool.or(B.blank(txt), U32.is_gt(i, ind)), B.ln.deep(t, no, ind, False{}), hb))

def dp_items_rev(xs: List<&2, B.Item>, +acc: List<&2, B.Item>, +hx: {B.items.deep(xs) == True{} : Bool}, +ha: {B.items.deep(acc) == True{} : Bool}) ->
    {B.items.deep(List.reverse.go(&2, B.Item, xs, acc)) == True{} : Bool}:
  match xs:
    case Nil{}:
      ha
    case Con{+it, +t}:
      dp_items_rev(t, Con{it, acc}, and_r(B.item.deep(it), B.items.deep(t), hx),
        and_intro(B.item.deep(it), B.items.deep(acc), and_l(B.item.deep(it), B.items.deep(t), hx), ha))

def dp_lm(c: Bool, +name: List<&2, U32>, +txt: List<&2, U32>, +body: List<&2, B.Ln>, +no: B.Loc, +ind: U32, +hb: {B.ln.deep(body, no, ind, False{}) == True{} : Bool}) ->
    {B.item.deep(lm_k(c, name, txt, body, no, ind)) == True{} : Bool}:
  match c:
    case True{}:
      dp_bf(body, no, ind, hb)
    case False{}:
      {==}

def dp_law(p: List<&2, U32> & List<&2, U32>, +txt: List<&2, U32>, +body: List<&2, B.Ln>, +no: B.Loc, +ind: U32, +hb: {B.ln.deep(body, no, ind, False{}) == True{} : Bool}) ->
    {B.item.deep(B.law.r(p, txt, body, no, ind)) == True{} : Bool}:
  match p:
    case (+name, +rest):
      dp_lm(Bool.and(B.name.ok(B.trim(name)), B.blank(B.trim(rest))), B.trim(name), txt, body, no, ind, hb)

def dp_pr(c1: Bool, c2: Bool, +upd: Bool, +name: List<&2, U32>, +rest: List<&2, U32>, +txt: List<&2, U32>, +body: List<&2, B.Ln>, +no: B.Loc, +ind: U32,
    +hb: {B.ln.deep(body, no, ind, False{}) == True{} : Bool}) -> {B.item.deep(pr_k(c1, c2, upd, name, rest, txt, body, no, ind)) == True{} : Bool}:
  match c1 c2:
    case True{} True{}:
      dp_bf(body, no, ind, hb)
    case True{} False{}:
      dp_bf(body, no, ind, hb)
    case False{} _:
      {==}

def dp_proofr(p: List<&2, U32> & List<&2, U32>, +upd: Bool, +lemma: Bool, +txt: List<&2, U32>, +body: List<&2, B.Ln>, +no: B.Loc, +ind: U32,
    +hb: {B.ln.deep(body, no, ind, False{}) == True{} : Bool}) -> {B.item.deep(B.proof.r(p, upd, lemma, txt, body, no, ind)) == True{} : Bool}:
  match p:
    case (+name, +rest):
      dp_pr(Bool.and(Bool.and(B.name.ok(B.trim(name)), Bool.not(B.blank(rest))), Bool.not(Bool.xor(lemma, B.holds(rest, B.codes(") ->"))))), lemma, upd, name, rest, txt, body, no, ind, hb)

def dp_proof(+txt: List<&2, U32>, upd: Bool, +body: List<&2, B.Ln>, +no: B.Loc, +ind: U32, +hb: {B.ln.deep(body, no, ind, False{}) == True{} : Bool}) ->
    {B.item.deep(B.proof.item(txt, upd, body, no, ind)) == True{} : Bool}:
  match upd:
    case True{}:
      dp_proofr(B.until(B.drop(10n, txt), 40), True{}, B.is.lemma(txt), txt, body, no, ind, hb)
    case False{}:
      dp_proofr(B.until(B.drop(6n, txt), 40), False{}, B.is.lemma(txt), txt, body, no, ind, hb)

def dp_named(ok: Bool, +name: List<&2, U32>, +rest: List<&2, U32>, +xs: List<&2, U32>, +share: U32, +upd: Bool, +body: List<&2, B.Ln>, +no: B.Loc, +ind: U32,
    +hb: {B.ln.deep(body, no, ind, False{}) == True{} : Bool}) -> {B.item.deep(B.def.named(ok, name, rest, xs, share, upd, body, no, ind)) == True{} : Bool}:
  match ok:
    case True{}:
      dp_bf(body, no, ind, hb)
    case False{}:
      {==}

def dp_dr(p: List<&2, U32> & List<&2, U32>, +xs: List<&2, U32>, +share: U32, +upd: Bool, +body: List<&2, B.Ln>, +no: B.Loc, +ind: U32,
    +hb: {B.ln.deep(body, no, ind, False{}) == True{} : Bool}) -> {B.item.deep(B.def.r(p, xs, share, upd, body, no, ind)) == True{} : Bool}:
  match p:
    case (+name, +rest):
      dp_named(Bool.and(B.name.ok(B.trim(name)), Bool.not(B.blank(rest))), B.trim(name), rest, xs, share, upd, body, no, ind, hb)

def dp_kwd(d: Bool, u: Bool, +xs: List<&2, U32>, +share: U32, +body: List<&2, B.Ln>, +no: B.Loc, +ind: U32, +hb: {B.ln.deep(body, no, ind, False{}) == True{} : Bool}) ->
    {B.item.deep(B.def.kw.d(d, u, xs, share, body, no, ind)) == True{} : Bool}:
  match d u:
    case True{} _:
      dp_dr(B.until(B.drop(4n, xs), 40), B.drop(4n, xs), share, False{}, body, no, ind, hb)
    case False{} True{}:
      dp_dr(B.until(B.upd.def(B.drop(4n, xs)), 40), B.upd.def(B.drop(4n, xs)), share, True{}, body, no, ind, hb)
    case False{} False{}:
      {==}

def dp_shs(s: Bool, c: Bool, +xs: List<&2, U32>, +body: List<&2, B.Ln>, +no: B.Loc, +ind: U32, +hb: {B.ln.deep(body, no, ind, False{}) == True{} : Bool}) ->
    {B.item.deep(B.def.share.s(s, c, xs, body, no, ind)) == True{} : Bool}:
  match s c:
    case True{} _:
      dp_kwd(B.starts.s(B.drop(7n, xs), "def "), B.starts.s(B.drop(7n, xs), "upd "), B.drop(7n, xs), 1, body, no, ind, hb)
    case False{} True{}:
      dp_kwd(B.starts.s(B.drop(7n, xs), "def "), B.starts.s(B.drop(7n, xs), "upd "), B.drop(7n, xs), 2, body, no, ind, hb)
    case False{} False{}:
      dp_kwd(B.starts.s(xs, "def "), B.starts.s(xs, "upd "), xs, 0, body, no, ind, hb)

def dp_fb(c1: Bool, c2: Bool, c3: Bool, c4: Bool, +txt: List<&2, U32>, +body: List<&2, B.Ln>, +no: B.Loc, +ind: U32, +hb: {B.ln.deep(body, no, ind, False{}) == True{} : Bool}) ->
    {B.item.deep(fbk(c1, c2, c3, c4, txt, body, no, ind)) == True{} : Bool}:
  match c1 c2 c3 c4:
    case True{} _ _ _:
      {==}
    case False{} True{} _ _:
      dp_law(B.until(B.drop(4n, txt), 58), txt, body, no, ind, hb)
    case False{} False{} True{} _:
      {==}
    case False{} False{} False{} True{}:
      dp_proof(txt, B.starts.s(txt, "upd "), body, no, ind, hb)
    case False{} False{} False{} False{}:
      dp_shs(B.starts.s(txt, "shared "), B.starts.s(txt, "copied "), txt, body, no, ind, hb)

def dp_block(+txt: List<&2, U32>, +body: List<&2, B.Ln>, +no: B.Loc, +ind: U32, +hb: {B.ln.deep(body, no, ind, False{}) == True{} : Bool}) ->
    {B.item.deep(B.flat.block(txt, body, no, ind)) == True{} : Bool}:
  dp_fb(B.is.datatype(txt), B.starts.s(txt, "law "), B.starts.s(txt, "upd law "), B.proof.kw(txt), txt, body, no, ind, hb)

def dp_onamed(ok: Bool, +with: Bool, +ext: Bool, +name: List<&2, U32>, +ps: List<&2, List<&2, U32>>, +xs: List<&2, U32>, +abs: Bool, +no: B.Loc, +ind: U32) ->
    {B.item.deep(B.obj.named(ok, with, ext, name, ps, xs, abs, no, ind)) == True{} : Bool}:
  match ok:
    case True{}:
      {==}
    case False{}:
      {==}

def dp_oe(p: List<&2, U32> & List<&2, U32>, +xs: List<&2, U32>, +abs: Bool, +ext: Bool, +no: B.Loc, +ind: U32) -> {B.item.deep(B.obj.ext(p, xs, abs, ext, no, ind)) == True{} : Bool}:
  match p:
    case (+name, +rest):
      dp_onamed(Bool.and(B.name.ok(name), Bool.or(Bool.or(B.blank(B.rtrim(rest)), B.same(B.rtrim(rest), B.codes("with"))),
          Bool.and(B.starts.s(B.rtrim(rest), "extends "), B.names.ok(B.obj.parents(B.rtrim(rest)))))),
        Bool.or(B.same(B.rtrim(rest), B.codes("with")), B.starts.s(List.reverse(&2, U32, B.rtrim(rest)), "htiw ")), ext,
        name, B.obj.parents(B.rtrim(rest)), xs, abs, no, ind)

def dp_obj(+xs: List<&2, U32>, +line: List<&2, U32>, +abs: Bool, +ext: Bool, +no: B.Loc, +ind: U32) -> {B.item.deep(B.obj.item(xs, line, abs, ext, no, ind)) == True{} : Bool}:
  dp_oe(B.until(xs, 32), line, abs, ext, no, ind)

def dp_dnamed(ok: Bool, +ns: List<&2, List<&2, U32>>, +line: List<&2, U32>, +no: B.Loc, +ind: U32) -> {B.item.deep(B.decl.named(ok, ns, line, no, ind)) == True{} : Bool}:
  match ok:
    case True{}:
      {==}
    case False{}:
      {==}

def dp_ditem(+ns: List<&2, List<&2, U32>>, +line: List<&2, U32>, +no: B.Loc, +ind: U32) -> {B.item.deep(B.decl.item(ns, line, no, ind)) == True{} : Bool}:
  dp_dnamed(Bool.and(B.decl.some(ns), B.names.ok(ns)), ns, line, no, ind)

def dp_dw(c: Bool, +name: List<&2, U32>, +ps: List<&2, U32>, +ret: List<&2, U32>, +txt: List<&2, U32>, +no: B.Loc, +ind: U32, +out: List<&2, B.Item>,
    +ho: {B.items.deep(out) == True{} : Bool}) -> {B.items.deep(dwk(c, name, ps, ret, txt, no, ind, out)) == True{} : Bool}:
  match c:
    case True{}:
      ho
    case False{}:
      ho

def dp_witness(+name: List<&2, U32>, +ps: List<&2, U32>, +ret: List<&2, U32>, +txt: List<&2, U32>, +no: B.Loc, +ind: U32, +out: List<&2, B.Item>,
    +ho: {B.items.deep(out) == True{} : Bool}) -> {B.items.deep(B.decl.witness(name, ps, ret, txt, no, ind, out)) == True{} : Bool}:
  dp_dw(Bool.and(B.name.ok(name), Bool.not(B.blank(ret))), name, ps, ret, txt, no, ind, out, ho)

def dp_dtk(c: Bool, +name: List<&2, U32>, +after: List<&2, U32>, +txt: List<&2, U32>, +no: B.Loc, +ind: U32, +out: List<&2, B.Item>,
    +ho: {B.items.deep(out) == True{} : Bool}) -> {B.items.deep(dtk(c, name, after, txt, no, ind, out)) == True{} : Bool}:
  match c:
    case True{}:
      dp_witness(name, B.parens(List.tail(&2, U32, after)),
        B.type.kind(B.trim(B.drop(Nat.add(List.length(&2, U32, B.parens(List.tail(&2, U32, after))), 2n), after))), txt, no, ind, out, ho)
    case False{}:
      dp_witness(name, Nil{}, B.type.kind(B.trim(after)), txt, no, ind, out, ho)

def dp_dtype(p: List<&2, U32> & List<&2, U32>, +txt: List<&2, U32>, +no: B.Loc, +ind: U32, +out: List<&2, B.Item>, +ho: {B.items.deep(out) == True{} : Bool}) ->
    {B.items.deep(B.decl.type.k(p, txt, no, ind, out)) == True{} : Bool}:
  match p:
    case (+name, +after):
      dp_dtk(B.starts.s(after, "("), name, after, txt, no, ind, out, ho)

def dp_dtl(c: Bool, +r: List<&2, U32>, +txt: List<&2, U32>, +no: B.Loc, +ind: U32, +out: List<&2, B.Item>, +ho: {B.items.deep(out) == True{} : Bool}) ->
    {B.items.deep(dtl(c, r, txt, no, ind, out)) == True{} : Bool}:
  match c:
    case True{}:
      dp_dtype(B.name.split(r, B.classes(r), Nil{}), txt, no, ind, out, ho)
    case False{}:
      and_intro(B.item.deep(B.decl.item(B.commas(r), txt, no, ind)), B.items.deep(out), dp_ditem(B.commas(r), txt, no, ind), ho)

def dp_ddk(c: Bool, +name: List<&2, U32>, +rest: List<&2, U32>, +txt: List<&2, U32>, +no: B.Loc, +ind: U32, +out: List<&2, B.Item>, +ho: {B.items.deep(out) == True{} : Bool}) ->
    {B.items.deep(ddk(c, name, rest, txt, no, ind, out)) == True{} : Bool}:
  match c:
    case True{}:
      dp_witness(B.trim(name), B.parens(rest), B.trim(B.drop(Nat.add(List.length(&2, U32, B.parens(rest)), 4n), rest)), txt, no, ind, out, ho)
    case False{}:
      ho

def dp_ddef(p: List<&2, U32> & List<&2, U32>, +txt: List<&2, U32>, +no: B.Loc, +ind: U32, +out: List<&2, B.Item>, +ho: {B.items.deep(out) == True{} : Bool}) ->
    {B.items.deep(B.decl.def.k(p, txt, no, ind, out)) == True{} : Bool}:
  match p:
    case (+name, +rest):
      dp_ddk(B.holds(rest, B.codes(") ->")), name, rest, txt, no, ind, out, ho)

def dp_dl(c1: Bool, c2: Bool, +rest: List<&2, U32>, +txt: List<&2, U32>, +no: B.Loc, +ind: U32, +out: List<&2, B.Item>, +ho: {B.items.deep(out) == True{} : Bool}) ->
    {B.items.deep(dlk(c1, c2, rest, txt, no, ind, out)) == True{} : Bool}:
  match c1 c2:
    case True{} _:
      dp_dtl(Bool.or(B.holds(B.trim(B.drop(5n, rest)), B.codes(":")), B.holds(B.trim(B.drop(5n, rest)), B.codes("("))), B.trim(B.drop(5n, rest)), txt, no, ind, out, ho)
    case False{} True{}:
      dp_ddef(B.until(B.when(List<&2, U32>, B.starts.s(rest, "def "), w => B.drop(4n, rest), w => rest), 40), txt, no, ind, out, ho)
    case False{} False{}:
      and_intro(B.item.deep(B.decl.item(B.commas(rest), txt, no, ind)), B.items.deep(out), dp_ditem(B.commas(rest), txt, no, ind), ho)

def dp_decl(+rest: List<&2, U32>, +txt: List<&2, U32>, +no: B.Loc, +ind: U32, +out: List<&2, B.Item>, +ho: {B.items.deep(out) == True{} : Bool}) ->
    {B.items.deep(B.decl.line(rest, txt, no, ind, out)) == True{} : Bool}:
  dp_dl(B.starts.s(rest, "type "), B.holds(rest, B.codes("(")), rest, txt, no, ind, out, ho)

def dp_fl(skip: Bool, imp: Bool, abs: Bool, obj: Bool, decl: Bool, +txt: List<&2, U32>, +no: B.Loc, +ind: U32, +out: List<&2, B.Item>, +ho: {B.items.deep(out) == True{} : Bool}) ->
    {B.items.deep(B.flat.line(skip, imp, abs, obj, decl, txt, no, ind, out)) == True{} : Bool}:
  match skip imp abs obj decl:
    case True{} _ _ _ _:
      ho
    case False{} True{} _ _ _:
      ho
    case False{} False{} True{} _ _:
      and_intro(B.item.deep(B.obj.item(B.drop(16n, txt), txt, True{}, False{}, no, ind)), B.items.deep(out), dp_obj(B.drop(16n, txt), txt, True{}, False{}, no, ind), ho)
    case False{} False{} False{} True{} _:
      and_intro(B.item.deep(B.obj.item(B.drop(7n, txt), txt, False{}, False{}, no, ind)), B.items.deep(out), dp_obj(B.drop(7n, txt), txt, False{}, False{}, no, ind), ho)
    case False{} False{} False{} False{} True{}:
      dp_decl(B.drop(8n, txt), txt, no, ind, out, ho)
    case False{} False{} False{} False{} False{}:
      ho

def dp_ex(c: Bool, +txt: List<&2, U32>, +no: B.Loc, +ind: U32) -> {B.item.deep(exk(c, txt, no, ind)) == True{} : Bool}:
  match c:
    case True{}:
      dp_obj(B.drop(16n, txt), txt, True{}, True{}, no, ind)
    case False{}:
      dp_obj(B.drop(7n, txt), txt, False{}, True{}, no, ind)

def dp_fik(c: Bool, +txt: List<&2, U32>, +no: B.Loc, +ind: U32, +out: List<&2, B.Item>, +ho: {B.items.deep(out) == True{} : Bool}) ->
    {B.items.deep(fik(c, txt, no, ind, out)) == True{} : Bool}:
  match c:
    case True{}:
      and_intro(B.item.deep(B.ext.item(txt, no, ind)), B.items.deep(out), dp_ex(B.starts.s(txt, "extend abstract "), txt, no, ind), ho)
    case False{}:
      dp_fl(Bool.or(B.blank(txt), B.comment(txt)), B.starts.s(txt, "import "), B.starts.s(txt, "abstract object "), B.starts.s(txt, "object "),
        B.starts.s(txt, "declare "), txt, no, ind, out, ho)

def dp_tm(c: Bool, +upd: Bool, +name: List<&2, U32>, +ps: List<&2, U32>, +after: List<&2, U32>, +ty: List<&2, U32>, +xs: List<&2, U32>, +no: B.Loc, +ind: U32) ->
    {B.item.deep(tmk(c, upd, name, ps, after, ty, xs, no, ind)) == True{} : Bool}:
  match c:
    case True{}:
      and_intro(Bool.or(Bool.or(B.loc.eq(no, no), B.blank(ty)), U32.is_gt(U32.add(ind, 2), ind)), True{},
        or_l_true(Bool.or(B.loc.eq(no, no), B.blank(ty)), U32.is_gt(U32.add(ind, 2), ind), or_l_true(B.loc.eq(no, no), B.blank(ty), loc_eq_refl(no))), {==})
    case False{}:
      {==}

def dp_made(+upd: Bool, +name: List<&2, U32>, +ps: List<&2, U32>, +after: List<&2, U32>, +ty: List<&2, U32>, +xs: List<&2, U32>, +no: B.Loc, +ind: U32) ->
    {B.item.deep(B.type.made(upd, name, ps, after, ty, xs, no, ind)) == True{} : Bool}:
  dp_tm(Bool.and(B.name.ok(name), Bool.not(B.blank(ty))), upd, name, ps, after, ty, xs, no, ind)

def dp_tl(c: Bool, +upd: Bool, +name: List<&2, U32>, +after: List<&2, U32>, +ty: List<&2, U32>, +xs: List<&2, U32>, +no: B.Loc, +ind: U32) ->
    {B.item.deep(tlk(c, upd, name, after, ty, xs, no, ind)) == True{} : Bool}:
  match c:
    case True{}:
      dp_made(upd, name, B.parens(List.tail(&2, U32, after)), B.drop(Nat.add(List.length(&2, U32, B.parens(List.tail(&2, U32, after))), 2n), after), ty, xs, no, ind)
    case False{}:
      dp_made(upd, name, Nil{}, after, ty, xs, no, ind)

def dp_lhs(+upd: Bool, p: List<&2, U32> & List<&2, U32>, +ty: List<&2, U32>, +xs: List<&2, U32>, +no: B.Loc, +ind: U32) ->
    {B.item.deep(B.type.lhs(upd, p, ty, xs, no, ind)) == True{} : Bool}:
  match p:
    case (+name, +after):
      dp_tl(B.starts.s(after, "("), upd, name, after, ty, xs, no, ind)

def dp_teq(+upd: Bool, p: List<&2, U32> & List<&2, U32>, +xs: List<&2, U32>, +no: B.Loc, +ind: U32) -> {B.item.deep(B.type.eq(upd, p, xs, no, ind)) == True{} : Bool}:
  match p:
    case (+lhs, +ty):
      dp_lhs(upd, B.name.split(B.trim(lhs), B.classes(B.trim(lhs)), Nil{}), B.trim(ty), xs, no, ind)

def dp_ti(c: Bool, +txt: List<&2, U32>, +no: B.Loc, +ind: U32) -> {B.item.deep(tik(c, txt, no, ind)) == True{} : Bool}:
  match c:
    case True{}:
      dp_teq(True{}, B.split.at(B.drop(9n, txt), B.codes(" = "), Nil{}), txt, no, ind)
    case False{}:
      dp_teq(False{}, B.split.at(B.drop(5n, txt), B.codes(" = "), Nil{}), txt, no, ind)

def dp_plain(c: Bool, +txt: List<&2, U32>, +no: B.Loc, +ind: U32, +out: List<&2, B.Item>, +ho: {B.items.deep(out) == True{} : Bool}) ->
    {B.items.deep(plk(c, txt, no, ind, out)) == True{} : Bool}:
  match c:
    case True{}:
      and_intro(B.item.deep(B.type.item(txt, no, ind)), B.items.deep(out), dp_ti(B.starts.s(txt, "upd "), txt, no, ind), ho)
    case False{}:
      dp_fik(B.starts.s(txt, "extend "), txt, no, ind, out, ho)

def dp_fg(c: Bool, +m: Nat, +txt: List<&2, U32>, +t: List<&2, B.Ln>, +no: B.Loc, +ind: U32, +out: List<&2, B.Item>,
    ht: {B.items.deep(B.flat.go(m, Pair.snd(List<&2, B.Ln>, List<&2, B.Ln>, B.body.go(t, ind, Nil{})), Con{B.flat.block(txt, B.body.trim(Pair.fst(List<&2, B.Ln>, List<&2, B.Ln>, B.body.go(t, ind, Nil{}))), no, ind), out})) == True{} : Bool}, hf: {B.items.deep(B.flat.go(m, t, plk(B.is.member.type(txt), txt, no, ind, out))) == True{} : Bool}) ->
    {B.items.deep(fgk(c, m, txt, t, no, ind, out)) == True{} : Bool}:
  match c:
    case True{}:
      %Equal.sym(List<&2, B.Item>, B.on.pair(List<&2, B.Ln>, List<&2, B.Ln>, List<&2, B.Item>, B.body.go(t, ind, Nil{}), body => rest => B.flat.go(m, rest, Con{B.flat.block(txt, B.body.trim(body), no, ind), out})), B.flat.go(m, Pair.snd(List<&2, B.Ln>, List<&2, B.Ln>, B.body.go(t, ind, Nil{})), Con{B.flat.block(txt, B.body.trim(Pair.fst(List<&2, B.Ln>, List<&2, B.Ln>, B.body.go(t, ind, Nil{}))), no, ind), out}), pair_eta(B.body.go(t, ind, Nil{}), body => rest => B.flat.go(m, rest, Con{B.flat.block(txt, B.body.trim(body), no, ind), out}))) :
        {B.items.deep(_) == True{} : Bool}
      ht
    case False{}:
      hf

# the items read from any lines
def dp_flat(n: Nat, ls: List<&2, B.Ln>, +out: List<&2, B.Item>, +ho: {B.items.deep(out) == True{} : Bool}) -> {B.items.deep(B.flat.go(n, ls, out)) == True{} : Bool}:
  match n:
    case 0n:
      dp_items_rev(out, Nil{}, ho, {==})
    case 1n+(+m):
      match ls:
        case Nil{}:
          dp_items_rev(out, Nil{}, ho, {==})
        case Con{l, +t}:
          match l:
            case B.Ln{+no, +ind, +txt}:
              dp_fg(Bool.and(Bool.not(B.is.member.type(txt)), Bool.or(B.is_def(txt), B.is.datatype(txt))), m, txt, t, no, ind, out,
                dp_flat(m, Pair.snd(List<&2, B.Ln>, List<&2, B.Ln>, B.body.go(t, ind, Nil{})), Con{B.flat.block(txt, B.body.trim(Pair.fst(List<&2, B.Ln>, List<&2, B.Ln>, B.body.go(t, ind, Nil{}))), no, ind), out},
                  and_intro(B.item.deep(B.flat.block(txt, B.body.trim(Pair.fst(List<&2, B.Ln>, List<&2, B.Ln>, B.body.go(t, ind, Nil{}))), no, ind)), B.items.deep(out),
                    dp_block(txt, B.body.trim(Pair.fst(List<&2, B.Ln>, List<&2, B.Ln>, B.body.go(t, ind, Nil{}))), no, ind,
                      dp_trim(Pair.fst(List<&2, B.Ln>, List<&2, B.Ln>, B.body.go(t, ind, Nil{})), no, ind, dp_bg(t, ind, Nil{}, no, {==}))),
                    ho)),
                dp_flat(m, t, plk(B.is.member.type(txt), txt, no, ind, out), dp_plain(B.is.member.type(txt), txt, no, ind, out, ho)))

def Laws.deep.items(ls):
  dp_flat(List.length(&2, B.Ln, ls), ls, Nil{}, {==})

# The tree keeps each body clear of a marker's place (`deep.tree`), as
# `markers.tree` keeps its numbers: a body's lines made the tree's one
# for one, a blank one without tokens (`dt_lnbl`).

def dt_blank(txt: List<&2, U32>, h: {B.blank(txt) == True{} : Bool}) -> {B.toks.blank(B.toks(txt)) == True{} : Bool}:
  match txt:
    case Nil{}:
      {==}
    case Con{c, r}:
      Empty.absurd({B.toks.blank(B.toks(Con{c, r})) == True{} : Bool}, MB.false_ne_true()(h))

# an or's middle term traded for one it gives
def dt_or(+f: Bool, +a: Bool, +a2: Bool, +g: Bool, h: {Bool.or(Bool.or(f, a), g) == True{} : Bool}, ha: {a == True{} : Bool} -> {a2 == True{} : Bool}) ->
    {Bool.or(Bool.or(f, a2), g) == True{} : Bool}:
  or_cases(Bool.or(f, a), g, Bool.or(Bool.or(f, a2), g), h,
    p => or_cases(f, a, Bool.or(Bool.or(f, a2), g), p, p1 => or_l_true(Bool.or(f, a2), g, or_l_true(f, a2, p1)), p2 => or_l_true(Bool.or(f, a2), g, or_r_true(f, a2, ha(p2)))),
    q => or_r_true(Bool.or(f, a2), g, q))

def dt_lnbl(ls: List<&2, B.Ln>, +no: B.Loc, +ind: U32, +first: Bool, +h: {B.ln.deep(ls, no, ind, first) == True{} : Bool}) ->
    {B.bl.deep(B.toks.lines(ls), no, ind, first) == True{} : Bool}:
  match ls:
    case Nil{}:
      {==}
    case Con{l, +t}:
      match l:
        case B.Ln{+n, +i, +txt}:
          and_intro(Bool.or(Bool.or(Bool.and(first, B.loc.eq(n, no)), B.toks.blank(B.toks(txt))), U32.is_gt(i, ind)), B.bl.deep(B.toks.lines(t), no, ind, False{}),
            dt_or(Bool.and(first, B.loc.eq(n, no)), B.blank(txt), B.toks.blank(B.toks(txt)), U32.is_gt(i, ind),
              and_l(Bool.or(Bool.or(Bool.and(first, B.loc.eq(n, no)), B.blank(txt)), U32.is_gt(i, ind)), B.ln.deep(t, no, ind, False{}), h), p => dt_blank(txt, p)),
            dt_lnbl(t, no, ind, False{}, and_r(Bool.or(Bool.or(Bool.and(first, B.loc.eq(n, no)), B.blank(txt)), U32.is_gt(i, ind)), B.ln.deep(t, no, ind, False{}), h)))

def dt_frok(st: List<&2, B.Fr>) -> Bool:
  match st:
    case Nil{}:
      True{}
    case Con{f, t}:
      match f:
        case B.Fr{+top, +ind, +abs, +with, +ext, name, parents, kids, +no}:
          Bool.and(B.defs.deep(kids), dt_frok(t))

def dt_cons(n: B.Node, +ks: List<&2, B.Node>, +hn: {B.defs.deep(Con{n, Nil{}}) == True{} : Bool}, +hk: {B.defs.deep(ks) == True{} : Bool}) -> {B.defs.deep(Con{n, ks}) == True{} : Bool}:
  match n:
    case B.NObj{+abs, +ext, +name, +parents, +kids, +no}:
      and_intro(B.defs.deep(kids), B.defs.deep(ks), and_l(B.defs.deep(kids), True{}, hn), hk)
    case B.NDef{+share, +upd, +name, +rest, +params, +body, +no, +ind, +what}:
      and_intro(B.bl.deep(body, no, ind, True{}), B.defs.deep(ks),
        and_l(B.bl.deep(body, no, ind, True{}), True{}, hn), hk)
    case B.NImport{+txt, +no}:
      hk
    case B.NDecl{+names, +no}:
      hk
    case B.NBad{+txt, +no}:
      hk
    case B.NErr{+msg, +no}:
      hk
    case B.NBend{+lines, +no}:
      hk

def dt_head(n: B.Node, +t: List<&2, B.Node>, +h: {B.defs.deep(Con{n, t}) == True{} : Bool}) -> {B.defs.deep(Con{n, Nil{}}) == True{} : Bool}:
  match n:
    case B.NObj{+abs, +ext, +name, +parents, +kids, +no}:
      and_intro(B.defs.deep(kids), True{}, and_l(B.defs.deep(kids), B.defs.deep(t), h), {==})
    case B.NDef{+share, +upd, +name, +rest, +params, +body, +no, +ind, +what}:
      and_intro(B.bl.deep(body, no, ind, True{}), True{},
        and_l(B.bl.deep(body, no, ind, True{}), B.defs.deep(t), h), {==})
    case B.NImport{+txt, +no}:
      {==}
    case B.NDecl{+names, +no}:
      {==}
    case B.NBad{+txt, +no}:
      {==}
    case B.NErr{+msg, +no}:
      {==}
    case B.NBend{+lines, +no}:
      {==}

def dt_tail(n: B.Node, +t: List<&2, B.Node>, +h: {B.defs.deep(Con{n, t}) == True{} : Bool}) -> {B.defs.deep(t) == True{} : Bool}:
  match n:
    case B.NObj{+abs, +ext, +name, +parents, +kids, +no}:
      and_r(B.defs.deep(kids), B.defs.deep(t), h)
    case B.NDef{+share, +upd, +name, +rest, +params, +body, +no, +ind, +what}:
      and_r(B.bl.deep(body, no, ind, True{}), B.defs.deep(t), h)
    case B.NImport{+txt, +no}:
      h
    case B.NDecl{+names, +no}:
      h
    case B.NBad{+txt, +no}:
      h
    case B.NErr{+msg, +no}:
      h
    case B.NBend{+lines, +no}:
      h

def dt_rev(xs: List<&2, B.Node>, +acc: List<&2, B.Node>, +hx: {B.defs.deep(xs) == True{} : Bool}, +ha: {B.defs.deep(acc) == True{} : Bool}) ->
    {B.defs.deep(List.reverse.go(&2, B.Node, xs, acc)) == True{} : Bool}:
  match xs:
    case Nil{}:
      ha
    case Con{+n, +t}:
      dt_rev(t, Con{n, acc}, dt_tail(n, t, hx), dt_cons(n, acc, dt_head(n, t, hx), ha))

def dt_into(st: List<&2, B.Fr>, +n: B.Node, +hn: {B.defs.deep(Con{n, Nil{}}) == True{} : Bool}, +hs: {dt_frok(st) == True{} : Bool}) -> {dt_frok(B.close.into(st, n)) == True{} : Bool}:
  match st:
    case Nil{}:
      {==}
    case Con{f, +rest}:
      match f:
        case B.Fr{+top, +ind, +abs, +with, +ext, +name, +parents, +kids, +no}:
          and_intro(B.defs.deep(Con{n, kids}), dt_frok(rest), dt_cons(n, kids, hn, and_l(B.defs.deep(kids), dt_frok(rest), hs)), and_r(B.defs.deep(kids), dt_frok(rest), hs))

def dt_with(with: Bool, kids: List<&2, B.Node>, +name: List<&2, U32>, +no: B.Loc, +st: List<&2, B.Fr>, +hs: {dt_frok(st) == True{} : Bool}) ->
    {dt_frok(B.close.with(with, kids, name, no, st)) == True{} : Bool}:
  match with:
    case True{}:
      hs
    case False{}:
      match kids:
        case Nil{}:
          hs
        case Con{k, t}:
          dt_into(st, B.NErr{List.append(&2, U32, B.codes("object "), List.append(&2, U32, name, B.codes(" has members, so its header ends with `with`"))), no}, {==}, hs)

def dt_cgo(c: Bool, +k: Nat, +top: Bool, +ind: U32, +abs: Bool, +with: Bool, +ext: Bool, +name: List<&2, U32>, +parents: List<&2, List<&2, U32>>,
    +kids: List<&2, B.Node>, +no: B.Loc, +rest: List<&2, B.Fr>, +i: U32,
    ih: {dt_frok(B.close.go(k, B.close.into(B.close.with(with, kids, name, no, rest), B.NObj{abs, ext, name, parents, List.reverse(&2, B.Node, kids), no}), i)) == True{} : Bool},
    hs: {dt_frok(Con{B.Fr{top, ind, abs, with, ext, name, parents, kids, no}, rest}) == True{} : Bool}) ->
    {dt_frok(cgo(c, k, top, ind, abs, with, ext, name, parents, kids, no, rest, i)) == True{} : Bool}:
  match c:
    case True{}:
      ih
    case False{}:
      hs

def dt_close(n: Nat, st: List<&2, B.Fr>, +i: U32, +hs: {dt_frok(st) == True{} : Bool}) -> {dt_frok(B.close.go(n, st, i)) == True{} : Bool}:
  match n:
    case 0n:
      hs
    case 1n+(+k):
      match st:
        case Nil{}:
          {==}
        case Con{f, +rest}:
          match f:
            case B.Fr{+top, +ind, +abs, +with, +ext, +name, +parents, +kids, +no}:
              dt_cgo(Bool.and(Bool.not(top), U32.is_ge(ind, i)), k, top, ind, abs, with, ext, name, parents, kids, no, rest, i,
                dt_close(k, B.close.into(B.close.with(with, kids, name, no, rest), B.NObj{abs, ext, name, parents, List.reverse(&2, B.Node, kids), no}), i,
                  dt_into(B.close.with(with, kids, name, no, rest), B.NObj{abs, ext, name, parents, List.reverse(&2, B.Node, kids), no},
                    and_intro(B.defs.deep(List.reverse(&2, B.Node, kids)), True{}, dt_rev(kids, Nil{}, and_l(B.defs.deep(kids), dt_frok(rest), hs), {==}), {==}),
                    dt_with(with, kids, name, no, rest, and_r(B.defs.deep(kids), dt_frok(rest), hs)))),
                hs)

def dt_close_all(+st: List<&2, B.Fr>, +i: U32, +hs: {dt_frok(st) == True{} : Bool}) -> {dt_frok(B.close(st, i)) == True{} : Bool}:
  dt_close(List.length(&2, B.Fr, st), st, i, hs)

def dt_put(st: List<&2, B.Fr>, it: B.Item, +hi: {B.item.deep(it) == True{} : Bool}, +hs: {dt_frok(st) == True{} : Bool}) -> {dt_frok(B.tree.put(st, it)) == True{} : Bool}:
  match it:
    case B.IObj{+abs, +with, +ext, +name, +parents, +no, +ind}:
      hs
    case B.IDef{+share, +upd, +name, +rest, +params, +body, +no, +ind, +what}:
      dt_into(st, B.NDef{share, upd, name, rest, params, B.toks.lines(body), no, ind, what}, and_intro(B.bl.deep(B.toks.lines(body), no, ind, True{}), True{}, dt_lnbl(body, no, ind, True{}, hi), {==}), hs)
    case B.IImport{+txt, +no, +ind}:
      dt_into(st, B.NImport{txt, no}, {==}, hs)
    case B.IDecl{+names, +no, +ind}:
      dt_into(st, B.NDecl{names, no}, {==}, hs)
    case B.IBad{+txt, +no, +ind}:
      dt_into(st, B.NBad{txt, no}, {==}, hs)
    case B.IBend{+lines, +no, +ind}:
      dt_into(st, B.NBend{lines, no}, {==}, hs)

def dt_tree_go(its: List<&2, B.Item>, +st: List<&2, B.Fr>, +hi: {B.items.deep(its) == True{} : Bool}, +hs: {dt_frok(st) == True{} : Bool}) ->
    {dt_frok(B.tree.go(its, st)) == True{} : Bool}:
  match its:
    case Nil{}:
      dt_close_all(st, 0, hs)
    case Con{it, +t}:
      match it:
        case B.IImport{+txt, +no, +ind}:
          dt_tree_go(t, B.tree.put(B.close(st, ind), B.IImport{txt, no, ind}), and_r(B.item.deep(B.IImport{txt, no, ind}), B.items.deep(t), hi),
            dt_put(B.close(st, ind), B.IImport{txt, no, ind}, and_l(B.item.deep(B.IImport{txt, no, ind}), B.items.deep(t), hi), dt_close_all(st, ind, hs)))
        case B.IObj{+abs, +with, +ext, +name, +parents, +no, +ind}:
          dt_tree_go(t, B.tree.put(B.close(st, ind), B.IObj{abs, with, ext, name, parents, no, ind}), and_r(B.item.deep(B.IObj{abs, with, ext, name, parents, no, ind}), B.items.deep(t), hi),
            dt_put(B.close(st, ind), B.IObj{abs, with, ext, name, parents, no, ind}, and_l(B.item.deep(B.IObj{abs, with, ext, name, parents, no, ind}), B.items.deep(t), hi), dt_close_all(st, ind, hs)))
        case B.IDecl{+names, +no, +ind}:
          dt_tree_go(t, B.tree.put(B.close(st, ind), B.IDecl{names, no, ind}), and_r(B.item.deep(B.IDecl{names, no, ind}), B.items.deep(t), hi),
            dt_put(B.close(st, ind), B.IDecl{names, no, ind}, and_l(B.item.deep(B.IDecl{names, no, ind}), B.items.deep(t), hi), dt_close_all(st, ind, hs)))
        case B.IDef{+share, +upd, +name, +rest, +params, +body, +no, +ind, +what}:
          dt_tree_go(t, B.tree.put(B.close(st, ind), B.IDef{share, upd, name, rest, params, body, no, ind, what}), and_r(B.item.deep(B.IDef{share, upd, name, rest, params, body, no, ind, what}), B.items.deep(t), hi),
            dt_put(B.close(st, ind), B.IDef{share, upd, name, rest, params, body, no, ind, what}, and_l(B.item.deep(B.IDef{share, upd, name, rest, params, body, no, ind, what}), B.items.deep(t), hi), dt_close_all(st, ind, hs)))
        case B.IBad{+txt, +no, +ind}:
          dt_tree_go(t, B.tree.put(B.close(st, ind), B.IBad{txt, no, ind}), and_r(B.item.deep(B.IBad{txt, no, ind}), B.items.deep(t), hi),
            dt_put(B.close(st, ind), B.IBad{txt, no, ind}, and_l(B.item.deep(B.IBad{txt, no, ind}), B.items.deep(t), hi), dt_close_all(st, ind, hs)))
        case B.IBend{+lines, +no, +ind}:
          dt_tree_go(t, B.tree.put(B.close(st, ind), B.IBend{lines, no, ind}), and_r(B.item.deep(B.IBend{lines, no, ind}), B.items.deep(t), hi),
            dt_put(B.close(st, ind), B.IBend{lines, no, ind}, and_l(B.item.deep(B.IBend{lines, no, ind}), B.items.deep(t), hi), dt_close_all(st, ind, hs)))

def dt_fin(st: List<&2, B.Fr>, +hs: {dt_frok(st) == True{} : Bool}) -> {B.defs.deep(B.tree.fin(st)) == True{} : Bool}:
  match st:
    case Nil{}:
      {==}
    case Con{f, +rest}:
      match f:
        case B.Fr{+top, +ind, +abs, +with, +ext, +name, +parents, +kids, +no}:
          dt_rev(kids, Nil{}, and_l(B.defs.deep(kids), dt_frok(rest), hs), {==})

def Laws.deep.tree(its, h):
  dt_fin(B.tree.go(its, [B.Fr{True{}, 0, False{}, True{}, False{}, Nil{}, Nil{}, Nil{}, B.loc.top(0)}]), dt_tree_go(its, [B.Fr{True{}, 0, False{}, True{}, False{}, Nil{}, Nil{}, Nil{}, B.loc.top(0)}], h, {==}))

def Laws.deep.read(bs, base):
  Laws.deep.tree(B.flat(B.lines.at(bs, base)), Laws.deep.items(B.lines.at(bs, base)))

# Each unit's lines clear of a marker's place (`deep.units`), as
# `markers.units` numbers them: a unit's lines its definition's body's,
# line for line at the same depth, a blank one blank (`nos`, its `lk`),
# so as its body (`nos_deep`).

def dpu_imp(a: Bool, +b: Bool, h: {Bool.or(Bool.not(a), b) == True{} : Bool}, p: {a == True{} : Bool}) -> {b == True{} : Bool}:
  match a:
    case True{}:
      h
    case False{}:
      Empty.absurd({b == True{} : Bool}, MB.false_ne_true()(p))

def nos_deep(ls: List<&2, B.Rl>, bs: List<&2, B.Bl>, +no: B.Loc, +ind: U32, +first: Bool, +hn: {nos(ls, bs) == True{} : Bool}, +hb: {B.bl.deep(bs, no, ind, first) == True{} : Bool}) ->
    {B.rl.deep(ls, no, ind, first) == True{} : Bool}:
  match ls:
    case Nil{}:
      {==}
    case Con{l, +lt}:
      match l:
        case B.Rl{+n1, +i1, +t1}:
          match bs:
            case Nil{}:
              Empty.absurd({B.rl.deep(Con{B.Rl{n1, i1, t1}, lt}, no, ind, first) == True{} : Bool}, MB.false_ne_true()(hn))
            case Con{b, +bt}:
              match b:
                case B.Bl{+n2, +i2, +t2}:
                  %Equal.sym(B.Loc, n1, n2, loc_eq_eq(n1, n2, and_l(B.loc.eq(n1, n2), lk(B.Rl{n1, i1, t1}, B.Bl{n2, i2, t2}),
                      and_l(Bool.and(B.loc.eq(n1, n2), lk(B.Rl{n1, i1, t1}, B.Bl{n2, i2, t2})), nos(lt, bt), hn)))) :
                    {Bool.and(Bool.or(Bool.or(Bool.and(first, B.loc.eq(_, no)), B.rts.blank(t1)), U32.is_gt(i1, ind)), B.rl.deep(lt, no, ind, False{})) == True{} : Bool}
                  %Equal.sym(U32, i1, i2, u32_eq_of_is_eq(i1, i2, and_l(U32.is_eq(i1, i2), Bool.or(Bool.not(B.toks.blank(t2)), B.rts.blank(t1)),
                      and_r(B.loc.eq(n1, n2), lk(B.Rl{n1, i1, t1}, B.Bl{n2, i2, t2}), and_l(Bool.and(B.loc.eq(n1, n2), lk(B.Rl{n1, i1, t1}, B.Bl{n2, i2, t2})), nos(lt, bt), hn))))) :
                    {Bool.and(Bool.or(Bool.or(Bool.and(first, B.loc.eq(n2, no)), B.rts.blank(t1)), U32.is_gt(_, ind)), B.rl.deep(lt, no, ind, False{})) == True{} : Bool}
                  and_intro(Bool.or(Bool.or(Bool.and(first, B.loc.eq(n2, no)), B.rts.blank(t1)), U32.is_gt(i2, ind)), B.rl.deep(lt, no, ind, False{}),
                    dt_or(Bool.and(first, B.loc.eq(n2, no)), B.toks.blank(t2), B.rts.blank(t1), U32.is_gt(i2, ind),
                      and_l(Bool.or(Bool.or(Bool.and(first, B.loc.eq(n2, no)), B.toks.blank(t2)), U32.is_gt(i2, ind)), B.bl.deep(bt, no, ind, False{}), hb),
                      p => dpu_imp(B.toks.blank(t2), B.rts.blank(t1), and_r(U32.is_eq(i1, i2), Bool.or(Bool.not(B.toks.blank(t2)), B.rts.blank(t1)),
                        and_r(B.loc.eq(n1, n2), lk(B.Rl{n1, i1, t1}, B.Bl{n2, i2, t2}), and_l(Bool.and(B.loc.eq(n1, n2), lk(B.Rl{n1, i1, t1}, B.Bl{n2, i2, t2})), nos(lt, bt), hn))), p)),
                    nos_deep(lt, bt, no, ind, False{}, and_r(Bool.and(B.loc.eq(n1, n2), lk(B.Rl{n1, i1, t1}, B.Bl{n2, i2, t2})), nos(lt, bt), hn),
                      and_r(Bool.or(Bool.or(Bool.and(first, B.loc.eq(n2, no)), B.toks.blank(t2)), U32.is_gt(i2, ind)), B.bl.deep(bt, no, ind, False{}), hb)))

def nbdp(nd: B.Node) -> Bool:
  match nd:
    case B.NDef{+share, +upd, name, rest, params, +body, +no, +ind, +what}:
      B.bl.deep(body, no, ind, True{})
    case _:
      True{}

def dsdp(ds: List<&2, B.Node>) -> Bool:
  match ds:
    case Nil{}:
      True{}
    case Con{+d, t}:
      Bool.and(nbdp(d), dsdp(t))

def dsdp_app(a: List<&2, B.Node>, +b: List<&2, B.Node>, +ha: {dsdp(a) == True{} : Bool}, +hb: {dsdp(b) == True{} : Bool}) -> {dsdp(List.append(&2, B.Node, a, b)) == True{} : Bool}:
  match a:
    case Nil{}:
      hb
    case Con{+d, +t}:
      and_intro(nbdp(d), dsdp(List.append(&2, B.Node, t, b)), and_l(nbdp(d), dsdp(t), ha), dsdp_app(t, b, and_r(nbdp(d), dsdp(t), ha), hb))

def dsdp_tree(ns: List<&2, B.Node>, +h: {B.defs.deep(ns) == True{} : Bool}) -> {dsdp(B.tree.defs(ns)) == True{} : Bool}:
  match ns:
    case Nil{}:
      {==}
    case Con{nd, +t}:
      match nd:
        case B.NObj{+abs, +ext, +name, +parents, +kids, +no}:
          dsdp_app(B.tree.defs(kids), B.tree.defs(t), dsdp_tree(kids, and_l(B.defs.deep(kids), B.defs.deep(t), h)), dsdp_tree(t, and_r(B.defs.deep(kids), B.defs.deep(t), h)))
        case B.NDef{+share, +upd, +name, +rest, +params, +body, +no, +ind, +what}:
          and_intro(B.bl.deep(body, no, ind, True{}), dsdp(B.tree.defs(t)),
            and_l(B.bl.deep(body, no, ind, True{}), B.defs.deep(t), h),
            dsdp_tree(t, and_r(B.bl.deep(body, no, ind, True{}), B.defs.deep(t), h)))
        case B.NImport{+txt, +no}:
          dsdp_tree(t, h)
        case B.NDecl{+names, +no}:
          dsdp_tree(t, h)
        case B.NBad{+txt, +no}:
          dsdp_tree(t, h)
        case B.NErr{+msg, +no}:
          dsdp_tree(t, h)
        case B.NBend{+lines, +no}:
          dsdp_tree(t, h)

def dsdp_trees(ts: List<&2, List<&2, B.Node>>, +h: {B.trees.deep(ts) == True{} : Bool}) -> {dsdp(B.trees.defs(ts)) == True{} : Bool}:
  match ts:
    case Nil{}:
      {==}
    case Con{+tr, +t}:
      dsdp_app(B.tree.defs(tr), B.trees.defs(t), dsdp_tree(tr, and_l(B.defs.deep(tr), B.trees.deep(t), h)), dsdp_trees(t, and_r(B.defs.deep(tr), B.trees.deep(t), h)))

def same_dp(d: B.Node, nd: B.Node, +hs: {B.ndef.same(d, nd) == True{} : Bool}, +hd: {nbdp(d) == True{} : Bool}) -> {nbdp(nd) == True{} : Bool}:
  %Laws.nodes.same_eq(d, nd, hs) : {nbdp(_) == True{} : Bool}
  hd

def in_dp(ds: List<&2, B.Node>, +nd: B.Node, +hin: {B.def.in(ds, nd) == True{} : Bool}, +hd: {dsdp(ds) == True{} : Bool}) -> {nbdp(nd) == True{} : Bool}:
  match ds:
    case Nil{}:
      Empty.absurd({nbdp(nd) == True{} : Bool}, MB.false_ne_true()(hin))
    case Con{+d, +t}:
      or_cases(B.ndef.same(d, nd), B.def.in(t, nd), nbdp(nd), hin, p => same_dp(d, nd, p, and_l(nbdp(d), dsdp(t), hd)), q => in_dp(t, nd, q, and_r(nbdp(d), dsdp(t), hd)))

def unit_dp(u: B.Un, +ds: List<&2, B.Node>, +hh: {B.node.held(B.un.node(u), ds) == True{} : Bool}, +hd: {dsdp(ds) == True{} : Bool}, +hm: {um1(u) == True{} : Bool}) ->
    {B.un.deep(u) == True{} : Bool}:
  match u:
    case B.Un{+o, +i, nd, +hd2, +ls}:
      match nd:
        case B.NDef{+share, +upd, +name, +rest, +params, +body, +no, +ind, +what}:
          nos_deep(ls, body, no, ind, True{}, hm, in_dp(ds, B.NDef{share, upd, name, rest, params, body, no, ind, what}, hh, hd))
        case B.NImport{+txt, +no}:
          {==}
        case B.NDecl{+names, +no}:
          {==}
        case B.NBad{+txt, +no}:
          {==}
        case B.NErr{+msg, +no}:
          {==}
        case B.NBend{+lines, +no}:
          {==}
        case B.NObj{+abs, +ext, +name, +parents, +kids, +no}:
          {==}

def units_dp(us: List<&2, B.Un>, +ds: List<&2, B.Node>, +hh: {B.units.held(us, ds) == True{} : Bool}, +hd: {dsdp(ds) == True{} : Bool}, +hm: {um(us) == True{} : Bool}) ->
    {B.units.deep(us) == True{} : Bool}:
  match us:
    case Nil{}:
      {==}
    case Con{+u, +t}:
      and_intro(B.un.deep(u), B.units.deep(t),
        unit_dp(u, ds, and_l(B.node.held(B.un.node(u), ds), B.units.held(t, ds), hh), hd, and_l(um1(u), um(t), hm)),
        units_dp(t, ds, and_r(B.node.held(B.un.node(u), ds), B.units.held(t, ds), hh), hd, and_r(um1(u), um(t), hm)))

def Laws.deep.units(trees, als, ls, fs, als2, paths, pss, h):
  units_dp(B.units(B.module.copies(B.obs.made(B.syn.of(als, B.obs(trees))), B.cx.of(B.obs.made(B.syn.of(als, B.obs(trees))), ls, fs, als2, paths, pss))), B.trees.defs(trees), Laws.nodes(trees, als, ls, fs, als2, paths, pss), dsdp_trees(trees, h),
    units_m(B.module.copies(B.obs.made(B.syn.of(als, B.obs(trees))), B.cx.of(B.obs.made(B.syn.of(als, B.obs(trees))), ls, fs, als2, paths, pss)), mcopies_m(B.obs.made(B.syn.of(als, B.obs(trees))), B.cx.of(B.obs.made(B.syn.of(als, B.obs(trees))), ls, fs, als2, paths, pss))))

# The markers unambiguous at emission (`unambiguous.emitted`), as
# `markers.emitted`: a unit whose node is no definition has no lines
# (`units_e`), so every unit's lines are clear of a marker's place
# (`dlined`), the table's too (`units.positions`); with the context
# (`markers.inline`), the writer's law has its hypotheses.

# a unit's lines clear of a marker's place, its definition's
def dlined(+u: B.Un) -> Bool:
  B.rl.deep(B.un.lines(u), B.node.no(B.un.node(u)), B.node.ind(B.un.node(u)), True{})

def dlined_of(u: B.Un, +hk: {B.un.deep(u) == True{} : Bool}, +he: {une(u) == True{} : Bool}) -> {dlined(u) == True{} : Bool}:
  match u:
    case B.Un{+o, +i, nd, +hd, ls}:
      match nd:
        case B.NDef{+share, +upd, +name, +rest, +params, +body, +no, +ind, +what}:
          hk
        case B.NImport{+txt, +no}:
          match ls:
            case Nil{}:
              {==}
            case Con{+l, +t}:
              nope(dlined(B.Un{o, i, B.NImport{txt, no}, hd, Con{l, t}}), he)
        case B.NDecl{+names, +no}:
          match ls:
            case Nil{}:
              {==}
            case Con{+l, +t}:
              nope(dlined(B.Un{o, i, B.NDecl{names, no}, hd, Con{l, t}}), he)
        case B.NBad{+txt, +no}:
          match ls:
            case Nil{}:
              {==}
            case Con{+l, +t}:
              nope(dlined(B.Un{o, i, B.NBad{txt, no}, hd, Con{l, t}}), he)
        case B.NErr{+msg, +no}:
          match ls:
            case Nil{}:
              {==}
            case Con{+l, +t}:
              nope(dlined(B.Un{o, i, B.NErr{msg, no}, hd, Con{l, t}}), he)
        case B.NBend{+lines, +no}:
          match ls:
            case Nil{}:
              {==}
            case Con{+l, +t}:
              nope(dlined(B.Un{o, i, B.NBend{lines, no}, hd, Con{l, t}}), he)
        case B.NObj{+abs, +ext, +name, +parents, +kids, +no}:
          match ls:
            case Nil{}:
              {==}
            case Con{+l, +t}:
              nope(dlined(B.Un{o, i, B.NObj{abs, ext, name, parents, kids, no}, hd, Con{l, t}}), he)

def unsdl(us: List<&2, B.Un>) -> Bool:
  match us:
    case Nil{}:
      True{}
    case Con{+u, t}:
      Bool.and(dlined(u), unsdl(t))

def unsdl_of(us: List<&2, B.Un>, +hk: {B.units.deep(us) == True{} : Bool}, +he: {unse(us) == True{} : Bool}) -> {unsdl(us) == True{} : Bool}:
  match us:
    case Nil{}:
      {==}
    case Con{+u, +t}:
      and_intro(dlined(u), unsdl(t), dlined_of(u, and_l(B.un.deep(u), B.units.deep(t), hk), and_l(une(u), unse(t), he)),
        unsdl_of(t, and_r(B.un.deep(u), B.units.deep(t), hk), and_r(une(u), unse(t), he)))

def udol_k(c: Bool, +u: B.Un, +t: List<&2, B.Un>, +laws: Bool, +hu: {dlined(u) == True{} : Bool}, +ih: {unsdl(B.units.of(t, laws)) == True{} : Bool}) ->
    {unsdl(uok(c, u, t, laws)) == True{} : Bool}:
  match c:
    case True{}:
      and_intro(dlined(u), unsdl(B.units.of(t, laws)), hu, ih)
    case False{}:
      ih

def unsdl_filter(us: List<&2, B.Un>, +laws: Bool, +h: {unsdl(us) == True{} : Bool}) -> {unsdl(B.units.of(us, laws)) == True{} : Bool}:
  match us:
    case Nil{}:
      {==}
    case Con{+u, +t}:
      udol_k(Bool.not(Bool.xor(laws, U32.is_gt(B.node.what(B.un.node(u)), 0))), u, t, laws, and_l(dlined(u), unsdl(t), h), unsdl_filter(t, laws, and_r(dlined(u), unsdl(t), h)))

def dlined_get(us: List<&2, B.Un>, n: Nat, +h: {unsdl(us) == True{} : Bool}) -> {dlined(B.un.or(List.get(&2, B.Un, us, n))) == True{} : Bool}:
  match us:
    case Nil{}:
      {==}
    case Con{+u, +t}:
      match n:
        case 0n:
          and_l(dlined(u), unsdl(t), h)
        case 1n+k:
          dlined_get(t, k, and_r(dlined(u), unsdl(t), h))

# the unit the table finds: the list's, so clear
def dl_at(+us: List<&2, B.Un>, +s: U32, +h: {unsdl(us) == True{} : Bool}) -> {dlined(B.ut.un(B.pt.of(B.Un, us), s)) == True{} : Bool}:
  %Equal.sym(B.Un, B.ut.un(B.pt.of(B.Un, us), s), B.un.at(us, s), Laws.units.positions(us, s)) : {dlined(_) == True{} : Bool}
  dlined_get(us, U32.to_nat(s), h)

def Laws.unambiguous.emitted(files, trees, als, paths, us, res, mode, rtypes, ux, mt, laws, s, x, j, b, hf, ht, hd):
  Laws.markers.unambiguous(B.Ec{files, B.obs.made(B.syn.of(als, B.obs(trees))), us, als, B.emit.own(B.objects.cx(als, paths, B.obs(trees))), res, paths, mode, rtypes, ux, B.pt.of(B.Un, B.units.of(B.units(B.module.copies(B.obs.made(B.syn.of(als, B.obs(trees))), B.objects.cx(als, paths, B.obs(trees)))), laws)), mt}, s, x, j, b,
    Laws.markers.inline(files, trees, als, paths, us, res, mode, rtypes, ux, mt, laws, hf, ht),
    dl_at(B.units.of(B.units(B.module.copies(B.obs.made(B.syn.of(als, B.obs(trees))), B.objects.cx(als, paths, B.obs(trees)))), laws), s, unsdl_filter(B.units(B.module.copies(B.obs.made(B.syn.of(als, B.obs(trees))), B.objects.cx(als, paths, B.obs(trees)))), laws,
      unsdl_of(B.units(B.module.copies(B.obs.made(B.syn.of(als, B.obs(trees))), B.objects.cx(als, paths, B.obs(trees)))), Laws.deep.units(trees, als, B.sy.ls(B.syn.of(als, B.obs(trees))), B.folds(B.sy.ls(B.syn.of(als, B.obs(trees))), B.obs.made(B.syn.of(als, B.obs(trees))), B.chains.bad(B.obs.made(B.syn.of(als, B.obs(trees))), B.obs.made(B.syn.of(als, B.obs(trees))), B.sy.pss(B.syn.of(als, B.obs(trees))))), als, paths, B.sy.pss(B.syn.of(als, B.obs(trees))), hd), units_e(B.module.copies(B.obs.made(B.syn.of(als, B.obs(trees))), B.objects.cx(als, paths, B.obs(trees))), mcopies_e(B.obs.made(B.syn.of(als, B.obs(trees))), B.objects.cx(als, paths, B.obs(trees))))))))

# A linearization sound (`c3.lin`): the merge's soundness (`c3.sound`)
# over the lists without the empty ones, which drops none of what they
# keep (`lists_kept`)

def lists_kept(ss: List<&2, B.Sq>, +ys: List<&2, U32>, +hk: {B.sqs.kept(B.c3.lists(ss), ys) == True{} : Bool}) -> {B.sqs.kept(ss, ys) == True{} : Bool}:
  match ss:
    case Nil{}:
      {==}
    case Con{s, +t}:
      match s:
        case B.Sq{+o, xs}:
          match xs:
            case Nil{}:
              and_intro(B.subseq(ys, Nil{}), B.sqs.kept(t, ys), sub_nil(ys), lists_kept(t, ys, hk))
            case Con{+x, +r}:
              and_intro(B.subseq(ys, Con{x, r}), B.sqs.kept(t, ys), and_l(B.subseq(ys, Con{x, r}), B.sqs.kept(B.c3.lists(t), ys), hk),
                lists_kept(t, ys, and_r(B.subseq(ys, Con{x, r}), B.sqs.kept(B.c3.lists(t), ys), hk)))

def lin_mg_sound(+id: U32, m: B.Mg, +ss: List<&2, B.Sq>, +hs: {B.mg.sound(m, B.c3.lists(ss)) == True{} : Bool}) -> {B.lz.sound(B.lin.mg(id, m), id, ss) == True{} : Bool}:
  match m:
    case B.MOk{+ord}:
      and_intro(Bool.and(U32.is_eq(id, id), B.sqs.kept(ss, ord)), B.distinct(ord),
        and_intro(U32.is_eq(id, id), B.sqs.kept(ss, ord), u32_is_eq_refl(id),
          lists_kept(ss, ord, and_l(B.sqs.kept(B.c3.lists(ss), ord), B.distinct(ord), hs))),
        and_r(B.sqs.kept(B.c3.lists(ss), ord), B.distinct(ord), hs))
    case B.MFail{+seqs}:
      {==}

def Laws.c3.lin(id, ps, seqs):
  lin_mg_sound(id, B.c3.merge(1n+B.sqs.len(List.append(&2, B.Sq, seqs, [B.Sq{id, ps}])), B.c3.lists(List.append(&2, B.Sq, seqs, [B.Sq{id, ps}])), Nil{}), List.append(&2, B.Sq, seqs, [B.Sq{id, ps}]),
    Laws.c3.sound(1n+B.sqs.len(List.append(&2, B.Sq, seqs, [B.Sq{id, ps}])), B.c3.lists(List.append(&2, B.Sq, seqs, [B.Sq{id, ps}]))))

# The datatypes as where.sh reads them (`markers.datatypes`): text within
# a line goes to the current line (`dt_onto`), a newline starts the next;
# each line as read after a newline of its own (`dt_lines`), each
# datatype after its marker's line (`dt_text`); a line's first byte a
# space, where deeper or blank, or its header's `t` (`dt_dc`).

# nl.go's step mirrored
def dt_k(+c: Bool, +h: U32, +t: List<&2, U32>, +cur: List<&2, U32>) -> List<&2, List<&2, U32>>:
  B.when(List<&2, List<&2, U32>>, c, u => Con{List.reverse(&2, U32, cur), B.nl.go(t, Nil{})}, u => B.nl.go(t, Con{h, cur}))

def dt_kf(c: Bool, +h: U32, +t: List<&2, U32>, +cur: List<&2, U32>, hc: {c == False{} : Bool}) -> {dt_k(c, h, t, cur) == B.nl.go(t, Con{h, cur}) : List<&2, List<&2, U32>>}:
  match c:
    case True{}:
      Empty.absurd({dt_k(True{}, h, t, cur) == B.nl.go(t, Con{h, cur}) : List<&2, List<&2, U32>>}, MB.false_ne_true()(Equal.sym(Bool, True{}, False{}, hc)))
    case False{}:
      {==}

# text within a line: on the current line
def dt_onto(xs: List<&2, U32>, +ys: List<&2, U32>, +cur: List<&2, U32>, +hx: {B.inline(xs) == True{} : Bool}) ->
    {B.nl.go(List.append(&2, U32, xs, ys), cur) == B.nl.go(ys, B.rev.onto(xs, cur)) : List<&2, List<&2, U32>>}:
  match xs:
    case Nil{}:
      {==}
    case Con{+h, +t}:
      Equal.trans(List<&2, List<&2, U32>>, B.nl.go(Con{h, List.append(&2, U32, t, ys)}, cur), B.nl.go(List.append(&2, U32, t, ys), Con{h, cur}), B.nl.go(ys, B.rev.onto(t, Con{h, cur})),
        dt_kf(U32.is_eq(h, 10), h, List.append(&2, U32, t, ys), cur, ne10(h, t, hx)),
        dt_onto(t, ys, Con{h, cur}, il_tail(h, t, hx)))

def dt_ro(xs: List<&2, U32>, +acc: List<&2, U32>) -> {B.rev.onto(xs, acc) == List.reverse.go(&2, U32, xs, acc) : List<&2, U32>}:
  match xs:
    case Nil{}:
      {==}
    case Con{+h, +t}:
      dt_ro(t, Con{h, acc})

# a line gathered reversed, read back
def dt_back(+xs: List<&2, U32>) -> {List.reverse(&2, U32, B.rev.onto(xs, Nil{})) == xs : List<&2, U32>}:
  Equal.trans(List<&2, U32>, List.reverse(&2, U32, B.rev.onto(xs, Nil{})), List.reverse(&2, U32, List.reverse(&2, U32, xs)), xs,
    Equal.cong(List<&2, U32>, List<&2, U32>, ys => List.reverse(&2, U32, ys), B.rev.onto(xs, Nil{}), List.reverse(&2, U32, xs), dt_ro(xs, Nil{})),
    ML.reverse_reverse(&2, U32, xs))

def dt_back2(+s: List<&2, U32>, +t: List<&2, U32>) -> {List.reverse(&2, U32, B.rev.onto(t, B.rev.onto(s, Nil{}))) == List.append(&2, U32, s, t) : List<&2, U32>}:
  %onto_app(s, t, Nil{}) : {List.reverse(&2, U32, _) == List.append(&2, U32, s, t) : List<&2, U32>}
  dt_back(List.append(&2, U32, s, t))

# a line after its newline: its depth's spaces and its text, then the rest
def dt_inner(+s: List<&2, U32>, +txt: List<&2, U32>, +bl: List<&2, U32>, +c: List<&2, U32>, +rest: List<&2, List<&2, U32>>, +hs: {B.inline(s) == True{} : Bool}, +ht: {B.inline(txt) == True{} : Bool},
    ih: {B.nl.go(List.append(&2, U32, bl, c), B.rev.onto(txt, B.rev.onto(s, Nil{}))) == Con{List.reverse(&2, U32, B.rev.onto(txt, B.rev.onto(s, Nil{}))), rest} : List<&2, List<&2, U32>>}) ->
    {B.nl.go(List.append(&2, U32, List.append(&2, U32, s, List.append(&2, U32, txt, bl)), c), Nil{}) == Con{List.append(&2, U32, s, txt), rest} : List<&2, List<&2, U32>>}:
  %Equal.sym(List<&2, U32>, List.append(&2, U32, List.append(&2, U32, s, List.append(&2, U32, txt, bl)), c), List.append(&2, U32, s, List.append(&2, U32, List.append(&2, U32, txt, bl), c)),
      ML.append_assoc(&2, U32, s, List.append(&2, U32, txt, bl), c)) : {B.nl.go(_, Nil{}) == Con{List.append(&2, U32, s, txt), rest} : List<&2, List<&2, U32>>}
  %Equal.sym(List<&2, U32>, List.append(&2, U32, List.append(&2, U32, txt, bl), c), List.append(&2, U32, txt, List.append(&2, U32, bl, c)), ML.append_assoc(&2, U32, txt, bl, c)) :
    {B.nl.go(List.append(&2, U32, s, _), Nil{}) == Con{List.append(&2, U32, s, txt), rest} : List<&2, List<&2, U32>>}
  %Equal.sym(List<&2, List<&2, U32>>, B.nl.go(List.append(&2, U32, s, List.append(&2, U32, txt, List.append(&2, U32, bl, c))), Nil{}), B.nl.go(List.append(&2, U32, txt, List.append(&2, U32, bl, c)), B.rev.onto(s, Nil{})),
      dt_onto(s, List.append(&2, U32, txt, List.append(&2, U32, bl, c)), Nil{}, hs)) : {_ == Con{List.append(&2, U32, s, txt), rest} : List<&2, List<&2, U32>>}
  %Equal.sym(List<&2, List<&2, U32>>, B.nl.go(List.append(&2, U32, txt, List.append(&2, U32, bl, c)), B.rev.onto(s, Nil{})), B.nl.go(List.append(&2, U32, bl, c), B.rev.onto(txt, B.rev.onto(s, Nil{}))),
      dt_onto(txt, List.append(&2, U32, bl, c), B.rev.onto(s, Nil{}), ht)) : {_ == Con{List.append(&2, U32, s, txt), rest} : List<&2, List<&2, U32>>}
  %Equal.sym(List<&2, List<&2, U32>>, B.nl.go(List.append(&2, U32, bl, c), B.rev.onto(txt, B.rev.onto(s, Nil{}))), Con{List.reverse(&2, U32, B.rev.onto(txt, B.rev.onto(s, Nil{}))), rest}, ih) :
    {_ == Con{List.append(&2, U32, s, txt), rest} : List<&2, List<&2, U32>>}
  %Equal.sym(List<&2, U32>, List.reverse(&2, U32, B.rev.onto(txt, B.rev.onto(s, Nil{}))), List.append(&2, U32, s, txt), dt_back2(s, txt)) :
    {Con{_, rest} == Con{List.append(&2, U32, s, txt), rest} : List<&2, List<&2, U32>>}
  {==}

# a datatype's lines, each after a newline of its own, then the rest
def dt_lines(ls: List<&2, B.Ln>, +cur: List<&2, U32>, +r: List<&2, U32>, +hl: {B.lns.inline(ls) == True{} : Bool}) ->
    {B.nl.go(List.append(&2, U32, B.bend.lines(ls), Con{10, r}), cur) == Con{List.reverse(&2, U32, cur), List.append(&2, List<&2, U32>, B.lns.out(ls), B.nl.go(r, Nil{}))} : List<&2, List<&2, U32>>}:
  match ls:
    case Nil{}:
      {==}
    case Con{l, +lt}:
      match l:
        case B.Ln{+n, +i, +txt}:
          Equal.cong(List<&2, List<&2, U32>>, List<&2, List<&2, U32>>, z => Con{List.reverse(&2, U32, cur), z},
            B.nl.go(List.append(&2, U32, List.append(&2, U32, B.spaces(U32.to_nat(i)), List.append(&2, U32, txt, B.bend.lines(lt))), Con{10, r}), Nil{}),
            Con{List.append(&2, U32, B.spaces(U32.to_nat(i)), txt), List.append(&2, List<&2, U32>, B.lns.out(lt), B.nl.go(r, Nil{}))},
            dt_inner(B.spaces(U32.to_nat(i)), txt, B.bend.lines(lt), Con{10, r}, List.append(&2, List<&2, U32>, B.lns.out(lt), B.nl.go(r, Nil{})), il_spaces(U32.to_nat(i)),
              and_l(B.inline(txt), B.lns.inline(lt), hl),
              dt_lines(lt, B.rev.onto(txt, B.rev.onto(B.spaces(U32.to_nat(i)), Nil{})), r, and_r(B.inline(txt), B.lns.inline(lt), hl))))

# a datatype's lines within a line, its own conjuncts taken apart
def bo_il(ls: List<&2, B.Ln>, +no: B.Loc, +h: {B.bend.ok(ls, no) == True{} : Bool}) -> {B.lns.inline(ls) == True{} : Bool}:
  match ls:
    case Nil{}:
      {==}
    case Con{l, +t}:
      match l:
        case B.Ln{+n, +i, +txt}:
          and_intro(B.inline(txt), B.lns.inline(t), and_r(Bool.and(B.loc.eq(n, no), B.is.datatype(txt)), B.inline(txt), and_l(Bool.and(Bool.and(B.loc.eq(n, no), B.is.datatype(txt)), B.inline(txt)), B.ln.from(t, B.loc.next(no)), and_l(Bool.and(Bool.and(Bool.and(B.loc.eq(n, no), B.is.datatype(txt)), B.inline(txt)), B.ln.from(t, B.loc.next(no))), B.ln.deep(t, no, i, False{}), and_l(Bool.and(Bool.and(Bool.and(Bool.and(B.loc.eq(n, no), B.is.datatype(txt)), B.inline(txt)), B.ln.from(t, B.loc.next(no))), B.ln.deep(t, no, i, False{})), B.lns.inline(t), h)))), and_r(Bool.and(Bool.and(Bool.and(Bool.and(B.loc.eq(n, no), B.is.datatype(txt)), B.inline(txt)), B.ln.from(t, B.loc.next(no))), B.ln.deep(t, no, i, False{})), B.lns.inline(t), h))

def dt_mk(+ml: List<&2, U32>, +y: List<&2, U32>, +lines: List<&2, B.Ln>, +dt: List<&2, U32>, +rest: List<&2, List<&2, U32>>, +hm: {B.inline(ml) == True{} : Bool},
    +hl: {B.lns.inline(lines) == True{} : Bool}, ih: {B.nl.go(dt, Nil{}) == Con{Nil{}, rest} : List<&2, List<&2, U32>>}) ->
    {B.nl.go(List.append(&2, U32, ml, List.append(&2, U32, B.bend.lines(lines), Con{10, dt})), Nil{}) == Con{ml, List.append(&2, List<&2, U32>, B.lns.out(lines), Con{Nil{}, rest})} : List<&2, List<&2, U32>>}:
  %Equal.sym(List<&2, List<&2, U32>>, B.nl.go(List.append(&2, U32, ml, List.append(&2, U32, B.bend.lines(lines), Con{10, dt})), Nil{}), B.nl.go(List.append(&2, U32, B.bend.lines(lines), Con{10, dt}), B.rev.onto(ml, Nil{})),
      dt_onto(ml, List.append(&2, U32, B.bend.lines(lines), Con{10, dt}), Nil{}, hm)) : {_ == Con{ml, List.append(&2, List<&2, U32>, B.lns.out(lines), Con{Nil{}, rest})} : List<&2, List<&2, U32>>}
  %Equal.sym(List<&2, List<&2, U32>>, B.nl.go(List.append(&2, U32, B.bend.lines(lines), Con{10, dt}), B.rev.onto(ml, Nil{})),
      Con{List.reverse(&2, U32, B.rev.onto(ml, Nil{})), List.append(&2, List<&2, U32>, B.lns.out(lines), B.nl.go(dt, Nil{}))}, dt_lines(lines, B.rev.onto(ml, Nil{}), dt, hl)) :
    {_ == Con{ml, List.append(&2, List<&2, U32>, B.lns.out(lines), Con{Nil{}, rest})} : List<&2, List<&2, U32>>}
  %Equal.sym(List<&2, List<&2, U32>>, B.nl.go(dt, Nil{}), Con{Nil{}, rest}, ih) : {Con{List.reverse(&2, U32, B.rev.onto(ml, Nil{})), List.append(&2, List<&2, U32>, B.lns.out(lines), _)} == Con{ml, List.append(&2, List<&2, U32>, B.lns.out(lines), Con{Nil{}, rest})} : List<&2, List<&2, U32>>}
  %Equal.sym(List<&2, U32>, List.reverse(&2, U32, B.rev.onto(ml, Nil{})), ml, dt_back(ml)) : {Con{_, List.append(&2, List<&2, U32>, B.lns.out(lines), Con{Nil{}, rest})} == Con{ml, List.append(&2, List<&2, U32>, B.lns.out(lines), Con{Nil{}, rest})} : List<&2, List<&2, U32>>}
  {==}

# the datatypes' text, each after its marker's line
def dt_text(ns: List<&2, B.Node>, +files: List<&2, List<&2, U32>>, +cur: List<&2, U32>, +hf: {B.inlines(files) == True{} : Bool}, +hb: {B.nodes.bend(ns) == True{} : Bool}) ->
    {B.nl.go(B.datatypes(ns, files), cur) == Con{List.reverse(&2, U32, cur), B.dts.lines(ns, files)} : List<&2, List<&2, U32>>}:
  match ns:
    case Nil{}:
      {==}
    case Con{nd, +t}:
      match nd:
        case B.NBend{+lines, +no}:
          Equal.cong(List<&2, List<&2, U32>>, List<&2, List<&2, U32>>, z => Con{List.reverse(&2, U32, cur), z},
            B.nl.go(List.append(&2, U32, B.marker.line(files, no), List.append(&2, U32, B.bend.lines(lines), Con{10, B.datatypes(t, files)})), Nil{}),
            Con{B.marker.line(files, no), List.append(&2, List<&2, U32>, B.lns.out(lines), Con{Nil{}, B.dts.lines(t, files)})},
            dt_mk(B.marker.line(files, no), List.append(&2, U32, B.bend.lines(lines), Con{10, B.datatypes(t, files)}), lines, B.datatypes(t, files), B.dts.lines(t, files),
              il_marker(files, no, hf), bo_il(lines, no, and_l(B.bend.ok(lines, no), B.nodes.bend(t), hb)),
              dt_text(t, files, Nil{}, hf, and_r(B.bend.ok(lines, no), B.nodes.bend(t), hb))))
        case B.NObj{+abs, +ext, +name, +parents, +kids, +no}:
          dt_text(t, files, cur, hf, and_r(B.nodes.bend(kids), B.nodes.bend(t), hb))
        case B.NImport{+txt, +no}:
          dt_text(t, files, cur, hf, hb)
        case B.NDecl{+names, +no}:
          dt_text(t, files, cur, hf, hb)
        case B.NDef{+share, +upd, +name, +rest, +params, +body, +no, +ind, +what}:
          dt_text(t, files, cur, hf, hb)
        case B.NBad{+txt, +no}:
          dt_text(t, files, cur, hf, hb)
        case B.NErr{+msg, +no}:
          dt_text(t, files, cur, hf, hb)

def dt_lsr(xss: List<&2, List<&2, U32>>) -> {B.lines.same(xss, xss) == True{} : Bool}:
  match xss:
    case Nil{}:
      {==}
    case Con{+x, +t}:
      and_intro(B.same(x, x), B.lines.same(t, t), Laws.names.same_refl(x), dt_lsr(t))

def dt_same(+ns: List<&2, B.Node>, +files: List<&2, List<&2, U32>>, +hf: {B.inlines(files) == True{} : Bool}, +hb: {B.nodes.bend(ns) == True{} : Bool}) ->
    {B.lines.same(B.nl.split(B.datatypes(ns, files)), Con{Nil{}, B.dts.lines(ns, files)}) == True{} : Bool}:
  %Equal.sym(List<&2, List<&2, U32>>, B.nl.go(B.datatypes(ns, files), Nil{}), Con{Nil{}, B.dts.lines(ns, files)}, dt_text(ns, files, Nil{}, hf, hb)) :
    {B.lines.same(_, Con{Nil{}, B.dts.lines(ns, files)}) == True{} : Bool}
  dt_lsr(Con{Nil{}, B.dts.lines(ns, files)})

# Each line's first byte no `#`

# a datatype's header starts `type `
def dt_hnot(c: Bool, +xs: List<&2, U32>, +p: List<&2, U32>, h: {B.holds.not(c, xs, p) == True{} : Bool}) -> {c == True{} : Bool}:
  match c:
    case True{}:
      {==}
    case False{}:
      Empty.absurd({False{} == True{} : Bool}, MB.false_ne_true()(h))

def dt_hc(m: Nat, txt: List<&2, U32>, hd: {B.is.datatype(txt) == True{} : Bool}) -> {B.text.clear(List.append(&2, U32, B.spaces(m), txt)) == True{} : Bool}:
  match m:
    case 0n:
      match txt:
        case Nil{}:
          {==}
        case Con{+h, +r}:
          %Equal.sym(U32, h, 116, u32_eq_of_is_eq(h, 116, and_l(U32.is_eq(h, 116), B.starts.s(r, "ype "),
              dt_hnot(B.starts.s(Con{h, r}, "type "), Con{h, r}, B.codes(" = "), hd)))) :
            {B.text.clear(Con{_, r}) == True{} : Bool}
          {==}
    case 1n+k:
      {==}

def dt_blank_c(m: Nat, txt: List<&2, U32>, h: {B.blank(txt) == True{} : Bool}) -> {B.text.clear(List.append(&2, U32, B.spaces(m), txt)) == True{} : Bool}:
  match m:
    case 0n:
      match txt:
        case Nil{}:
          {==}
        case Con{c, r}:
          Empty.absurd({B.text.clear(List.append(&2, U32, B.spaces(0n), Con{c, r})) == True{} : Bool}, MB.false_ne_true()(h))
    case 1n+k:
      {==}

def dt_gt_c(m: Nat, +txt: List<&2, U32>, i0: Nat, h: {Nat.is_gt(m, i0) == True{} : Bool}) -> {B.text.clear(List.append(&2, U32, B.spaces(m), txt)) == True{} : Bool}:
  match m i0:
    case 0n 0n:
      Empty.absurd({B.text.clear(List.append(&2, U32, B.spaces(0n), txt)) == True{} : Bool}, MB.false_ne_true()(h))
    case 0n 1n+j:
      Empty.absurd({B.text.clear(List.append(&2, U32, B.spaces(0n), txt)) == True{} : Bool}, MB.false_ne_true()(h))
    case 1n+k _:
      {==}

# a datatype's body lines: blank or deeper than its header, so a space
# first or empty
def dt_body(ls: List<&2, B.Ln>, +no: B.Loc, +i: U32, +hd: {B.ln.deep(ls, no, i, False{}) == True{} : Bool}) -> {B.lns.clear(ls) == True{} : Bool}:
  match ls:
    case Nil{}:
      {==}
    case Con{l, +t}:
      match l:
        case B.Ln{+n2, +i2, +txt2}:
          and_intro(B.text.clear(List.append(&2, U32, B.spaces(U32.to_nat(i2)), txt2)), B.lns.clear(t),
            or_cases(B.blank(txt2), U32.is_gt(i2, i), B.text.clear(List.append(&2, U32, B.spaces(U32.to_nat(i2)), txt2)),
              and_l(Bool.or(B.blank(txt2), U32.is_gt(i2, i)), B.ln.deep(t, no, i, False{}), hd),
              p => dt_blank_c(U32.to_nat(i2), txt2, p),
              q => dt_gt_c(U32.to_nat(i2), txt2, U32.to_nat(i),
                Equal.trans(Bool, Nat.is_gt(U32.to_nat(i2), U32.to_nat(i)), U32.is_gt(i2, i), True{}, Equal.sym(Bool, U32.is_gt(i2, i), Nat.is_gt(U32.to_nat(i2), U32.to_nat(i)), MU.u32_is_gt_to_nat(i2, i)), q))),
            dt_body(t, no, i, and_r(Bool.or(B.blank(txt2), U32.is_gt(i2, i)), B.ln.deep(t, no, i, False{}), hd)))

def dt_lc(ls: List<&2, B.Ln>, +no: B.Loc, +h: {B.bend.ok(ls, no) == True{} : Bool}) -> {B.lns.clear(ls) == True{} : Bool}:
  match ls:
    case Nil{}:
      {==}
    case Con{l, +t}:
      match l:
        case B.Ln{+n, +i, +txt}:
          and_intro(B.text.clear(List.append(&2, U32, B.spaces(U32.to_nat(i)), txt)), B.lns.clear(t),
            dt_hc(U32.to_nat(i), txt, and_r(B.loc.eq(n, no), B.is.datatype(txt), and_l(Bool.and(B.loc.eq(n, no), B.is.datatype(txt)), B.inline(txt), and_l(Bool.and(Bool.and(B.loc.eq(n, no), B.is.datatype(txt)), B.inline(txt)), B.ln.from(t, B.loc.next(no)), and_l(Bool.and(Bool.and(Bool.and(B.loc.eq(n, no), B.is.datatype(txt)), B.inline(txt)), B.ln.from(t, B.loc.next(no))), B.ln.deep(t, no, i, False{}), and_l(Bool.and(Bool.and(Bool.and(Bool.and(B.loc.eq(n, no), B.is.datatype(txt)), B.inline(txt)), B.ln.from(t, B.loc.next(no))), B.ln.deep(t, no, i, False{})), B.lns.inline(t), h)))))),
            dt_body(t, no, i, and_r(Bool.and(Bool.and(Bool.and(B.loc.eq(n, no), B.is.datatype(txt)), B.inline(txt)), B.ln.from(t, B.loc.next(no))), B.ln.deep(t, no, i, False{}), and_l(Bool.and(Bool.and(Bool.and(Bool.and(B.loc.eq(n, no), B.is.datatype(txt)), B.inline(txt)), B.ln.from(t, B.loc.next(no))), B.ln.deep(t, no, i, False{})), B.lns.inline(t), h))))

def dt_dc(ns: List<&2, B.Node>, +hb: {B.nodes.bend(ns) == True{} : Bool}) -> {B.dts.clear(ns) == True{} : Bool}:
  match ns:
    case Nil{}:
      {==}
    case Con{nd, +t}:
      match nd:
        case B.NBend{+lines, +no}:
          and_intro(B.lns.clear(lines), B.dts.clear(t), dt_lc(lines, no, and_l(B.bend.ok(lines, no), B.nodes.bend(t), hb)), dt_dc(t, and_r(B.bend.ok(lines, no), B.nodes.bend(t), hb)))
        case B.NObj{+abs, +ext, +name, +parents, +kids, +no}:
          dt_dc(t, and_r(B.nodes.bend(kids), B.nodes.bend(t), hb))
        case B.NImport{+txt, +no}:
          dt_dc(t, hb)
        case B.NDecl{+names, +no}:
          dt_dc(t, hb)
        case B.NDef{+share, +upd, +name, +rest, +params, +body, +no, +ind, +what}:
          dt_dc(t, hb)
        case B.NBad{+txt, +no}:
          dt_dc(t, hb)
        case B.NErr{+msg, +no}:
          dt_dc(t, hb)

def Laws.markers.datatypes(ns, files, hf, hb):
  and_intro(B.lines.same(B.nl.split(B.datatypes(ns, files)), Con{Nil{}, B.dts.lines(ns, files)}), B.dts.clear(ns), dt_same(ns, files, hf, hb), dt_dc(ns, hb))

# Every datatype read as where.sh reads it (`bends.items`): its header's
# line, then the lines after it while deeper or blank, numbered on from it
# (`trim_ok`, `bg_fst`), clear (`dp_trim`, `dp_bg`) and within a line
# (`btrim_il`, `bg_il`), made an item by flat.block's first choice
# (`bi_fb`); no other item maker makes one (the twins of `markers.items`'
# lemmas).

def bi_rev(xs: List<&2, B.Item>, +acc: List<&2, B.Item>, +hx: {B.items.bend(xs) == True{} : Bool}, +ha: {B.items.bend(acc) == True{} : Bool}) ->
    {B.items.bend(List.reverse.go(&2, B.Item, xs, acc)) == True{} : Bool}:
  match xs:
    case Nil{}:
      ha
    case Con{+it, +t}:
      bi_rev(t, Con{it, acc}, and_r(B.item.bend(it), B.items.bend(t), hx),
        and_intro(B.item.bend(it), B.items.bend(acc), and_l(B.item.bend(it), B.items.bend(t), hx), ha))


def bi_lm(c: Bool, +name: List<&2, U32>, +txt: List<&2, U32>, +body: List<&2, B.Ln>, +no: B.Loc, +ind: U32, +hb: {B.ln.from(body, B.loc.next(no)) == True{} : Bool}) ->
    {B.item.bend(lm_k(c, name, txt, body, no, ind)) == True{} : Bool}:
  match c:
    case True{}:
      {==}
    case False{}:
      {==}

def bi_law(p: List<&2, U32> & List<&2, U32>, +txt: List<&2, U32>, +body: List<&2, B.Ln>, +no: B.Loc, +ind: U32, +hb: {B.ln.from(body, B.loc.next(no)) == True{} : Bool}) ->
    {B.item.bend(B.law.r(p, txt, body, no, ind)) == True{} : Bool}:
  match p:
    case (+name, +rest):
      bi_lm(Bool.and(B.name.ok(B.trim(name)), B.blank(B.trim(rest))), B.trim(name), txt, body, no, ind, hb)

def bi_pr(c1: Bool, c2: Bool, +upd: Bool, +name: List<&2, U32>, +rest: List<&2, U32>, +txt: List<&2, U32>, +body: List<&2, B.Ln>, +no: B.Loc, +ind: U32,
    +hb: {B.ln.from(body, B.loc.next(no)) == True{} : Bool}) -> {B.item.bend(pr_k(c1, c2, upd, name, rest, txt, body, no, ind)) == True{} : Bool}:
  match c1 c2:
    case True{} True{}:
      {==}
    case True{} False{}:
      {==}
    case False{} _:
      {==}

def bi_proofr(p: List<&2, U32> & List<&2, U32>, +upd: Bool, +lemma: Bool, +txt: List<&2, U32>, +body: List<&2, B.Ln>, +no: B.Loc, +ind: U32,
    +hb: {B.ln.from(body, B.loc.next(no)) == True{} : Bool}) -> {B.item.bend(B.proof.r(p, upd, lemma, txt, body, no, ind)) == True{} : Bool}:
  match p:
    case (+name, +rest):
      bi_pr(Bool.and(Bool.and(B.name.ok(B.trim(name)), Bool.not(B.blank(rest))), Bool.not(Bool.xor(lemma, B.holds(rest, B.codes(") ->"))))), lemma, upd, name, rest, txt, body, no, ind, hb)

def bi_proof(+txt: List<&2, U32>, upd: Bool, +body: List<&2, B.Ln>, +no: B.Loc, +ind: U32, +hb: {B.ln.from(body, B.loc.next(no)) == True{} : Bool}) ->
    {B.item.bend(B.proof.item(txt, upd, body, no, ind)) == True{} : Bool}:
  match upd:
    case True{}:
      bi_proofr(B.until(B.drop(10n, txt), 40), True{}, B.is.lemma(txt), txt, body, no, ind, hb)
    case False{}:
      bi_proofr(B.until(B.drop(6n, txt), 40), False{}, B.is.lemma(txt), txt, body, no, ind, hb)

def bi_named(ok: Bool, +name: List<&2, U32>, +rest: List<&2, U32>, +xs: List<&2, U32>, +share: U32, +upd: Bool, +body: List<&2, B.Ln>, +no: B.Loc, +ind: U32,
    +hb: {B.ln.from(body, B.loc.next(no)) == True{} : Bool}) -> {B.item.bend(B.def.named(ok, name, rest, xs, share, upd, body, no, ind)) == True{} : Bool}:
  match ok:
    case True{}:
      {==}
    case False{}:
      {==}

def bi_dr(p: List<&2, U32> & List<&2, U32>, +xs: List<&2, U32>, +share: U32, +upd: Bool, +body: List<&2, B.Ln>, +no: B.Loc, +ind: U32,
    +hb: {B.ln.from(body, B.loc.next(no)) == True{} : Bool}) -> {B.item.bend(B.def.r(p, xs, share, upd, body, no, ind)) == True{} : Bool}:
  match p:
    case (+name, +rest):
      bi_named(Bool.and(B.name.ok(B.trim(name)), Bool.not(B.blank(rest))), B.trim(name), rest, xs, share, upd, body, no, ind, hb)

def bi_kwd(d: Bool, u: Bool, +xs: List<&2, U32>, +share: U32, +body: List<&2, B.Ln>, +no: B.Loc, +ind: U32, +hb: {B.ln.from(body, B.loc.next(no)) == True{} : Bool}) ->
    {B.item.bend(B.def.kw.d(d, u, xs, share, body, no, ind)) == True{} : Bool}:
  match d u:
    case True{} _:
      bi_dr(B.until(B.drop(4n, xs), 40), B.drop(4n, xs), share, False{}, body, no, ind, hb)
    case False{} True{}:
      bi_dr(B.until(B.upd.def(B.drop(4n, xs)), 40), B.upd.def(B.drop(4n, xs)), share, True{}, body, no, ind, hb)
    case False{} False{}:
      {==}

def bi_shs(s: Bool, c: Bool, +xs: List<&2, U32>, +body: List<&2, B.Ln>, +no: B.Loc, +ind: U32, +hb: {B.ln.from(body, B.loc.next(no)) == True{} : Bool}) ->
    {B.item.bend(B.def.share.s(s, c, xs, body, no, ind)) == True{} : Bool}:
  match s c:
    case True{} _:
      bi_kwd(B.starts.s(B.drop(7n, xs), "def "), B.starts.s(B.drop(7n, xs), "upd "), B.drop(7n, xs), 1, body, no, ind, hb)
    case False{} True{}:
      bi_kwd(B.starts.s(B.drop(7n, xs), "def "), B.starts.s(B.drop(7n, xs), "upd "), B.drop(7n, xs), 2, body, no, ind, hb)
    case False{} False{}:
      bi_kwd(B.starts.s(xs, "def "), B.starts.s(xs, "upd "), xs, 0, body, no, ind, hb)

def bi_onamed(ok: Bool, +with: Bool, +ext: Bool, +name: List<&2, U32>, +ps: List<&2, List<&2, U32>>, +xs: List<&2, U32>, +abs: Bool, +no: B.Loc, +ind: U32) ->
    {B.item.bend(B.obj.named(ok, with, ext, name, ps, xs, abs, no, ind)) == True{} : Bool}:
  match ok:
    case True{}:
      {==}
    case False{}:
      {==}

def bi_oe(p: List<&2, U32> & List<&2, U32>, +xs: List<&2, U32>, +abs: Bool, +ext: Bool, +no: B.Loc, +ind: U32) -> {B.item.bend(B.obj.ext(p, xs, abs, ext, no, ind)) == True{} : Bool}:
  match p:
    case (+name, +rest):
      bi_onamed(Bool.and(B.name.ok(name), Bool.or(Bool.or(B.blank(B.rtrim(rest)), B.same(B.rtrim(rest), B.codes("with"))),
          Bool.and(B.starts.s(B.rtrim(rest), "extends "), B.names.ok(B.obj.parents(B.rtrim(rest)))))),
        Bool.or(B.same(B.rtrim(rest), B.codes("with")), B.starts.s(List.reverse(&2, U32, B.rtrim(rest)), "htiw ")), ext,
        name, B.obj.parents(B.rtrim(rest)), xs, abs, no, ind)

def bi_obj(+xs: List<&2, U32>, +line: List<&2, U32>, +abs: Bool, +ext: Bool, +no: B.Loc, +ind: U32) -> {B.item.bend(B.obj.item(xs, line, abs, ext, no, ind)) == True{} : Bool}:
  bi_oe(B.until(xs, 32), line, abs, ext, no, ind)

def bi_dnamed(ok: Bool, +ns: List<&2, List<&2, U32>>, +line: List<&2, U32>, +no: B.Loc, +ind: U32) -> {B.item.bend(B.decl.named(ok, ns, line, no, ind)) == True{} : Bool}:
  match ok:
    case True{}:
      {==}
    case False{}:
      {==}

def bi_ditem(+ns: List<&2, List<&2, U32>>, +line: List<&2, U32>, +no: B.Loc, +ind: U32) -> {B.item.bend(B.decl.item(ns, line, no, ind)) == True{} : Bool}:
  bi_dnamed(Bool.and(B.decl.some(ns), B.names.ok(ns)), ns, line, no, ind)

def bi_dw(c: Bool, +name: List<&2, U32>, +ps: List<&2, U32>, +ret: List<&2, U32>, +txt: List<&2, U32>, +no: B.Loc, +ind: U32, +out: List<&2, B.Item>,
    +ho: {B.items.bend(out) == True{} : Bool}) -> {B.items.bend(dwk(c, name, ps, ret, txt, no, ind, out)) == True{} : Bool}:
  match c:
    case True{}:
      ho
    case False{}:
      ho

def bi_witness(+name: List<&2, U32>, +ps: List<&2, U32>, +ret: List<&2, U32>, +txt: List<&2, U32>, +no: B.Loc, +ind: U32, +out: List<&2, B.Item>,
    +ho: {B.items.bend(out) == True{} : Bool}) -> {B.items.bend(B.decl.witness(name, ps, ret, txt, no, ind, out)) == True{} : Bool}:
  bi_dw(Bool.and(B.name.ok(name), Bool.not(B.blank(ret))), name, ps, ret, txt, no, ind, out, ho)

def bi_dtk(c: Bool, +name: List<&2, U32>, +after: List<&2, U32>, +txt: List<&2, U32>, +no: B.Loc, +ind: U32, +out: List<&2, B.Item>,
    +ho: {B.items.bend(out) == True{} : Bool}) -> {B.items.bend(dtk(c, name, after, txt, no, ind, out)) == True{} : Bool}:
  match c:
    case True{}:
      bi_witness(name, B.parens(List.tail(&2, U32, after)),
        B.type.kind(B.trim(B.drop(Nat.add(List.length(&2, U32, B.parens(List.tail(&2, U32, after))), 2n), after))), txt, no, ind, out, ho)
    case False{}:
      bi_witness(name, Nil{}, B.type.kind(B.trim(after)), txt, no, ind, out, ho)

def bi_dtype(p: List<&2, U32> & List<&2, U32>, +txt: List<&2, U32>, +no: B.Loc, +ind: U32, +out: List<&2, B.Item>, +ho: {B.items.bend(out) == True{} : Bool}) ->
    {B.items.bend(B.decl.type.k(p, txt, no, ind, out)) == True{} : Bool}:
  match p:
    case (+name, +after):
      bi_dtk(B.starts.s(after, "("), name, after, txt, no, ind, out, ho)

def bi_dtl(c: Bool, +r: List<&2, U32>, +txt: List<&2, U32>, +no: B.Loc, +ind: U32, +out: List<&2, B.Item>, +ho: {B.items.bend(out) == True{} : Bool}) ->
    {B.items.bend(dtl(c, r, txt, no, ind, out)) == True{} : Bool}:
  match c:
    case True{}:
      bi_dtype(B.name.split(r, B.classes(r), Nil{}), txt, no, ind, out, ho)
    case False{}:
      and_intro(B.item.bend(B.decl.item(B.commas(r), txt, no, ind)), B.items.bend(out), bi_ditem(B.commas(r), txt, no, ind), ho)

def bi_ddk(c: Bool, +name: List<&2, U32>, +rest: List<&2, U32>, +txt: List<&2, U32>, +no: B.Loc, +ind: U32, +out: List<&2, B.Item>, +ho: {B.items.bend(out) == True{} : Bool}) ->
    {B.items.bend(ddk(c, name, rest, txt, no, ind, out)) == True{} : Bool}:
  match c:
    case True{}:
      bi_witness(B.trim(name), B.parens(rest), B.trim(B.drop(Nat.add(List.length(&2, U32, B.parens(rest)), 4n), rest)), txt, no, ind, out, ho)
    case False{}:
      ho

def bi_ddef(p: List<&2, U32> & List<&2, U32>, +txt: List<&2, U32>, +no: B.Loc, +ind: U32, +out: List<&2, B.Item>, +ho: {B.items.bend(out) == True{} : Bool}) ->
    {B.items.bend(B.decl.def.k(p, txt, no, ind, out)) == True{} : Bool}:
  match p:
    case (+name, +rest):
      bi_ddk(B.holds(rest, B.codes(") ->")), name, rest, txt, no, ind, out, ho)

def bi_dl(c1: Bool, c2: Bool, +rest: List<&2, U32>, +txt: List<&2, U32>, +no: B.Loc, +ind: U32, +out: List<&2, B.Item>, +ho: {B.items.bend(out) == True{} : Bool}) ->
    {B.items.bend(dlk(c1, c2, rest, txt, no, ind, out)) == True{} : Bool}:
  match c1 c2:
    case True{} _:
      bi_dtl(Bool.or(B.holds(B.trim(B.drop(5n, rest)), B.codes(":")), B.holds(B.trim(B.drop(5n, rest)), B.codes("("))), B.trim(B.drop(5n, rest)), txt, no, ind, out, ho)
    case False{} True{}:
      bi_ddef(B.until(B.when(List<&2, U32>, B.starts.s(rest, "def "), w => B.drop(4n, rest), w => rest), 40), txt, no, ind, out, ho)
    case False{} False{}:
      and_intro(B.item.bend(B.decl.item(B.commas(rest), txt, no, ind)), B.items.bend(out), bi_ditem(B.commas(rest), txt, no, ind), ho)

def bi_decl(+rest: List<&2, U32>, +txt: List<&2, U32>, +no: B.Loc, +ind: U32, +out: List<&2, B.Item>, +ho: {B.items.bend(out) == True{} : Bool}) ->
    {B.items.bend(B.decl.line(rest, txt, no, ind, out)) == True{} : Bool}:
  bi_dl(B.starts.s(rest, "type "), B.holds(rest, B.codes("(")), rest, txt, no, ind, out, ho)

def bi_fl(skip: Bool, imp: Bool, abs: Bool, obj: Bool, decl: Bool, +txt: List<&2, U32>, +no: B.Loc, +ind: U32, +out: List<&2, B.Item>, +ho: {B.items.bend(out) == True{} : Bool}) ->
    {B.items.bend(B.flat.line(skip, imp, abs, obj, decl, txt, no, ind, out)) == True{} : Bool}:
  match skip imp abs obj decl:
    case True{} _ _ _ _:
      ho
    case False{} True{} _ _ _:
      ho
    case False{} False{} True{} _ _:
      and_intro(B.item.bend(B.obj.item(B.drop(16n, txt), txt, True{}, False{}, no, ind)), B.items.bend(out), bi_obj(B.drop(16n, txt), txt, True{}, False{}, no, ind), ho)
    case False{} False{} False{} True{} _:
      and_intro(B.item.bend(B.obj.item(B.drop(7n, txt), txt, False{}, False{}, no, ind)), B.items.bend(out), bi_obj(B.drop(7n, txt), txt, False{}, False{}, no, ind), ho)
    case False{} False{} False{} False{} True{}:
      bi_decl(B.drop(8n, txt), txt, no, ind, out, ho)
    case False{} False{} False{} False{} False{}:
      ho

def bi_ex(c: Bool, +txt: List<&2, U32>, +no: B.Loc, +ind: U32) -> {B.item.bend(exk(c, txt, no, ind)) == True{} : Bool}:
  match c:
    case True{}:
      bi_obj(B.drop(16n, txt), txt, True{}, True{}, no, ind)
    case False{}:
      bi_obj(B.drop(7n, txt), txt, False{}, True{}, no, ind)

def bi_fik(c: Bool, +txt: List<&2, U32>, +no: B.Loc, +ind: U32, +out: List<&2, B.Item>, +ho: {B.items.bend(out) == True{} : Bool}) ->
    {B.items.bend(fik(c, txt, no, ind, out)) == True{} : Bool}:
  match c:
    case True{}:
      and_intro(B.item.bend(B.ext.item(txt, no, ind)), B.items.bend(out), bi_ex(B.starts.s(txt, "extend abstract "), txt, no, ind), ho)
    case False{}:
      bi_fl(Bool.or(B.blank(txt), B.comment(txt)), B.starts.s(txt, "import "), B.starts.s(txt, "abstract object "), B.starts.s(txt, "object "),
        B.starts.s(txt, "declare "), txt, no, ind, out, ho)

def bi_tm(c: Bool, +upd: Bool, +name: List<&2, U32>, +ps: List<&2, U32>, +after: List<&2, U32>, +ty: List<&2, U32>, +xs: List<&2, U32>, +no: B.Loc, +ind: U32) ->
    {B.item.bend(tmk(c, upd, name, ps, after, ty, xs, no, ind)) == True{} : Bool}:
  match c:
    case True{}:
      {==}
    case False{}:
      {==}

def bi_made(+upd: Bool, +name: List<&2, U32>, +ps: List<&2, U32>, +after: List<&2, U32>, +ty: List<&2, U32>, +xs: List<&2, U32>, +no: B.Loc, +ind: U32) ->
    {B.item.bend(B.type.made(upd, name, ps, after, ty, xs, no, ind)) == True{} : Bool}:
  bi_tm(Bool.and(B.name.ok(name), Bool.not(B.blank(ty))), upd, name, ps, after, ty, xs, no, ind)

def bi_tl(c: Bool, +upd: Bool, +name: List<&2, U32>, +after: List<&2, U32>, +ty: List<&2, U32>, +xs: List<&2, U32>, +no: B.Loc, +ind: U32) ->
    {B.item.bend(tlk(c, upd, name, after, ty, xs, no, ind)) == True{} : Bool}:
  match c:
    case True{}:
      bi_made(upd, name, B.parens(List.tail(&2, U32, after)), B.drop(Nat.add(List.length(&2, U32, B.parens(List.tail(&2, U32, after))), 2n), after), ty, xs, no, ind)
    case False{}:
      bi_made(upd, name, Nil{}, after, ty, xs, no, ind)

def bi_lhs(+upd: Bool, p: List<&2, U32> & List<&2, U32>, +ty: List<&2, U32>, +xs: List<&2, U32>, +no: B.Loc, +ind: U32) ->
    {B.item.bend(B.type.lhs(upd, p, ty, xs, no, ind)) == True{} : Bool}:
  match p:
    case (+name, +after):
      bi_tl(B.starts.s(after, "("), upd, name, after, ty, xs, no, ind)

def bi_teq(+upd: Bool, p: List<&2, U32> & List<&2, U32>, +xs: List<&2, U32>, +no: B.Loc, +ind: U32) -> {B.item.bend(B.type.eq(upd, p, xs, no, ind)) == True{} : Bool}:
  match p:
    case (+lhs, +ty):
      bi_lhs(upd, B.name.split(B.trim(lhs), B.classes(B.trim(lhs)), Nil{}), B.trim(ty), xs, no, ind)

def bi_ti(c: Bool, +txt: List<&2, U32>, +no: B.Loc, +ind: U32) -> {B.item.bend(tik(c, txt, no, ind)) == True{} : Bool}:
  match c:
    case True{}:
      bi_teq(True{}, B.split.at(B.drop(9n, txt), B.codes(" = "), Nil{}), txt, no, ind)
    case False{}:
      bi_teq(False{}, B.split.at(B.drop(5n, txt), B.codes(" = "), Nil{}), txt, no, ind)

def bi_plain(c: Bool, +txt: List<&2, U32>, +no: B.Loc, +ind: U32, +out: List<&2, B.Item>, +ho: {B.items.bend(out) == True{} : Bool}) ->
    {B.items.bend(plk(c, txt, no, ind, out)) == True{} : Bool}:
  match c:
    case True{}:
      and_intro(B.item.bend(B.type.item(txt, no, ind)), B.items.bend(out), bi_ti(B.starts.s(txt, "upd "), txt, no, ind), ho)
    case False{}:
      bi_fik(B.starts.s(txt, "extend "), txt, no, ind, out, ho)

def bi_fg(c: Bool, +m: Nat, +txt: List<&2, U32>, +t: List<&2, B.Ln>, +no: B.Loc, +ind: U32, +out: List<&2, B.Item>,
    ht: {B.items.bend(B.flat.go(m, Pair.snd(List<&2, B.Ln>, List<&2, B.Ln>, B.body.go(t, ind, Nil{})), Con{B.flat.block(txt, B.body.trim(Pair.fst(List<&2, B.Ln>, List<&2, B.Ln>, B.body.go(t, ind, Nil{}))), no, ind), out})) == True{} : Bool}, hf: {B.items.bend(B.flat.go(m, t, plk(B.is.member.type(txt), txt, no, ind, out))) == True{} : Bool}) ->
    {B.items.bend(fgk(c, m, txt, t, no, ind, out)) == True{} : Bool}:
  match c:
    case True{}:
      %Equal.sym(List<&2, B.Item>, B.on.pair(List<&2, B.Ln>, List<&2, B.Ln>, List<&2, B.Item>, B.body.go(t, ind, Nil{}), body => rest => B.flat.go(m, rest, Con{B.flat.block(txt, B.body.trim(body), no, ind), out})), B.flat.go(m, Pair.snd(List<&2, B.Ln>, List<&2, B.Ln>, B.body.go(t, ind, Nil{})), Con{B.flat.block(txt, B.body.trim(Pair.fst(List<&2, B.Ln>, List<&2, B.Ln>, B.body.go(t, ind, Nil{}))), no, ind), out}), pair_eta(B.body.go(t, ind, Nil{}), body => rest => B.flat.go(m, rest, Con{B.flat.block(txt, B.body.trim(body), no, ind), out}))) :
        {B.items.bend(_) == True{} : Bool}
      ht
    case False{}:
      hf


# flat.block's decisions: a datatype the first
def bi_fb(c1: Bool, c2: Bool, c3: Bool, c4: Bool, +txt: List<&2, U32>, +body: List<&2, B.Ln>, +no: B.Loc, +ind: U32, +hb: {B.ln.from(body, B.loc.next(no)) == True{} : Bool},
    +e1: {B.is.datatype(txt) == c1 : Bool}, +hti: {B.inline(txt) == True{} : Bool}, +hd: {B.ln.deep(body, no, ind, False{}) == True{} : Bool},
    +hbi: {B.lns.inline(body) == True{} : Bool}) -> {B.item.bend(fbk(c1, c2, c3, c4, txt, body, no, ind)) == True{} : Bool}:
  match c1 c2 c3 c4:
    case True{} _ _ _:
      and_intro(Bool.and(Bool.and(Bool.and(Bool.and(B.loc.eq(no, no), B.is.datatype(txt)), B.inline(txt)), B.ln.from(body, B.loc.next(no))), B.ln.deep(body, no, ind, False{})), B.lns.inline(body),
        and_intro(Bool.and(Bool.and(Bool.and(B.loc.eq(no, no), B.is.datatype(txt)), B.inline(txt)), B.ln.from(body, B.loc.next(no))), B.ln.deep(body, no, ind, False{}),
          and_intro(Bool.and(Bool.and(B.loc.eq(no, no), B.is.datatype(txt)), B.inline(txt)), B.ln.from(body, B.loc.next(no)),
            and_intro(Bool.and(B.loc.eq(no, no), B.is.datatype(txt)), B.inline(txt),
              and_intro(B.loc.eq(no, no), B.is.datatype(txt), loc_eq_refl(no), e1), hti), hb), hd), hbi)
    case False{} True{} _ _:
      bi_law(B.until(B.drop(4n, txt), 58), txt, body, no, ind, hb)
    case False{} False{} True{} _:
      {==}
    case False{} False{} False{} True{}:
      bi_proof(txt, B.starts.s(txt, "upd "), body, no, ind, hb)
    case False{} False{} False{} False{}:
      bi_shs(B.starts.s(txt, "shared "), B.starts.s(txt, "copied "), txt, body, no, ind, hb)

def bi_block(+txt: List<&2, U32>, +body: List<&2, B.Ln>, +no: B.Loc, +ind: U32, +hb: {B.ln.from(body, B.loc.next(no)) == True{} : Bool},
    +hti: {B.inline(txt) == True{} : Bool}, +hd: {B.ln.deep(body, no, ind, False{}) == True{} : Bool}, +hbi: {B.lns.inline(body) == True{} : Bool}) ->
    {B.item.bend(B.flat.block(txt, body, no, ind)) == True{} : Bool}:
  bi_fb(B.is.datatype(txt), B.starts.s(txt, "law "), B.starts.s(txt, "upd law "), B.proof.kw(txt), txt, body, no, ind, hb, {==}, hti, hd, hbi)

# the items read from lines numbered one more each, within a line
def bi_flat(n: Nat, ls: List<&2, B.Ln>, +out: List<&2, B.Item>, +hc: {chain(ls) == True{} : Bool}, +hi: {B.lns.inline(ls) == True{} : Bool}, +ho: {B.items.bend(out) == True{} : Bool}) ->
    {B.items.bend(B.flat.go(n, ls, out)) == True{} : Bool}:
  match n:
    case 0n:
      bi_rev(out, Nil{}, ho, {==})
    case 1n+(+m):
      match ls:
        case Nil{}:
          bi_rev(out, Nil{}, ho, {==})
        case Con{l, +t}:
          match l:
            case B.Ln{+no, +ind, +txt}:
              bi_fg(Bool.and(Bool.not(B.is.member.type(txt)), Bool.or(B.is_def(txt), B.is.datatype(txt))), m, txt, t, no, ind, out,
                bi_flat(m, Pair.snd(List<&2, B.Ln>, List<&2, B.Ln>, B.body.go(t, ind, Nil{})), Con{B.flat.block(txt, B.body.trim(Pair.fst(List<&2, B.Ln>, List<&2, B.Ln>, B.body.go(t, ind, Nil{}))), no, ind), out},
                  bg_snd(t, ind, Nil{}, B.loc.next(no), and_r(B.loc.eq(no, no), B.ln.from(t, B.loc.next(no)), hc)),
                  lpil_b(B.body.go(t, ind, Nil{}), bg_il(t, ind, Nil{}, and_r(B.inline(txt), B.lns.inline(t), hi), {==})),
                  and_intro(B.item.bend(B.flat.block(txt, B.body.trim(Pair.fst(List<&2, B.Ln>, List<&2, B.Ln>, B.body.go(t, ind, Nil{}))), no, ind)), B.items.bend(out),
                    bi_block(txt, B.body.trim(Pair.fst(List<&2, B.Ln>, List<&2, B.Ln>, B.body.go(t, ind, Nil{}))), no, ind,
                      trim_ok(Pair.fst(List<&2, B.Ln>, List<&2, B.Ln>, B.body.go(t, ind, Nil{})), B.loc.next(no), bg_fst(t, ind, Nil{}, B.loc.next(no), B.loc.next(no), and_r(B.loc.eq(no, no), B.ln.from(t, B.loc.next(no)), hc), loc_eq_refl(B.loc.next(no)))),
                      and_l(B.inline(txt), B.lns.inline(t), hi),
                      dp_trim(Pair.fst(List<&2, B.Ln>, List<&2, B.Ln>, B.body.go(t, ind, Nil{})), no, ind, dp_bg(t, ind, Nil{}, no, {==})),
                      btrim_il(Pair.fst(List<&2, B.Ln>, List<&2, B.Ln>, B.body.go(t, ind, Nil{})), lpil_a(B.body.go(t, ind, Nil{}), bg_il(t, ind, Nil{}, and_r(B.inline(txt), B.lns.inline(t), hi), {==})))),
                    ho)),
                bi_flat(m, t, plk(B.is.member.type(txt), txt, no, ind, out), chain_of(t, B.loc.next(no), and_r(B.loc.eq(no, no), B.ln.from(t, B.loc.next(no)), hc)),
                  and_r(B.inline(txt), B.lns.inline(t), hi), bi_plain(B.is.member.type(txt), txt, no, ind, out, ho)))

def Laws.bends.items(ls, k, h, hi):
  bi_flat(List.length(&2, B.Ln, ls), ls, Nil{}, chain_of(ls, k, h), hi, {==})

# The tree keeps each datatype so (`bends.tree`), as `markers.tree` keeps
# the bodies' numbers: an item's lines its node's.
def bt_frok(st: List<&2, B.Fr>) -> Bool:
  match st:
    case Nil{}:
      True{}
    case Con{f, t}:
      match f:
        case B.Fr{+top, +ind, +abs, +with, +ext, name, parents, kids, +no}:
          Bool.and(B.nodes.bend(kids), bt_frok(t))

def bt_cons(n: B.Node, +ks: List<&2, B.Node>, +hn: {B.nodes.bend(Con{n, Nil{}}) == True{} : Bool}, +hk: {B.nodes.bend(ks) == True{} : Bool}) -> {B.nodes.bend(Con{n, ks}) == True{} : Bool}:
  match n:
    case B.NObj{+abs, +ext, +name, +parents, +kids, +no}:
      and_intro(B.nodes.bend(kids), B.nodes.bend(ks), and_l(B.nodes.bend(kids), True{}, hn), hk)
    case B.NBend{+lines, +no}:
      and_intro(B.bend.ok(lines, no), B.nodes.bend(ks), and_l(B.bend.ok(lines, no), True{}, hn), hk)
    case B.NImport{+txt, +no}:
      hk
    case B.NDecl{+names, +no}:
      hk
    case B.NDef{+share, +upd, +name, +rest, +params, +body, +no, +ind, +what}:
      hk
    case B.NBad{+txt, +no}:
      hk
    case B.NErr{+msg, +no}:
      hk

def bt_head(n: B.Node, +t: List<&2, B.Node>, +h: {B.nodes.bend(Con{n, t}) == True{} : Bool}) -> {B.nodes.bend(Con{n, Nil{}}) == True{} : Bool}:
  match n:
    case B.NObj{+abs, +ext, +name, +parents, +kids, +no}:
      and_intro(B.nodes.bend(kids), True{}, and_l(B.nodes.bend(kids), B.nodes.bend(t), h), {==})
    case B.NBend{+lines, +no}:
      and_intro(B.bend.ok(lines, no), True{}, and_l(B.bend.ok(lines, no), B.nodes.bend(t), h), {==})
    case B.NImport{+txt, +no}:
      {==}
    case B.NDecl{+names, +no}:
      {==}
    case B.NDef{+share, +upd, +name, +rest, +params, +body, +no, +ind, +what}:
      {==}
    case B.NBad{+txt, +no}:
      {==}
    case B.NErr{+msg, +no}:
      {==}

def bt_tail(n: B.Node, +t: List<&2, B.Node>, +h: {B.nodes.bend(Con{n, t}) == True{} : Bool}) -> {B.nodes.bend(t) == True{} : Bool}:
  match n:
    case B.NObj{+abs, +ext, +name, +parents, +kids, +no}:
      and_r(B.nodes.bend(kids), B.nodes.bend(t), h)
    case B.NBend{+lines, +no}:
      and_r(B.bend.ok(lines, no), B.nodes.bend(t), h)
    case B.NImport{+txt, +no}:
      h
    case B.NDecl{+names, +no}:
      h
    case B.NDef{+share, +upd, +name, +rest, +params, +body, +no, +ind, +what}:
      h
    case B.NBad{+txt, +no}:
      h
    case B.NErr{+msg, +no}:
      h

def bt_rev(xs: List<&2, B.Node>, +acc: List<&2, B.Node>, +hx: {B.nodes.bend(xs) == True{} : Bool}, +ha: {B.nodes.bend(acc) == True{} : Bool}) ->
    {B.nodes.bend(List.reverse.go(&2, B.Node, xs, acc)) == True{} : Bool}:
  match xs:
    case Nil{}:
      ha
    case Con{+n, +t}:
      bt_rev(t, Con{n, acc}, bt_tail(n, t, hx), bt_cons(n, acc, bt_head(n, t, hx), ha))

def bt_into(st: List<&2, B.Fr>, +n: B.Node, +hn: {B.nodes.bend(Con{n, Nil{}}) == True{} : Bool}, +hs: {bt_frok(st) == True{} : Bool}) -> {bt_frok(B.close.into(st, n)) == True{} : Bool}:
  match st:
    case Nil{}:
      {==}
    case Con{f, +rest}:
      match f:
        case B.Fr{+top, +ind, +abs, +with, +ext, +name, +parents, +kids, +no}:
          and_intro(B.nodes.bend(Con{n, kids}), bt_frok(rest), bt_cons(n, kids, hn, and_l(B.nodes.bend(kids), bt_frok(rest), hs)), and_r(B.nodes.bend(kids), bt_frok(rest), hs))

def bt_with(with: Bool, kids: List<&2, B.Node>, +name: List<&2, U32>, +no: B.Loc, +st: List<&2, B.Fr>, +hs: {bt_frok(st) == True{} : Bool}) ->
    {bt_frok(B.close.with(with, kids, name, no, st)) == True{} : Bool}:
  match with:
    case True{}:
      hs
    case False{}:
      match kids:
        case Nil{}:
          hs
        case Con{k, t}:
          bt_into(st, B.NErr{List.append(&2, U32, B.codes("object "), List.append(&2, U32, name, B.codes(" has members, so its header ends with `with`"))), no}, {==}, hs)

def bt_cgo(c: Bool, +k: Nat, +top: Bool, +ind: U32, +abs: Bool, +with: Bool, +ext: Bool, +name: List<&2, U32>, +parents: List<&2, List<&2, U32>>,
    +kids: List<&2, B.Node>, +no: B.Loc, +rest: List<&2, B.Fr>, +i: U32,
    ih: {bt_frok(B.close.go(k, B.close.into(B.close.with(with, kids, name, no, rest), B.NObj{abs, ext, name, parents, List.reverse(&2, B.Node, kids), no}), i)) == True{} : Bool},
    hs: {bt_frok(Con{B.Fr{top, ind, abs, with, ext, name, parents, kids, no}, rest}) == True{} : Bool}) ->
    {bt_frok(cgo(c, k, top, ind, abs, with, ext, name, parents, kids, no, rest, i)) == True{} : Bool}:
  match c:
    case True{}:
      ih
    case False{}:
      hs

def bt_close(n: Nat, st: List<&2, B.Fr>, +i: U32, +hs: {bt_frok(st) == True{} : Bool}) -> {bt_frok(B.close.go(n, st, i)) == True{} : Bool}:
  match n:
    case 0n:
      hs
    case 1n+(+k):
      match st:
        case Nil{}:
          {==}
        case Con{f, +rest}:
          match f:
            case B.Fr{+top, +ind, +abs, +with, +ext, +name, +parents, +kids, +no}:
              bt_cgo(Bool.and(Bool.not(top), U32.is_ge(ind, i)), k, top, ind, abs, with, ext, name, parents, kids, no, rest, i,
                bt_close(k, B.close.into(B.close.with(with, kids, name, no, rest), B.NObj{abs, ext, name, parents, List.reverse(&2, B.Node, kids), no}), i,
                  bt_into(B.close.with(with, kids, name, no, rest), B.NObj{abs, ext, name, parents, List.reverse(&2, B.Node, kids), no},
                    and_intro(B.nodes.bend(List.reverse(&2, B.Node, kids)), True{}, bt_rev(kids, Nil{}, and_l(B.nodes.bend(kids), bt_frok(rest), hs), {==}), {==}),
                    bt_with(with, kids, name, no, rest, and_r(B.nodes.bend(kids), bt_frok(rest), hs)))),
                hs)

def bt_close_all(+st: List<&2, B.Fr>, +i: U32, +hs: {bt_frok(st) == True{} : Bool}) -> {bt_frok(B.close(st, i)) == True{} : Bool}:
  bt_close(List.length(&2, B.Fr, st), st, i, hs)

# an item put: its node so
def bt_put(st: List<&2, B.Fr>, it: B.Item, +hi: {B.item.bend(it) == True{} : Bool}, +hs: {bt_frok(st) == True{} : Bool}) -> {bt_frok(B.tree.put(st, it)) == True{} : Bool}:
  match it:
    case B.IObj{+abs, +with, +ext, +name, +parents, +no, +ind}:
      hs
    case B.IDef{+share, +upd, +name, +rest, +params, +body, +no, +ind, +what}:
      bt_into(st, B.NDef{share, upd, name, rest, params, B.toks.lines(body), no, ind, what}, {==}, hs)
    case B.IImport{+txt, +no, +ind}:
      bt_into(st, B.NImport{txt, no}, {==}, hs)
    case B.IDecl{+names, +no, +ind}:
      bt_into(st, B.NDecl{names, no}, {==}, hs)
    case B.IBad{+txt, +no, +ind}:
      bt_into(st, B.NBad{txt, no}, {==}, hs)
    case B.IBend{+lines, +no, +ind}:
      bt_into(st, B.NBend{lines, no}, and_intro(B.bend.ok(lines, no), True{}, hi, {==}), hs)

def bt_tree_go(its: List<&2, B.Item>, +st: List<&2, B.Fr>, +hi: {B.items.bend(its) == True{} : Bool}, +hs: {bt_frok(st) == True{} : Bool}) ->
    {bt_frok(B.tree.go(its, st)) == True{} : Bool}:
  match its:
    case Nil{}:
      bt_close_all(st, 0, hs)
    case Con{it, +t}:
      match it:
        case B.IImport{+txt, +no, +ind}:
          bt_tree_go(t, B.tree.put(B.close(st, ind), B.IImport{txt, no, ind}), and_r(B.item.bend(B.IImport{txt, no, ind}), B.items.bend(t), hi),
            bt_put(B.close(st, ind), B.IImport{txt, no, ind}, and_l(B.item.bend(B.IImport{txt, no, ind}), B.items.bend(t), hi), bt_close_all(st, ind, hs)))
        case B.IObj{+abs, +with, +ext, +name, +parents, +no, +ind}:
          bt_tree_go(t, B.tree.put(B.close(st, ind), B.IObj{abs, with, ext, name, parents, no, ind}), and_r(B.item.bend(B.IObj{abs, with, ext, name, parents, no, ind}), B.items.bend(t), hi),
            bt_put(B.close(st, ind), B.IObj{abs, with, ext, name, parents, no, ind}, and_l(B.item.bend(B.IObj{abs, with, ext, name, parents, no, ind}), B.items.bend(t), hi), bt_close_all(st, ind, hs)))
        case B.IDecl{+names, +no, +ind}:
          bt_tree_go(t, B.tree.put(B.close(st, ind), B.IDecl{names, no, ind}), and_r(B.item.bend(B.IDecl{names, no, ind}), B.items.bend(t), hi),
            bt_put(B.close(st, ind), B.IDecl{names, no, ind}, and_l(B.item.bend(B.IDecl{names, no, ind}), B.items.bend(t), hi), bt_close_all(st, ind, hs)))
        case B.IDef{+share, +upd, +name, +rest, +params, +body, +no, +ind, +what}:
          bt_tree_go(t, B.tree.put(B.close(st, ind), B.IDef{share, upd, name, rest, params, body, no, ind, what}), and_r(B.item.bend(B.IDef{share, upd, name, rest, params, body, no, ind, what}), B.items.bend(t), hi),
            bt_put(B.close(st, ind), B.IDef{share, upd, name, rest, params, body, no, ind, what}, and_l(B.item.bend(B.IDef{share, upd, name, rest, params, body, no, ind, what}), B.items.bend(t), hi), bt_close_all(st, ind, hs)))
        case B.IBad{+txt, +no, +ind}:
          bt_tree_go(t, B.tree.put(B.close(st, ind), B.IBad{txt, no, ind}), and_r(B.item.bend(B.IBad{txt, no, ind}), B.items.bend(t), hi),
            bt_put(B.close(st, ind), B.IBad{txt, no, ind}, and_l(B.item.bend(B.IBad{txt, no, ind}), B.items.bend(t), hi), bt_close_all(st, ind, hs)))
        case B.IBend{+lines, +no, +ind}:
          bt_tree_go(t, B.tree.put(B.close(st, ind), B.IBend{lines, no, ind}), and_r(B.item.bend(B.IBend{lines, no, ind}), B.items.bend(t), hi),
            bt_put(B.close(st, ind), B.IBend{lines, no, ind}, and_l(B.item.bend(B.IBend{lines, no, ind}), B.items.bend(t), hi), bt_close_all(st, ind, hs)))

def bt_fin(st: List<&2, B.Fr>, +hs: {bt_frok(st) == True{} : Bool}) -> {B.nodes.bend(B.tree.fin(st)) == True{} : Bool}:
  match st:
    case Nil{}:
      {==}
    case Con{f, +rest}:
      match f:
        case B.Fr{+top, +ind, +abs, +with, +ext, +name, +parents, +kids, +no}:
          bt_rev(kids, Nil{}, and_l(B.nodes.bend(kids), bt_frok(rest), hs), {==})

def Laws.bends.tree(its, h):
  bt_fin(B.tree.go(its, [B.Fr{True{}, 0, False{}, True{}, False{}, Nil{}, Nil{}, Nil{}, B.loc.top(0)}]), bt_tree_go(its, [B.Fr{True{}, 0, False{}, True{}, False{}, Nil{}, Nil{}, Nil{}, B.loc.top(0)}], h, {==}))

def Laws.bends.read(bs, base):
  Laws.bends.tree(B.flat(B.lines.at(bs, base)), Laws.bends.items(B.lines.at(bs, base), B.loc.next(base), Laws.markers.lines(bs, base), Laws.inline.lines(bs, base)))

# Every object's members' datatypes so (`bends.members`), as
# `inline.members` carries the members' texts: the walk's frames hold
# nodes so (`bwf`), an object made of a node's kids.

def bwf(st: List<&2, B.Wf>) -> Bool:
  match st:
    case Nil{}:
      True{}
    case Con{f, t}:
      match f:
        case B.Wf{+host, path, nodes}:
          Bool.and(B.nodes.bend(nodes), bwf(t))

def bwf_on(+host: U32, +path: List<&2, List<&2, U32>>, +t: List<&2, B.Node>, +rest: List<&2, B.Wf>, +ht: {B.nodes.bend(t) == True{} : Bool}, +hr: {bwf(rest) == True{} : Bool}) ->
    {bwf(Con{B.Wf{host, path, t}, rest}) == True{} : Bool}:
  and_intro(B.nodes.bend(t), bwf(rest), ht, hr)

def bwf_n(+host: U32, +path: List<&2, List<&2, U32>>, +ns: List<&2, B.Node>, +rest: List<&2, B.Wf>, +h: {bwf(Con{B.Wf{host, path, ns}, rest}) == True{} : Bool}) -> {B.nodes.bend(ns) == True{} : Bool}:
  and_l(B.nodes.bend(ns), bwf(rest), h)

def bwf_r(+host: U32, +path: List<&2, List<&2, U32>>, +ns: List<&2, B.Node>, +rest: List<&2, B.Wf>, +h: {bwf(Con{B.Wf{host, path, ns}, rest}) == True{} : Bool}) -> {bwf(rest) == True{} : Bool}:
  and_r(B.nodes.bend(ns), bwf(rest), h)

def bm_og(n: Nat, st: List<&2, B.Wf>, +next: U32, +out: List<&2, B.Ob>, +hs: {bwf(st) == True{} : Bool}, +ho: {B.obs.mems.bend(out) == True{} : Bool}) ->
    {B.obs.mems.bend(B.obs.go(n, st, next, out)) == True{} : Bool}:
  match n:
    case 0n:
      ho
    case 1n+(+k):
      match st:
        case Nil{}:
          ho
        case Con{f, +rest}:
          match f:
            case B.Wf{+host, +path, nodes}:
              match nodes:
                case Nil{}:
                  bm_og(k, rest, next, out, bwf_r(host, path, Nil{}, rest, hs), ho)
                case Con{nd, +t}:
                  match nd:
                    case B.NObj{+abs, +ext, +name, +parents, +kids, +no}:
                      bm_og(k, Con{B.Wf{next, List.append(&2, List<&2, U32>, path, [name]), kids}, Con{B.Wf{host, path, t}, rest}}, U32.add(next, 1),
                        Con{B.Ob{next, host, List.append(&2, List<&2, U32>, path, [name]), abs, parents, kids, no, B.ob.kind.of(ext, path), next}, out},
                        bwf_on(next, List.append(&2, List<&2, U32>, path, [name]), kids, Con{B.Wf{host, path, t}, rest},
                          and_l(B.nodes.bend(kids), B.nodes.bend(t), bwf_n(host, path, Con{B.NObj{abs, ext, name, parents, kids, no}, t}, rest, hs)),
                          bwf_on(host, path, t, rest, and_r(B.nodes.bend(kids), B.nodes.bend(t), bwf_n(host, path, Con{B.NObj{abs, ext, name, parents, kids, no}, t}, rest, hs)), bwf_r(host, path, Con{B.NObj{abs, ext, name, parents, kids, no}, t}, rest, hs))),
                        and_intro(B.nodes.bend(kids), B.obs.mems.bend(out), and_l(B.nodes.bend(kids), B.nodes.bend(t), bwf_n(host, path, Con{B.NObj{abs, ext, name, parents, kids, no}, t}, rest, hs)), ho))
                    case B.NBend{+lines, +no}:
                      bm_og(k, Con{B.Wf{host, path, t}, rest}, next, out,
                        bwf_on(host, path, t, rest, and_r(B.bend.ok(lines, no), B.nodes.bend(t), bwf_n(host, path, Con{B.NBend{lines, no}, t}, rest, hs)),
                          bwf_r(host, path, Con{B.NBend{lines, no}, t}, rest, hs)), ho)
                    case B.NDef{+share, +upd, +name, +rest2, +params, +body, +no, +ind, +what}:
                      bm_og(k, Con{B.Wf{host, path, t}, rest}, next, out, hs, ho)
                    case B.NImport{+txt, +no}:
                      bm_og(k, Con{B.Wf{host, path, t}, rest}, next, out, hs, ho)
                    case B.NDecl{+names, +no}:
                      bm_og(k, Con{B.Wf{host, path, t}, rest}, next, out, hs, ho)
                    case B.NBad{+txt, +no}:
                      bm_og(k, Con{B.Wf{host, path, t}, rest}, next, out, hs, ho)
                    case B.NErr{+msg, +no}:
                      bm_og(k, Con{B.Wf{host, path, t}, rest}, next, out, hs, ho)

def bm_rgo(xs: List<&2, B.Ob>, +acc: List<&2, B.Ob>, +hx: {B.obs.mems.bend(xs) == True{} : Bool}, +ha: {B.obs.mems.bend(acc) == True{} : Bool}) ->
    {B.obs.mems.bend(List.reverse.go(&2, B.Ob, xs, acc)) == True{} : Bool}:
  match xs:
    case Nil{}:
      ha
    case Con{+o, +t}:
      bm_rgo(t, Con{o, acc}, and_r(B.ob.mems.bend(o), B.obs.mems.bend(t), hx), and_intro(B.ob.mems.bend(o), B.obs.mems.bend(acc), and_l(B.ob.mems.bend(o), B.obs.mems.bend(t), hx), ha))

def bm_app(xs: List<&2, B.Ob>, +b: List<&2, B.Ob>, +hx: {B.obs.mems.bend(xs) == True{} : Bool}, +hb: {B.obs.mems.bend(b) == True{} : Bool}) ->
    {B.obs.mems.bend(List.append(&2, B.Ob, xs, b)) == True{} : Bool}:
  match xs:
    case Nil{}:
      hb
    case Con{+o, +t}:
      and_intro(B.ob.mems.bend(o), B.obs.mems.bend(List.append(&2, B.Ob, t, b)), and_l(B.ob.mems.bend(o), B.obs.mems.bend(t), hx), bm_app(t, b, and_r(B.ob.mems.bend(o), B.obs.mems.bend(t), hx), hb))

def bm_mods(ts: List<&2, List<&2, B.Node>>, +k: U32, +out: List<&2, B.Ob>, +ht: {B.trees.bend(ts) == True{} : Bool}, +ho: {B.obs.mems.bend(out) == True{} : Bool}) ->
    {B.obs.mems.bend(B.obs.mods(ts, k, out)) == True{} : Bool}:
  match ts:
    case Nil{}:
      ho
    case Con{+tr, +t}:
      bm_mods(t, U32.add(k, 1), B.obs.mod(tr, k, out), and_r(B.nodes.bend(tr), B.trees.bend(t), ht),
        bm_og(B.wf.turns([B.Wf{U32.from_nat(List.length(&2, B.Ob, out)), Nil{}, tr}]), [B.Wf{U32.from_nat(List.length(&2, B.Ob, out)), Nil{}, tr}], U32.add(U32.from_nat(List.length(&2, B.Ob, out)), 1),
          Con{B.Ob{U32.from_nat(List.length(&2, B.Ob, out)), U32.from_nat(List.length(&2, B.Ob, out)), Nil{}, False{}, Nil{}, tr, B.loc.top(k), 0,
            U32.from_nat(List.length(&2, B.Ob, out))}, out},
          bwf_on(U32.from_nat(List.length(&2, B.Ob, out)), Nil{}, tr, Nil{}, and_l(B.nodes.bend(tr), B.trees.bend(t), ht), {==}),
          and_intro(B.nodes.bend(tr), B.obs.mems.bend(out), and_l(B.nodes.bend(tr), B.trees.bend(t), ht), ho)))

def bm_obs(+trees: List<&2, List<&2, B.Node>>, +h: {B.trees.bend(trees) == True{} : Bool}) -> {B.obs.mems.bend(B.obs(trees)) == True{} : Bool}:
  bm_rgo(B.obs.mods(trees, 0, Nil{}), Nil{}, bm_mods(trees, 0, Nil{}, h, {==}), {==})

def bm_sx_k(c: Bool, +n: List<&2, U32>, +t: List<&2, List<&2, U32>>, +x: U32, +obs: List<&2, B.Ob>, +made: List<&2, B.Ob>, +next: U32,
    ih1: {B.obs.mems.bend(B.syn.x(t, x, obs, made, next)) == True{} : Bool},
    ih2: {B.obs.mems.bend(B.syn.x(t, x, obs, Con{B.Ob{next, x, List.append(&2, List<&2, U32>, B.ob.path(B.ob.at(obs, x)), [n]), B.ob.abs(B.ob.at(obs, x)), Nil{}, Nil{}, B.ob.no(B.ob.at(obs, x)), 3, next}, made}, U32.add(next, 1))) == True{} : Bool}) ->
    {B.obs.mems.bend(sxk(c, n, t, x, obs, made, next)) == True{} : Bool}:
  match c:
    case True{}:
      ih1
    case False{}:
      ih2

def bm_sx(ns: List<&2, List<&2, U32>>, +x: U32, +obs: List<&2, B.Ob>, +made: List<&2, B.Ob>, +next: U32, +hm: {B.obs.mems.bend(made) == True{} : Bool}) ->
    {B.obs.mems.bend(B.syn.x(ns, x, obs, made, next)) == True{} : Bool}:
  match ns:
    case Nil{}:
      hm
    case Con{+n, +t}:
      bm_sx_k(Bool.or(B.made.has(obs, x, n), B.made.has(made, x, n)), n, t, x, obs, made, next, bm_sx(t, x, obs, made, next, hm),
        bm_sx(t, x, obs, Con{B.Ob{next, x, List.append(&2, List<&2, U32>, B.ob.path(B.ob.at(obs, x)), [n]), B.ob.abs(B.ob.at(obs, x)), Nil{}, Nil{}, B.ob.no(B.ob.at(obs, x)), 3, next}, made},
          U32.add(next, 1), and_intro(True{}, B.obs.mems.bend(made), {==}, hm)))

def bm_sr_k(c: Bool, +id: U32, +t: List<&2, B.Ob>, +obs: List<&2, B.Ob>, +ls: List<&2, Maybe<&2, B.Lz>>, +made: List<&2, B.Ob>,
    ih1: {B.obs.mems.bend(B.syn.round(t, obs, ls, B.syn.x(B.mixin.names(B.lz.ord(B.lz.at(ls, id)), obs, Nil{}), id, obs, made, U32.add(U32.from_nat(List.length(&2, B.Ob, obs)), U32.from_nat(List.length(&2, B.Ob, made)))))) == True{} : Bool},
    ih2: {B.obs.mems.bend(B.syn.round(t, obs, ls, made)) == True{} : Bool}) -> {B.obs.mems.bend(srk(c, id, t, obs, ls, made)) == True{} : Bool}:
  match c:
    case True{}:
      ih1
    case False{}:
      ih2

def bm_sr(os: List<&2, B.Ob>, +obs: List<&2, B.Ob>, +ls: List<&2, Maybe<&2, B.Lz>>, +made: List<&2, B.Ob>, +hm: {B.obs.mems.bend(made) == True{} : Bool}) ->
    {B.obs.mems.bend(B.syn.round(os, obs, ls, made)) == True{} : Bool}:
  match os:
    case Nil{}:
      hm
    case Con{o, +t}:
      match o:
        case B.Ob{+id, +host, path, +abs, parents, mems, +no, +kind, +tpl}:
          bm_sr_k(Bool.and(B.is.object(kind), Bool.not(U32.is_eq(id, host))), id, t, obs, ls, made,
            bm_sr(t, obs, ls, B.syn.x(B.mixin.names(B.lz.ord(B.lz.at(ls, id)), obs, Nil{}), id, obs, made, U32.add(U32.from_nat(List.length(&2, B.Ob, obs)), U32.from_nat(List.length(&2, B.Ob, made)))),
              bm_sx(B.mixin.names(B.lz.ord(B.lz.at(ls, id)), obs, Nil{}), id, obs, made, U32.add(U32.from_nat(List.length(&2, B.Ob, obs)), U32.from_nat(List.length(&2, B.Ob, made))), hm)),
            bm_sr(t, obs, ls, made, hm))

def bm_get(os: List<&2, B.Ob>, n: Nat, +h: {B.obs.mems.bend(os) == True{} : Bool}) -> {B.nodes.bend(B.ob.mems(B.ob.or(List.get(&2, B.Ob, os, n)))) == True{} : Bool}:
  match os:
    case Nil{}:
      {==}
    case Con{o, +t}:
      match o:
        case B.Ob{+id, +host, +path, +abs, +parents, +mems, +no, +kind, +tpl}:
          match n:
            case 0n:
              and_l(B.nodes.bend(mems), B.obs.mems.bend(t), h)
            case 1n+k:
              bm_get(t, k, and_r(B.nodes.bend(mems), B.obs.mems.bend(t), h))

def bm_at(+obs: List<&2, B.Ob>, +id: U32, +h: {B.obs.mems.bend(obs) == True{} : Bool}) -> {B.nodes.bend(B.ob.mems(B.ob.at(obs, id))) == True{} : Bool}:
  bm_get(obs, U32.to_nat(id), h)

def bm_ct_k(c: Bool, +t: U32, +r: List<&2, U32>, +x: U32, +obs: List<&2, B.Ob>, +made: List<&2, B.Ob>, +next: U32,
    ih1: {B.obs.mems.bend(B.copies.t(r, x, obs, made, next)) == True{} : Bool},
    ih2: {B.obs.mems.bend(B.copies.t(r, x, obs, Con{B.Ob{next, x, B.ob.path(B.ob.at(obs, t)), B.ob.abs(B.ob.at(obs, t)), Nil{}, B.ob.mems(B.ob.at(obs, t)), B.ob.no(B.ob.at(obs, t)), B.ob.kind(B.ob.at(obs, t)), t}, made}, U32.add(next, 1))) == True{} : Bool}) ->
    {B.obs.mems.bend(ctk(c, t, r, x, obs, made, next)) == True{} : Bool}:
  match c:
    case True{}:
      ih1
    case False{}:
      ih2

def bm_ct(ts: List<&2, U32>, +x: U32, +obs: List<&2, B.Ob>, +made: List<&2, B.Ob>, +next: U32, +hobs: {B.obs.mems.bend(obs) == True{} : Bool},
    +hm: {B.obs.mems.bend(made) == True{} : Bool}) -> {B.obs.mems.bend(B.copies.t(ts, x, obs, made, next)) == True{} : Bool}:
  match ts:
    case Nil{}:
      hm
    case Con{+t, +r}:
      bm_ct_k(B.copy.has(obs, made, t, x), t, r, x, obs, made, next, bm_ct(r, x, obs, made, next, hobs, hm),
        bm_ct(r, x, obs, Con{B.Ob{next, x, B.ob.path(B.ob.at(obs, t)), B.ob.abs(B.ob.at(obs, t)), Nil{}, B.ob.mems(B.ob.at(obs, t)), B.ob.no(B.ob.at(obs, t)), B.ob.kind(B.ob.at(obs, t)), t}, made},
          U32.add(next, 1), hobs, and_intro(B.nodes.bend(B.ob.mems(B.ob.at(obs, t))), B.obs.mems.bend(made), bm_at(obs, t, hobs), hm)))

def bm_sc_k(c: Bool, +host: U32, +path: List<&2, List<&2, U32>>, +t: List<&2, B.Ob>, +obs: List<&2, B.Ob>, +ls: List<&2, Maybe<&2, B.Lz>>, +made: List<&2, B.Ob>,
    ih1: {B.obs.mems.bend(B.syn.copies(t, obs, ls, B.copies.t(B.mixins.of(B.lz.ord(B.lz.at(ls, host)), obs, B.path.last(path)), host, obs, made, U32.add(U32.from_nat(List.length(&2, B.Ob, obs)), U32.from_nat(List.length(&2, B.Ob, made)))))) == True{} : Bool},
    ih2: {B.obs.mems.bend(B.syn.copies(t, obs, ls, made)) == True{} : Bool}) -> {B.obs.mems.bend(sck(c, host, path, t, obs, ls, made)) == True{} : Bool}:
  match c:
    case True{}:
      ih1
    case False{}:
      ih2

def bm_sc(os: List<&2, B.Ob>, +obs: List<&2, B.Ob>, +ls: List<&2, Maybe<&2, B.Lz>>, +made: List<&2, B.Ob>, +hobs: {B.obs.mems.bend(obs) == True{} : Bool},
    +hm: {B.obs.mems.bend(made) == True{} : Bool}) -> {B.obs.mems.bend(B.syn.copies(os, obs, ls, made)) == True{} : Bool}:
  match os:
    case Nil{}:
      hm
    case Con{o, +t}:
      match o:
        case B.Ob{+id, +host, +path, +abs, parents, mems, +no, +kind, +tpl}:
          bm_sc_k(U32.is_eq(kind, 3), host, path, t, obs, ls, made,
            bm_sc(t, obs, ls, B.copies.t(B.mixins.of(B.lz.ord(B.lz.at(ls, host)), obs, B.path.last(path)), host, obs, made, U32.add(U32.from_nat(List.length(&2, B.Ob, obs)), U32.from_nat(List.length(&2, B.Ob, made)))), hobs,
              bm_ct(B.mixins.of(B.lz.ord(B.lz.at(ls, host)), obs, B.path.last(path)), host, obs, made, U32.add(U32.from_nat(List.length(&2, B.Ob, obs)), U32.from_nat(List.length(&2, B.Ob, made))), hobs, hm)),
            bm_sc(t, obs, ls, made, hobs, hm))

def bm_sg_k(c: Bool, +k: Nat, +als: List<&2, B.Al>, +obs: List<&2, B.Ob>, +npss: List<&2, List<&2, U32>>, +nls: List<&2, Maybe<&2, B.Lz>>, +made: List<&2, B.Ob>,
    +h: {B.obs.mems.bend(obs) == True{} : Bool}, ih: {B.obs.mems.bend(B.sy.obs(B.syn.go(k, als, List.append(&2, B.Ob, obs, List.reverse(&2, B.Ob, made)), npss, nls))) == True{} : Bool}) ->
    {B.obs.mems.bend(B.sy.obs(sgk(c, k, als, obs, npss, nls, made))) == True{} : Bool}:
  match c:
    case True{}:
      h
    case False{}:
      ih

def bm_sg(n: Nat, +als: List<&2, B.Al>, +obs: List<&2, B.Ob>, +pss: List<&2, List<&2, U32>>, +ls: List<&2, Maybe<&2, B.Lz>>, +h: {B.obs.mems.bend(obs) == True{} : Bool}) ->
    {B.obs.mems.bend(B.sy.obs(B.syn.go(n, als, obs, pss, ls))) == True{} : Bool}:
  match n:
    case 0n:
      h
    case 1n+(+k):
      bm_sg_k(Bool.and(B.obs.none(B.syn.copies(obs, obs, B.lins(B.pids(obs, als, obs, ls)), B.syn.round(obs, obs, B.lins(B.pids(obs, als, obs, ls)), Nil{}))), B.pss.eq(B.pids(obs, als, obs, ls), pss)), k, als, obs, B.pids(obs, als, obs, ls), B.lins(B.pids(obs, als, obs, ls)), B.syn.copies(obs, obs, B.lins(B.pids(obs, als, obs, ls)), B.syn.round(obs, obs, B.lins(B.pids(obs, als, obs, ls)), Nil{})), h,
        bm_sg(k, als, List.append(&2, B.Ob, obs, List.reverse(&2, B.Ob, B.syn.copies(obs, obs, B.lins(B.pids(obs, als, obs, ls)), B.syn.round(obs, obs, B.lins(B.pids(obs, als, obs, ls)), Nil{})))), B.pids(obs, als, obs, ls), B.lins(B.pids(obs, als, obs, ls)),
          bm_app(obs, List.reverse(&2, B.Ob, B.syn.copies(obs, obs, B.lins(B.pids(obs, als, obs, ls)), B.syn.round(obs, obs, B.lins(B.pids(obs, als, obs, ls)), Nil{}))), h,
            bm_rgo(B.syn.copies(obs, obs, B.lins(B.pids(obs, als, obs, ls)), B.syn.round(obs, obs, B.lins(B.pids(obs, als, obs, ls)), Nil{})), Nil{},
              bm_sc(obs, obs, B.lins(B.pids(obs, als, obs, ls)), B.syn.round(obs, obs, B.lins(B.pids(obs, als, obs, ls)), Nil{}), h, bm_sr(obs, obs, B.lins(B.pids(obs, als, obs, ls)), Nil{}, {==})), {==}))))

def bm_ma(os: List<&2, B.Ob>, +obs: List<&2, B.Ob>, +pss: List<&2, List<&2, U32>>, +h: {B.obs.mems.bend(os) == True{} : Bool}) -> {B.obs.mems.bend(B.made.abs(os, obs, pss)) == True{} : Bool}:
  match os:
    case Nil{}:
      {==}
    case Con{o, +t}:
      match o:
        case B.Ob{+id, +host, +path, +abs, parents, +mems, +no, +kind, +tpl}:
          and_intro(B.nodes.bend(mems), B.obs.mems.bend(B.made.abs(t, obs, pss)), and_l(B.nodes.bend(mems), B.obs.mems.bend(t), h),
            bm_ma(t, obs, pss, and_r(B.nodes.bend(mems), B.obs.mems.bend(t), h)))

def Laws.bends.members(trees, als, h):
  bm_ma(B.sy.obs(B.syn.of(als, B.obs(trees))), B.sy.obs(B.syn.of(als, B.obs(trees))), B.sy.pss(B.syn.of(als, B.obs(trees))),
    bm_sg(Nat.add(2n, Nat.add(List.length(&2, B.Ob, B.obs(trees)), List.length(&2, B.Ob, B.obs(trees)))), als, B.obs(trees), Nil{}, Nil{}, bm_obs(trees, h)))

# The datatypes at emission (`datatypes.emitted`): the root's members, an
# object's, so (`bends.members`); the writer's law has its hypotheses.

def Laws.datatypes.emitted(files, trees, als, hf, hb):
  Laws.markers.datatypes(B.ob.mems(B.ob.at(B.obs.made(B.syn.of(als, B.obs(trees))), 0)), files, hf, bm_at(B.obs.made(B.syn.of(als, B.obs(trees))), 0, Laws.bends.members(trees, als, hb)))

# Imports local, or a package's (`imports.local`, `imports.package`,
# `imports.package.root`): the boundary read off `import.plain`, which
# tests it apart from the plain names; a package's path kept by a case
# split on the test that found it, the test a `Bool` parameter of the
# function that decides on it.

def Laws.imports.local(p, ext, h):
  and_l(B.path.down(B.split.slash(p, Nil{}, Nil{})), B.import.parts(B.split.slash(p, Nil{}, Nil{}), ext), h)

def cip_pkg(+c: Bool, +mpath: List<&2, U32>, +p: List<&2, U32>, +alias: List<&2, U32>, +blend: Bool, +no: B.Loc, h: {c == True{} : Bool}) ->
    {Con{B.Ci{alias, B.ci.path(c, mpath, p, blend), no}, Nil{}} == Con{B.Ci{alias, p, no}, Nil{}} : List<&2, B.Ci>}:
  match c:
    case True{}:
      {==}
    case False{}:
      Empty.absurd({Con{B.Ci{alias, B.ci.path(False{}, mpath, p, blend), no}, Nil{}} == Con{B.Ci{alias, p, no}, Nil{}} : List<&2, B.Ci>}, MB.false_ne_true()(h))

def Laws.imports.package(mpath, p, alias, blend, no, h):
  cip_pkg(B.path.pkg(p), mpath, p, alias, blend, no, h)

def rik_pkg(+c: Bool, +root: List<&2, U32>, +p: List<&2, U32>, h: {c == True{} : Bool}) -> {B.rel.import.k(c, root, p) == p : List<&2, U32>}:
  match c:
    case True{}:
      {==}
    case False{}:
      Empty.absurd({B.rel.import.k(False{}, root, p) == p : List<&2, U32>}, MB.false_ne_true()(h))

def Laws.imports.package.root(root, p, h):
  rik_pkg(B.path.pkg(p), root, p, h)

# Laws proven (`laws.proven`, `laws.emitted`): the laws' check decides
# each unit in a helper on its tests (`er.laws.k`), so that its step
# splits them: a definition's errors leave its proof alone (it is no
# law), a stray proof's error is no Nil, and a law's, empty, says its
# proof is found (`er.unproven.k`'s test the law's own predicate).

def unp_k(c: Bool, +x: B.Un, +ux: B.Ht<B.Xe>, e: {c == B.un.proven(x, ux) : Bool}, h: {B.er.unproven.k(c, x) == Nil{} : List<&2, B.Er>}) ->
    {B.un.proven(x, ux) == True{} : Bool}:
  match c:
    case True{}:
      Equal.sym(Bool, True{}, B.un.proven(x, ux), e)
    case False{}:
      Empty.absurd({B.un.proven(x, ux) == True{} : Bool}, er_cons(B.Er{B.node.no(B.un.node(x)), "law " ++ B.text(B.rf.name(B.un.ref(x))) ++ " has no proof: a concrete object proves each law it has, and a module its own; a law not yet proven belongs in an abstract object"}, Nil{}, h))

def lp_k(c1: Bool, c2: Bool, +x: B.Un, +rest: List<&2, B.Er>, +ut: B.Ht<B.Pk<B.Un>>, +ux: B.Ht<B.Xe>,
    e1: {c1 == U32.is_eq(B.node.what(B.un.node(x)), 0) : Bool}, h: {B.er.laws.k(c1, c2, x, rest, ut, ux) == Nil{} : List<&2, B.Er>}) ->
    {B.un.proven(x, ux) == True{} : Bool}:
  match c1 c2:
    case True{} _:
      %Equal.sym(U32, B.node.what(B.un.node(x)), 0, u32_eq_of_is_eq(B.node.what(B.un.node(x)), 0, Equal.sym(Bool, True{}, U32.is_eq(B.node.what(B.un.node(x)), 0), e1))) :
        {Bool.or(Bool.not(U32.is_eq(_, 1)), Maybe.is_some(&2, U32, B.ux.find(ux, B.rf.proof(B.un.ref(x))))) == True{} : Bool}
      {==}
    case False{} True{}:
      Empty.absurd({B.un.proven(x, ux) == True{} : Bool}, er_cons(B.Er{B.node.no(B.un.node(x)), "proof " ++ B.text(B.name.plain(B.rf.name(B.un.ref(x)))) ++ " proves no law: its object states none of that name"}, rest, h))
    case False{} False{}:
      unp_k(B.un.proven(x, ux), x, ux, {==}, app_nil_l(B.er.unproven(x, ux), rest, h))

def lr_k(c1: Bool, c2: Bool, +x: B.Un, +rest: List<&2, B.Er>, +ut: B.Ht<B.Pk<B.Un>>, +ux: B.Ht<B.Xe>,
    h: {B.er.laws.k(c1, c2, x, rest, ut, ux) == Nil{} : List<&2, B.Er>}) -> {rest == Nil{} : List<&2, B.Er>}:
  match c1 c2:
    case True{} _:
      app_nil_r(B.er.law.rls(B.un.lines(x), ut, ux), rest, app_nil_r(B.er.law.rts(B.un.hd(x), ut, ux, B.node.no(B.un.node(x))), List.append(&2, B.Er, B.er.law.rls(B.un.lines(x), ut, ux), rest), h))
    case False{} True{}:
      Empty.absurd({rest == Nil{} : List<&2, B.Er>}, er_cons(B.Er{B.node.no(B.un.node(x)), "proof " ++ B.text(B.name.plain(B.rf.name(B.un.ref(x)))) ++ " proves no law: its object states none of that name"}, rest, h))
    case False{} False{}:
      app_nil_r(B.er.unproven(x, ux), rest, h)

def Laws.laws.proven(xs, ut, ux, h):
  match xs:
    case Nil{}:
      {==}
    case Con{+x, +t}:
      and_intro(B.un.proven(x, ux), B.laws.proven(t, ux),
        lp_k(U32.is_eq(B.node.what(B.un.node(x)), 0), Bool.and(U32.is_eq(B.node.what(B.un.node(x)), 2), Bool.not(B.on.maybe(U32, Bool, B.ux.find(ux, B.rf.law(B.un.ref(x))), v => False{}, +y => U32.is_eq(B.ut.what(ut, y), 1)))),
          x, B.er.laws(t, ut, ux), ut, ux, {==}, h),
        Laws.laws.proven(t, ut, ux, lr_k(U32.is_eq(B.node.what(B.un.node(x)), 0), Bool.and(U32.is_eq(B.node.what(B.un.node(x)), 2), Bool.not(B.on.maybe(U32, Bool, B.ux.find(ux, B.rf.law(B.un.ref(x))), v => False{}, +y => U32.is_eq(B.ut.what(ut, y), 1)))),
          x, B.er.laws(t, ut, ux), ut, ux, h)))

# the laws' check's part of emission's errors, a module with laws
def ers_laws(+a: List<&2, B.Er>, +b: List<&2, B.Er>, +c: List<&2, B.Er>, +r: List<&2, B.Er>,
    h: {List.append(&2, B.Er, a, List.append(&2, B.Er, b, List.append(&2, B.Er, c, r))) == Nil{} : List<&2, B.Er>}) -> {c == Nil{} : List<&2, B.Er>}:
  app_nil_l(c, r, app_nil_r(b, List.append(&2, B.Er, c, r), app_nil_r(a, List.append(&2, B.Er, b, List.append(&2, B.Er, c, r)), h)))

# a unit that is no law, proof or lemma: proven, having no law to prove
def nf_true(b: Bool, h: {Bool.not(b) == False{} : Bool}) -> {b == True{} : Bool}:
  match b:
    case True{}:
      {==}
    case False{}:
      Empty.absurd({False{} == True{} : Bool}, MB.false_ne_true()(Equal.sym(Bool, True{}, False{}, h)))

def def_proven(+x: B.Un, +ux: B.Ht<B.Xe>, +h: {Bool.not(U32.is_eq(B.node.what(B.un.node(x)), 0)) == False{} : Bool}) -> {B.un.proven(x, ux) == True{} : Bool}:
  %Equal.sym(U32, B.node.what(B.un.node(x)), 0, u32_eq_of_is_eq(B.node.what(B.un.node(x)), 0, nf_true(U32.is_eq(B.node.what(B.un.node(x)), 0), h))) :
    {Bool.or(Bool.not(U32.is_eq(_, 1)), Maybe.is_some(&2, U32, B.ux.find(ux, B.rf.proof(B.un.ref(x))))) == True{} : Bool}
  {==}

# a module none of whose units is a law, proof or lemma: every law (none)
# proven, the check emission skips for it (`units.lawful`) needed by none
def lawless_proven(xs: List<&2, B.Un>, +ux: B.Ht<B.Xe>, +h: {B.units.lawful(xs) == False{} : Bool}) -> {B.laws.proven(xs, ux) == True{} : Bool}:
  match xs:
    case Nil{}:
      {==}
    case Con{+x, +t}:
      and_intro(B.un.proven(x, ux), B.laws.proven(t, ux),
        def_proven(x, ux, or_false_l(Bool.not(U32.is_eq(B.node.what(B.un.node(x)), 0)), B.units.lawful(t), h)),
        lawless_proven(t, ux, or_false_r(Bool.not(U32.is_eq(B.node.what(B.un.node(x)), 0)), B.units.lawful(t), h)))

# the laws' check, run or skipped: every law proven either way
def le_any(c: Bool, +all: List<&2, B.Un>, +h: {B.er.laws.if(c, all) == Nil{} : List<&2, B.Er>}, +hc: {c == B.units.lawful(all) : Bool}) ->
    {B.laws.proven(all, B.ux.of(all)) == True{} : Bool}:
  match c:
    case True{}:
      Laws.laws.proven(all, B.pt.of(B.Un, all), B.ux.of(all), h)
    case False{}:
      lawless_proven(all, B.ux.of(all), Equal.sym(Bool, False{}, B.units.lawful(all), hc))

def Laws.laws.emitted(dse, mse, all, order, e, lwe, pfe, h):
  le_any(B.units.lawful(all), all,
    ers_laws(dse, mse, B.er.laws.if(B.units.lawful(all), all),
      List.append(&2, B.Er, B.er.names.of(B.names.all(List.reverse(&2, U32, order), e)), List.append(&2, B.Er, lwe, pfe)), h), {==})

# Errors reach the output (`errors.*`)
# ------------------------------------
#
# Each stage's dispatcher gives an error-free output only where its
# errors are none: `ers.out` is never a success, and a test branched on
# is split (`rm_k1`, `rm_k2`, `rn_k`); a list whose head is none is
# empty (`head_nil`).

def head_nil(es: List<&2, B.Er>, h: {Maybe.is_some(&2, B.Er, List.head(&2, B.Er, es)) == False{} : Bool}) -> {es == Nil{} : List<&2, B.Er>}:
  match es:
    case Nil{}:
      {==}
    case Con{e, t}:
      Empty.absurd({Con{e, t} == Nil{} : List<&2, B.Er>}, MB.false_ne_true()(Equal.sym(Bool, True{}, False{}, h)))

def rm_k2(c2: Bool, +cmd: U32, +q: List<&2, U32>, +r: B.Md, +t: List<&2, B.Md>, +eq: {c2 == Maybe.is_some(&2, B.Er, List.head(&2, B.Er, B.load.ers(r, t))) : Bool},
    h: {B.out.ok(B.when(B.Out, c2, v => B.ers.out(B.mds.names(Con{r, t}, B.md.path(r)), B.mds.srcs(Con{r, t}), B.load.ers(r, t)), v => B.run(cmd, B.mds.names(Con{r, t}, B.md.path(r)), B.mds.srcs(Con{r, t}), q, B.mds.paths(Con{r, t}), B.mds.trees(Con{r, t}, 0)))) == True{} : Bool}) ->
    {B.load.ers(r, t) == Nil{} : List<&2, B.Er>}:
  match c2:
    case True{}:
      Empty.absurd({B.load.ers(r, t) == Nil{} : List<&2, B.Er>}, MB.false_ne_true()(h))
    case False{}:
      head_nil(B.load.ers(r, t), Equal.sym(Bool, False{}, Maybe.is_some(&2, B.Er, List.head(&2, B.Er, B.load.ers(r, t))), eq))

def rm_k1(c1: Bool, +cmd: U32, +q: List<&2, U32>, +r: B.Md, +t: List<&2, B.Md>,
    h: {B.out.ok(B.when(B.Out, c1, u => B.when(B.Out, Maybe.is_some(&2, B.Er, List.head(&2, B.Er, B.load.ers(r, t))), v => B.ers.out(B.mds.names(Con{r, t}, B.md.path(r)), B.mds.srcs(Con{r, t}), B.load.ers(r, t)), v => B.run(cmd, B.mds.names(Con{r, t}, B.md.path(r)), B.mds.srcs(Con{r, t}), q, B.mds.paths(Con{r, t}), B.mds.trees(Con{r, t}, 0))), u => B.Out{False{}, "blend: cannot read " ++ B.text(B.md.path(r))})) == True{} : Bool}) ->
    {B.load.ers(r, t) == Nil{} : List<&2, B.Er>}:
  match c1:
    case True{}:
      rm_k2(Maybe.is_some(&2, B.Er, List.head(&2, B.Er, B.load.ers(r, t))), cmd, q, r, t, {==}, h)
    case False{}:
      Empty.absurd({B.load.ers(r, t) == Nil{} : List<&2, B.Er>}, MB.false_ne_true()(h))

def Laws.errors.read(cmd, q, r, t, h):
  rm_k1(B.md.ok(r), cmd, q, r, t, h)

def objout_ok(+cmd: U32, +files: List<&2, List<&2, U32>>, +srcs: List<&2, List<&2, U32>>, +q: List<&2, U32>, +cx: B.Cx, es: List<&2, B.Er>,
    h: {B.out.ok(B.objects.out(cmd, files, srcs, q, cx, es)) == True{} : Bool}) -> {es == Nil{} : List<&2, B.Er>}:
  match es:
    case Nil{}:
      {==}
    case Con{x, t}:
      Empty.absurd({Con{x, t} == Nil{} : List<&2, B.Er>}, MB.false_ne_true()(h))

def Laws.errors.objects(cmd, files, srcs, q, paths, trees, h):
  objout_ok(cmd, files, srcs, q, B.objects.cx(B.als.all(trees, 0, paths, B.obs(trees)), paths, B.obs(trees)), B.objects.ers(B.als.all(trees, 0, paths, B.obs(trees)), B.objects.cx(B.als.all(trees, 0, paths, B.obs(trees)), paths, B.obs(trees))), h)

def ro_ok(+files: List<&2, List<&2, U32>>, +srcs: List<&2, List<&2, U32>>, +obs: List<&2, B.Ob>, +os: List<&2, B.Oc>, es: List<&2, B.Er>,
    h: {B.out.ok(B.resolve.out(files, srcs, obs, os, es)) == True{} : Bool}) -> {es == Nil{} : List<&2, B.Er>}:
  match es:
    case Nil{}:
      {==}
    case Con{x, t}:
      Empty.absurd({Con{x, t} == Nil{} : List<&2, B.Er>}, MB.false_ne_true()(h))

def rn_k(c: Bool, +cmd: U32, +files: List<&2, List<&2, U32>>, +srcs: List<&2, List<&2, U32>>, +cx: B.Cx, +os: List<&2, B.Oc>, +eq: {c == Bool.or(U32.is_eq(cmd, 3), Maybe.is_some(&2, B.Er, List.head(&2, B.Er, B.ocs.ers(os)))) : Bool},
    h: {B.out.ok(B.resolved.out(c, files, srcs, cx, os)) == True{} : Bool}) ->
    {B.ocs.ers(os) == Nil{} : List<&2, B.Er>}:
  match c:
    case True{}:
      ro_ok(files, srcs, B.cx.obs(cx), os, B.ocs.ers(os), h)
    case False{}:
      head_nil(B.ocs.ers(os), or_false_r(U32.is_eq(cmd, 3), Maybe.is_some(&2, B.Er, List.head(&2, B.Er, B.ocs.ers(os))), Equal.sym(Bool, False{}, Bool.or(U32.is_eq(cmd, 3), Maybe.is_some(&2, B.Er, List.head(&2, B.Er, B.ocs.ers(os)))), eq)))

def Laws.errors.copies(cmd, files, srcs, cx, os, h):
  rn_k(Bool.or(U32.is_eq(cmd, 3), Maybe.is_some(&2, B.Er, List.head(&2, B.Er, B.ocs.ers(os)))), cmd, files, srcs, cx, os, {==}, h)

def Laws.errors.emitted(files, srcs, e, order, tree, more, lw, pf, es, h):
  match es:
    case Nil{}:
      {==}
    case Con{x, t}:
      Empty.absurd({Con{x, t} == Nil{} : List<&2, B.Er>}, MB.false_ne_true()(h))

# Fuel enough (`flat.fuel`, `close.fuel`)
# ---------------------------------------
#
# A loop on fuel takes at least one of its input a turn: past the input
# left, one more turn of fuel changes nothing (`flat_more`, `close_more`),
# so that any more changes nothing; `body.go` leaves no more lines than
# it was given (`bg_len`), and closing an object keeps the stack's height
# but for its frame (`into_len`, `with_len`).

def bgl_k(c: Bool, +no: B.Loc, +li: U32, +txt: List<&2, U32>, +t: List<&2, B.Ln>, +ind: U32, +acc: List<&2, B.Ln>,
    ih: MNat.le(List.length(&2, B.Ln, Pair.snd(List<&2, B.Ln>, List<&2, B.Ln>, B.body.go(t, ind, Con{B.Ln{no, li, txt}, acc}))), List.length(&2, B.Ln, t))) ->
    MNat.le(List.length(&2, B.Ln, Pair.snd(List<&2, B.Ln>, List<&2, B.Ln>, bgk(c, no, li, txt, t, ind, acc))), 1n+List.length(&2, B.Ln, t)):
  match c:
    case True{}:
      MNat.le_trans(List.length(&2, B.Ln, Pair.snd(List<&2, B.Ln>, List<&2, B.Ln>, B.body.go(t, ind, Con{B.Ln{no, li, txt}, acc}))), List.length(&2, B.Ln, t), 1n+List.length(&2, B.Ln, t),
        ih, MNat.le_succ(List.length(&2, B.Ln, t)))
    case False{}:
      MNat.le_refl(1n+List.length(&2, B.Ln, t))

# body.go's lines left: no more than it was given
def bg_len(ls: List<&2, B.Ln>, +ind: U32, +acc: List<&2, B.Ln>) -> MNat.le(List.length(&2, B.Ln, Pair.snd(List<&2, B.Ln>, List<&2, B.Ln>, B.body.go(ls, ind, acc))), List.length(&2, B.Ln, ls)):
  match ls:
    case Nil{}:
      MNat.le_refl(0n)
    case Con{l, +t}:
      match l:
        case B.Ln{+no, +li, +txt}:
          bgl_k(Bool.or(B.blank(txt), U32.is_gt(li, ind)), no, li, txt, t, ind, acc, bg_len(t, ind, Con{B.Ln{no, li, txt}, acc}))

def fm_k(c: Bool, +m: Nat, +txt: List<&2, U32>, +t: List<&2, B.Ln>, +no: B.Loc, +ind: U32, +out: List<&2, B.Item>, +h: MNat.le(List.length(&2, B.Ln, t), m),
    ih: @ls2:List<&2, B.Ln> -> @o2:List<&2, B.Item> -> @h2:MNat.le(List.length(&2, B.Ln, ls2), m) -> {B.flat.go(1n+m, ls2, o2) == B.flat.go(m, ls2, o2) : List<&2, B.Item>}) ->
    {fgk(c, 1n+m, txt, t, no, ind, out) == fgk(c, m, txt, t, no, ind, out) : List<&2, B.Item>}:
  match c:
    case True{}:
      %Equal.sym(List<&2, B.Item>, B.on.pair(List<&2, B.Ln>, List<&2, B.Ln>, List<&2, B.Item>, B.body.go(t, ind, Nil{}), body => rest => B.flat.go(1n+m, rest, Con{B.flat.block(txt, B.body.trim(body), no, ind), out})), B.flat.go(1n+m, Pair.snd(List<&2, B.Ln>, List<&2, B.Ln>, B.body.go(t, ind, Nil{})), Con{B.flat.block(txt, B.body.trim(Pair.fst(List<&2, B.Ln>, List<&2, B.Ln>, B.body.go(t, ind, Nil{}))), no, ind), out}), pair_eta(B.body.go(t, ind, Nil{}), body => rest => B.flat.go(1n+m, rest, Con{B.flat.block(txt, B.body.trim(body), no, ind), out}))) :
        {_ == fgk(True{}, m, txt, t, no, ind, out) : List<&2, B.Item>}
      %Equal.sym(List<&2, B.Item>, B.on.pair(List<&2, B.Ln>, List<&2, B.Ln>, List<&2, B.Item>, B.body.go(t, ind, Nil{}), body => rest => B.flat.go(m, rest, Con{B.flat.block(txt, B.body.trim(body), no, ind), out})), B.flat.go(m, Pair.snd(List<&2, B.Ln>, List<&2, B.Ln>, B.body.go(t, ind, Nil{})), Con{B.flat.block(txt, B.body.trim(Pair.fst(List<&2, B.Ln>, List<&2, B.Ln>, B.body.go(t, ind, Nil{}))), no, ind), out}), pair_eta(B.body.go(t, ind, Nil{}), body => rest => B.flat.go(m, rest, Con{B.flat.block(txt, B.body.trim(body), no, ind), out}))) :
        {B.flat.go(1n+m, Pair.snd(List<&2, B.Ln>, List<&2, B.Ln>, B.body.go(t, ind, Nil{})), Con{B.flat.block(txt, B.body.trim(Pair.fst(List<&2, B.Ln>, List<&2, B.Ln>, B.body.go(t, ind, Nil{}))), no, ind), out}) == _ : List<&2, B.Item>}
      ih(Pair.snd(List<&2, B.Ln>, List<&2, B.Ln>, B.body.go(t, ind, Nil{})), Con{B.flat.block(txt, B.body.trim(Pair.fst(List<&2, B.Ln>, List<&2, B.Ln>, B.body.go(t, ind, Nil{}))), no, ind), out},
        MNat.le_trans(List.length(&2, B.Ln, Pair.snd(List<&2, B.Ln>, List<&2, B.Ln>, B.body.go(t, ind, Nil{}))), List.length(&2, B.Ln, t), m, bg_len(t, ind, Nil{}), h))
    case False{}:
      ih(t, plk(B.is.member.type(txt), txt, no, ind, out), h)

# flat.go past the lines left: one more turn changes nothing
def flat_more(n: Nat, ls: List<&2, B.Ln>, +out: List<&2, B.Item>, +h: MNat.le(List.length(&2, B.Ln, ls), n)) -> {B.flat.go(1n+n, ls, out) == B.flat.go(n, ls, out) : List<&2, B.Item>}:
  match n:
    case 0n:
      match ls:
        case Nil{}:
          {==}
        case Con{l, t}:
          Empty.absurd({B.flat.go(1n, Con{l, t}, out) == B.flat.go(0n, Con{l, t}, out) : List<&2, B.Item>}, MB.false_ne_true()(h))
    case 1n+(+m):
      match ls:
        case Nil{}:
          {==}
        case Con{l, +t}:
          match l:
            case B.Ln{+no, +ind, +txt}:
              fm_k(Bool.and(Bool.not(B.is.member.type(txt)), Bool.or(B.is_def(txt), B.is.datatype(txt))), m, txt, t, no, ind, out, h,
                ls2 => o2 => h2 => flat_more(m, ls2, o2, h2))

def Laws.flat.fuel(ls, k):
  match k:
    case 0n:
      {==}
    case 1n+(+j):
      Equal.trans(List<&2, B.Item>, B.flat.go(1n+Nat.add(j, List.length(&2, B.Ln, ls)), ls, Nil{}), B.flat.go(Nat.add(j, List.length(&2, B.Ln, ls)), ls, Nil{}), B.flat(ls),
        flat_more(Nat.add(j, List.length(&2, B.Ln, ls)), ls, Nil{}, le_add_l(j, List.length(&2, B.Ln, ls))), Laws.flat.fuel(ls, j))

# closing an object keeps the stack's height
def into_len(st: List<&2, B.Fr>, +n: B.Node) -> {List.length(&2, B.Fr, B.close.into(st, n)) == List.length(&2, B.Fr, st) : Nat}:
  match st:
    case Nil{}:
      {==}
    case Con{f, rest}:
      {==}

def with_len(with: Bool, kids: List<&2, B.Node>, +name: List<&2, U32>, +no: B.Loc, +st: List<&2, B.Fr>) ->
    {List.length(&2, B.Fr, B.close.with(with, kids, name, no, st)) == List.length(&2, B.Fr, st) : Nat}:
  match with:
    case True{}:
      match kids:
        case Nil{}:
          {==}
        case Con{k, t}:
          {==}
    case False{}:
      match kids:
        case Nil{}:
          {==}
        case Con{k, t}:
          into_len(st, B.NErr{List.append(&2, U32, B.codes("object "), List.append(&2, U32, name, B.codes(" has members, so its header ends with `with`"))), no})

def cm_k(c: Bool, +m: Nat, +top: Bool, +ind: U32, +abs: Bool, +with: Bool, +ext: Bool, +name: List<&2, U32>, +parents: List<&2, List<&2, U32>>,
    +kids: List<&2, B.Node>, +no: B.Loc, +rest: List<&2, B.Fr>, +i: U32, +h: MNat.le(List.length(&2, B.Fr, rest), m),
    ih: @st2:List<&2, B.Fr> -> @h2:MNat.le(List.length(&2, B.Fr, st2), m) -> {B.close.go(1n+m, st2, i) == B.close.go(m, st2, i) : List<&2, B.Fr>}) ->
    {cgo(c, 1n+m, top, ind, abs, with, ext, name, parents, kids, no, rest, i) == cgo(c, m, top, ind, abs, with, ext, name, parents, kids, no, rest, i) : List<&2, B.Fr>}:
  match c:
    case True{}:
      ih(B.close.into(B.close.with(with, kids, name, no, rest), B.NObj{abs, ext, name, parents, List.reverse(&2, B.Node, kids), no}),
        (%Equal.sym(Nat, List.length(&2, B.Fr, B.close.into(B.close.with(with, kids, name, no, rest), B.NObj{abs, ext, name, parents, List.reverse(&2, B.Node, kids), no})),
            List.length(&2, B.Fr, B.close.with(with, kids, name, no, rest)),
            into_len(B.close.with(with, kids, name, no, rest), B.NObj{abs, ext, name, parents, List.reverse(&2, B.Node, kids), no})) : MNat.le(_, m)
          %Equal.sym(Nat, List.length(&2, B.Fr, B.close.with(with, kids, name, no, rest)), List.length(&2, B.Fr, rest), with_len(with, kids, name, no, rest)) : MNat.le(_, m)
          h))
    case False{}:
      {==}

# close.go past the stack left: one more turn changes nothing
def close_more(n: Nat, st: List<&2, B.Fr>, +i: U32, +h: MNat.le(List.length(&2, B.Fr, st), n)) -> {B.close.go(1n+n, st, i) == B.close.go(n, st, i) : List<&2, B.Fr>}:
  match n:
    case 0n:
      match st:
        case Nil{}:
          {==}
        case Con{f, rest}:
          Empty.absurd({B.close.go(1n, Con{f, rest}, i) == B.close.go(0n, Con{f, rest}, i) : List<&2, B.Fr>}, MB.false_ne_true()(h))
    case 1n+(+m):
      match st:
        case Nil{}:
          {==}
        case Con{f, +rest}:
          match f:
            case B.Fr{+top, +ind, +abs, +with, +ext, +name, +parents, +kids, +no}:
              cm_k(Bool.and(Bool.not(top), U32.is_ge(ind, i)), m, top, ind, abs, with, ext, name, parents, kids, no, rest, i, h,
                st2 => h2 => close_more(m, st2, i, h2))

def Laws.close.fuel(st, i, k):
  match k:
    case 0n:
      {==}
    case 1n+(+j):
      Equal.trans(List<&2, B.Fr>, B.close.go(1n+Nat.add(j, List.length(&2, B.Fr, st)), st, i), B.close.go(Nat.add(j, List.length(&2, B.Fr, st)), st, i), B.close(st, i),
        close_more(Nat.add(j, List.length(&2, B.Fr, st)), st, i, le_add_l(j, List.length(&2, B.Fr, st))), Laws.close.fuel(st, i, j))

# The objects' fuel (`obs.fuel`): a turn for each node and each list's
# end, as `obs.turns` counts them, an object's members pushed as a list
# of their own (`add_assoc` regrouping their turns); a stack never holds
# no turn (`turns_nz`).

def turns_nz(nodes: List<&2, B.Node>, +r: Nat) -> {Nat.is_le(Nat.add(B.obs.turns(nodes), r), 0n) == False{} : Bool}:
  match nodes:
    case Nil{}:
      {==}
    case Con{nd, t}:
      match nd:
        case B.NObj{+abs, +ext, +name, +parents, +kids, +no}:
          {==}
        case B.NImport{+txt, +no}:
          {==}
        case B.NDecl{+names, +no}:
          {==}
        case B.NDef{+share, +upd, +name, +rest, +params, +body, +no, +ind, +what}:
          {==}
        case B.NBad{+txt, +no}:
          {==}
        case B.NErr{+msg, +no}:
          {==}
        case B.NBend{+lines, +no}:
          {==}

# obs.go past the turns left: one more changes nothing
def obs_more(n: Nat, st: List<&2, B.Wf>, +next: U32, +out: List<&2, B.Ob>, +h: MNat.le(B.wf.turns(st), n)) -> {B.obs.go(1n+n, st, next, out) == B.obs.go(n, st, next, out) : List<&2, B.Ob>}:
  match n:
    case 0n:
      match st:
        case Nil{}:
          {==}
        case Con{f, +rest}:
          match f:
            case B.Wf{+host, +path, +nodes}:
              Empty.absurd({B.obs.go(1n, Con{B.Wf{host, path, nodes}, rest}, next, out) == B.obs.go(0n, Con{B.Wf{host, path, nodes}, rest}, next, out) : List<&2, B.Ob>},
                MB.false_ne_true()(Equal.trans(Bool, False{}, Nat.is_le(Nat.add(B.obs.turns(nodes), B.wf.turns(rest)), 0n), True{},
                  Equal.sym(Bool, Nat.is_le(Nat.add(B.obs.turns(nodes), B.wf.turns(rest)), 0n), False{}, turns_nz(nodes, B.wf.turns(rest))), h)))
    case 1n+(+m):
      match st:
        case Nil{}:
          {==}
        case Con{f, +rest}:
          match f:
            case B.Wf{+host, +path, nodes}:
              match nodes:
                case Nil{}:
                  obs_more(m, rest, next, out, h)
                case Con{nd, +t}:
                  match nd:
                    case B.NObj{+abs, +ext, +name, +parents, +kids, +no}:
                      obs_more(m, Con{B.Wf{next, List.append(&2, List<&2, U32>, path, [name]), kids}, Con{B.Wf{host, path, t}, rest}}, U32.add(next, 1),
                        Con{B.Ob{next, host, List.append(&2, List<&2, U32>, path, [name]), abs, parents, kids, no, B.ob.kind.of(ext, path), next}, out},
                        (%MNat.add_assoc(B.obs.turns(kids), B.obs.turns(t), B.wf.turns(rest)) : MNat.le(_, m)
                          h))
                    case B.NImport{+txt, +no}:
                      obs_more(m, Con{B.Wf{host, path, t}, rest}, next, out, h)
                    case B.NDecl{+names, +no}:
                      obs_more(m, Con{B.Wf{host, path, t}, rest}, next, out, h)
                    case B.NDef{+share, +upd, +dname, +drest, +params, +body, +no, +ind, +what}:
                      obs_more(m, Con{B.Wf{host, path, t}, rest}, next, out, h)
                    case B.NBad{+txt, +no}:
                      obs_more(m, Con{B.Wf{host, path, t}, rest}, next, out, h)
                    case B.NErr{+msg, +no}:
                      obs_more(m, Con{B.Wf{host, path, t}, rest}, next, out, h)
                    case B.NBend{+lines, +no}:
                      obs_more(m, Con{B.Wf{host, path, t}, rest}, next, out, h)

def Laws.obs.fuel(st, next, out, k):
  match k:
    case 0n:
      {==}
    case 1n+(+j):
      Equal.trans(List<&2, B.Ob>, B.obs.go(1n+Nat.add(j, B.wf.turns(st)), st, next, out), B.obs.go(Nat.add(j, B.wf.turns(st)), st, next, out), B.obs.from(st, next, out),
        obs_more(Nat.add(j, B.wf.turns(st)), st, next, out, le_add_l(j, B.wf.turns(st))), Laws.obs.fuel(st, next, out, j))

# Hosts' turns
# ------------

# law hosts.fuel: where er.hosts reports none, each object's host is
# numbered no higher than its place (`hosted_get`, an object past the
# list's end hosted by 0), so that a host other than the object itself
# is numbered lower (`host_lt`, through `u32_is_eq_to_nat` and Nat.cmp),
# and the walk past id's number takes one more turn for nothing

# a comparison at most and not equal is less
def cmp_lt(c: Cmp, hle: {Cmp.is_le(c) == True{} : Bool}, ne: {Cmp.is_eq(c) == False{} : Bool}) -> {Cmp.is_lt(c) == True{} : Bool}:
  match c:
    case LT{}:
      {==}
    case EQ{}:
      Empty.absurd({Cmp.is_lt(EQ{}) == True{} : Bool}, MB.true_ne_false()(ne))
    case GT{}:
      Empty.absurd({Cmp.is_lt(GT{}) == True{} : Bool}, MB.false_ne_true()(hle))

def lt_from(+a: Nat, +b: Nat, hle: MNat.le(a, b), ne: {Nat.is_eq(a, b) == False{} : Bool}) -> MNat.le(1n+a, b):
  Equal.trans(Bool, Nat.is_le(1n+a, b), Nat.is_lt(a, b), True{}, Equal.sym(Bool, Nat.is_lt(a, b), Nat.is_le(1n+a, b), MNat.is_lt_eq_succ_le(a, b)),
    cmp_lt(Nat.cmp(a, b), hle, ne))

# er.hosts reporting none of an object and the rest: the object's host
# numbered no higher than its place, and none of the rest
def eh_head(c: Bool, +o: B.Ob, +t: List<&2, B.Ob>, +i: Nat, e: {Nat.is_le(U32.to_nat(B.ob.host(o)), i) == c : Bool},
    h: {B.when(List<&2, B.Er>, c, u => B.er.hosts(t, 1n+i), u => Con{B.er.host(o), B.er.hosts(t, 1n+i)}) == Nil{} : List<&2, B.Er>}) ->
    MNat.le(U32.to_nat(B.ob.host(o)), i):
  match c:
    case True{}:
      e
    case False{}:
      Empty.absurd(MNat.le(U32.to_nat(B.ob.host(o)), i), er_cons(B.er.host(o), B.er.hosts(t, 1n+i), h))

def eh_tail(c: Bool, +o: B.Ob, +t: List<&2, B.Ob>, +i: Nat,
    h: {B.when(List<&2, B.Er>, c, u => B.er.hosts(t, 1n+i), u => Con{B.er.host(o), B.er.hosts(t, 1n+i)}) == Nil{} : List<&2, B.Er>}) ->
    {B.er.hosts(t, 1n+i) == Nil{} : List<&2, B.Er>}:
  match c:
    case True{}:
      h
    case False{}:
      Empty.absurd({B.er.hosts(t, 1n+i) == Nil{} : List<&2, B.Er>}, er_cons(B.er.host(o), B.er.hosts(t, 1n+i), h))

# where er.hosts from place i reports none, the object j places on has
# its host numbered i + j at most; past the list's end, host 0
def hosted_get(xs: List<&2, B.Ob>, +i: Nat, j: Nat, +h: {B.er.hosts(xs, i) == Nil{} : List<&2, B.Er>}) ->
    MNat.le(U32.to_nat(B.ob.host(B.ob.or(List.get(&2, B.Ob, xs, j)))), Nat.add(j, i)):
  match xs:
    case Nil{}:
      MNat.zero_le(Nat.add(j, i))
    case Con{+o, +t}:
      match j:
        case 0n:
          eh_head(Nat.is_le(U32.to_nat(B.ob.host(o)), i), o, t, i, {==}, h)
        case 1n+(+p):
          %MNat.add_succ(p, i) : {Nat.is_le(U32.to_nat(B.ob.host(B.ob.or(List.get(&2, B.Ob, t, p)))), _) == True{} : Bool}
          hosted_get(t, 1n+i, p, eh_tail(Nat.is_le(U32.to_nat(B.ob.host(o)), i), o, t, i, h))

def hosted_at(+obs: List<&2, B.Ob>, +id: U32, +hc: {B.er.hosts(obs, 0n) == Nil{} : List<&2, B.Er>}) ->
    MNat.le(U32.to_nat(B.ob.host(B.ob.at(obs, id))), U32.to_nat(id)):
  %MNat.add_zero(U32.to_nat(id)) : {Nat.is_le(U32.to_nat(B.ob.host(B.ob.at(obs, id))), _) == True{} : Bool}
  hosted_get(obs, 0n, U32.to_nat(id), hc)

# a host other than the object itself numbered lower
def host_lt(+obs: List<&2, B.Ob>, +id: U32, +hc: {B.er.hosts(obs, 0n) == Nil{} : List<&2, B.Er>}, e: {B.is.root(obs, id) == False{} : Bool}) ->
    MNat.le(1n+U32.to_nat(B.ob.host(B.ob.at(obs, id))), U32.to_nat(id)):
  lt_from(U32.to_nat(B.ob.host(B.ob.at(obs, id))), U32.to_nat(id), hosted_at(obs, id, hc),
    Equal.trans(Bool, Nat.is_eq(U32.to_nat(B.ob.host(B.ob.at(obs, id))), U32.to_nat(id)), U32.is_eq(B.ob.host(B.ob.at(obs, id)), id), False{},
      Equal.sym(Bool, U32.is_eq(B.ob.host(B.ob.at(obs, id)), id), Nat.is_eq(U32.to_nat(B.ob.host(B.ob.at(obs, id))), U32.to_nat(id)),
        MU.u32_is_eq_to_nat(B.ob.host(B.ob.at(obs, id)), id)), e))

# no turn left: id is numbered 0, a module's root
def hm_0(c: Bool, +obs: List<&2, B.Ob>, +id: U32, +hc: {B.er.hosts(obs, 0n) == Nil{} : List<&2, B.Er>}, e: {B.is.root(obs, id) == c : Bool},
    h: MNat.le(U32.to_nat(id), 0n)) ->
    {B.when(List<&2, U32>, c, u => Nil{}, u => Con{B.ob.host(B.ob.at(obs, id)), B.hosts.go(0n, obs, B.ob.host(B.ob.at(obs, id)))}) == Nil{} : List<&2, U32>}:
  match c:
    case True{}:
      {==}
    case False{}:
      Empty.absurd({Con{B.ob.host(B.ob.at(obs, id)), B.hosts.go(0n, obs, B.ob.host(B.ob.at(obs, id)))} == Nil{} : List<&2, U32>},
        MB.false_ne_true()(MNat.le_trans(1n+U32.to_nat(B.ob.host(B.ob.at(obs, id))), U32.to_nat(id), 0n, host_lt(obs, id, hc, e), h)))

# a turn: a root ends the walk; else its host, numbered lower, one turn
# fewer
def hm_k(c: Bool, +m: Nat, +obs: List<&2, B.Ob>, +id: U32, +hc: {B.er.hosts(obs, 0n) == Nil{} : List<&2, B.Er>}, e: {B.is.root(obs, id) == c : Bool},
    h: MNat.le(U32.to_nat(id), 1n+m),
    ih: @x:U32 -> @hx:MNat.le(U32.to_nat(x), m) -> {B.hosts.go(1n+m, obs, x) == B.hosts.go(m, obs, x) : List<&2, U32>}) ->
    {B.when(List<&2, U32>, c, u => Nil{}, u => Con{B.ob.host(B.ob.at(obs, id)), B.hosts.go(1n+m, obs, B.ob.host(B.ob.at(obs, id)))}) ==
      B.when(List<&2, U32>, c, u => Nil{}, u => Con{B.ob.host(B.ob.at(obs, id)), B.hosts.go(m, obs, B.ob.host(B.ob.at(obs, id)))}) : List<&2, U32>}:
  match c:
    case True{}:
      {==}
    case False{}:
      Equal.cong(List<&2, U32>, List<&2, U32>, xs => Con{B.ob.host(B.ob.at(obs, id)), xs},
        B.hosts.go(1n+m, obs, B.ob.host(B.ob.at(obs, id))), B.hosts.go(m, obs, B.ob.host(B.ob.at(obs, id))),
        ih(B.ob.host(B.ob.at(obs, id)), MNat.le_trans(1n+U32.to_nat(B.ob.host(B.ob.at(obs, id))), U32.to_nat(id), 1n+m, host_lt(obs, id, hc, e), h)))

# hosts.go past id's number: one more turn changes nothing
def hosts_more(n: Nat, +obs: List<&2, B.Ob>, +id: U32, +hc: {B.er.hosts(obs, 0n) == Nil{} : List<&2, B.Er>}, h: MNat.le(U32.to_nat(id), n)) ->
    {B.hosts.go(1n+n, obs, id) == B.hosts.go(n, obs, id) : List<&2, U32>}:
  match n:
    case 0n:
      hm_0(B.is.root(obs, id), obs, id, hc, {==}, h)
    case 1n+(+m):
      hm_k(B.is.root(obs, id), m, obs, id, hc, {==}, h, x => hx => hosts_more(m, obs, x, hc, hx))

def Laws.hosts.fuel(obs, id, k, h):
  match k:
    case 0n:
      {==}
    case 1n+(+j):
      Equal.trans(List<&2, U32>, B.hosts.go(1n+Nat.add(j, 1n+U32.to_nat(id)), obs, id), B.hosts.go(Nat.add(j, 1n+U32.to_nat(id)), obs, id), B.hosts(obs, id),
        hosts_more(Nat.add(j, 1n+U32.to_nat(id)), obs, id, h,
          MNat.le_trans(U32.to_nat(id), 1n+U32.to_nat(id), Nat.add(j, 1n+U32.to_nat(id)), MNat.le_succ(U32.to_nat(id)), le_add_l(j, 1n+U32.to_nat(id)))),
        Laws.hosts.fuel(obs, id, j, h))

# law objects.checked: the stage's errors none, each check's in turn,
# the first of an append and the rest (`app_nil_l`, `app_nil_r`)
def nil_empty(a: List<&2, B.Er>, ha: {a == Nil{} : List<&2, B.Er>}) -> {List.is_empty(&2, B.Er, a) == True{} : Bool}:
  match a:
    case Nil{}:
      {==}
    case Con{+x, +t}:
      Empty.absurd({List.is_empty(&2, B.Er, Con{x, t}) == True{} : Bool}, er_cons(x, t, ha))

def nil_and(a: List<&2, B.Er>, +r: Bool, ha: {a == Nil{} : List<&2, B.Er>}, hr: {r == True{} : Bool}) -> {Bool.and(List.is_empty(&2, B.Er, a), r) == True{} : Bool}:
  match a:
    case Nil{}:
      hr
    case Con{+x, +t}:
      Empty.absurd({Bool.and(List.is_empty(&2, B.Er, Con{x, t}), r) == True{} : Bool}, er_cons(x, t, ha))

def and_nil(+a: List<&2, B.Er>, +b: List<&2, B.Er>, +r: Bool, +h: {List.append(&2, B.Er, a, b) == Nil{} : List<&2, B.Er>},
    k: @hb:{b == Nil{} : List<&2, B.Er>} -> {r == True{} : Bool}) -> {Bool.and(List.is_empty(&2, B.Er, a), r) == True{} : Bool}:
  nil_and(a, r, app_nil_l(a, b, h), k(app_nil_r(a, b, h)))

